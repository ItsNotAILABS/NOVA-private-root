{
  "_SOVEREIGN": "NOVA SOVEREIGN BUILD MANIFEST — NSCP-2025",
  "_OWNER": "Alfredo Medina Hernandez | Dallas TX | MedinaSITech@outlook.com",
  "_NOTICE": "This manifest drives the NOVA sovereign build CLI. No DFX required.",
  "_EPOCH": "NOVA-EPOCH-2025",

  "version": "1",
  "name": "NOVA",
  "description": "NOVA (PARALLAX) — Sovereign Cognitive Swarm Organism",

  "compiler": {
    "tool": "moc",
    "version": "0.13.4",
    "source": "https://github.com/dfinity/motoko/releases/download/0.13.4/moc",
    "source_linux_aarch64": "https://github.com/dfinity/motoko/releases/download/0.13.4/moc",
    "cache_dir": ".nova/moc"
  },

  "canisters": {
    "swarm_brain": {
      "type": "motoko",
      "main": "src/swarm_brain/main.mo",
      "dependencies": [],
      "description": "Core organism brain — 17-layer sovereign cognitive system"
    },
    "swarm_organism": {
      "type": "motoko",
      "main": "src/swarm_organism/main.mo",
      "dependencies": ["swarm_brain"],
      "description": "Organism-level orchestration canister"
    },
    "swarm_command": {
      "type": "motoko",
      "main": "src/swarm_command/main.mo",
      "dependencies": [],
      "description": "Mission command, HITL approval, waypoint management, MAVLink bridge"
    },
    "swarm_metals": {
      "type": "motoko",
      "main": "src/swarm_metals/main.mo",
      "dependencies": [],
      "description": "Sovereign metals pipeline — 12-metal resonance vector processor"
    },
    "swarm_audit": {
      "type": "motoko",
      "main": "src/swarm_audit/main.mo",
      "dependencies": [],
      "description": "Append-only audit log — immutable swarm event record"
    },
    "swarm_telemetry": {
      "type": "motoko",
      "main": "src/swarm_telemetry/main.mo",
      "dependencies": [],
      "description": "Drone telemetry store — episodic memory, formation patterns, recognition"
    },
    "swarm_quantum": {
      "type": "motoko",
      "main": "src/swarm_quantum/main.mo",
      "dependencies": [],
      "description": "Quantum cognitive state engine — Q-channels, convergence, coherence"
    },
    "swarm_oracle": {
      "type": "motoko",
      "main": "src/swarm_oracle/main.mo",
      "dependencies": ["swarm_brain", "swarm_organism", "swarm_command", "swarm_metals", "swarm_audit", "swarm_telemetry", "swarm_quantum"],
      "description": "Unified read-only information oracle — composite queries across all swarm dimensions"
    },
    "chrysalis": {
      "type": "motoko",
      "main": "src/chrysalis/main.mo",
      "dependencies": [],
      "description": "CHRYSALIS — Alpha Organism №1 — Golden Mathematics Core (FIBONACCI + SPIRAL sub-models)"
    },
    "scribe": {
      "type": "motoko",
      "main": "src/scribe/main.mo",
      "dependencies": [],
      "description": "SCRIBE — Alpha Organism №2 — Document Organism (CLASSIFIER + SYNTHESIZER sub-models)"
    },
    "architect": {
      "type": "motoko",
      "main": "src/architect/main.mo",
      "dependencies": [],
      "description": "ARCHITECT — Alpha Organism №3 — Meta-Builder (REPLICATOR sub-model)"
    },
    "nexus_propagator": {
      "type": "motoko",
      "main": "src/nexus_propagator/main.mo",
      "dependencies": [],
      "description": "NEXUS — Alpha Organism №4 — Substrate Walker (PROPAGATOR sub-model)"
    },
    "medina": {
      "type": "motoko",
      "main": "icp/medina/Medina.mo",
      "dependencies": [],
      "description": "Medina doctrine canister"
    },
    "frontend": {
      "type": "assets",
      "source": ["src/frontend/dist"],
      "dependencies": ["swarm_brain", "swarm_organism"],
      "description": "Sovereign web UI (Vite + React)"
    }
  },

  "build": {
    "output_dir": ".nova/build",
    "wasm_dir": ".nova/build/canisters",
    "idl_dir": ".nova/build/idl",
    "flags": ["--package", "base", ".nova/moc-packages/base"]
  },

  "check": {
    "type_check_only": true,
    "flags": ["--check"]
  },

  "networks": {
    "local": {
      "bind": "127.0.0.1:8000",
      "type": "persistent"
    }
  }
}
