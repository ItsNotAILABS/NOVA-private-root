{
  "name": "scribe-app",
  "version": "1.0.0",
  "description": "SCRIBE — Full Production Research & IP Protection App",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "start": "electron ."
  },
  "keywords": [
    "SCRIBE",
    "NOVA",
    "Research",
    "IP Protection",
    "Document Classification"
  ],
  "author": "Alfredo Medina Hernandez",
  "license": "PROPRIETARY",
  "dependencies": {
    "@dfinity/agent": "^1.4.0",
    "@dfinity/candid": "^1.4.0",
    "@dfinity/principal": "^1.4.0"
  },
  "devDependencies": {
    "electron": "^39.8.1",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.medintech.scribe",
    "productName": "SCRIBE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "assets/icon.png"
    }
  }
}
