# ═══════════════════════════════════════════════════════════════════════════════
# NOVA / PARALLAX — CPL-F Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your canister IDs after deployment.
#
# LOCAL DEV:  Leave defaults (http://127.0.0.1:8000 + local canister IDs)
# MAINNET:    Set VITE_IC_HOST=https://icp0.io and use mainnet canister IDs
# ═══════════════════════════════════════════════════════════════════════════════

# ── ICP Host ──────────────────────────────────────────────────────────────────
# Local:   http://127.0.0.1:8000  (default when empty)
# Mainnet: https://icp0.io
VITE_IC_HOST=

# ── Canister IDs ──────────────────────────────────────────────────────────────
# After running `dfx deploy` (local) or `dfx deploy --network ic` (mainnet),
# canister IDs are written to .dfx/local/canister_ids.json or canister_ids.json.
# Copy the relevant IDs here.
VITE_SWARM_BRAIN_CANISTER_ID=
VITE_PARALLAX_CANISTER_ID=
VITE_NOVA_BUILDER_CANISTER_ID=
VITE_NOVA_STUDENT_CANISTER_ID=
VITE_DALLAS_ISD_CANISTER_ID=
VITE_SKYHI_CANISTER_ID=

# ── AURO Companion ───────────────────────────────────────────────────────────
VITE_AURO_API_BASE=http://127.0.0.1:8787
VITE_AURO_BRIDGE_TOKEN=
