  // Golden ratio — the universal proportion
  public let PHI : Float = 1.618033988749894848204586834365638117720309179805762862135;
  public let PHI_INVERSE : Float = 0.618033988749894848204586834365638117720309179805762862135;
  public let PHI_SQUARED : Float = 2.618033988749894848204586834365638117720309179805762862135;
  
  // Mathematical constants
  public let PI : Float = 3.14159265358979323846264338327950288419716939937510;
  public let E : Float = 2.71828182845904523536028747135266249775724709369995;
  public let SQRT_2 : Float = 1.41421356237309504880168872420969807856967187537694;
  public let SQRT_5 : Float = 2.23606797749978969640917366873127623544061835961152;
  
  // Physical constants
  public let C : Float = 299792458.0;  // Speed of light (m/s)
  public let MU_0 : Float = 1.25663706212e-6;  // Permeability of free space
  public let EPSILON_0 : Float = 8.8541878128e-12;  // Permittivity of free space

