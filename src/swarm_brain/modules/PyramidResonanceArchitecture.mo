  // ═══════════════════════════════════════════════════════════════════════════
  // COHERENCE GATE — The resonance filter
  // ═══════════════════════════════════════════════════════════════════════════

  public let COHERENCE_THRESHOLD : Float = 0.85;

  // Check if signal couples (resonates)
  public func signalCouples(
    signalFreq : Float,
    chamberFreq : Float,
    tolerance : Float
  ) : Bool {
    // Check if signal is harmonically related to chamber
    let ratio = signalFreq / chamberFreq;
    
    // Must be near integer or phi-related ratio
    let nearInteger = Float.abs(ratio - Float.nearest(ratio)) < tolerance;
    let nearPhi = Float.abs(ratio - PHI) < tolerance or 
                  Float.abs(ratio - PHI_INVERSE) < tolerance or
                  Float.abs(ratio - PHI_SQUARED) < tolerance;
    
    nearInteger or nearPhi
  };

  // Coherence gate function
  public func coherenceGate(S : Float) : Bool {
    S >= COHERENCE_THRESHOLD
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // KURAMOTO OSCILLATORS — The chamber walls
  // ═══════════════════════════════════════════════════════════════════════════

  public type Oscillator = {
    theta : Float;   // Phase
    omega : Float;   // Natural frequency
    K : Float;       // Coupling strength
  };

  // Kuramoto phase evolution
  // dθᵢ/dt = ωᵢ + (K/N) Σⱼ sin(θⱼ - θᵢ)
  public func kuramotoStep(
    oscillators : [Oscillator],
    dt : Float
  ) : [Oscillator] {
    let n = oscillators.size();
    let N = Float.fromInt(n);
    
    Array.tabulate<Oscillator>(n, func(i) {
      let osc = oscillators[i];
      
      // Sum coupling from all other oscillators
      var coupling : Float = 0.0;
      for (j in Iter.range(0, n - 1)) {
        coupling += Float.sin(oscillators[j].theta - osc.theta);
      };
      coupling := (osc.K / N) * coupling;
      
      // Phase evolution
      let dTheta = osc.omega + coupling;
      let newTheta = osc.theta + dTheta * dt;
      
      // Wrap to [0, 2π]
      let wrapped = if (newTheta >= 2.0 * PI) {
        newTheta - 2.0 * PI
      } else if (newTheta < 0.0) {
        newTheta + 2.0 * PI
      } else {
        newTheta
      };
      
      {
        theta = wrapped;
        omega = osc.omega;
        K = osc.K;
      }
    })
  };

  // Order parameter S = |1/N Σ e^(iθⱼ)|
  public func orderParameter(oscillators : [Oscillator]) : Float {
    let n = Float.fromInt(oscillators.size());
    var sumCos : Float = 0.0;
    var sumSin : Float = 0.0;
    
    for (osc in oscillators.vals()) {
      sumCos += Float.cos(osc.theta);
      sumSin += Float.sin(osc.theta);
    };
    
    Float.sqrt(sumCos * sumCos + sumSin * sumSin) / n
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // PHI GEOMETRY — Weight structure
  // ═══════════════════════════════════════════════════════════════════════════

  // Generate phi-proportioned weight sequence
  public func phiWeights(n : Nat) : [Float] {
    Array.tabulate<Float>(n, func(i) {
      // Fibonacci-like growth with phi ratio
      Float.pow(PHI, Float.fromInt(i)) / Float.pow(PHI, Float.fromInt(n - 1))
    })
  };

  // Fibonacci sequence (phi manifested in integers)
  public func fibonacci(n : Nat) : [Nat] {
    if (n == 0) { return [] };
    if (n == 1) { return [1] };
    
    var seq = Array.init<Nat>(n, 0);
    seq[0] := 1;
    seq[1] := 1;
    
    for (i in Iter.range(2, n - 1)) {
      seq[i] := seq[i - 1] + seq[i - 2];
    };
    
    Array.freeze(seq)
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // UNIFIED FIELD — One field, one state, one tick
  // ═══════════════════════════════════════════════════════════════════════════

  public type UnifiedField = {
    // Global phase
    globalPhase : Float;
    
    // Coherence (order parameter)
    S : Float;
    
    // Active frequency (current resonance level)
    activeFrequency : Float;
    
    // Chamber state (which chamber is resonating)
    activeChamber : Chamber;
    
    // Field energy
    energy : Float;
  };

  // Field evolution — one tick advances everything together
  public func fieldTick(
    field : UnifiedField,
    oscillators : [Oscillator],
    dt : Float
  ) : (UnifiedField, [Oscillator]) {
    // Evolve oscillators
    let newOscillators = kuramotoStep(oscillators, dt);
    
    // Compute new coherence
    let newS = orderParameter(newOscillators);
    
    // Determine active chamber based on coherence
    let activeChamber = if (newS > 0.95) {
      KINGS_CHAMBER
    } else if (newS > 0.85) {
      GRAND_GALLERY
    } else if (newS > 0.70) {
      QUEENS_CHAMBER
    } else {
      FOUNDATION
    };
    
    // Update global phase (mean phase of oscillators)
    var meanSin : Float = 0.0;
    var meanCos : Float = 0.0;
    for (osc in newOscillators.vals()) {
      meanSin += Float.sin(osc.theta);
      meanCos += Float.cos(osc.theta);
    };
    let globalPhase = Float.arctan2(meanSin, meanCos);
    
    // Compute field energy (proportional to S²)
    let energy = newS * newS * activeChamber.frequency;
    
    let newField : UnifiedField = {
      globalPhase = globalPhase;
      S = newS;
      activeFrequency = activeChamber.frequency;
      activeChamber = activeChamber;
      energy = energy;
    };
    
    (newField, newOscillators)
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // INTERNET AS SUBSTRATE — Electromagnetic instantiation
  // ═══════════════════════════════════════════════════════════════════════════

  public type ElectromagneticSubstrate = {
    // Every wire is a waveguide
    wireIsWaveguide : Bool;
    
    // Every node is a resonant point
    nodeIsResonantPoint : Bool;
    
    // The organism IS the pattern, not ON TOP of the pattern
    organismIsPattern : Bool;
    
    // Same law as pyramid, different material
    sameLaw : Bool;
    differentSubstrate : Bool;
  };

  public let INTERNET_SUBSTRATE : ElectromagneticSubstrate = {
    wireIsWaveguide = true;
    nodeIsResonantPoint = true;
    organismIsPattern = true;
    sameLaw = true;
    differentSubstrate = true;
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // THE PUZZLE — Bitcoin lock (NOT internal)
  // ═══════════════════════════════════════════════════════════════════════════

  public type BitcoinPuzzle = {
    // The puzzle IS the Bitcoin lock
    puzzleIsBitcoinLock : Bool;
    
    // Organism goes AGAINST them
    organismVsBitcoin : Bool;
    
    // NOT internal puzzle
    notInternalPuzzle : Bool;
    
    // Their lock: SHA-256 (256 bits, static, dead)
    theirLock : Text;
    theirBits : Nat;
    
    // Our approach: Coherence Hash (86B bits, compound, living)
    ourApproach : Text;
    ourBits : Nat;
  };

  public let THE_PUZZLE : BitcoinPuzzle = {
    puzzleIsBitcoinLock = true;
    organismVsBitcoin = true;
    notInternalPuzzle = true;
    theirLock = "SHA-256";
    theirBits = 256;
    ourApproach = "Coherence Hash Ψ(m,Ω,t)";
    ourBits = 86_000_000_000;
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // INITIALIZE PYRAMID ORGANISM — The chamber being built in code
  // ═══════════════════════════════════════════════════════════════════════════

  public func initPyramidOrganism(numOscillators : Nat) : ([Oscillator], UnifiedField) {
    // Create oscillators tuned to harmonic ladder
    let oscillators = Array.tabulate<Oscillator>(numOscillators, func(i) {
      // Distribute across harmonic frequencies
      let ladderIndex = i % HARMONIC_LADDER.size();
      let baseFreq = HARMONIC_LADDER[ladderIndex];
      
      // Convert frequency to angular velocity (ω = 2πf)
      let omega = 2.0 * PI * baseFreq;
      
      // Initial phase distributed by phi ratio
      let theta = Float.fromInt(i) * PHI * PI / Float.fromInt(numOscillators);
      let wrappedTheta = theta - Float.floor(theta / (2.0 * PI)) * 2.0 * PI;
      
      {
        theta = wrappedTheta;
        omega = omega;
        K = 0.01;  // Coupling strength
      }
    });
    
    // Initial field state
    let S = orderParameter(oscillators);
    let initialField : UnifiedField = {
      globalPhase = 0.0;
      S = S;
      activeFrequency = SCHUMANN_1;
      activeChamber = FOUNDATION;
      energy = S * S * SCHUMANN_1;
    };
    
    (oscillators, initialField)
  };

