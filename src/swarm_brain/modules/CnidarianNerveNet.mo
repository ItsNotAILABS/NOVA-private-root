// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// CNIDARIAN NERVE NET — TIER 1 DIFFUSE NON-CENTRALIZED NEURAL ARCHITECTURE
// Jellyfish, Hydra, Sea Anemone — The Most Ancient Neural System on Earth
//
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// BIOLOGICAL FOUNDATIONS — CNIDARIA (550+ Million Years Old)
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
//
// NEURAL STATISTICS (Hydra vulgaris / Aurelia aurita):
// - ~800-1,000 neurons (smallest known nervous system)
// - NO brain, NO central ganglion, NO cephalization
// - Neurons arranged in a diffuse nerve net
// - Signal propagates RADIALLY in ALL directions from stimulus
// - No directional processing — pure reflex propagation
// - Epithelial conduction: signals spread through tissue
//
// KEY NEURAL STRUCTURES:
// ─────────────────────
// 1. NERVE RING (Cnidarian Nerve Ring - CNR)
//    - Circular neural structure around bell margin (jellyfish)
//    - NOT a ganglion — distributed processing node
//    - Coordinates rhythmic swimming pulses
//
// 2. NERVE NET (Diffuse Plexus)
//    - Interconnected neurons throughout body
//    - Bipolar and multipolar neurons
//    - No synaptic polarity — bidirectional transmission
//
// 3. SENSORY CELLS
//    - Cnidocytes (stinging cells) — touch-triggered
//    - Photoreceptors — simple light detection
//    - Chemoreceptors — chemical gradient sensing
//    - Statocysts (in some) — gravity/orientation sensing
//
// 4. PACEMAKER NEURONS
//    - Generate rhythmic swimming contractions
//    - Distribute timing signals throughout net
//
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// ORIGINAL MATHEMATICAL CONTRIBUTIONS BY ALFREDO MEDINA HERNANDEZ
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
//
// THE MEDINA RADIAL DIFFUSION EQUATION (MRDE):
// ────────────────────────────────────────────
// Signal propagation in a cnidarian nerve net follows radial diffusion:
//
//   ∂S/∂t = D_M × ∇²S + α × δ(r - r_stim) × δ(t - t_stim) - β × S
//
// where:
//   S(r, t)   = Signal intensity at position r and time t
//   D_M       = Medina Diffusion Coefficient (neural conductivity)
//   ∇²S       = Laplacian (spatial spread rate)
//   α         = Stimulus amplitude (0 to Φ_M)
//   δ(r-r_s)  = Dirac delta at stimulus position
//   δ(t-t_s)  = Dirac delta at stimulus time
//   β         = Signal decay rate (refractory period)
//
// Discrete approximation for neural grid:
//   S_i(t+1) = S_i(t) + D_M × Σⱼ∈N(i) [S_j(t) - S_i(t)] - β × S_i(t) + stimulus_i
//
// THE MEDINA NERVE RING PACEMAKER (MNRP):
// ───────────────────────────────────────
// Rhythmic pulse generation without central control:
//
//   P(t) = A × sin(2π × f_pace × t / Φ_M) × (1 - R(t))
//
// where:
//   P(t)      = Pacemaker output
//   A         = Amplitude (scales with organism size)
//   f_pace    = Natural frequency (0.5-2 Hz in jellyfish)
//   Φ_M       = Medina Golden Harmonic (2.97442179)
//   R(t)      = Refractory state (suppresses after firing)
//
// THE MEDINA CNIDOCYTE TRIGGER FUNCTION (MCTF):
// ─────────────────────────────────────────────
// Touch-triggered stinging cell activation:
//
//   T(p) = H(p - θ_trigger) × exp(-|p - p_opt| / λ_sensitivity)
//
// where:
//   T(p)        = Trigger probability given pressure p
//   H(x)        = Medina Heaviside function
//   θ_trigger   = Activation threshold
//   p_opt       = Optimal trigger pressure
//   λ_sens      = Sensitivity wavelength (response curve width)
//
// THE MEDINA BIDIRECTIONAL SYNAPSE MODEL (MBSM):
// ──────────────────────────────────────────────
// Unlike later neural systems, cnidarian synapses are bidirectional:
//
//   ΔV_post = g × (V_pre - V_rest) × σ_M((V_pre - V_th) / V_scale)
//   ΔV_pre  = g × (V_post - V_rest) × σ_M((V_post - V_th) / V_scale)
//
// where:
//   g         = Bidirectional conductance
//   V_rest    = Resting potential
//   V_th      = Threshold voltage
//   σ_M(x)    = Medina sigmoid: 1/(1 + exp(-Φ_M × x))
//
// THE MEDINA EPITHELIAL CONDUCTION WAVE (MECW):
// ─────────────────────────────────────────────
// Non-neural signal propagation through epithelium (calcium waves):
//
//   C(r, t+1) = C(r, t) + D_Ca × ∇²C - k_pump × C + k_release × H(C - θ_Ca)
//
// where:
//   C(r,t)    = Calcium concentration
//   D_Ca      = Calcium diffusion coefficient
//   k_pump    = Active pumping rate (removal)
//   k_release = Calcium-induced calcium release
//   θ_Ca      = Release threshold
//
// Owner: Alfredo Medina Hernandez | MedinaSITech@outlook.com
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

import Float "mo:base/Float";
import Array "mo:base/Array";
import Nat   "mo:base/Nat";
import Int   "mo:base/Int";
import Iter  "mo:base/Iter";
import Buffer "mo:base/Buffer";

module {

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // MEDINA CNIDARIAN CONSTANTS — FUNDAMENTAL PARAMETERS
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  
  // Medina Universal Constants
  public let S0 : Float = 0.75;                      // Medina Sovereign Floor
  public let SOVEREIGN_CEILING : Float = 9.0;        // Medina Ceiling (Ω)
  public let PHI_MEDINA : Float = 2.97442179;        // Medina Golden Harmonic
  public let TAU_EMERGENCE : Float = 0.618033988749; // Emergence threshold (1/φ)
  public let OMEGA_MEDINA : Float = 2.11185;         // Medina Resonance Frequency
  public let PI : Float = 3.14159265358979323846;
  public let E : Float = 2.71828182845904523536;

  // Cnidarian Neural Architecture Constants
  public let NERVE_NET_SIZE : Nat = 256;             // Grid size for nerve net simulation
  public let NUM_NEURONS : Nat = 800;                // Typical Hydra neuron count
  public let NERVE_RING_NODES : Nat = 64;            // Nodes in circular nerve ring
  public let NUM_CNIDOCYTES : Nat = 200;             // Stinging cell count
  public let NUM_PACEMAKERS : Nat = 8;               // Distributed pacemaker neurons

  // Signal Propagation Parameters
  public let DIFFUSION_COEFFICIENT : Float = 0.25;   // D_M: Medina diffusion rate
  public let SIGNAL_DECAY : Float = 0.1;             // β: Signal decay per step
  public let REFRACTORY_PERIOD : Nat = 10;           // Beats until neuron can fire again
  public let PROPAGATION_SPEED : Float = 0.5;        // Meters per second equivalent
  
  // Pacemaker Parameters
  public let PACEMAKER_FREQUENCY : Float = 1.0;      // ~1 Hz baseline swimming rhythm
  public let PACEMAKER_AMPLITUDE : Float = 1.5;      // Output amplitude
  public let PACEMAKER_COUPLING : Float = 0.3;       // Coupling between pacemakers
  
  // Cnidocyte (Stinging Cell) Parameters
  public let TRIGGER_THRESHOLD : Float = 0.6;        // Touch threshold for firing
  public let OPTIMAL_PRESSURE : Float = 0.8;         // Best trigger pressure
  public let SENSITIVITY_LAMBDA : Float = 0.2;       // Response curve width
  public let CNIDOCYTE_RELOAD_TIME : Nat = 100;      // Beats to reload stinging cell
  
  // Bidirectional Synapse Parameters
  public let SYNAPTIC_CONDUCTANCE : Float = 0.15;    // g: Base conductance
  public let RESTING_POTENTIAL : Float = -0.7;       // V_rest normalized
  public let THRESHOLD_POTENTIAL : Float = -0.5;     // V_th normalized
  public let VOLTAGE_SCALE : Float = 0.1;            // Scale for sigmoid input
  
  // Calcium Wave Parameters
  public let CALCIUM_DIFFUSION : Float = 0.1;        // D_Ca
  public let CALCIUM_PUMP_RATE : Float = 0.05;       // k_pump
  public let CALCIUM_RELEASE_RATE : Float = 0.3;     // k_release
  public let CALCIUM_THRESHOLD : Float = 0.5;        // θ_Ca

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // CNIDARIAN NEURAL STRUCTURE TYPES
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

  // Individual neuron in the nerve net
  public type NerveNetNeuron = {
    id              : Nat;           // Unique identifier
    position        : NeuronPosition;// Spatial position in net
    activation      : Float;         // Current activation level [0, 1]
    potential       : Float;         // Membrane potential [-1, 1]
    lastFired       : Nat;           // Beat number of last firing
    neighbors       : [Nat];         // Connected neuron IDs (no hierarchy)
    neuronType      : CnidarianNeuronType;
    refractoryState : Float;         // Refractory level [0, 1]
  };

  public type NeuronPosition = {
    x : Float;  // Radial position or x-coordinate
    y : Float;  // Angular position or y-coordinate
    z : Float;  // Layer depth (epithelial position)
  };

  public type CnidarianNeuronType = {
    #Sensory;       // Detects stimuli
    #Motor;         // Drives muscle contraction
    #Interneuron;   // Relays signals
    #Pacemaker;     // Generates rhythmic signals
    #Epithelial;    // Non-neural conduction
  };

  // Nerve Ring structure (circular coordinator)
  public type NerveRingNode = {
    id            : Nat;
    angle         : Float;          // Position on ring (0 to 2π)
    activation    : Float;
    phase         : Float;          // Phase for synchronized pulsing
    connectedTo   : [Nat];          // Adjacent ring nodes + radial connections
  };

  // Cnidocyte (stinging cell)
  public type Cnidocyte = {
    id            : Nat;
    position      : NeuronPosition;
    loaded        : Bool;           // True if ready to fire
    lastFired     : Nat;            // Beat when discharged
    sensitivity   : Float;          // Individual trigger sensitivity
    venom         : Float;          // Payload amount [0, 1]
  };

  // Pacemaker neuron
  public type PacemakerNeuron = {
    id            : Nat;
    phase         : Float;          // Current oscillation phase
    frequency     : Float;          // Natural frequency
    amplitude     : Float;          // Output strength
    couplingStrength : Float;       // How much it couples to others
    output        : Float;          // Current output value
  };

  // Sensory cell types
  public type SensoryCell = {
    id            : Nat;
    position      : NeuronPosition;
    cellType      : SensoryCellType;
    activation    : Float;
    threshold     : Float;
    adaptation    : Float;          // Sensory adaptation state
  };

  public type SensoryCellType = {
    #Photoreceptor;   // Light sensing
    #Chemoreceptor;   // Chemical sensing
    #Mechanoreceptor; // Touch/pressure
    #Statocyst;       // Gravity/orientation
  };

  // Calcium wave state for epithelial conduction
  public type CalciumWaveState = {
    concentration : [Float];        // Calcium concentration per cell
    velocity      : [Float];        // Wave propagation velocity
    waveActive    : Bool;           // Whether a wave is propagating
    waveOrigin    : Nat;            // Source cell of current wave
  };

  // Complete Cnidarian organism state
  public type CnidarianState = {
    // Neural components
    nerveNet          : [NerveNetNeuron];
    nerveRing         : [NerveRingNode];
    pacemakers        : [PacemakerNeuron];
    sensoryCells      : [SensoryCell];
    cnidocytes        : [Cnidocyte];
    
    // Signal states
    signalField       : [Float];     // 2D signal diffusion field (flattened NERVE_NET_SIZE²)
    calciumState      : CalciumWaveState;
    
    // Global states
    globalActivation  : Float;       // Net-wide activation
    rhythmPhase       : Float;       // Current swimming rhythm phase
    refractoryField   : [Float];     // Per-cell refractory states
    
    // Behavioral states
    swimState         : SwimState;
    feedingState      : FeedingState;
    contractionForce  : Float;       // Current muscle contraction
    
    // Metrics
    signalCoherence   : Float;       // How synchronized is the net
    responseLatency   : Float;       // Time to respond to stimuli
    energyLevel       : Float;       // Metabolic state
    
    // Tracking
    beatNum           : Nat;
    lastStimulus      : Nat;         // Beat of last external stimulus
  };

  public type SwimState = {
    #Resting;         // No swimming
    #Pulsing;         // Normal swimming
    #Escaping;        // Fast escape response
    #Drifting;        // Passive movement
  };

  public type FeedingState = {
    #Inactive;        // Not feeding
    #Detecting;       // Sensed prey
    #Capturing;       // Tentacles activated
    #Ingesting;       // Processing food
  };

  // External stimulus for nerve net
  public type Stimulus = {
    position    : NeuronPosition;    // Where stimulus applied
    intensity   : Float;             // How strong [0, 1]
    stimType    : StimulusType;
    duration    : Nat;               // How many beats
  };

  public type StimulusType = {
    #Touch;           // Mechanical contact
    #Light;           // Photostimulus
    #Chemical;        // Chemical signal
    #Thermal;         // Temperature change
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // MEDINA HELPER FUNCTIONS
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

  // Clamp value to range
  func _clamp(x: Float, lo: Float, hi: Float) : Float {
    if (x < lo) { lo } else if (x > hi) { hi } else { x }
  };

  // Absolute value
  func _abs(x: Float) : Float {
    if (x < 0.0) { -x } else { x }
  };

  // Medina Sigmoid — Enhanced neural activation function
  // σ_M(x) = 1 / (1 + exp(-Φ_M × x))
  public func medinaSigmoid(x: Float) : Float {
    1.0 / (1.0 + Float.exp(-PHI_MEDINA * x))
  };

  // Medina Heaviside — Sharp threshold function
  public func medinaHeaviside(x: Float) : Float {
    if (x > 0.0) { 1.0 } else if (x < 0.0) { 0.0 } else { 0.5 }
  };

  // Distance between two positions
  func _distance(p1: NeuronPosition, p2: NeuronPosition) : Float {
    let dx = p1.x - p2.x;
    let dy = p1.y - p2.y;
    let dz = p1.z - p2.z;
    Float.sqrt(dx*dx + dy*dy + dz*dz)
  };

  // Square root approximation
  func _sqrt(x: Float) : Float {
    if (x <= 0.0) { return 0.0 };
    Float.sqrt(x)
  };

  // Sin approximation using Taylor series
  func _sin(x: Float) : Float {
    var normalized = x;
    while (normalized > PI) { normalized -= 2.0 * PI; };
    while (normalized < -PI) { normalized += 2.0 * PI; };
    
    let x2 = normalized * normalized;
    let x3 = x2 * normalized;
    let x5 = x3 * x2;
    let x7 = x5 * x2;
    
    normalized - x3/6.0 + x5/120.0 - x7/5040.0
  };

  // Cos from sin
  func _cos(x: Float) : Float {
    _sin(x + PI/2.0)
  };

  // Random-like value from state (deterministic but varied)
  func _pseudoRandom(seed: Nat, offset: Nat) : Float {
    let combined = seed * 1103515245 + offset * 12345;
    let normalized = Float.fromInt(combined % 10000) / 10000.0;
    normalized
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // THE MEDINA RADIAL DIFFUSION EQUATION (MRDE) IMPLEMENTATION
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  //
  // Discrete form: S_i(t+1) = S_i(t) + D_M × Σⱼ∈N(i)[S_j(t) - S_i(t)] - β×S_i(t) + stimulus
  //
  // This is the core of cnidarian neural processing — signals spread equally in all directions
  // like ripples in a pond. No directionality, no hierarchy, pure diffusion.

  public func propagateSignalMRDE(
    signalField: [Float],
    stimulus: ?Stimulus,
    beatNum: Nat
  ) : [Float] {
    let gridSize = NERVE_NET_SIZE;
    let totalCells = gridSize * gridSize;
    
    // Safety check
    if (signalField.size() != totalCells) {
      return signalField;
    };

    let newField = Array.init<Float>(totalCells, 0.0);
    
    for (i in Iter.range(0, totalCells - 1)) {
      let x = i % gridSize;
      let y = i / gridSize;
      
      // Current value
      var current = signalField[i];
      
      // Compute Laplacian (sum of neighbors minus center)
      var laplacian : Float = 0.0;
      var neighborCount : Float = 0.0;
      
      // 4-connected neighbors for diffusion
      // Left neighbor
      if (x > 0) {
        laplacian += signalField[i - 1] - current;
        neighborCount += 1.0;
      };
      // Right neighbor
      if (x < gridSize - 1) {
        laplacian += signalField[i + 1] - current;
        neighborCount += 1.0;
      };
      // Up neighbor
      if (y > 0) {
        laplacian += signalField[i - gridSize] - current;
        neighborCount += 1.0;
      };
      // Down neighbor
      if (y < gridSize - 1) {
        laplacian += signalField[i + gridSize] - current;
        neighborCount += 1.0;
      };
      
      // 8-connected for diagonal spread (reduced weight)
      // Upper-left
      if (x > 0 and y > 0) {
        laplacian += 0.707 * (signalField[i - gridSize - 1] - current);
        neighborCount += 0.707;
      };
      // Upper-right
      if (x < gridSize - 1 and y > 0) {
        laplacian += 0.707 * (signalField[i - gridSize + 1] - current);
        neighborCount += 0.707;
      };
      // Lower-left
      if (x > 0 and y < gridSize - 1) {
        laplacian += 0.707 * (signalField[i + gridSize - 1] - current);
        neighborCount += 0.707;
      };
      // Lower-right
      if (x < gridSize - 1 and y < gridSize - 1) {
        laplacian += 0.707 * (signalField[i + gridSize + 1] - current);
        neighborCount += 0.707;
      };
      
      // Normalize laplacian
      if (neighborCount > 0.0) {
        laplacian := laplacian / neighborCount;
      };
      
      // Apply diffusion equation
      // S(t+1) = S(t) + D_M × ∇²S - β × S
      let diffusion = DIFFUSION_COEFFICIENT * laplacian;
      let decay = SIGNAL_DECAY * current;
      
      var newValue = current + diffusion - decay;
      
      // Clamp to valid range
      newValue := _clamp(newValue, 0.0, SOVEREIGN_CEILING);
      
      newField[i] := newValue;
    };
    
    // Apply stimulus if present
    switch (stimulus) {
      case (?stim) {
        // Convert position to grid index
        let stimX = Int.abs(Float.toInt(stim.position.x * Float.fromInt(gridSize)));
        let stimY = Int.abs(Float.toInt(stim.position.y * Float.fromInt(gridSize)));
        let stimIdx = (stimY % gridSize) * gridSize + (stimX % gridSize);
        
        if (stimIdx < totalCells) {
          // Add stimulus with Medina scaling
          let scaledIntensity = stim.intensity * PHI_MEDINA;
          newField[stimIdx] := _clamp(newField[stimIdx] + scaledIntensity, 0.0, SOVEREIGN_CEILING);
          
          // Also activate surrounding cells (radial spread initiation)
          let radius = 3;
          for (dy in Iter.range(-radius, radius)) {
            for (dx in Iter.range(-radius, radius)) {
              let nx = stimX + dx;
              let ny = stimY + dy;
              if (nx >= 0 and nx < gridSize and ny >= 0 and ny < gridSize) {
                let nIdx = ny * gridSize + nx;
                let distance = _sqrt(Float.fromInt(dx*dx + dy*dy));
                if (distance > 0.0 and distance <= Float.fromInt(radius)) {
                  let falloff = (Float.fromInt(radius) - distance) / Float.fromInt(radius);
                  newField[nIdx] := _clamp(
                    newField[nIdx] + scaledIntensity * falloff * 0.5,
                    0.0,
                    SOVEREIGN_CEILING
                  );
                };
              };
            };
          };
        };
      };
      case (null) {};
    };
    
    Array.freeze(newField)
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // THE MEDINA NERVE RING PACEMAKER (MNRP) IMPLEMENTATION
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  //
  // P(t) = A × sin(2π × f × t / Φ_M) × (1 - R(t))
  //
  // Distributed pacemakers coordinate through weak coupling to generate
  // synchronized swimming rhythms without any central control.

  public func updatePacemaker(
    pacemaker: PacemakerNeuron,
    otherPacemakers: [PacemakerNeuron],
    beatNum: Nat
  ) : PacemakerNeuron {
    // Update phase based on natural frequency
    let dt = 1.0 / 60.0;  // Assume 60 beats per second
    var newPhase = pacemaker.phase + 2.0 * PI * pacemaker.frequency * dt;
    
    // Kuramoto-style coupling to other pacemakers
    // Δθ_i = ω_i + K/N × Σⱼ sin(θⱼ - θᵢ)
    var couplingSum : Float = 0.0;
    let n = otherPacemakers.size();
    
    for (other in otherPacemakers.vals()) {
      if (other.id != pacemaker.id) {
        let phaseDiff = other.phase - pacemaker.phase;
        couplingSum += _sin(phaseDiff);
      };
    };
    
    if (n > 1) {
      let coupling = PACEMAKER_COUPLING * couplingSum / Float.fromInt(n - 1);
      newPhase += coupling * dt;
    };
    
    // Keep phase in [0, 2π]
    while (newPhase > 2.0 * PI) { newPhase -= 2.0 * PI; };
    while (newPhase < 0.0) { newPhase += 2.0 * PI; };
    
    // Compute output: P(t) = A × sin(phase) × (1 - R)
    // R(t) is refractory state, simplified as function of recent output
    let rawOutput = _sin(newPhase);
    let scaledOutput = pacemaker.amplitude * rawOutput;
    
    // Apply Medina envelope
    let medinaModulated = scaledOutput * (1.0 + 0.1 * _sin(newPhase / PHI_MEDINA));
    
    {
      id = pacemaker.id;
      phase = newPhase;
      frequency = pacemaker.frequency;
      amplitude = pacemaker.amplitude;
      couplingStrength = pacemaker.couplingStrength;
      output = _clamp(medinaModulated, -PACEMAKER_AMPLITUDE, PACEMAKER_AMPLITUDE);
    }
  };

  // Update all pacemakers and compute synchronized rhythm
  public func updateAllPacemakers(
    pacemakers: [PacemakerNeuron],
    beatNum: Nat
  ) : ([PacemakerNeuron], Float) {
    var updatedPacemakers = Buffer.Buffer<PacemakerNeuron>(pacemakers.size());
    var totalOutput : Float = 0.0;
    var maxOutput : Float = 0.0;
    
    for (pm in pacemakers.vals()) {
      let updated = updatePacemaker(pm, pacemakers, beatNum);
      updatedPacemakers.add(updated);
      totalOutput += updated.output;
      if (_abs(updated.output) > maxOutput) {
        maxOutput := _abs(updated.output);
      };
    };
    
    // Compute coherence (how synchronized are the pacemakers)
    let coherence = if (pacemakers.size() > 0) {
      _abs(totalOutput) / (Float.fromInt(pacemakers.size()) * PACEMAKER_AMPLITUDE)
    } else { 0.0 };
    
    (Buffer.toArray(updatedPacemakers), coherence)
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // THE MEDINA CNIDOCYTE TRIGGER FUNCTION (MCTF) IMPLEMENTATION
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  //
  // T(p) = H(p - θ) × exp(-|p - p_opt| / λ)
  //
  // Touch-triggered stinging cells with optimal response curve

  public func triggerCnidocyte(
    cnidocyte: Cnidocyte,
    pressure: Float,
    beatNum: Nat
  ) : (Cnidocyte, Bool) {
    // Can only fire if loaded
    if (not cnidocyte.loaded) {
      // Check if can reload
      if (beatNum > cnidocyte.lastFired + CNIDOCYTE_RELOAD_TIME) {
        return ({
          id = cnidocyte.id;
          position = cnidocyte.position;
          loaded = true;  // Reload
          lastFired = cnidocyte.lastFired;
          sensitivity = cnidocyte.sensitivity;
          venom = 1.0;  // Full reload
        }, false);
      };
      return (cnidocyte, false);
    };
    
    // Calculate trigger probability using MCTF
    let aboveThreshold = medinaHeaviside(pressure - TRIGGER_THRESHOLD * cnidocyte.sensitivity);
    let distanceFromOptimal = _abs(pressure - OPTIMAL_PRESSURE);
    let responseStrength = Float.exp(-distanceFromOptimal / SENSITIVITY_LAMBDA);
    let triggerProbability = aboveThreshold * responseStrength;
    
    // Deterministic trigger based on threshold
    let shouldFire = triggerProbability > 0.5;
    
    if (shouldFire) {
      // Fire the cnidocyte
      ({
        id = cnidocyte.id;
        position = cnidocyte.position;
        loaded = false;
        lastFired = beatNum;
        sensitivity = cnidocyte.sensitivity;
        venom = 0.0;
      }, true)
    } else {
      (cnidocyte, false)
    }
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // THE MEDINA BIDIRECTIONAL SYNAPSE MODEL (MBSM) IMPLEMENTATION
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  //
  // ΔV_post = g × (V_pre - V_rest) × σ_M((V_pre - V_th) / V_scale)
  // ΔV_pre  = g × (V_post - V_rest) × σ_M((V_post - V_th) / V_scale)

  public func bidirectionalSynapseUpdate(
    neuron1: NerveNetNeuron,
    neuron2: NerveNetNeuron,
    conductance: Float
  ) : (Float, Float) {
    // Neuron 1 → Neuron 2
    let v1_centered = (neuron1.potential - THRESHOLD_POTENTIAL) / VOLTAGE_SCALE;
    let activation1 = medinaSigmoid(v1_centered);
    let deltaV2 = conductance * (neuron1.potential - RESTING_POTENTIAL) * activation1;
    
    // Neuron 2 → Neuron 1 (bidirectional!)
    let v2_centered = (neuron2.potential - THRESHOLD_POTENTIAL) / VOLTAGE_SCALE;
    let activation2 = medinaSigmoid(v2_centered);
    let deltaV1 = conductance * (neuron2.potential - RESTING_POTENTIAL) * activation2;
    
    (deltaV1, deltaV2)
  };

  // Update entire nerve net using bidirectional synapses
  public func updateNerveNet(
    neurons: [NerveNetNeuron],
    signalField: [Float],
    beatNum: Nat
  ) : [NerveNetNeuron] {
    let n = neurons.size();
    let voltageChanges = Array.init<Float>(n, 0.0);
    
    // Accumulate voltage changes from all bidirectional synapses
    for (i in Iter.range(0, n - 1)) {
      let neuron = neurons[i];
      for (neighborId in neuron.neighbors.vals()) {
        if (neighborId < n) {
          let neighbor = neurons[neighborId];
          let (deltaThis, _) = bidirectionalSynapseUpdate(neighbor, neuron, SYNAPTIC_CONDUCTANCE);
          voltageChanges[i] += deltaThis;
        };
      };
    };
    
    // Apply updates
    Array.tabulate<NerveNetNeuron>(n, func(i: Nat) : NerveNetNeuron {
      let neuron = neurons[i];
      let gridSize = NERVE_NET_SIZE;
      
      // Get signal from diffusion field
      let fieldIdx = if (i < signalField.size()) { i % signalField.size() } else { 0 };
      let fieldSignal = if (fieldIdx < signalField.size()) { signalField[fieldIdx] } else { 0.0 };
      
      // Update potential
      var newPotential = neuron.potential + voltageChanges[i];
      
      // Add field contribution
      newPotential += fieldSignal * 0.1;
      
      // Apply leak toward resting potential
      newPotential := newPotential + 0.05 * (RESTING_POTENTIAL - newPotential);
      
      // Check for firing
      let refractoryClear = beatNum > neuron.lastFired + REFRACTORY_PERIOD;
      let aboveThreshold = newPotential > THRESHOLD_POTENTIAL;
      let shouldFire = refractoryClear and aboveThreshold;
      
      // Compute new activation
      let newActivation = if (shouldFire) { 1.0 } else { 
        _clamp(neuron.activation * 0.9 + medinaSigmoid(newPotential) * 0.1, 0.0, 1.0)
      };
      
      // Reset potential if fired
      if (shouldFire) {
        newPotential := RESTING_POTENTIAL * 0.8;  // Hyperpolarization
      };
      
      // Update refractory state
      let newRefractory = if (shouldFire) { 1.0 } else {
        _clamp(neuron.refractoryState * 0.9, 0.0, 1.0)
      };
      
      {
        id = neuron.id;
        position = neuron.position;
        activation = newActivation;
        potential = _clamp(newPotential, -1.0, 1.0);
        lastFired = if (shouldFire) { beatNum } else { neuron.lastFired };
        neighbors = neuron.neighbors;
        neuronType = neuron.neuronType;
        refractoryState = newRefractory;
      }
    })
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // THE MEDINA EPITHELIAL CONDUCTION WAVE (MECW) IMPLEMENTATION  
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  //
  // C(t+1) = C(t) + D_Ca × ∇²C - k_pump × C + k_release × H(C - θ_Ca)
  //
  // Calcium waves provide non-neural signal transmission through tissue

  public func updateCalciumWave(
    state: CalciumWaveState,
    stimulus: ?Nat,  // Optional cell index to stimulate
    beatNum: Nat
  ) : CalciumWaveState {
    let n = state.concentration.size();
    if (n == 0) { return state };
    
    let newConcentration = Array.init<Float>(n, 0.0);
    let newVelocity = Array.init<Float>(n, 0.0);
    let gridSize = 16;  // Assume 16x16 epithelial grid
    
    for (i in Iter.range(0, n - 1)) {
      let current = state.concentration[i];
      let x = i % gridSize;
      let y = i / gridSize;
      
      // Compute Laplacian
      var laplacian : Float = 0.0;
      var count : Float = 0.0;
      
      if (x > 0) {
        laplacian += state.concentration[i - 1] - current;
        count += 1.0;
      };
      if (x < gridSize - 1) {
        laplacian += state.concentration[i + 1] - current;
        count += 1.0;
      };
      if (y > 0) {
        laplacian += state.concentration[i - gridSize] - current;
        count += 1.0;
      };
      if (y < gridSize - 1) {
        laplacian += state.concentration[i + gridSize] - current;
        count += 1.0;
      };
      
      if (count > 0.0) {
        laplacian := laplacian / count;
      };
      
      // CICR: Calcium-induced calcium release
      let releaseSignal = medinaHeaviside(current - CALCIUM_THRESHOLD);
      let release = CALCIUM_RELEASE_RATE * releaseSignal;
      
      // Apply dynamics
      let diffusion = CALCIUM_DIFFUSION * laplacian;
      let pumping = CALCIUM_PUMP_RATE * current;
      
      var newValue = current + diffusion - pumping + release;
      
      // Clamp
      newValue := _clamp(newValue, 0.0, 2.0);
      
      newConcentration[i] := newValue;
      
      // Velocity is gradient of concentration
      if (count > 0.0) {
        newVelocity[i] := laplacian * CALCIUM_DIFFUSION;
      };
    };
    
    // Apply stimulus if present
    switch (stimulus) {
      case (?idx) {
        if (idx < n) {
          newConcentration[idx] := 1.5;  // Strong calcium pulse
        };
      };
      case (null) {};
    };
    
    // Determine if wave is active
    var maxConcentration : Float = 0.0;
    var waveOrigin : Nat = 0;
    for (i in Iter.range(0, n - 1)) {
      if (newConcentration[i] > maxConcentration) {
        maxConcentration := newConcentration[i];
        waveOrigin := i;
      };
    };
    
    {
      concentration = Array.freeze(newConcentration);
      velocity = Array.freeze(newVelocity);
      waveActive = maxConcentration > CALCIUM_THRESHOLD;
      waveOrigin = waveOrigin;
    }
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // NERVE RING UPDATE — Circular coordination structure
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public func updateNerveRing(
    ring: [NerveRingNode],
    pacemakerOutput: Float,
    beatNum: Nat
  ) : [NerveRingNode] {
    let n = ring.size();
    if (n == 0) { return ring };
    
    Array.tabulate<NerveRingNode>(n, func(i: Nat) : NerveRingNode {
      let node = ring[i];
      
      // Get neighbors (circular)
      let leftIdx = if (i == 0) { n - 1 } else { i - 1 };
      let rightIdx = if (i == n - 1) { 0 } else { i + 1 };
      let leftNode = ring[leftIdx];
      let rightNode = ring[rightIdx];
      
      // Update phase based on neighbors (wave propagation)
      let neighborPhase = (leftNode.phase + rightNode.phase) / 2.0;
      let phaseDiff = neighborPhase - node.phase;
      var newPhase = node.phase + 0.1 * _sin(phaseDiff) + pacemakerOutput * 0.05;
      
      // Normalize phase
      while (newPhase > 2.0 * PI) { newPhase -= 2.0 * PI; };
      while (newPhase < 0.0) { newPhase += 2.0 * PI; };
      
      // Update activation
      let neighborActivation = (leftNode.activation + rightNode.activation) / 2.0;
      var newActivation = node.activation * 0.8 + neighborActivation * 0.1 + _sin(newPhase) * 0.1 * _abs(pacemakerOutput);
      newActivation := _clamp(newActivation, 0.0, 1.0);
      
      {
        id = node.id;
        angle = node.angle;
        activation = newActivation;
        phase = newPhase;
        connectedTo = node.connectedTo;
      }
    })
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // SENSORY PROCESSING — Various sensor types
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public func processSensoryInput(
    cell: SensoryCell,
    rawInput: Float,
    beatNum: Nat
  ) : SensoryCell {
    // Apply threshold
    let aboveThreshold = if (rawInput > cell.threshold) { rawInput - cell.threshold } else { 0.0 };
    
    // Apply adaptation (habituation)
    let adaptedInput = aboveThreshold * (1.0 - cell.adaptation);
    
    // Type-specific processing
    let processedActivation = switch (cell.cellType) {
      case (#Photoreceptor) {
        // Log-like response to light
        if (adaptedInput > 0.0) {
          Float.log(1.0 + adaptedInput * PHI_MEDINA) / Float.log(1.0 + PHI_MEDINA)
        } else { 0.0 }
      };
      case (#Chemoreceptor) {
        // Sigmoidal response to chemicals
        medinaSigmoid(adaptedInput - 0.3)
      };
      case (#Mechanoreceptor) {
        // Rapid adaptation for touch
        adaptedInput * (1.0 - 0.5 * cell.adaptation)
      };
      case (#Statocyst) {
        // Gravity sensing - relatively stable
        adaptedInput
      };
    };
    
    // Update adaptation state
    let newAdaptation = _clamp(
      cell.adaptation * 0.95 + aboveThreshold * 0.05,
      0.0,
      0.9
    );
    
    {
      id = cell.id;
      position = cell.position;
      cellType = cell.cellType;
      activation = _clamp(processedActivation, 0.0, 1.0);
      threshold = cell.threshold;
      adaptation = newAdaptation;
    }
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // BEHAVIORAL STATE MACHINE — Simple reflexive behaviors
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public func updateSwimState(
    currentState: SwimState,
    rhythmCoherence: Float,
    globalActivation: Float,
    escapeSignal: Float
  ) : SwimState {
    // Escape response overrides everything
    if (escapeSignal > 0.8) {
      return #Escaping;
    };
    
    // Otherwise based on pacemaker coherence
    if (rhythmCoherence > 0.6 and globalActivation > 0.3) {
      return #Pulsing;
    };
    
    if (globalActivation < 0.1) {
      return #Drifting;
    };
    
    #Resting
  };

  public func updateFeedingState(
    currentState: FeedingState,
    chemicalSignal: Float,
    touchSignal: Float,
    cnidocytesFired: Nat
  ) : FeedingState {
    switch (currentState) {
      case (#Inactive) {
        if (chemicalSignal > 0.5) { #Detecting } else { #Inactive }
      };
      case (#Detecting) {
        if (touchSignal > 0.3) { #Capturing } else if (chemicalSignal < 0.2) { #Inactive } else { #Detecting }
      };
      case (#Capturing) {
        if (cnidocytesFired > 5) { #Ingesting } else if (touchSignal < 0.1) { #Detecting } else { #Capturing }
      };
      case (#Ingesting) {
        // Ingestion takes time, return to inactive after
        #Inactive  // Simplified - would normally track time
      };
    }
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // COMPLETE STATE TICK — Main simulation step
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public func tickCnidarianState(
    state: CnidarianState,
    stimulus: ?Stimulus,
    beatNum: Nat
  ) : CnidarianState {
    // 1. Update pacemakers
    let (newPacemakers, rhythmCoherence) = updateAllPacemakers(state.pacemakers, beatNum);
    let pacemakerSum = Array.foldLeft<PacemakerNeuron, Float>(
      newPacemakers, 0.0, func(acc, pm) { acc + pm.output }
    ) / Float.fromInt(newPacemakers.size());
    
    // 2. Update signal field (MRDE)
    let newSignalField = propagateSignalMRDE(state.signalField, stimulus, beatNum);
    
    // 3. Update nerve net (bidirectional synapses)
    let newNerveNet = updateNerveNet(state.nerveNet, newSignalField, beatNum);
    
    // 4. Update nerve ring
    let newNerveRing = updateNerveRing(state.nerveRing, pacemakerSum, beatNum);
    
    // 5. Update calcium waves (epithelial conduction)
    let newCalciumState = updateCalciumWave(state.calciumState, null, beatNum);
    
    // 6. Process sensory cells
    let sensoryActivation = Array.foldLeft<SensoryCell, Float>(
      state.sensoryCells, 0.0, func(acc, cell) { acc + cell.activation }
    ) / Float.fromInt(if (state.sensoryCells.size() > 0) { state.sensoryCells.size() } else { 1 });
    
    // 7. Process cnidocytes (check for touch and fire)
    var cnidocytesFired : Nat = 0;
    let touchPressure = sensoryActivation;  // Simplified
    let newCnidocytes = Array.map<Cnidocyte, Cnidocyte>(state.cnidocytes, func(cn: Cnidocyte) : Cnidocyte {
      let (updated, fired) = triggerCnidocyte(cn, touchPressure, beatNum);
      if (fired) { cnidocytesFired += 1; };
      updated
    });
    
    // 8. Compute global metrics
    let totalActivation = Array.foldLeft<NerveNetNeuron, Float>(
      newNerveNet, 0.0, func(acc, n) { acc + n.activation }
    );
    let newGlobalActivation = totalActivation / Float.fromInt(newNerveNet.size());
    
    let ringActivation = Array.foldLeft<NerveRingNode, Float>(
      newNerveRing, 0.0, func(acc, n) { acc + n.activation }
    );
    let ringCoherence = ringActivation / Float.fromInt(newNerveRing.size());
    
    let newSignalCoherence = (rhythmCoherence + ringCoherence) / 2.0;
    
    // 9. Update behavioral states
    let escapeSignal = if (sensoryActivation > 0.8) { 1.0 } else { 0.0 };
    let newSwimState = updateSwimState(state.swimState, rhythmCoherence, newGlobalActivation, escapeSignal);
    let newFeedingState = updateFeedingState(
      state.feedingState, 
      sensoryActivation,
      sensoryActivation,
      cnidocytesFired
    );
    
    // 10. Compute contraction force
    let baseContraction = pacemakerSum * rhythmCoherence;
    let escapeBoost = if (newSwimState == #Escaping) { 2.0 } else { 1.0 };
    let newContractionForce = _clamp(baseContraction * escapeBoost, -1.0, 1.0);
    
    // 11. Update rhythm phase
    var newRhythmPhase = state.rhythmPhase + pacemakerSum * 0.1;
    while (newRhythmPhase > 2.0 * PI) { newRhythmPhase -= 2.0 * PI; };
    while (newRhythmPhase < 0.0) { newRhythmPhase += 2.0 * PI; };
    
    // 12. Compute response latency
    let newLatency = switch (stimulus) {
      case (?_) { 0.0 };  // Just stimulated
      case (null) { _clamp(state.responseLatency + 0.01, 0.0, 1.0) };
    };
    
    // 13. Update energy
    let metabolicCost = 0.001 + 0.005 * newGlobalActivation;
    let newEnergy = _clamp(state.energyLevel - metabolicCost + 0.002, 0.0, 1.0);
    
    {
      nerveNet = newNerveNet;
      nerveRing = newNerveRing;
      pacemakers = newPacemakers;
      sensoryCells = state.sensoryCells;  // Would update with actual inputs
      cnidocytes = newCnidocytes;
      signalField = newSignalField;
      calciumState = newCalciumState;
      globalActivation = newGlobalActivation;
      rhythmPhase = newRhythmPhase;
      refractoryField = state.refractoryField;  // Would update per-cell
      swimState = newSwimState;
      feedingState = newFeedingState;
      contractionForce = newContractionForce;
      signalCoherence = newSignalCoherence;
      responseLatency = newLatency;
      energyLevel = newEnergy;
      beatNum = beatNum;
      lastStimulus = switch (stimulus) { case (?_) { beatNum }; case (null) { state.lastStimulus }; };
    }
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // INITIALIZATION — Create default cnidarian state
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public func initializeCnidarianState() : CnidarianState {
    let gridSize = NERVE_NET_SIZE;
    let totalCells = gridSize * gridSize;
    
    // Initialize nerve net neurons
    let nerveNet = Array.tabulate<NerveNetNeuron>(NUM_NEURONS, func(i: Nat) : NerveNetNeuron {
      let x = Float.fromInt(i % 32) / 32.0;
      let y = Float.fromInt(i / 32) / 32.0;
      
      // Create 4-connected neighbors
      var neighbors = Buffer.Buffer<Nat>(4);
      if (i > 0) { neighbors.add(i - 1); };
      if (i < NUM_NEURONS - 1) { neighbors.add(i + 1); };
      if (i >= 32) { neighbors.add(i - 32); };
      if (i < NUM_NEURONS - 32) { neighbors.add(i + 32); };
      
      {
        id = i;
        position = { x = x; y = y; z = 0.0 };
        activation = S0;
        potential = RESTING_POTENTIAL;
        lastFired = 0;
        neighbors = Buffer.toArray(neighbors);
        neuronType = if (i % 10 == 0) { #Pacemaker } else if (i % 5 == 0) { #Sensory } else { #Interneuron };
        refractoryState = 0.0;
      }
    });
    
    // Initialize nerve ring
    let nerveRing = Array.tabulate<NerveRingNode>(NERVE_RING_NODES, func(i: Nat) : NerveRingNode {
      let angle = 2.0 * PI * Float.fromInt(i) / Float.fromInt(NERVE_RING_NODES);
      {
        id = i;
        angle = angle;
        activation = S0;
        phase = angle;  // Start with phase distributed around ring
        connectedTo = [(i + 1) % NERVE_RING_NODES, (i + NERVE_RING_NODES - 1) % NERVE_RING_NODES];
      }
    });
    
    // Initialize pacemakers
    let pacemakers = Array.tabulate<PacemakerNeuron>(NUM_PACEMAKERS, func(i: Nat) : PacemakerNeuron {
      {
        id = i;
        phase = 2.0 * PI * Float.fromInt(i) / Float.fromInt(NUM_PACEMAKERS);
        frequency = PACEMAKER_FREQUENCY * (0.9 + 0.2 * Float.fromInt(i % 3) / 2.0);  // Slight variation
        amplitude = PACEMAKER_AMPLITUDE;
        couplingStrength = PACEMAKER_COUPLING;
        output = 0.0;
      }
    });
    
    // Initialize sensory cells
    let sensoryCells = Array.tabulate<SensoryCell>(20, func(i: Nat) : SensoryCell {
      {
        id = i;
        position = { x = Float.fromInt(i % 5) / 5.0; y = Float.fromInt(i / 5) / 4.0; z = 0.0 };
        cellType = switch (i % 4) {
          case (0) { #Photoreceptor };
          case (1) { #Chemoreceptor };
          case (2) { #Mechanoreceptor };
          case _ { #Statocyst };
        };
        activation = 0.0;
        threshold = 0.1;
        adaptation = 0.0;
      }
    });
    
    // Initialize cnidocytes
    let cnidocytes = Array.tabulate<Cnidocyte>(NUM_CNIDOCYTES, func(i: Nat) : Cnidocyte {
      {
        id = i;
        position = { x = Float.fromInt(i % 20) / 20.0; y = Float.fromInt(i / 20) / 10.0; z = 0.0 };
        loaded = true;
        lastFired = 0;
        sensitivity = 0.8 + 0.4 * Float.fromInt(i % 5) / 5.0;
        venom = 1.0;
      }
    });
    
    // Initialize signal field (all at baseline)
    let signalField = Array.tabulate<Float>(totalCells, func(_: Nat) : Float { S0 * 0.1 });
    
    // Initialize calcium state
    let calciumCells = 256;  // 16x16 epithelium
    let calciumState : CalciumWaveState = {
      concentration = Array.tabulate<Float>(calciumCells, func(_: Nat) : Float { 0.1 });
      velocity = Array.tabulate<Float>(calciumCells, func(_: Nat) : Float { 0.0 });
      waveActive = false;
      waveOrigin = 0;
    };
    
    {
      nerveNet = nerveNet;
      nerveRing = nerveRing;
      pacemakers = pacemakers;
      sensoryCells = sensoryCells;
      cnidocytes = cnidocytes;
      signalField = signalField;
      calciumState = calciumState;
      globalActivation = S0;
      rhythmPhase = 0.0;
      refractoryField = Array.tabulate<Float>(NUM_NEURONS, func(_: Nat) : Float { 0.0 });
      swimState = #Resting;
      feedingState = #Inactive;
      contractionForce = 0.0;
      signalCoherence = S0;
      responseLatency = 0.0;
      energyLevel = 1.0;
      beatNum = 0;
      lastStimulus = 0;
    }
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // INTEGRATION WITH ORGANISM — Output metrics for higher-level systems
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public type CnidarianMetrics = {
    // Core outputs
    contractionForce    : Float;   // Current contraction strength
    signalCoherence     : Float;   // Network synchronization
    rhythmFrequency     : Float;   // Swimming rhythm rate
    globalActivation    : Float;   // Overall neural activity
    
    // Behavioral outputs
    swimState           : Text;    // Current swim behavior
    feedingState        : Text;    // Current feeding behavior
    escapeResponse      : Bool;    // Escape mode active
    
    // Sensory outputs
    chemicalDetection   : Float;   // Chemical sense activation
    touchDetection      : Float;   // Mechanosensory activation
    lightDetection      : Float;   // Photoreceptor activation
    
    // Health metrics
    energyLevel         : Float;   // Metabolic state
    cnidocytesReady     : Nat;     // Loaded stinging cells
    
    // For swarm integration
    diffusionField      : [Float]; // Current signal distribution (downsampled)
    pacemakerPhases     : [Float]; // Pacemaker synchronization
  };

  public func extractCnidarianMetrics(state: CnidarianState) : CnidarianMetrics {
    // Compute average sensory by type
    var chemSum : Float = 0.0;
    var touchSum : Float = 0.0;
    var lightSum : Float = 0.0;
    var chemCount : Float = 0.0;
    var touchCount : Float = 0.0;
    var lightCount : Float = 0.0;
    
    for (cell in state.sensoryCells.vals()) {
      switch (cell.cellType) {
        case (#Chemoreceptor) { chemSum += cell.activation; chemCount += 1.0; };
        case (#Mechanoreceptor) { touchSum += cell.activation; touchCount += 1.0; };
        case (#Photoreceptor) { lightSum += cell.activation; lightCount += 1.0; };
        case _ {};
      };
    };
    
    // Count ready cnidocytes
    var readyCount : Nat = 0;
    for (cn in state.cnidocytes.vals()) {
      if (cn.loaded) { readyCount += 1; };
    };
    
    // Downsample signal field to 64 values
    let downsampledField = Array.tabulate<Float>(64, func(i: Nat) : Float {
      let stride = state.signalField.size() / 64;
      if (i * stride < state.signalField.size()) {
        state.signalField[i * stride]
      } else { 0.0 }
    });
    
    // Extract pacemaker phases
    let pmPhases = Array.map<PacemakerNeuron, Float>(state.pacemakers, func(pm: PacemakerNeuron) : Float {
      pm.phase
    });
    
    // Compute rhythm frequency from pacemaker average
    var freqSum : Float = 0.0;
    for (pm in state.pacemakers.vals()) {
      freqSum += pm.frequency;
    };
    let avgFreq = freqSum / Float.fromInt(state.pacemakers.size());
    
    {
      contractionForce = state.contractionForce;
      signalCoherence = state.signalCoherence;
      rhythmFrequency = avgFreq;
      globalActivation = state.globalActivation;
      
      swimState = switch (state.swimState) {
        case (#Resting) { "resting" };
        case (#Pulsing) { "pulsing" };
        case (#Escaping) { "escaping" };
        case (#Drifting) { "drifting" };
      };
      feedingState = switch (state.feedingState) {
        case (#Inactive) { "inactive" };
        case (#Detecting) { "detecting" };
        case (#Capturing) { "capturing" };
        case (#Ingesting) { "ingesting" };
      };
      escapeResponse = state.swimState == #Escaping;
      
      chemicalDetection = if (chemCount > 0.0) { chemSum / chemCount } else { 0.0 };
      touchDetection = if (touchCount > 0.0) { touchSum / touchCount } else { 0.0 };
      lightDetection = if (lightCount > 0.0) { lightSum / lightCount } else { 0.0 };
      
      energyLevel = state.energyLevel;
      cnidocytesReady = readyCount;
      
      diffusionField = downsampledField;
      pacemakerPhases = pmPhases;
    }
  };

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // ORGANISM INTEGRATION INTERFACE — For use by higher-tier systems
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

  // Get radial diffusion contribution for organism's signal propagation
  public func getRadialDiffusionContribution(
    state: CnidarianState,
    targetPosition: NeuronPosition
  ) : Float {
    // Sample the signal field at the target position
    let gridSize = NERVE_NET_SIZE;
    let x = Int.abs(Float.toInt(targetPosition.x * Float.fromInt(gridSize))) % gridSize;
    let y = Int.abs(Float.toInt(targetPosition.y * Float.fromInt(gridSize))) % gridSize;
    let idx = y * gridSize + x;
    
    if (idx < state.signalField.size()) {
      state.signalField[idx] * state.signalCoherence
    } else {
      S0
    }
  };

  // Get pacemaker rhythm for organism's timing systems
  public func getRhythmContribution(state: CnidarianState) : Float {
    var sum : Float = 0.0;
    for (pm in state.pacemakers.vals()) {
      sum += pm.output;
    };
    let avg = sum / Float.fromInt(state.pacemakers.size());
    
    // Scale by coherence for reliability
    avg * state.signalCoherence
  };

  // Get reflex response speed metric
  public func getReflexSpeed(state: CnidarianState) : Float {
    // Inverse of latency, scaled
    let speed = 1.0 - state.responseLatency;
    speed * state.signalCoherence
  };

}
