  // ═══════════════════════════════════════════════════════════════════════════
  // SHELL 3 OPERATIONS — Core Processing
  // ═══════════════════════════════════════════════════════════════════════════
  
  /// Kuramoto phase coupling for Shell 3
  public func kuramotoCoupling(
    phases : [Float],
    frequencies : [Float],
    activations : [Float],
    K : Float,
    dt : Float
  ) : { newPhases : [Float]; coherence : Float; meanPhase : Float } {
    
    let N = phases.size();
    let nFloat = Float.fromInt(N);
    
    // Compute mean phase and coherence
    var cosSum : Float = 0.0;
    var sinSum : Float = 0.0;
    for (phase in phases.vals()) {
      cosSum += cos(phase);
      sinSum += sin(phase);
    };
    let coherence = sqrt(cosSum * cosSum + sinSum * sinSum) / nFloat;
    let meanPhase = Float.arctan2(sinSum, cosSum);
    
    // Update phases with Kuramoto dynamics
    let newPhases = Array.tabulate<Float>(N, func(i : Nat) : Float {
      let phase_i = if (i < phases.size()) { phases[i] } else { 0.0 };
      let freq_i = if (i < frequencies.size()) { frequencies[i] } else { 12.0 };
      let act_i = if (i < activations.size()) { activations[i] } else { S0 };
      
      // dθ/dt = ω + (K/N) × Σ sin(θ_j - θ_i)
      var coupling : Float = 0.0;
      for (j in phases.keys()) {
        let phase_j = phases[j];
        let act_j = if (j < activations.size()) { activations[j] } else { S0 };
        coupling += sin(phase_j - phase_i) * act_j;
      };
      coupling := K * coupling / nFloat;
      
      var newPhase = phase_i + (freq_i * TAU + coupling) * dt;
      while (newPhase > TAU) { newPhase -= TAU };
      while (newPhase < 0.0) { newPhase += TAU };
      newPhase
    });
    
    { newPhases = newPhases; coherence = coherence; meanPhase = meanPhase }
  };
  
  /// Hebbian weight update with eligibility traces
  public func hebbianUpdate(
    weights : [Float],
    preActivations : [Float],
    postActivations : [Float],
    eligibility : [Float],
    eta : Float,
    decay : Float,
    threshold : Float
  ) : { newWeights : [Float]; newEligibility : [Float] } {
    
    let preN = preActivations.size();
    let postN = postActivations.size();
    let wSize = weights.size();
    
    let newWeights = Array.tabulate<Float>(wSize, func(idx : Nat) : Float {
      let i = idx / postN;  // Pre-synaptic index
      let j = idx % postN;  // Post-synaptic index
      
      let w = if (idx < weights.size()) { weights[idx] } else { S0 };
      let e = if (idx < eligibility.size()) { eligibility[idx] } else { 0.0 };
      let pre = if (i < preN) { preActivations[i] } else { S0 };
      let post = if (j < postN) { postActivations[j] } else { S0 };
      
      // Hebbian update only if both above threshold
      let dW = if (pre > threshold and post > threshold) {
        eta * (pre - S0) * (post - S0)
      } else {
        0.0
      };
      
      // Weight update with eligibility trace
      fclamp(w + dW + e * 0.1 - decay * (w - S0), S0, 2.0)
    });
    
    let newEligibility = Array.tabulate<Float>(wSize, func(idx : Nat) : Float {
      let i = idx / postN;
      let j = idx % postN;
      
      let e = if (idx < eligibility.size()) { eligibility[idx] } else { 0.0 };
      let pre = if (i < preN) { preActivations[i] } else { S0 };
      let post = if (j < postN) { postActivations[j] } else { S0 };
      
      // Update eligibility: decays but accumulates correlations
      fclamp(e * 0.95 + 0.05 * (pre - S0) * (post - S0), 0.0, 1.0)
    });
    
    { newWeights = newWeights; newEligibility = newEligibility }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // QUANTUM OPERATOR COMPUTATIONS
  // ═══════════════════════════════════════════════════════════════════════════
  
  /// PARALLAX: 5-path complex amplitude interference
  public func computeParallax(
    activations : [Float],
    kfEng : Float
  ) : QuantumParallax {
    
    // Generate 5 complex amplitudes from activations
    let paths = Array.tabulate<Float>(5, func(i : Nat) : Float {
      cos(kfEng * Float.fromInt(i + 1))
    });
    let quadrature = Array.tabulate<Float>(5, func(i : Nat) : Float {
      sin(kfEng * Float.fromInt(i + 1))
    });
    
    // Compute |ψ|² = I² + Q²
    let amplitudes = Array.tabulate<Float>(5, func(i : Nat) : Float {
      paths[i] * paths[i] + quadrature[i] * quadrature[i]
    });
    
    // Find winner (max amplitude)
    var maxAmp : Float = 0.0;
    var winner : Nat = 0;
    for (i in amplitudes.keys()) {
      if (amplitudes[i] > maxAmp) {
        maxAmp := amplitudes[i];
        winner := i;
      };
    };
    
    let score = fclamp(S0 + maxAmp * 0.25, S0, 2.0);
    
    { paths; quadrature; amplitudes; winner; score }
  };
  
  /// ENTANGLA: CHSH Bell inequality S-value
  public func computeEntangla(
    activations : [Float],
    previousEma : Float
  ) : QuantumEntangla {
    
    // Four correlators from activations
    let a0 = if (0 < activations.size()) { activations[0] } else { S0 };
    let a1 = if (1 < activations.size()) { activations[1] } else { S0 };
    let a2 = if (2 < activations.size()) { activations[2] } else { S0 };
    let a3 = if (3 < activations.size()) { activations[3] } else { S0 };
    
    let E_ab = tanh(a0 * a1);
    let E_ab2 = tanh(a0 * a2);
    let E_a2b = tanh(a3 * a1);
    let E_a2b2 = tanh(a3 * a2);
    
    let correlators = [E_ab, E_ab2, E_a2b, E_a2b2];
    
    // CHSH S-value
    let sValue = abs(E_ab - E_ab2) + abs(E_a2b + E_a2b2);
    
    // EMA over 50 beats
    let emaBeta = 0.96;  // ~50 beat half-life
    let ema = emaBeta * previousEma + (1.0 - emaBeta) * sValue;
    
    // Bell violation bonus when S > 2.0
    let violationBonus = if (sValue > 2.0) { 0.1 } else { 0.0 };
    
    let score = fclamp(S0 + ema / 4.0 + violationBonus, S0, 2.0);
    
    { correlators; sValue; ema; violationBonus; score }
  };
  
  /// VERITAS: 5-qubit stabilizer parity
  public func computeVeritas(
    doctrineLawScores : [Float],
    doctrineAlignment : Float
  ) : QuantumVeritas {
    
    // Divide doctrine cores into 5 groups
    let groupSize = doctrineLawScores.size() / 5;
    
    let stabilizers = Array.tabulate<Float>(5, func(g : Nat) : Float {
      var groupSum : Float = 0.0;
      let start = g * groupSize;
      let endI = min(start + groupSize, doctrineLawScores.size());
      var i = start;
      while (i < endI) {
        groupSum += if (i < doctrineLawScores.size()) { doctrineLawScores[i] } else { S0 };
        i += 1;
      };
      groupSum
    });
    
    // Syndrome: count of groups with parity = 1 (sum > threshold)
    let syndromeVector = Array.tabulate<Float>(5, func(g : Nat) : Float {
      // Parity check via mod 2.0 approximation
      let sum = stabilizers[g];
      if (sum - Float.fromInt(Int.abs(Float.toInt(sum))) > S0) { 1.0 } else { 0.0 }
    });
    
    var syndromeCount : Float = 0.0;
    for (s in syndromeVector.vals()) {
      syndromeCount += s;
    };
    
    let parityScore = (5.0 - syndromeCount) / 5.0;
    let score = fclamp(S0 + parityScore * 0.5, S0, 2.0);
    
    { stabilizers; syndromeVector; parityScore; score }
  };
  
  /// BYPASS: Boltzmann annealing N=7 paths
  public func computeBypass(
    kfEng : Float,
    substrateEntropy : Float
  ) : QuantumBypass {
    
    // Temperature from substrate entropy
    let temperature = fclamp(1.0 - kfEng, 0.001, 1.0);
    
    // 7 path energies
    let pathEnergies = Array.tabulate<Float>(7, func(k : Nat) : Float {
      kfEng + Float.fromInt(k) * 0.01
    });
    
    // Boltzmann probabilities: P ∝ exp(-E/T)
    var totalWeight : Float = 0.0;
    let weights = Array.tabulate<Float>(7, func(k : Nat) : Float {
      let w = exp(-pathEnergies[k] / temperature);
      totalWeight += w;
      w
    });
    
    let probabilities = Array.tabulate<Float>(7, func(k : Nat) : Float {
      if (totalWeight > 0.0) { weights[k] / totalWeight } else { 1.0 / 7.0 }
    });
    
    // Select min-energy path
    var minEnergy : Float = 1e10;
    var selectedPath : Nat = 0;
    for (k in pathEnergies.keys()) {
      if (pathEnergies[k] < minEnergy) {
        minEnergy := pathEnergies[k];
        selectedPath := k;
      };
    };
    
    let score = fclamp(S0 + probabilities[0] / (probabilities[0] + probabilities[6]), S0, 2.0);
    
    { pathEnergies; probabilities; temperature; selectedPath; score }
  };
  
  /// CHRONO: Fisher information F_Q
  public func computeChrono(
    kfEng : Float,
    ringBuffer : [Float],
    ringIndex : Nat
  ) : QuantumChrono {
    
    // Update ring buffer
    let newRingBuffer = Array.tabulate<Float>(5, func(i : Nat) : Float {
      if (i == ringIndex % 5) { kfEng }
      else if (i < ringBuffer.size()) { ringBuffer[i] }
      else { S0 }
    });
    let newRingIndex = (ringIndex + 1) % 5;
    
    // Compute variance of ring buffer
    let m = mean(newRingBuffer);
    var sumSq : Float = 0.0;
    for (v in newRingBuffer.vals()) {
      let d = v - m;
      sumSq += d * d;
    };
    let variance = sumSq / 5.0;
    
    // Fisher information: F_Q = 4 × variance
    let fisherInfo = 4.0 * variance;
    
    // Cramér-Rao injection
    let cramerRaoInjection = fclamp(fisherInfo * 0.1, 0.0, 0.05);
    
    let score = fclamp(S0 + fisherInfo, S0, 2.0);
    
    { ringBuffer = newRingBuffer; ringIndex = newRingIndex; variance; fisherInfo; cramerRaoInjection; score }
  };
  
  /// QMEM: T₂ fidelity decay quantum memory
  public func computeQmem(
    qps : Float,
    timeSinceReset : Nat,
    dreamCycleFired : Bool
  ) : QuantumMemory {
    
    // T₂ = stQMEM_QPS × 500 beats
    let t2Time = qps * 500.0;
    
    // F(t) = exp(-t/T₂)
    let t = Float.fromInt(timeSinceReset % 500);
    let fidelity = exp(-t / max(1.0, t2Time));
    
    // Reset on dream cycle
    let newTimeSinceReset = if (dreamCycleFired) { 0 } else { timeSinceReset + 1 };
    
    let score = fclamp(S0 + fidelity * 0.5, S0, 2.0);
    
    { fidelity; t2Time; timeSinceReset = newTimeSinceReset; score }
  };
  
  /// RESONEX: N² quadratic superradiance
  public func computeResonex(
    activations : [Float],
    kfEng : Float,
    previousCascadeCount : Nat
  ) : QuantumResonex {
    
    // Count nodes above 0.90
    var participants : Nat = 0;
    for (a in activations.vals()) {
      if (a > 0.90) { participants += 1 };
    };
    
    let n = Float.fromInt(participants);
    let N = Float.fromInt(activations.size());
    
    // N² quadratic superradiance amplitude
    let amplitude = (n / N) * (n / N) * 0.5;
    
    // Cascade condition: N > 8 and kfEng > 0.92
    let cascadeActive = participants > 8 and kfEng > 0.92;
    let cascadeCount = if (cascadeActive) { previousCascadeCount + 1 } else { previousCascadeCount };
    
    let score = fclamp(S0 + amplitude, S0, 2.0);
    
    { participants; amplitude; cascadeActive; cascadeCount; score }
  };
  
  /// QSOV: Quantum Sovereignty geometric mean
  public func computeQsov(
    parallaxScore : Float,
    entanglaScore : Float,
    veritasScore : Float,
    bypassScore : Float,
    chronoScore : Float,
    qmemScore : Float,
    resonexScore : Float
  ) : Float {
    
    let scores = [parallaxScore, entanglaScore, veritasScore, bypassScore, chronoScore, qmemScore, resonexScore];
    let geoMean = geometricMean(scores);
    
    fclamp(geoMean, S0, 2.0)
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // FREE ENERGY COMPUTATION
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func computeFreeEnergy(
    shell3Activations : [Float],
    shell12Activations : [Float],
    substrateEntropy : Float,
    prevF : Float
  ) : { U : Float; T : Float; S : Float; F : Float; deltaF : Float } {
    
    // Internal Energy U = mean activations
    let U = (mean(shell3Activations) + mean(shell12Activations)) / 2.0;
    
    // Temperature T = substrate entropy
    let T = fclamp(substrateEntropy, 0.01, 1.0);
    
    // Entropy S = Shannon entropy (normalized)
    var totalAct : Float = 0.0;
    for (a in shell3Activations.vals()) { totalAct += max(0.001, a) };
    
    var H : Float = 0.0;
    if (totalAct > 0.0) {
      for (a in shell3Activations.vals()) {
        let p = max(0.001, a) / totalAct;
        if (p > 0.001) { H -= p * ln(p) };
      };
    };
    let maxH = ln(Float.fromInt(shell3Activations.size()));
    let S = if (maxH > 0.0) { H / maxH } else { 0.0 };
    
    // Free Energy F = U - T×S
    let F = U - T * S;
    let deltaF = F - prevF;
    
    { U; T; S; F = fclamp(F, 0.5, 3.0); deltaF }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // PREDICTION FIELD — 60-step Kalman
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func updatePredictionField(
    field : [Float],
    currentActivations : [Float],
    kalmanGain : [Float]
  ) : { newField : [Float]; error : Float; newKalmanGain : [Float] } {
    
    let nodes = currentActivations.size();
    
    // Compute prediction error
    var totalError : Float = 0.0;
    for (i in currentActivations.keys()) {
      if (i < nodes) {
        let predicted = if (i < field.size()) { field[i] } else { S0 };
        let actual = currentActivations[i];
        totalError += abs(actual - predicted);
      };
    };
    let error = totalError / Float.fromInt(nodes);
    
    // Update Kalman gain based on error
    let newKalmanGain = Array.tabulate<Float>(nodes, func(i : Nat) : Float {
      let oldGain = if (i < kalmanGain.size()) { kalmanGain[i] } else { 0.5 };
      let prediction = if (i < field.size()) { field[i] } else { S0 };
      let actual = if (i < currentActivations.size()) { currentActivations[i] } else { S0 };
      let localError = abs(actual - prediction);
      
      // Increase gain if error is high
      fclamp(oldGain + (localError - 0.1) * 0.1, 0.1, 0.9)
    });
    
    // Propagate prediction: leaky integrator with Kalman gain
    let newField = Array.tabulate<Float>(PREDICTION_FLOATS, func(idx : Nat) : Float {
      let step = idx / nodes;
      let node = idx % nodes;
      
      let oldPred = if (idx < field.size()) { field[idx] } else { S0 };
      let current = if (node < currentActivations.size()) { currentActivations[node] } else { S0 };
      let gain = if (node < newKalmanGain.size()) { newKalmanGain[node] } else { 0.5 };
      
      if (step == 0) {
        // First step: blend current with prediction
        fclamp(oldPred * (1.0 - gain) + current * gain, S0 * 0.5, 2.0)
      } else {
        // Later steps: decay toward baseline
        fclamp(oldPred * 0.95 + S0 * 0.05, S0 * 0.5, 2.0)
      }
    });
    
    { newField; error; newKalmanGain }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // QUANTUM BATTERY — Superradiance charge, Shell 3 discharge
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func updateQuantumBattery(
    charge : Float,
    capacity : Float,
    resonexScore : Float,
    shell12Coherence : Float,
    shell3Activations : [Float]
  ) : { newCharge : Float; dischargeTarget : Nat; discharged : Bool } {
    
    // Charge from RESONEX superradiance
    let newCharge = fclamp(charge + resonexScore * 0.001, S0 * 0.5, capacity);
    
    // Find weakest Shell 3 node
    var minAct : Float = 1e10;
    var dischargeTarget : Nat = 0;
    for (i in shell3Activations.keys()) {
      if (shell3Activations[i] < minAct) {
        minAct := shell3Activations[i];
        dischargeTarget := i;
      };
    };
    
    // Discharge when coherence drops below 1.02
    let discharged = shell12Coherence < 1.02 and newCharge > S0;
    let finalCharge = if (discharged) {
      fclamp(newCharge - 0.01, S0 * 0.5, capacity)
    } else {
      newCharge
    };
    
    { newCharge = finalCharge; dischargeTarget; discharged }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // PROMETHEUS PRIME — Anomaly Detection
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func updatePrometheus(
    baseline : [Float],
    observations : [Float],
    anomalyLog : [AnomalyEvent],
    beat : Nat
  ) : { newBaseline : [Float]; anomalies : [AnomalyEvent]; tier1Actions : [Text] } {
    
    // Update rolling baseline (EMA)
    let newBaseline = Array.tabulate<Float>(PROMETHEUS_SLOTS, func(i : Nat) : Float {
      let base = if (i < baseline.size()) { baseline[i] } else { S0 };
      let obs = if (i < observations.size()) { observations[i] } else { S0 };
      base * 0.999 + obs * 0.001
    });
    
    // Z-score anomaly detection
    let anomalyBuffer = Buffer.Buffer<AnomalyEvent>(10);
    let actionBuffer = Buffer.Buffer<Text>(5);
    
    for (i in observations.keys()) {
      if (i < PROMETHEUS_SLOTS) {
        let obs = observations[i];
        let base = if (i < newBaseline.size()) { newBaseline[i] } else { S0 };
        let z = abs(obs - base) / 0.05;  // σ = 0.05
        
        if (z > 3.0) {
          // Tier determination by z-score
          let tier : Nat = if (z > 10.0) { 5 }
                          else if (z > 7.0) { 4 }
                          else if (z > 5.0) { 3 }
                          else if (z > 4.0) { 2 }
                          else { 1 };
          
          let event : AnomalyEvent = {
            beat = beat;
            slot = i;
            zScore = z;
            tier = tier;
            action = if (tier >= 3) { "ALERT" } else { "LOG" };
          };
          anomalyBuffer.add(event);
          
          // Tier 1-2 auto actions
          if (tier <= 2) {
            actionBuffer.add("AUTO_CORRECT_SLOT_" # Nat.toText(i));
          };
        };
      };
    };
    
    // Keep last 20 anomalies
    let newAnomalies = Array.append(anomalyLog, Buffer.toArray(anomalyBuffer));
    let truncatedAnomalies = if (newAnomalies.size() > 20) {
      Array.tabulate<AnomalyEvent>(20, func(i : Nat) : AnomalyEvent {
        newAnomalies[newAnomalies.size() - 20 + i]
      })
    } else {
      newAnomalies
    };
    
    { newBaseline; anomalies = truncatedAnomalies; tier1Actions = Buffer.toArray(actionBuffer) }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // ATLAS TERRITORY — Stigmergy
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func updateAtlas(
    pheromone : [Float],
    sovereignty : [Float],
    shell12Coherence : Float,
    qsov : Float,
    beat : Nat
  ) : { newPheromone : [Float]; newSovereignty : [Float]; sovIndex : Float } {
    
    let cellIdx = beat % ATLAS_CELLS;
    
    // Pheromone evaporation + deposit
    let newPheromone = Array.tabulate<Float>(ATLAS_CELLS, func(i : Nat) : Float {
      let p = if (i < pheromone.size()) { pheromone[i] } else { S0 };
      let evaporated = p * 0.98;  // 2% evaporation
      let deposited = if (i == cellIdx) { shell12Coherence * 0.01 } else { 0.0 };
      fclamp(evaporated + deposited, 0.0, 5.0)
    });
    
    // Sovereignty update
    let newSovereignty = Array.tabulate<Float>(ATLAS_CELLS, func(i : Nat) : Float {
      let s = if (i < sovereignty.size()) { sovereignty[i] } else { S0 };
      let boost = if (i == cellIdx) { qsov * 0.001 } else { 0.0 };
      fclamp(s + boost, 0.0, 5.0)
    });
    
    // Aggregate sovereignty index
    let sovIndex = mean(newSovereignty);
    
    { newPheromone; newSovereignty; sovIndex }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // GEN 3 ANIMALS — EMA Update
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func updateGen3Animals(
    current : {
      peregrine : Float; moleRat : Float; cuttlefish : Float; salmon : Float;
      spider : Float; bat : Float; albatross : Float; shrimp : Float;
      lyrebird : Float; octopus : Float; beetle : Float; vampBat : Float;
      dungBeetle : Float; platypus : Float; hagfish : Float; mantis : Float;
    },
    shell12Coherence : Float
  ) : {
    peregrine : Float; moleRat : Float; cuttlefish : Float; salmon : Float;
    spider : Float; bat : Float; albatross : Float; shrimp : Float;
    lyrebird : Float; octopus : Float; beetle : Float; vampBat : Float;
    dungBeetle : Float; platypus : Float; hagfish : Float; mantis : Float;
  } {
    
    // EMA update: animal = animal × 0.999 + coherence × 0.001
    let update = func(v : Float) : Float {
      fclamp(v * 0.999 + shell12Coherence * 0.001, S0, 2.0)
    };
    
    {
      peregrine = update(current.peregrine);
      moleRat = update(current.moleRat);
      cuttlefish = update(current.cuttlefish);
      salmon = update(current.salmon);
      spider = update(current.spider);
      bat = update(current.bat);
      albatross = update(current.albatross);
      shrimp = update(current.shrimp);
      lyrebird = update(current.lyrebird);
      octopus = update(current.octopus);
      beetle = update(current.beetle);
      vampBat = update(current.vampBat);
      dungBeetle = update(current.dungBeetle);
      platypus = update(current.platypus);
      hagfish = update(current.hagfish);
      mantis = update(current.mantis);
    }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // BEE NEURON MODEL — Sparse Gate, 20Hz Anchor
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func applyBeeNeuronModel(
    activations : [Float],
    oscillatorPhase : Float,
    beat : Nat
  ) : { sparseActivations : [Float]; newPhase : Float; waggleCode : Nat; coherence : Float } {
    
    // Find 95th percentile threshold
    let sorted = Array.sort<Float>(activations, Float.compare);
    let idx95 = (activations.size() * 95) / 100;
    let threshold = if (idx95 < sorted.size()) { sorted[idx95] } else { S0 };
    
    // Apply sparse GABA gate
    let sparseActivations = Array.tabulate<Float>(activations.size(), func(i : Nat) : Float {
      let a = activations[i];
      if (a < threshold) {
        fclamp(a * 0.7, S0 * 0.5, 2.0)  // GABA suppression
      } else {
        a
      }
    });
    
    // 20Hz oscillator phase advance
    let phaseIncrement = TAU * 20.0 / 12.0;  // 20 Hz at 12 Hz heartbeat
    var newPhase = oscillatorPhase + phaseIncrement;
    if (newPhase > TAU) { newPhase -= TAU };
    
    // Waggle compression every 20 beats
    let waggleCode : Nat = if (beat % 20 == 0) {
      // Compute directional vector
      var xSum : Float = 0.0;
      var ySum : Float = 0.0;
      var total : Float = 0.0;
      for (i in activations.keys()) {
        let a = activations[i];
        let x = Float.fromInt(i % 8);
        let y = Float.fromInt(i / 8);
        xSum += x * a;
        ySum += y * a;
        total += a;
      };
      let comX = if (total > 0.0) { xSum / total } else { 4.0 };
      let comY = if (total > 0.0) { ySum / total } else { 4.0 };
      
      // Encode as 8-bit value
      let dx = Int.abs(Float.toInt(comX * 16.0));
      let dy = Int.abs(Float.toInt(comY * 16.0));
      (dx % 256) + (dy % 256) * 256
    } else { 0 };
    
    // Phase coherence
    var cosSum : Float = 0.0;
    var sinSum : Float = 0.0;
    for (i in activations.keys()) {
      let phase = newPhase + Float.fromInt(i) * 0.1;
      cosSum += cos(phase);
      sinSum += sin(phase);
    };
    let coherence = sqrt(cosSum * cosSum + sinSum * sinSum) / Float.fromInt(activations.size());
    
    { sparseActivations; newPhase; waggleCode; coherence }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // ARES ROLLBACK — Snapshot and Restore
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func takeAresSnapshot(
    snapshots : [[Float]],
    snapshotBeats : [Nat],
    currentSlot : Nat,
    weights : [Float],
    beat : Nat
  ) : { newSnapshots : [[Float]]; newSnapshotBeats : [Nat]; newSlot : Nat } {
    
    // Copy weights to current slot
    let weightsToStore = Array.tabulate<Float>(ARES_WEIGHTS, func(i : Nat) : Float {
      if (i < weights.size()) { weights[i] } else { S0 }
    });
    
    let newSnapshots = Array.tabulate<[Float]>(ARES_SNAPSHOTS, func(s : Nat) : [Float] {
      if (s == currentSlot) { weightsToStore }
      else if (s < snapshots.size()) { snapshots[s] }
      else { Array.tabulate<Float>(ARES_WEIGHTS, func(_ : Nat) : Float { S0 }) }
    });
    
    let newSnapshotBeats = Array.tabulate<Nat>(ARES_SNAPSHOTS, func(s : Nat) : Nat {
      if (s == currentSlot) { beat }
      else if (s < snapshotBeats.size()) { snapshotBeats[s] }
      else { 0 }
    });
    
    let newSlot = (currentSlot + 1) % ARES_SNAPSHOTS;
    
    { newSnapshots; newSnapshotBeats; newSlot }
  };
  
  public func rollbackAres(
    snapshots : [[Float]],
    slot : Nat
  ) : [Float] {
    let safeSlot = slot % ARES_SNAPSHOTS;
    if (safeSlot < snapshots.size()) { snapshots[safeSlot] }
    else { Array.tabulate<Float>(ARES_WEIGHTS, func(_ : Nat) : Float { S0 }) }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // BEHAVIORAL DRIVES — Update
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func updateDrives(
    drives : {
      informationHunger : Float;
      curiosity : Float;
      completionDrive : Float;
      coherenceNeed : Float;
      masteryDrive : Float;
    },
    infoReceived : Bool,
    taskCompleted : Bool,
    coherenceLevel : Float
  ) : {
    informationHunger : Float;
    curiosity : Float;
    completionDrive : Float;
    coherenceNeed : Float;
    masteryDrive : Float;
  } {
    
    // Information hunger increases over time, decreases when info received
    let newHunger = if (infoReceived) {
      fclamp(drives.informationHunger - 0.1, 0.0, 1.0)
    } else {
      fclamp(drives.informationHunger + 0.01, 0.0, 1.0)
    };
    
    // Curiosity tracks novelty
    let newCuriosity = fclamp(drives.curiosity * 0.99 + 0.01 * newHunger, 0.3, 1.0);
    
    // Completion drive
    let newCompletion = if (taskCompleted) {
      fclamp(drives.completionDrive - 0.2, 0.0, 1.0)
    } else {
      fclamp(drives.completionDrive + 0.01, 0.0, 1.0)
    };
    
    // Coherence need inversely proportional to actual coherence
    let newCoherenceNeed = fclamp(1.0 - coherenceLevel, 0.0, 1.0);
    
    // Mastery drive
    let newMastery = fclamp(drives.masteryDrive * 0.999 + 0.001, 0.3, 1.0);
    
    {
      informationHunger = newHunger;
      curiosity = newCuriosity;
      completionDrive = newCompletion;
      coherenceNeed = newCoherenceNeed;
      masteryDrive = newMastery;
    }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // REWARD SYSTEM — TD Learning
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func updateRewards(
    rewards : {
      dopamine : Float;
      serotonin : Float;
      endorphin : Float;
      rewardPredictionError : Float;
    },
    actualReward : Float,
    expectedReward : Float,
    learningOccurred : Bool,
    taskCompleted : Bool
  ) : {
    dopamine : Float;
    serotonin : Float;
    endorphin : Float;
    rewardPredictionError : Float;
  } {
    
    // Reward prediction error (TD error)
    let rpe = actualReward - expectedReward;
    
    // Dopamine: reward signal + learning bonus
    let dopamineBoost = if (learningOccurred) { 0.3 } else { 0.0 };
    let taskBoost = if (taskCompleted) { 0.5 } else { 0.0 };
    let newDopamine = fclamp(rewards.dopamine * 0.9 + max(0.0, rpe) * 0.1 + dopamineBoost + taskBoost, S0 * 0.5, 2.0);
    
    // Serotonin: satisfaction level
    let newSerotonin = fclamp(rewards.serotonin * 0.95 + 0.05 * actualReward, S0 * 0.5, 2.0);
    
    // Endorphin: achievement pleasure
    let newEndorphin = fclamp(rewards.endorphin * 0.98 + (if (taskCompleted) { 0.5 } else { 0.0 }), 0.0, 2.0);
    
    {
      dopamine = newDopamine;
      serotonin = newSerotonin;
      endorphin = newEndorphin;
      rewardPredictionError = rpe;
    }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // ANIMA CHAIN — Identity Continuity
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func appendAnimaChain(
    chain : [Nat32],
    beat : Nat,
    significantEvent : Bool
  ) : [Nat32] {
    
    if (not significantEvent) { return chain };
    
    // Generate FNV-1a hash of current state
    let beatBytes : [Nat8] = [
      Nat8.fromNat(beat % 256),
      Nat8.fromNat((beat / 256) % 256),
      Nat8.fromNat((beat / 65536) % 256),
      Nat8.fromNat((beat / 16777216) % 256)
    ];
    let hash = fnv1a(beatBytes);
    
    // Append to chain (keep last 100)
    let newChain = Array.append(chain, [hash]);
    if (newChain.size() > 100) {
      Array.tabulate<Nat32>(100, func(i : Nat) : Nat32 {
        newChain[newChain.size() - 100 + i]
      })
    } else {
      newChain
    }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // MERIDIAN STATE — Numeric Output Only
  // ═══════════════════════════════════════════════════════════════════════════
  
  public type MeridianState = {
    s3Coherence : Float;
    qsov : Float;
    heartbeat : Nat;
    jubileeNext : Nat;
    freeEnergy : Float;
    qBattery : Float;
    predError : Float;
    waggle : Nat;
    s12Coherence : Float;
    aresSnapshots : Nat;
    atlasSov : Float;
  };
  
  public func getMeridianState(state : UnifiedOrganismState) : MeridianState {
    {
      s3Coherence = state.shell3.coherence;
      qsov = state.quantum.qsov;
      heartbeat = state.heartbeat;
      jubileeNext = state.jubileeCountdown;
      freeEnergy = state.freeEnergy.F;
      qBattery = state.battery.charge;
      predError = state.prediction.error;
      waggle = state.bee.waggleCode;
      s12Coherence = state.shell12.coherence;
      aresSnapshots = state.ares.currentSlot;
      atlasSov = state.atlas.sovIndex;
    }
  };
  
