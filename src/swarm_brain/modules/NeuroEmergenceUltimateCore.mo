  // ═══════════════════════════════════════════════════════════════════════════
  // MATH PRIMITIVES — High Precision Implementations
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func abs(x : Float) : Float { if (x < 0.0) -x else x };
  public func max(a : Float, b : Float) : Float { if (a > b) a else b };
  public func min(a : Float, b : Float) : Float { if (a < b) a else b };
  public func clamp(x : Float, lo : Float, hi : Float) : Float { max(lo, min(hi, x)) };
  public func fclamp(x : Float, lo : Float, hi : Float) : Float { max(lo, min(hi, x)) };
  
  /// Newton-Raphson square root (20 iterations)
  public func sqrt(x : Float) : Float {
    if (x <= 0.0) return 0.0;
    var g = x * 0.5; var i = 0;
    while (i < 20) { g := (g + x / g) * 0.5; i += 1 };
    g
  };
  
  /// Taylor series exponential (clamped input, 25 terms)
  public func exp(x : Float) : Float {
    let c = clamp(x, -50.0, 50.0);
    var s = 1.0; var t = 1.0; var i = 1;
    while (i < 25) { t *= c / Float.fromInt(i); s += t; i += 1 };
    s
  };
  
  /// Natural logarithm via arctanh series
  public func ln(x : Float) : Float {
    if (x <= 0.0) return -1e10;
    let z = (x - 1.0) / (x + 1.0);
    let z2 = z * z;
    var s = z; var t = z; var i = 1;
    while (i < 40) { t *= z2; s += t / Float.fromInt(2*i + 1); i += 1 };
    2.0 * s
  };
  
  /// Power function via exp(e × ln(b))
  public func pow(b : Float, e : Float) : Float { 
    if (b <= 0.0) 0.0 else exp(e * ln(b)) 
  };
  
  /// Taylor series sine (7 terms)
  public func sin(x : Float) : Float {
    var a = x;
    while (a > PI) { a -= TAU };
    while (a < -PI) { a += TAU };
    let x2 = a * a;
    a * (1.0 - x2/6.0 * (1.0 - x2/20.0 * (1.0 - x2/42.0 * (1.0 - x2/72.0 * (1.0 - x2/110.0 * (1.0 - x2/156.0))))))
  };
  
  /// Cosine via phase-shifted sine
  public func cos(x : Float) : Float { sin(x + PI * 0.5) };
  
  /// Hyperbolic tangent
  public func tanh(x : Float) : Float {
    if (x > 15.0) return 1.0;
    if (x < -15.0) return -1.0;
    let e2x = exp(2.0 * x);
    (e2x - 1.0) / (e2x + 1.0)
  };
  
  /// Logistic sigmoid
  public func sigmoid(x : Float) : Float { 1.0 / (1.0 + exp(-x)) };
  
  /// ReLU activation
  public func relu(x : Float) : Float { max(0.0, x) };
  
  /// Softplus activation (smooth ReLU)
  public func softplus(x : Float) : Float { ln(1.0 + exp(x)) };
  
  /// GELU approximation
  public func gelu(x : Float) : Float {
    0.5 * x * (1.0 + tanh(0.7978845608 * (x + 0.044715 * x * x * x)))
  };
  
  /// Geometric mean of array
  public func geometricMean(arr : [Float]) : Float {
    if (arr.size() == 0) return S0;
    var logSum : Float = 0.0;
    for (v in arr.vals()) {
      logSum += ln(max(0.001, v));
    };
    exp(logSum / Float.fromInt(arr.size()))
  };
  
  /// Arithmetic mean of array
  public func mean(arr : [Float]) : Float {
    if (arr.size() == 0) return S0;
    var sum : Float = 0.0;
    for (v in arr.vals()) { sum += v };
    sum / Float.fromInt(arr.size())
  };
  
  /// Standard deviation of array
  public func stddev(arr : [Float]) : Float {
    if (arr.size() < 2) return 0.0;
    let m = mean(arr);
    var sumSq : Float = 0.0;
    for (v in arr.vals()) {
      let d = v - m;
      sumSq += d * d;
    };
    sqrt(sumSq / Float.fromInt(arr.size() - 1))
  };
  
  /// Shannon entropy of probability distribution
  public func shannonEntropy(probs : [Float]) : Float {
    var H : Float = 0.0;
    for (p in probs.vals()) {
      if (p > 0.001) {
        H -= p * ln(p);
      };
    };
    H
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // SHAKE-256 SPONGE HASH (Simplified)
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func shake256Hash(input : Nat) : Nat {
    var state : Nat = input ^ 0x6a09e667;
    var i = 0;
    while (i < 24) {
      state := (state * 1664525 + 1013904223) % 4294967296;
      state := state ^ (state / 65536);
      state := (state * 22695477 + 1) % 4294967296;
      i += 1;
    };
    state
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // FNV-1a HASH (For ANIMA Chain)
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func fnv1a(data : [Nat8]) : Nat32 {
    var hash : Nat32 = 2166136261;
    for (byte in data.vals()) {
      hash := hash ^ Nat32.fromNat(Nat8.toNat(byte));
      hash := hash *% 16777619;
    };
    hash
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // LWE LATTICE VALIDITY (Simplified Learning With Errors)
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func lweValidity(docHash : Nat) : Float {
    let q : Nat = 3329;  // Kyber parameter
    var inner : Nat = 0;
    var k = 0;
    while (k < 8) {
      inner := (inner + (docHash / (k + 1)) * (k + 1)) % q;
      k += 1;
    };
    let error : Nat = inner % 13;
    fclamp(1.0 - Float.fromInt(error) / 13.0, 0.0, 1.0)
  };
  
