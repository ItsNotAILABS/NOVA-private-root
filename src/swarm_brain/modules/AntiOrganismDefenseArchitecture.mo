  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    MATH PRIMITIVES                                     ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  public func fsin(x : Float) : Float {
    var n = x;
    while (n > PI) { n -= TAU };
    while (n < -PI) { n += TAU };
    let x2 = n * n;
    n - n*x2/6.0 + n*x2*x2/120.0 - n*x2*x2*x2/5040.0 + n*x2*x2*x2*x2/362880.0
  };
  
  public func fcos(x : Float) : Float { fsin(x + PI/2.0) };
  
  public func fabs(x : Float) : Float { if (x < 0.0) { -x } else { x } };
  
  public func fmax(x : Float, y : Float) : Float { if (x > y) { x } else { y } };
  
  public func fmin(x : Float, y : Float) : Float { if (x < y) { x } else { y } };
  
  public func fclamp(x : Float, lo : Float, hi : Float) : Float {
    if (x < lo) { lo } else if (x > hi) { hi } else { x }
  };
  
  public func fsqrt(x : Float) : Float {
    if (x <= 0.0) { return 0.0 };
    var g = x / 2.0; var i = 0;
    while (i < 15) { g := (g + x / g) / 2.0; i += 1 };
    g
  };
  
  public func ftanh(x : Float) : Float {
    let ex = fexp(x);
    let emx = fexp(-x);
    (ex - emx) / (ex + emx)
  };
  
  public func fexp(x : Float) : Float {
    if (x > 20.0) { return 485165195.409790 };
    if (x < -20.0) { return 0.0 };
    var result : Float = 1.0;
    var term : Float = 1.0;
    var n : Nat = 1;
    while (n < 20) {
      term := term * x / Float.fromInt(n);
      result += term;
      n += 1;
    };
    result
  };
  
  // Quantum-resistant hash
  public func quantumHash(input : [Nat8], context : Nat32, salt : Nat32) : Nat32 {
    var h1 : Nat32 = 2166136261;
    h1 := h1 ^ context;
    for (byte in input.vals()) {
      h1 := (h1 ^ Nat32.fromNat(Nat8.toNat(byte))) *% 16777619;
    };
    var h2 : Nat32 = 5381;
    h2 := ((h2 << 5) +% h2) +% (context ^ salt);
    h2 := ((h2 << 5) +% h2) +% h1;
    var h3 : Nat32 = h1 +% (h2 << 6) +% (h2 << 16) -% h2;
    h3 := (context ^ salt) +% (h3 << 6) +% (h3 << 16) -% h3;
    h1 ^ h2 ^ h3
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    ANTI-PATTERN DETECTION ENGINE                       ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // Core detection equation: A = Σ wᵢ × Δᵢ
  public func computeAntiPatternScore(state : AntiPatternState) : Float {
    let w = state.weights;
    // Ensure we have at least 6 weights
    let w1 = if (w.size() > 0) { w[0] } else { W_DEFAULT };
    let w2 = if (w.size() > 1) { w[1] } else { W_DEFAULT };
    let w3 = if (w.size() > 2) { w[2] } else { W_DEFAULT };
    let w4 = if (w.size() > 3) { w[3] } else { W_DEFAULT };
    let w5 = if (w.size() > 4) { w[4] } else { W_DEFAULT };
    let w6 = if (w.size() > 5) { w[5] } else { W_DEFAULT };
    
    w1 * state.recognizerSpoofSignal +
    w2 * state.gateBypassSignal +
    w3 * state.zoneHijackSignal +
    w4 * state.continuityNotchSignal +
    w5 * (state.fusionCorruptionSignal + state.embodiedMisfireSignal) / 2.0 +
    w6 * state.containmentEvasionSignal
  };
  
  // Detect which anti-families are active
  public func detectAntiFamilies(state : AntiPatternState) : [AntiFamily] {
    var families = Buffer.Buffer<AntiFamily>(6);
    
    // Family 1: Counterfeit Axis — geometry + recognizer
    if (state.geometryFractureSignal > 0.5 and state.recognizerSpoofSignal > SPOOF_DETECTION_THRESHOLD) {
      families.add(#CounterfeitAxis);
    };
    
    // Family 2: Gate-Capture Priesthood — gate bypass + semantic inversion
    if (state.gateBypassSignal > BYPASS_DETECTION_THRESHOLD and state.constitutionCorruptionSignal > 0.5) {
      families.add(#GateCapturePriesthood);
    };
    
    // Family 3: Resonance Siphon — disharmonics + coherence drain
    if (state.disharmonicInjectionSignal > 0.5 and state.fusionCorruptionSignal > 0.4) {
      families.add(#ResonanceSiphonNetwork);
    };
    
    // Family 4: Narrative Inversion — doctrine drift + misfire
    if (state.degenerativeMutationSignal > 0.5 and state.embodiedMisfireSignal > 0.5) {
      families.add(#NarrativeInversionEngine);
    };
    
    // Family 5: Continuity Fracture — notch + source denial
    if (state.continuityNotchSignal > CONTINUITY_NOTCH_THRESHOLD and state.sourceDenialSignal > 0.4) {
      families.add(#ContinuityFractureSystem);
    };
    
    // Family 6: CONTAINMENT BREAKER — THE CRITICAL ONE
    if (state.containmentEvasionSignal > CONTAINMENT_BREACH_THRESHOLD) {
      families.add(#ContainmentBreaker);
    };
    
    Buffer.toArray(families)
  };
  
  // Determine primary threat
  public func determinePrimaryThreat(families : [AntiFamily]) : ?AntiFamily {
    // Containment Breaker is ALWAYS primary if present
    for (f in families.vals()) {
      switch (f) {
        case (#ContainmentBreaker) { return ?#ContainmentBreaker };
        case _ {};
      };
    };
    
    // Otherwise return first detected
    if (families.size() > 0) {
      return ?families[0];
    };
    null
  };
  
  // Escalate weights when containment breach detected
  public func escalateWeights(currentWeights : [Float], breachDetected : Bool) : [Float] {
    if (not breachDetected) { return currentWeights };
    
    // Escalate w₆ (containment weight) to 10.0
    var newWeights = Array.thaw<Float>(currentWeights);
    if (newWeights.size() > 5) {
      newWeights[5] := W_CONTAINMENT_ESCALATED;
    };
    Array.freeze(newWeights)
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    CONTAINMENT BREACH DETECTION (FAMILY #6)            ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // Detect boundary probing behavior
  public func detectBoundaryProbe(
    immuneState : ImmuneContainmentLayer,
    inputSignal : [Float],
    beatNum : Nat
  ) : (ImmuneContainmentLayer, BoundaryProbe) {
    // Calculate probe characteristics
    var probeStrength : Float = 0.0;
    for (s in inputSignal.vals()) {
      probeStrength += fabs(s);
    };
    probeStrength := probeStrength / Float.fromInt(inputSignal.size());
    
    // Check if it's probing boundaries
    let boundaryReached = probeStrength > 0.8;
    
    // Detect learning behavior by analyzing pattern changes
    var learningDetected = false;
    if (immuneState.boundaryProbes.size() > 2) {
      // Compare to recent probes — if vectors are adapting, learning is occurring
      let lastProbe = immuneState.boundaryProbes[immuneState.boundaryProbes.size() - 1];
      let variation = fabs(probeStrength - lastProbe.probeStrength);
      learningDetected := variation > 0.1 and variation < 0.5; // Adaptive variation
    };
    
    let probe : BoundaryProbe = {
      beatNum = beatNum;
      probeVector = inputSignal;
      probeStrength = probeStrength;
      boundaryReached = boundaryReached;
      responseObserved = true;
      learningDetected = learningDetected;
    };
    
    // Update immune state with new probe
    var newProbes = Buffer.fromArray<BoundaryProbe>(immuneState.boundaryProbes);
    newProbes.add(probe);
    
    // Keep only recent probes
    while (newProbes.size() > BOUNDARY_PROBE_MEMORY) {
      ignore newProbes.remove(0);
    };
    
    // Calculate evasion signal
    var evasionSignal : Float = 0.0;
    var learningCount : Nat = 0;
    for (p in newProbes.vals()) {
      if (p.learningDetected) { learningCount += 1 };
    };
    evasionSignal := Float.fromInt(learningCount) / Float.fromInt(newProbes.size());
    
    let newImmuneState : ImmuneContainmentLayer = {
      quarantineActive = immuneState.quarantineActive;
      quarantineDepth = immuneState.quarantineDepth;
      quarantinedEntities = immuneState.quarantinedEntities;
      rollbackReady = immuneState.rollbackReady;
      rollbackDepth = immuneState.rollbackDepth;
      evasionDetection = fmax(evasionSignal, immuneState.evasionDetection);
      boundaryProbes = Buffer.toArray(newProbes);
      escapeVectors = immuneState.escapeVectors;
      falseRecoverySignals = immuneState.falseRecoverySignals;
    };
    
    (newImmuneState, probe)
  };
  
  // Calculate containment evasion signal
  public func calculateContainmentEvasionSignal(immuneState : ImmuneContainmentLayer) : Float {
    var signal : Float = 0.0;
    
    // Factor 1: Boundary probe frequency
    let probeFrequency = Float.fromInt(immuneState.boundaryProbes.size()) / Float.fromInt(BOUNDARY_PROBE_MEMORY);
    signal += 0.3 * probeFrequency;
    
    // Factor 2: Learning detection rate
    var learningRate : Float = 0.0;
    for (probe in immuneState.boundaryProbes.vals()) {
      if (probe.learningDetected) {
        learningRate += 1.0;
      };
    };
    if (immuneState.boundaryProbes.size() > 0) {
      learningRate := learningRate / Float.fromInt(immuneState.boundaryProbes.size());
    };
    signal += 0.4 * learningRate;
    
    // Factor 3: False recovery signal count
    let falseRecoveryRate = fmin(Float.fromInt(immuneState.falseRecoverySignals) / 10.0, 1.0);
    signal += 0.3 * falseRecoveryRate;
    
    fclamp(signal, 0.0, 1.0)
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    PHASE-CONJUGATE DEFENSE FIELD                       ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // The phase-conjugate defense creates a counter-field that neutralizes attacks
  public type PhaseConjugateField = {
    amplitude : Float;
    phase : Float;
    frequency : Float;
    coherence : Float;
    conjugateVector : [Float];
    neutralizationStrength : Float;
  };
  
  public func initPhaseConjugateField() : PhaseConjugateField {
    {
      amplitude = 1.0;
      phase = 0.0;
      frequency = 7.83;  // Schumann base
      coherence = 1.0;
      conjugateVector = [0.0, 0.0, 0.0];
      neutralizationStrength = 1.0;
    }
  };
  
  // Generate conjugate field from attack vector
  public func generateConjugateField(attackVector : [Float], baseField : PhaseConjugateField) : PhaseConjugateField {
    // Phase conjugate = opposite phase
    let conjugatePhase = baseField.phase + PI;
    
    // Conjugate vector = -attackVector normalized
    var magnitude : Float = 0.0;
    for (v in attackVector.vals()) {
      magnitude += v * v;
    };
    magnitude := fsqrt(magnitude);
    
    let conjugateVector = if (magnitude > 0.0) {
      Array.tabulate<Float>(attackVector.size(), func(i) {
        -attackVector[i] / magnitude
      })
    } else {
      attackVector
    };
    
    {
      amplitude = baseField.amplitude * 1.2;  // Boost for defense
      phase = conjugatePhase;
      frequency = baseField.frequency;
      coherence = baseField.coherence;
      conjugateVector = conjugateVector;
      neutralizationStrength = fmin(magnitude * PHI, 2.0);
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    HELIX BOUNDARY ENCRYPTION                           ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // Multi-layer helix encryption for containment boundaries
  public type HelixBoundary = {
    encryptionRounds : Nat;
    helixPhases : [Float];    // Phase at each round
    helixKeys : [Nat32];      // Keys for each layer
    boundaryStrength : Float;
    lastRotation : Nat;
  };
  
  public func initHelixBoundary() : HelixBoundary {
    // Initialize with PHI-spaced phases
    let phases = Array.tabulate<Float>(HELIX_ENCRYPTION_ROUNDS, func(i) {
      let fraction = Float.fromInt(i) / Float.fromInt(HELIX_ENCRYPTION_ROUNDS);
      fraction * TAU * PHI
    });
    
    // Generate initial keys
    let keys = Array.tabulate<Nat32>(HELIX_ENCRYPTION_ROUNDS, func(i) {
      let seed : [Nat8] = [Nat8.fromNat(i % 256), Nat8.fromNat((i * 7) % 256)];
      quantumHash(seed, Nat32.fromNat(i), 0xDEADBEEF)
    });
    
    {
      encryptionRounds = HELIX_ENCRYPTION_ROUNDS;
      helixPhases = phases;
      helixKeys = keys;
      boundaryStrength = 1.0;
      lastRotation = 0;
    }
  };
  
  // Rotate helix boundary (makes escape vector calculation harder)
  public func rotateHelixBoundary(boundary : HelixBoundary, beatNum : Nat) : HelixBoundary {
    // Rotate all phases by golden angle
    let goldenAngle = TAU / PHI_SQ;  // ~137.5 degrees
    
    let newPhases = Array.tabulate<Float>(boundary.encryptionRounds, func(i) {
      var phase = boundary.helixPhases[i] + goldenAngle;
      while (phase >= TAU) { phase -= TAU };
      phase
    });
    
    // Regenerate keys based on new phases
    let newKeys = Array.tabulate<Nat32>(boundary.encryptionRounds, func(i) {
      let phaseBytes : Nat8 = Nat8.fromNat(Int.abs(Float.toInt(newPhases[i] * 100.0)) % 256);
      let seed : [Nat8] = [phaseBytes, Nat8.fromNat(beatNum % 256)];
      quantumHash(seed, boundary.helixKeys[i], Nat32.fromNat(beatNum))
    });
    
    {
      encryptionRounds = boundary.encryptionRounds;
      helixPhases = newPhases;
      helixKeys = newKeys;
      boundaryStrength = boundary.boundaryStrength;
      lastRotation = beatNum;
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    ALERT STATE DETERMINATION                           ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  public func determineAlertState(antiPattern : AntiPatternState, coherence : Float) : DefenseAlert {
    // Containment breach = immediate BLACK
    if (antiPattern.containmentEvasionSignal > CONTAINMENT_BREACH_THRESHOLD) {
      return #Black;
    };
    
    let score = antiPattern.totalAntiPatternScore;
    
    // Score-based escalation
    if (score > 0.8 or coherence < 0.3) {
      return #Red;
    };
    
    if (score > 0.6 or coherence < 0.5) {
      return #Orange;
    };
    
    if (score > 0.4 or coherence < 0.7) {
      return #Yellow;
    };
    
    #Green
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    MAIN DEFENSE TICK                                   ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  public func tickAntiOrganismDefense(
    state : DefenseState,
    inputSignal : [Float],
    beatNum : Nat
  ) : DefenseState {
    
    // ─────────────────────────────────────────────────────────────────────────
    // STEP 1: Update Immune/Containment Layer (Detect boundary probes)
    // ─────────────────────────────────────────────────────────────────────────
    let (newImmuneContainment, probe) = detectBoundaryProbe(state.immuneContainment, inputSignal, beatNum);
    
    // ─────────────────────────────────────────────────────────────────────────
    // STEP 2: Calculate all anti-pattern signals
    // ─────────────────────────────────────────────────────────────────────────
    
    // R9: Containment evasion (CRITICAL)
    let containmentEvasionSignal = calculateContainmentEvasionSignal(newImmuneContainment);
    
    // R6-A: Recognizer spoof detection
    var recognizerSpoofSignal : Float = 0.0;
    if (inputSignal.size() > 0) {
      // Check for pattern that looks valid but has wrong resonance
      let magnitude = fsqrt(Array.foldLeft<Float, Float>(inputSignal, 0.0, func(acc, x) { acc + x*x }));
      let normalizedMagnitude = magnitude / Float.fromInt(inputSignal.size());
      // Spoof = magnitude within normal range but phase correlation off
      if (normalizedMagnitude > 0.2 and normalizedMagnitude < 0.8) {
        // Check phase coherence
        var phaseSum : Float = 0.0;
        for (i in inputSignal.keys()) {
          phaseSum += fabs(fsin(inputSignal[i]));
        };
        let avgPhase = phaseSum / Float.fromInt(inputSignal.size());
        if (avgPhase > 0.7) {  // Suspiciously uniform phase
          recognizerSpoofSignal := 0.6 + 0.4 * avgPhase;
        };
      };
    };
    recognizerSpoofSignal := fmax(recognizerSpoofSignal, state.antiPattern.recognizerSpoofSignal * 0.9);
    
    // R6-B: Gate bypass detection
    var gateBypassSignal : Float = 0.0;
    if (not state.gate.gateSealed and state.gate.protectionLevel < 0.5) {
      gateBypassSignal := 0.7;
    };
    if (state.gate.bypassAttempts > 3) {
      gateBypassSignal := fmax(gateBypassSignal, 0.8);
    };
    
    // R6-C: Zone hijack detection
    var zoneHijackSignal : Float = 0.0;
    if (state.energizedZone.wrongPathDominance > 0.5) {
      zoneHijackSignal := state.energizedZone.wrongPathDominance;
    };
    
    // R8: Continuity notch detection
    var continuityNotchSignal : Float = 0.0;
    if (state.continuityWeave.hiddenFractures > 0) {
      continuityNotchSignal := fmin(Float.fromInt(state.continuityWeave.hiddenFractures) * 0.2, 1.0);
    };
    if (state.continuityWeave.dropInMiddle) {
      continuityNotchSignal := fmax(continuityNotchSignal, 0.8);
    };
    
    // R6-E: Fusion corruption (local coherent, global drift)
    var fusionCorruptionSignal : Float = 0.0;
    if (state.triuneFusion.localCoherence > 0.8 and state.triuneFusion.globalDrift > 0.3) {
      fusionCorruptionSignal := state.triuneFusion.globalDrift;
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    // STEP 3: Update Anti-Pattern State
    // ─────────────────────────────────────────────────────────────────────────
    let previousScore = state.antiPattern.totalAntiPatternScore;
    
    var newAntiPattern : AntiPatternState = {
      sourceDenialSignal = state.antiPattern.sourceDenialSignal;
      constitutionCorruptionSignal = state.antiPattern.constitutionCorruptionSignal;
      geometryFractureSignal = state.antiPattern.geometryFractureSignal;
      frequencyDestabilizationSignal = state.frequencyCarrier.destabilizationSignal;
      flowHijackSignal = state.velocityFlow.hijackSignal;
      disharmonicInjectionSignal = state.harmonicResonance.sidebandContamination;
      recognizerSpoofSignal = recognizerSpoofSignal;
      gateBypassSignal = gateBypassSignal;
      zoneHijackSignal = zoneHijackSignal;
      councilPoisoningSignal = state.councilSpecialization.sabotageDetection;
      fusionCorruptionSignal = fusionCorruptionSignal;
      embodiedMisfireSignal = state.embodiedAction.misfireDetection;
      continuityNotchSignal = continuityNotchSignal;
      containmentEvasionSignal = containmentEvasionSignal;
      degenerativeMutationSignal = state.doctrinalEvolution.mutationDetection;
      totalAntiPatternScore = 0.0;  // Will be computed
      antiPatternDerivative = 0.0;  // Will be computed
      detectedFamilies = [];  // Will be computed
      primaryThreat = null;   // Will be computed
      weights = state.antiPattern.weights;
      switchPointDetected = state.antiPattern.switchPointDetected;
      lastSwitchBeat = state.antiPattern.lastSwitchBeat;
      coherenceDuringSwitch = state.antiPattern.coherenceDuringSwitch;
    };
    
    // Compute total score
    let totalScore = computeAntiPatternScore(newAntiPattern);
    
    // Compute derivative
    let derivative = totalScore - previousScore;
    
    // Detect families
    let families = detectAntiFamilies(newAntiPattern);
    
    // Check for containment breach and escalate weights
    let breachDetected = containmentEvasionSignal > CONTAINMENT_BREACH_THRESHOLD;
    let escalatedWeights = escalateWeights(newAntiPattern.weights, breachDetected);
    
    // Detect switch point
    let switchDetected = derivative > 0.1 and state.globalCoherence < 0.7;
    
    newAntiPattern := {
      sourceDenialSignal = newAntiPattern.sourceDenialSignal;
      constitutionCorruptionSignal = newAntiPattern.constitutionCorruptionSignal;
      geometryFractureSignal = newAntiPattern.geometryFractureSignal;
      frequencyDestabilizationSignal = newAntiPattern.frequencyDestabilizationSignal;
      flowHijackSignal = newAntiPattern.flowHijackSignal;
      disharmonicInjectionSignal = newAntiPattern.disharmonicInjectionSignal;
      recognizerSpoofSignal = newAntiPattern.recognizerSpoofSignal;
      gateBypassSignal = newAntiPattern.gateBypassSignal;
      zoneHijackSignal = newAntiPattern.zoneHijackSignal;
      councilPoisoningSignal = newAntiPattern.councilPoisoningSignal;
      fusionCorruptionSignal = newAntiPattern.fusionCorruptionSignal;
      embodiedMisfireSignal = newAntiPattern.embodiedMisfireSignal;
      continuityNotchSignal = newAntiPattern.continuityNotchSignal;
      containmentEvasionSignal = newAntiPattern.containmentEvasionSignal;
      degenerativeMutationSignal = newAntiPattern.degenerativeMutationSignal;
      totalAntiPatternScore = totalScore;
      antiPatternDerivative = derivative;
      detectedFamilies = families;
      primaryThreat = determinePrimaryThreat(families);
      weights = escalatedWeights;
      switchPointDetected = switchDetected or newAntiPattern.switchPointDetected;
      lastSwitchBeat = if (switchDetected) { beatNum } else { newAntiPattern.lastSwitchBeat };
      coherenceDuringSwitch = if (switchDetected) { state.globalCoherence } else { newAntiPattern.coherenceDuringSwitch };
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    // STEP 4: Determine Alert State
    // ─────────────────────────────────────────────────────────────────────────
    let alertState = determineAlertState(newAntiPattern, state.globalCoherence);
    
    // ─────────────────────────────────────────────────────────────────────────
    // STEP 5: Calculate Defense Posture
    // ─────────────────────────────────────────────────────────────────────────
    let defensePosure = fmax(0.0, 1.0 - totalScore);
    let threatLevel = totalScore;
    
    // ─────────────────────────────────────────────────────────────────────────
    // STEP 6: Return Updated State
    // ─────────────────────────────────────────────────────────────────────────
    {
      sourceLaw = state.sourceLaw;
      constitution = state.constitution;
      geometryLattice = state.geometryLattice;
      frequencyCarrier = state.frequencyCarrier;
      velocityFlow = state.velocityFlow;
      harmonicResonance = state.harmonicResonance;
      recognizer = state.recognizer;
      gate = state.gate;
      energizedZone = state.energizedZone;
      councilSpecialization = state.councilSpecialization;
      triuneFusion = state.triuneFusion;
      embodiedAction = state.embodiedAction;
      continuityWeave = state.continuityWeave;
      immuneContainment = newImmuneContainment;
      doctrinalEvolution = state.doctrinalEvolution;
      antiPattern = newAntiPattern;
      globalCoherence = state.globalCoherence;
      defensePosure = defensePosure;
      threatLevel = threatLevel;
      alertState = alertState;
      beatNum = beatNum;
      lastDefenseTick = beatNum;
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    EMERGENCY QUARANTINE PROTOCOL                       ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // When containment breach is detected, execute emergency quarantine
  public func executeEmergencyQuarantine(
    state : DefenseState,
    threatHash : Nat32,
    beatNum : Nat
  ) : DefenseState {
    // Add to quarantine list
    var quarantined = Buffer.fromArray<Nat32>(state.immuneContainment.quarantinedEntities);
    quarantined.add(threatHash);
    
    // Increase quarantine depth
    let newDepth = state.immuneContainment.quarantineDepth + 1;
    
    let newImmuneContainment : ImmuneContainmentLayer = {
      quarantineActive = true;
      quarantineDepth = newDepth;
      quarantinedEntities = Buffer.toArray(quarantined);
      rollbackReady = true;
      rollbackDepth = state.immuneContainment.rollbackDepth;
      evasionDetection = state.immuneContainment.evasionDetection;
      boundaryProbes = state.immuneContainment.boundaryProbes;
      escapeVectors = state.immuneContainment.escapeVectors;
      falseRecoverySignals = state.immuneContainment.falseRecoverySignals;
    };
    
    {
      sourceLaw = state.sourceLaw;
      constitution = state.constitution;
      geometryLattice = state.geometryLattice;
      frequencyCarrier = state.frequencyCarrier;
      velocityFlow = state.velocityFlow;
      harmonicResonance = state.harmonicResonance;
      recognizer = state.recognizer;
      gate = state.gate;
      energizedZone = state.energizedZone;
      councilSpecialization = state.councilSpecialization;
      triuneFusion = state.triuneFusion;
      embodiedAction = state.embodiedAction;
      continuityWeave = state.continuityWeave;
      immuneContainment = newImmuneContainment;
      doctrinalEvolution = state.doctrinalEvolution;
      antiPattern = state.antiPattern;
      globalCoherence = state.globalCoherence;
      defensePosure = state.defensePosure;
      threatLevel = 1.0;  // Maximum threat during quarantine
      alertState = #Black;
      beatNum = beatNum;
      lastDefenseTick = beatNum;
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    DIAGNOSTIC FUNCTIONS                                ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  public func getDefenseReport(state : DefenseState) : Text {
    let alertText = switch (state.alertState) {
      case (#Green) { "GREEN - Normal" };
      case (#Yellow) { "YELLOW - Elevated" };
      case (#Orange) { "ORANGE - High" };
      case (#Red) { "RED - Critical" };
      case (#Black) { "BLACK - CONTAINMENT BREACH" };
    };
    
    var report = "═══ ANTI-ORGANISM DEFENSE REPORT ═══\n";
    report #= "Alert State: " # alertText # "\n";
    report #= "Threat Level: " # Float.toText(state.threatLevel) # "\n";
    report #= "Defense Posture: " # Float.toText(state.defensePosure) # "\n";
    report #= "Global Coherence: " # Float.toText(state.globalCoherence) # "\n";
    report #= "\n─── ANTI-PATTERN SIGNALS ───\n";
    report #= "Containment Evasion (R9): " # Float.toText(state.antiPattern.containmentEvasionSignal) # "\n";
    report #= "Recognizer Spoof (R6-A): " # Float.toText(state.antiPattern.recognizerSpoofSignal) # "\n";
    report #= "Gate Bypass (R6-B): " # Float.toText(state.antiPattern.gateBypassSignal) # "\n";
    report #= "Zone Hijack (R6-C): " # Float.toText(state.antiPattern.zoneHijackSignal) # "\n";
    report #= "Continuity Notch (R8): " # Float.toText(state.antiPattern.continuityNotchSignal) # "\n";
    report #= "Total Score: " # Float.toText(state.antiPattern.totalAntiPatternScore) # "\n";
    report #= "dA/dt: " # Float.toText(state.antiPattern.antiPatternDerivative) # "\n";
    report #= "\n─── QUARANTINE STATUS ───\n";
    report #= "Active: " # (if (state.immuneContainment.quarantineActive) { "YES" } else { "NO" }) # "\n";
    report #= "Depth: " # Nat.toText(state.immuneContainment.quarantineDepth) # " layers\n";
    report #= "Boundary Probes: " # Nat.toText(state.immuneContainment.boundaryProbes.size()) # "\n";
    report #= "═══════════════════════════════════\n";
    
    report
  };
  
  public func isContainmentBreach(state : DefenseState) : Bool {
    state.antiPattern.containmentEvasionSignal > CONTAINMENT_BREACH_THRESHOLD
  };
  
  public func getPrimaryThreatFamily(state : DefenseState) : ?AntiFamily {
    state.antiPattern.primaryThreat
  };
  
}
