// ║  A) MEMORY FORMS TO INGEST                                                                                ║
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
//
//   ORAL FORMS:
//   ────────────
//     • Chants — Rhythmic verbal patterns with field resonance
//     • Liturgy — Structured ceremonial sequences
//     • Epics — Long-form narrative with embedded wisdom
//     • Mnemonic verse — Memory aids encoded in rhythm
//     • Proverbs — Compressed wisdom fragments
//
//   STRUCTURAL FORMS:
//   ─────────────────
//     • Calendars — Temporal organization systems
//     • Ritual cycles — Periodic behavioral patterns
//     • Architecture alignments — Spatial-celestial relationships
//
//   SYMBOLIC FORMS:
//   ───────────────
//     • Glyphs — Visual encoding units
//     • Motifs — Recurring pattern signatures
//     • Geometric canon — Sacred proportion sets
//
//   EVENT FORMS:
//   ────────────
//     • Incident/outcome histories — Cause-effect records
//     • Lineage narratives — Genealogical trajectories
//
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// ║  B) ENCODING METHOD                                                                                        ║
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
//
//   event + phase + place + field-state + doctrine-state
//   indexed in cycles (daily / seasonal / long-cycle / mission-cycle)
//   stored as graph + waveform, not files-only
//
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// ║  C) NO-DROP MEMORY RULE                                                                                    ║
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
//
//   • Never delete trajectory
//   • Transform relevance, not existence
//   • Retain minority paths as latent pattern memory
//
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

import Float "mo:base/Float";
import Array "mo:base/Array";
import Nat "mo:base/Nat";
import Nat32 "mo:base/Nat32";
import Int "mo:base/Int";
import Buffer "mo:base/Buffer";
import Text "mo:base/Text";
import Option "mo:base/Option";
import Time "mo:base/Time";
import Hash "mo:base/Hash";

module {

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    PHYSICAL CONSTANTS                                  ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  public let PHI : Float = 1.6180339887498948482;
  public let PHI_SQUARED : Float = 2.6180339887498948482;
  public let PHI_CUBED : Float = 4.2360679774997896964;
  public let PI : Float = 3.14159265358979323846;
  public let TAU : Float = 6.28318530717958647692;
  public let E : Float = 2.71828182845904523536;
  public let SCHUMANN : Float = 7.83;
  
  // Memory constants
  public let MAX_ORAL_MEMORIES : Nat = 10000;
  public let MAX_STRUCTURAL_MEMORIES : Nat = 5000;
  public let MAX_SYMBOLIC_MEMORIES : Nat = 8000;
  public let MAX_EVENT_MEMORIES : Nat = 50000;
  public let MAX_GRAPH_NODES : Nat = 100000;
  public let MAX_GRAPH_EDGES : Nat = 500000;
  
  // Cycle lengths (in beats)
  public let DAILY_CYCLE : Nat = 86400;          // 1 day in seconds/beats
  public let SEASONAL_CYCLE : Nat = 7889238;     // ~91.25 days
  public let LONG_CYCLE : Nat = 31556952;        // 1 year in seconds
  public let MISSION_CYCLE : Nat = 604800;       // 1 week

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    A) ORAL FORMS — MEMORY TYPES                        ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Oral memory form type
  public type OralFormType = {
    #Chant;              // Rhythmic verbal patterns with field resonance
    #Liturgy;            // Structured ceremonial sequences
    #Epic;               // Long-form narrative with embedded wisdom
    #MnemonicVerse;      // Memory aids encoded in rhythm
    #Proverb;            // Compressed wisdom fragments
  };

  /// Chant memory — rhythmic verbal pattern
  public type ChantMemory = {
    chantId : Nat;
    name : Text;
    content : Text;
    
    // Rhythmic properties
    tempo : Float;               // Beats per minute
    meter : (Nat, Nat);          // Time signature (e.g., 4/4)
    accentPattern : [Bool];      // Which beats are accented
    
    // Field resonance
    resonanceFrequency : Float;  // Hz — primary frequency
    harmonics : [Float];         // Additional harmonic frequencies
    fieldStrength : Float;       // [0, 1] field coupling strength
    
    // Usage
    context : [ChantContext];
    lastUsed : Nat;
    useCount : Nat;
    
    // Encoding
    encodedWaveform : [Float];   // Sampled waveform representation
    phaseSignature : Float;      // Phase angle for coherence
    
    // Metadata
    origin : ?Text;
    tradition : ?Text;
    
    createdBeat : Nat;
    relevance : Float;           // [0, 1] current relevance
    archived : Bool;             // Never deleted, may be archived
  };

  public type ChantContext = {
    #Healing;
    #Protection;
    #Invocation;
    #Celebration;
    #Mourning;
    #Transition;
    #Daily;
    #Seasonal;
    #Emergency;
  };

  /// Liturgy memory — structured ceremonial sequence
  public type LiturgyMemory = {
    liturgyId : Nat;
    name : Text;
    
    // Structure
    stages : [LiturgyStage];
    totalDuration : Nat;         // Beats
    
    // Temporal binding
    cycleTiming : CycleTiming;
    
    // Field state
    requiredCoherence : Float;   // Minimum coherence to perform
    resultingCoherence : Float;  // Expected coherence after
    
    // Participants
    minimumParticipants : Nat;
    roleDefinitions : [LiturgyRole];
    
    // Metadata
    tradition : ?Text;
    lastPerformed : Nat;
    performanceCount : Nat;
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type LiturgyStage = {
    stageId : Nat;
    name : Text;
    duration : Nat;              // Beats
    chants : [Nat];              // ChantMemory IDs
    actions : [Text];
    requiredState : ?Text;
  };

  public type LiturgyRole = {
    roleName : Text;
    required : Bool;
    responsibilities : [Text];
  };

  public type CycleTiming = {
    #DailyCycle : { hourOfDay : Nat };
    #SeasonalCycle : { dayOfSeason : Nat; season : Season };
    #LongCycle : { dayOfYear : Nat };
    #MissionCycle : { phase : MissionPhase };
    #Anytime;
  };

  public type Season = {
    #Spring;
    #Summer;
    #Fall;
    #Winter;
  };

  public type MissionPhase = {
    #Preparation;
    #Execution;
    #Recovery;
    #Analysis;
  };

  /// Epic memory — long-form narrative
  public type EpicMemory = {
    epicId : Nat;
    title : Text;
    
    // Content structure
    chapters : [EpicChapter];
    totalLength : Nat;           // Word count
    
    // Embedded wisdom
    wisdomFragments : [WisdomFragment];
    lessonsEncoded : Nat;
    
    // Narrative properties
    protagonists : [Text];
    antagonists : [Text];
    themes : [Text];
    
    // Temporal span
    narrativeSpan : NarrativeSpan;
    
    // Recitation
    lastRecited : Nat;
    recitationCount : Nat;
    averageRecitationTime : Nat; // Beats
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type EpicChapter = {
    chapterId : Nat;
    title : Text;
    summary : Text;
    keyEvents : [Text];
    wisdomIndices : [Nat];       // Indices into wisdomFragments
  };

  public type WisdomFragment = {
    fragmentId : Nat;
    content : Text;
    applicability : [Text];      // When this wisdom applies
    extractedCount : Nat;        // Times this wisdom was applied
  };

  public type NarrativeSpan = {
    #Mythological;               // Timeless/primordial
    #Historical : { era : Text };
    #Contemporary;
    #Prophetic;
  };

  /// Mnemonic verse — memory aid encoded in rhythm
  public type MnemonicVerse = {
    verseId : Nat;
    content : Text;
    
    // What it encodes
    encodedData : EncodedDataType;
    dataReference : Text;        // What data this helps remember
    
    // Rhythmic structure
    syllablePattern : [Nat];     // Syllables per line
    rhymeScheme : Text;          // e.g., "ABAB", "AABB"
    meter : Text;                // e.g., "iambic pentameter"
    
    // Effectiveness
    recallAccuracy : Float;      // [0, 1] measured recall accuracy
    lastTested : Nat;
    testCount : Nat;
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type EncodedDataType = {
    #Sequence;                   // Ordered list
    #Formula;                    // Mathematical relationship
    #Procedure;                  // Step-by-step process
    #Categories;                 // Classification system
    #Dates;                      // Temporal data
    #Names;                      // Proper nouns
    #Concepts;                   // Abstract ideas
  };

  /// Proverb memory — compressed wisdom
  public type ProverbMemory = {
    proverbId : Nat;
    content : Text;
    
    // Interpretation
    literalMeaning : Text;
    deepMeaning : Text;
    applicationDomains : [Text];
    
    // Usage patterns
    triggerConditions : [TriggerCondition];
    lastTriggered : Nat;
    triggerCount : Nat;
    
    // Lineage
    origin : ?Text;
    variants : [Text];
    
    // Compression metrics
    wisdomDensity : Float;       // Meaning per word
    universality : Float;        // [0, 1] how broadly applicable
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type TriggerCondition = {
    conditionType : Text;
    threshold : Float;
    matchPattern : Text;
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    A) STRUCTURAL FORMS — MEMORY TYPES                  ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Calendar memory — temporal organization system
  public type CalendarMemory = {
    calendarId : Nat;
    name : Text;
    
    // Structure
    cycleType : CycleType;
    cycleLengthBeats : Nat;
    subdivisions : [CalendarSubdivision];
    
    // Alignments
    celestialAlignments : [CelestialAlignment];
    
    // Special days
    significantDays : [SignificantDay];
    
    // Synchronization
    syncPoint : { beat : Nat; realWorldReference : Text };
    driftCorrection : Float;     // Correction factor
    
    // Usage
    activeUse : Bool;
    lastSync : Nat;
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type CycleType = {
    #Solar;
    #Lunar;
    #Sidereal;
    #Synodic;
    #Custom : { description : Text };
  };

  public type CalendarSubdivision = {
    name : Text;
    lengthBeats : Nat;
    position : Nat;              // Position in parent cycle
  };

  public type CelestialAlignment = {
    body : CelestialBody;
    alignmentType : AlignmentType;
    beatInCycle : Nat;
  };

  public type CelestialBody = {
    #Sun;
    #Moon;
    #Mercury;
    #Venus;
    #Mars;
    #Jupiter;
    #Saturn;
    #Star : { name : Text };
    #Constellation : { name : Text };
  };

  public type AlignmentType = {
    #Rise;
    #Set;
    #Zenith;
    #Conjunction;
    #Opposition;
    #Equinox;
    #Solstice;
    #Custom : { description : Text };
  };

  public type SignificantDay = {
    name : Text;
    beatInCycle : Nat;
    significance : Text;
    rituals : [Nat];             // LiturgyMemory IDs
  };

  /// Ritual cycle memory — periodic behavioral pattern
  public type RitualCycleMemory = {
    cycleId : Nat;
    name : Text;
    
    // Cycle definition
    periodBeats : Nat;
    phases : [RitualPhase];
    
    // State tracking
    currentPhase : Nat;
    lastPhaseChange : Nat;
    cycleCount : Nat;            // Completed cycles
    
    // Binding
    boundCalendar : ?Nat;        // CalendarMemory ID if bound
    boundLiturgies : [Nat];      // LiturgyMemory IDs
    
    // Effectiveness
    completionRate : Float;      // [0, 1]
    coherenceGain : Float;       // Average coherence gain per cycle
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type RitualPhase = {
    phaseId : Nat;
    name : Text;
    durationBeats : Nat;
    actions : [Text];
    requiredState : PhaseRequirement;
    resultingState : PhaseResult;
  };

  public type PhaseRequirement = {
    minCoherence : Float;
    minEnergy : Float;
    otherConditions : [Text];
  };

  public type PhaseResult = {
    expectedCoherenceChange : Float;
    expectedEnergyChange : Float;
    stateTransitions : [Text];
  };

  /// Architecture alignment memory — spatial-celestial relationship
  public type ArchitectureAlignmentMemory = {
    alignmentId : Nat;
    name : Text;
    
    // Location
    coordinates : { lat : Float; lon : Float; alt : Float };
    
    // Structure
    structureType : StructureType;
    orientationDegrees : Float;  // Degrees from true north
    
    // Alignments
    primaryAlignment : CelestialAlignment;
    secondaryAlignments : [CelestialAlignment];
    geometricProportions : [GeometricProportion];
    
    // Field properties
    measuredFieldStrength : Float;
    resonanceFrequency : Float;
    harmonicProfile : [Float];
    
    // Temporal
    optimalVisitTimes : [{ beatInYear : Nat; reason : Text }];
    lastVisit : Nat;
    visitCount : Nat;
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type StructureType = {
    #Temple;
    #Pyramid;
    #StoneCircle;
    #Mound;
    #Altar;
    #Observatory;
    #Sanctuary;
    #NaturalFormation;
    #Custom : { description : Text };
  };

  public type GeometricProportion = {
    name : Text;
    ratio : Float;
    location : Text;             // Where in structure
    significance : Text;
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    A) SYMBOLIC FORMS — MEMORY TYPES                    ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Glyph memory — visual encoding unit
  public type GlyphMemory = {
    glyphId : Nat;
    name : Text;
    
    // Visual representation
    unicodeRepresentation : ?Text;
    vectorPath : ?Text;          // SVG path or similar
    bitmapHash : ?Nat32;         // Hash of bitmap if stored separately
    
    // Meaning
    primaryMeaning : Text;
    secondaryMeanings : [Text];
    contextualMeanings : [(Text, Text)]; // (context, meaning)
    
    // Combinatorics
    canCombineWith : [Nat];      // Other glyph IDs
    combinationRules : [CombinationRule];
    
    // Origin
    tradition : ?Text;
    era : ?Text;
    
    // Usage
    lastUsed : Nat;
    useCount : Nat;
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type CombinationRule = {
    partnerGlyphId : Nat;
    resultingMeaning : Text;
    position : CombinePosition;
  };

  public type CombinePosition = {
    #Before;
    #After;
    #Above;
    #Below;
    #Superimposed;
    #Nested;
  };

  /// Motif memory — recurring pattern signature
  public type MotifMemory = {
    motifId : Nat;
    name : Text;
    
    // Pattern definition
    patternType : PatternType;
    patternData : Text;          // Encoded pattern
    
    // Recognition
    signatureVector : [Float];   // Feature vector for recognition
    recognitionThreshold : Float;
    
    // Occurrences
    knownOccurrences : [MotifOccurrence];
    occurrenceCount : Nat;
    
    // Meaning
    associatedMeanings : [Text];
    strengthOfAssociation : [Float];
    
    // Temporal distribution
    firstKnownOccurrence : ?Nat;
    lastKnownOccurrence : ?Nat;
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type PatternType = {
    #Visual;
    #Auditory;
    #Temporal;
    #Spatial;
    #Behavioral;
    #Numerical;
    #Linguistic;
  };

  public type MotifOccurrence = {
    occurrenceId : Nat;
    location : Text;
    beat : Nat;
    confidence : Float;
    context : Text;
  };

  /// Geometric canon memory — sacred proportion set
  public type GeometricCanonMemory = {
    canonId : Nat;
    name : Text;
    
    // Proportions
    proportions : [CanonProportion];
    
    // Relationships
    derivedFrom : [Nat];         // Other canon IDs
    derives : [Nat];             // Canons derived from this
    
    // Applications
    applicationDomains : [GeometricDomain];
    
    // Verification
    mathematicalProof : ?Text;
    empiricalVerifications : Nat;
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type CanonProportion = {
    name : Text;
    ratio : Float;
    symbolicMeaning : Text;
    physicalManifestation : ?Text;
  };

  public type GeometricDomain = {
    #Architecture;
    #Music;
    #Art;
    #Nature;
    #Mathematics;
    #Astronomy;
    #FieldResonance;
    #BodyProportions;
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    A) EVENT FORMS — MEMORY TYPES                       ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Event memory — incident/outcome history
  public type EventMemory = {
    eventId : Nat;
    
    // Core encoding: event + phase + place + field-state + doctrine-state
    encoding : EventEncoding;
    
    // Description
    title : Text;
    description : Text;
    
    // Classification
    eventType : EventType;
    severity : EventSeverity;
    
    // Causal chain
    causes : [Nat];              // Other event IDs
    effects : [Nat];             // Other event IDs
    
    // Participants
    participants : [Text];
    affectedEntities : [Text];
    
    // Outcome
    outcome : EventOutcome;
    lessonsLearned : [Text];
    
    // Pattern matching
    similarEvents : [Nat];
    patternSignature : [Float];
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  /// Core event encoding structure
  public type EventEncoding = {
    // Event itself
    eventSignature : Nat32;      // Hash of event
    
    // Phase — where in cycles
    dailyCyclePhase : Float;     // [0, 1] position in day
    seasonalCyclePhase : Float;  // [0, 1] position in season
    longCyclePhase : Float;      // [0, 1] position in year
    missionCyclePhase : Float;   // [0, 1] position in mission
    
    // Place
    location : ?{ lat : Float; lon : Float };
    domainLocation : Text;       // Logical location (e.g., "finance", "health")
    
    // Field state at time of event
    fieldState : FieldState;
    
    // Doctrine state at time of event
    doctrineState : DoctrineState;
  };

  public type FieldState = {
    globalCoherence : Float;
    localCoherence : Float;
    resonanceLevel : Float;
    interferenceLevel : Float;
    fieldVector : [Float];       // Field direction/strength
  };

  public type DoctrineState = {
    activeDoctrines : [Text];
    doctrineStrengths : [Float];
    constitutionHash : Nat32;
    lawComplianceLevel : Float;
  };

  public type EventType = {
    #Creation;
    #Destruction;
    #Transformation;
    #Discovery;
    #Conflict;
    #Resolution;
    #Anomaly;
    #Milestone;
    #Failure;
    #Success;
    #Transition;
    #External;
    #Internal;
  };

  public type EventSeverity = {
    #Trivial;
    #Minor;
    #Moderate;
    #Significant;
    #Major;
    #Critical;
    #Catastrophic;
  };

  public type EventOutcome = {
    outcomeType : OutcomeType;
    coherenceChange : Float;
    stateChanges : [Text];
    resourceChanges : [ResourceChange];
  };

  public type OutcomeType = {
    #Positive;
    #Negative;
    #Neutral;
    #Mixed;
    #Unknown;
  };

  public type ResourceChange = {
    resourceType : Text;
    changeAmount : Float;
    changePercent : Float;
  };

  /// Lineage memory — genealogical trajectory
  public type LineageMemory = {
    lineageId : Nat;
    name : Text;
    
    // Lineage structure
    nodes : [LineageNode];
    edges : [LineageEdge];       // Parent-child relationships
    
    // Temporal span
    originBeat : Nat;
    currentGeneration : Nat;
    
    // Characteristics
    inheritedTraits : [InheritedTrait];
    mutationHistory : [LineMutation];
    
    // Pattern analysis
    recurringPatterns : [Nat];   // MotifMemory IDs
    generationalCycles : [Nat];  // Cycle lengths
    
    createdBeat : Nat;
    relevance : Float;
    archived : Bool;
  };

  public type LineageNode = {
    nodeId : Nat;
    name : Text;
    generation : Nat;
    birthBeat : Nat;
    deathBeat : ?Nat;
    traits : [Text];
    achievements : [Nat];        // EventMemory IDs
    eventIds : [Nat];            // Associated events
  };

  public type LineageEdge = {
    parentId : Nat;
    childId : Nat;
    relationshipType : RelationshipType;
    inheritanceStrength : Float; // [0, 1]
  };

  public type RelationshipType = {
    #Biological;
    #Adopted;
    #Mentorship;
    #Succession;
    #Spiritual;
    #Institutional;
  };

  public type InheritedTrait = {
    traitName : Text;
    inheritanceRate : Float;     // [0, 1] how often inherited
    mutationRate : Float;        // [0, 1] how often mutates
    dominance : Float;           // [0, 1] expression strength
  };

  public type LineMutation = {
    generation : Nat;
    traitAffected : Text;
    mutationType : MutationType;
    description : Text;
  };

  public type MutationType = {
    #Enhancement;
    #Degradation;
    #NewTrait;
    #LostTrait;
    #Combination;
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    B) ENCODING — GRAPH + WAVEFORM                      ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Memory graph node
  public type MemoryGraphNode = {
    nodeId : Nat;
    nodeType : MemoryNodeType;
    memoryId : Nat;              // ID in respective memory array
    
    // Position in semantic space
    semanticVector : [Float];    // Embedding
    
    // Waveform representation
    waveform : ?WaveformData;
    
    // Temporal
    createdBeat : Nat;
    lastAccessedBeat : Nat;
    accessCount : Nat;
    
    // Relevance (NO-DROP: never goes to zero, transforms instead)
    currentRelevance : Float;    // [ε, 1] — never zero
    peakRelevance : Float;       // Historical peak
    relevanceHistory : [Float];  // Recent history
    
    // Archival status
    archived : Bool;
    archivalBeat : ?Nat;
    latentPatternValue : Float;  // Value as minority path memory
  };

  public type MemoryNodeType = {
    // Oral
    #Chant;
    #Liturgy;
    #Epic;
    #MnemonicVerse;
    #Proverb;
    // Structural
    #Calendar;
    #RitualCycle;
    #ArchitectureAlignment;
    // Symbolic
    #Glyph;
    #Motif;
    #GeometricCanon;
    // Event
    #Event;
    #Lineage;
  };

  /// Memory graph edge
  public type MemoryGraphEdge = {
    edgeId : Nat;
    sourceNodeId : Nat;
    targetNodeId : Nat;
    
    // Relationship
    edgeType : MemoryEdgeType;
    strength : Float;            // [0, 1]
    
    // Temporal
    createdBeat : Nat;
    lastActivatedBeat : Nat;
    activationCount : Nat;
    
    // Hebbian
    hebbianWeight : Float;       // Strengthened by co-activation
    decayRate : Float;           // How fast it weakens
  };

  public type MemoryEdgeType = {
    #Causal;                     // A caused B
    #Temporal;                   // A happened before B
    #Semantic;                   // A is related to B in meaning
    #Structural;                 // A contains B
    #Derived;                    // B derived from A
    #Contrasts;                  // A and B are opposites
    #Reinforces;                 // A strengthens B
    #Triggers;                   // A activates B
  };

  /// Waveform data for memory encoding
  public type WaveformData = {
    // Time domain
    samples : [Float];           // Amplitude samples
    sampleRate : Float;          // Samples per beat
    duration : Nat;              // Total beats
    
    // Frequency domain
    fundamentalFrequency : Float;
    harmonics : [HarmonicComponent];
    
    // Phase information
    phaseOffset : Float;         // Initial phase
    phaseCoherence : Float;      // How stable phase is
    
    // Energy
    totalEnergy : Float;
    energyDistribution : [Float]; // Energy per frequency band
  };

  public type HarmonicComponent = {
    frequency : Float;
    amplitude : Float;
    phase : Float;
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    C) NO-DROP MEMORY RULE                              ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Relevance transformation (instead of deletion)
  public type RelevanceTransform = {
    nodeId : Nat;
    previousRelevance : Float;
    newRelevance : Float;
    transformType : TransformType;
    beat : Nat;
    reason : Text;
  };

  public type TransformType = {
    #Decay;                      // Natural decay over time
    #Archival;                   // Move to latent storage
    #Resurrection;               // Bring back from latent
    #Reinforcement;              // Strengthen through use
    #Contradiction;              // Weakened by contradicting evidence
    #Obsolescence;               // Superseded by newer memory
  };

  /// Minority path preservation
  public type MinorityPath = {
    pathId : Nat;
    nodeSequence : [Nat];        // Node IDs in path
    
    // Why it's minority
    divergencePoint : Nat;       // Where it diverged from majority
    divergenceReason : Text;
    
    // Value
    potentialValue : Float;      // Estimated future value
    uniqueInsights : [Text];     // What this path offers
    
    // Status
    status : MinorityPathStatus;
    preservationReason : Text;
    
    createdBeat : Nat;
    lastEvaluatedBeat : Nat;
  };

  public type MinorityPathStatus = {
    #Active;                     // Still being explored
    #Latent;                     // Preserved but not active
    #Resurrected;                // Brought back from latent
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    MEMORY TEMPLE STATE                                 ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Main state for Memory Temple
  public type MemoryTempleState = {
    // Oral memories
    chants : [ChantMemory];
    liturgies : [LiturgyMemory];
    epics : [EpicMemory];
    mnemonicVerses : [MnemonicVerse];
    proverbs : [ProverbMemory];
    
    // Structural memories
    calendars : [CalendarMemory];
    ritualCycles : [RitualCycleMemory];
    architectureAlignments : [ArchitectureAlignmentMemory];
    
    // Symbolic memories
    glyphs : [GlyphMemory];
    motifs : [MotifMemory];
    geometricCanons : [GeometricCanonMemory];
    
    // Event memories
    events : [EventMemory];
    lineages : [LineageMemory];
    
    // Graph structure
    graphNodes : [MemoryGraphNode];
    graphEdges : [MemoryGraphEdge];
    
    // No-drop tracking
    relevanceTransforms : [RelevanceTransform];
    minorityPaths : [MinorityPath];
    
    // Metrics
    totalMemories : Nat;
    activeMemories : Nat;
    archivedMemories : Nat;
    
    // Indices
    nextChantId : Nat;
    nextLiturgyId : Nat;
    nextEpicId : Nat;
    nextVerseId : Nat;
    nextProverbId : Nat;
    nextCalendarId : Nat;
    nextCycleId : Nat;
    nextAlignmentId : Nat;
    nextGlyphId : Nat;
    nextMotifId : Nat;
    nextCanonId : Nat;
    nextEventId : Nat;
    nextLineageId : Nat;
    nextNodeId : Nat;
    nextEdgeId : Nat;
    nextPathId : Nat;
    
    // Temporal
    currentBeat : Nat;
    lastCleanupBeat : Nat;
    
    // Global coherence
    memoryCoherence : Float;
    graphConnectivity : Float;
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    INITIALIZATION                                      ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Initialize empty Memory Temple
  public func initMemoryTemple() : MemoryTempleState {
    {
      chants = [];
      liturgies = [];
      epics = [];
      mnemonicVerses = [];
      proverbs = [];
      
      calendars = [];
      ritualCycles = [];
      architectureAlignments = [];
      
      glyphs = [];
      motifs = [];
      geometricCanons = [];
      
      events = [];
      lineages = [];
      
      graphNodes = [];
      graphEdges = [];
      
      relevanceTransforms = [];
      minorityPaths = [];
      
      totalMemories = 0;
      activeMemories = 0;
      archivedMemories = 0;
      
      nextChantId = 0;
      nextLiturgyId = 0;
      nextEpicId = 0;
      nextVerseId = 0;
      nextProverbId = 0;
      nextCalendarId = 0;
      nextCycleId = 0;
      nextAlignmentId = 0;
      nextGlyphId = 0;
      nextMotifId = 0;
      nextCanonId = 0;
      nextEventId = 0;
      nextLineageId = 0;
      nextNodeId = 0;
      nextEdgeId = 0;
      nextPathId = 0;
      
      currentBeat = 0;
      lastCleanupBeat = 0;
      
      memoryCoherence = 1.0;
      graphConnectivity = 0.0;
    }
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    MEMORY INGESTION                                    ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Add chant memory
  public func addChant(state : MemoryTempleState, chant : ChantMemory) : MemoryTempleState {
    let newChant = { chant with chantId = state.nextChantId };
    let newChants = Array.append(state.chants, [newChant]);
    
    // Create graph node
    let node = createGraphNode(state.nextNodeId, #Chant, state.nextChantId, state.currentBeat);
    let newNodes = Array.append(state.graphNodes, [node]);
    
    {
      state with
      chants = newChants;
      graphNodes = newNodes;
      nextChantId = state.nextChantId + 1;
      nextNodeId = state.nextNodeId + 1;
      totalMemories = state.totalMemories + 1;
      activeMemories = state.activeMemories + 1;
    }
  };

  /// Add event memory
  public func addEvent(state : MemoryTempleState, event : EventMemory) : MemoryTempleState {
    let newEvent = { event with eventId = state.nextEventId };
    let newEvents = Array.append(state.events, [newEvent]);
    
    // Create graph node
    let node = createGraphNode(state.nextNodeId, #Event, state.nextEventId, state.currentBeat);
    let newNodes = Array.append(state.graphNodes, [node]);
    
    {
      state with
      events = newEvents;
      graphNodes = newNodes;
      nextEventId = state.nextEventId + 1;
      nextNodeId = state.nextNodeId + 1;
      totalMemories = state.totalMemories + 1;
      activeMemories = state.activeMemories + 1;
    }
  };

  /// Add proverb memory
  public func addProverb(state : MemoryTempleState, proverb : ProverbMemory) : MemoryTempleState {
    let newProverb = { proverb with proverbId = state.nextProverbId };
    let newProverbs = Array.append(state.proverbs, [newProverb]);
    
    let node = createGraphNode(state.nextNodeId, #Proverb, state.nextProverbId, state.currentBeat);
    let newNodes = Array.append(state.graphNodes, [node]);
    
    {
      state with
      proverbs = newProverbs;
      graphNodes = newNodes;
      nextProverbId = state.nextProverbId + 1;
      nextNodeId = state.nextNodeId + 1;
      totalMemories = state.totalMemories + 1;
      activeMemories = state.activeMemories + 1;
    }
  };

  /// Create a graph node
  func createGraphNode(nodeId : Nat, nodeType : MemoryNodeType, memoryId : Nat, beat : Nat) : MemoryGraphNode {
    {
      nodeId = nodeId;
      nodeType = nodeType;
      memoryId = memoryId;
      semanticVector = [];        // Would be filled by embedding
      waveform = null;
      createdBeat = beat;
      lastAccessedBeat = beat;
      accessCount = 0;
      currentRelevance = 1.0;     // Start at full relevance
      peakRelevance = 1.0;
      relevanceHistory = [1.0];
      archived = false;
      archivalBeat = null;
      latentPatternValue = 0.0;
    }
  };

  /// Create a graph edge
  public func createEdge(
    state : MemoryTempleState,
    sourceId : Nat,
    targetId : Nat,
    edgeType : MemoryEdgeType,
    strength : Float
  ) : MemoryTempleState {
    let edge : MemoryGraphEdge = {
      edgeId = state.nextEdgeId;
      sourceNodeId = sourceId;
      targetNodeId = targetId;
      edgeType = edgeType;
      strength = strength;
      createdBeat = state.currentBeat;
      lastActivatedBeat = state.currentBeat;
      activationCount = 0;
      hebbianWeight = 0.1;
      decayRate = 0.001;
    };
    
    let newEdges = Array.append(state.graphEdges, [edge]);
    
    {
      state with
      graphEdges = newEdges;
      nextEdgeId = state.nextEdgeId + 1;
    }
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    NO-DROP OPERATIONS                                  ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Transform relevance (never delete)
  public func transformRelevance(
    state : MemoryTempleState,
    nodeId : Nat,
    newRelevance : Float,
    transformType : TransformType,
    reason : Text
  ) : MemoryTempleState {
    // Find and update the node
    let updatedNodes = Array.map<MemoryGraphNode, MemoryGraphNode>(state.graphNodes, func (node) {
      if (node.nodeId == nodeId) {
        let prevRelevance = node.currentRelevance;
        // Ensure relevance never goes below epsilon
        let safeRelevance = Float.max(0.001, newRelevance);
        
        // Record the transform
        let transform : RelevanceTransform = {
          nodeId = nodeId;
          previousRelevance = prevRelevance;
          newRelevance = safeRelevance;
          transformType = transformType;
          beat = state.currentBeat;
          reason = reason;
        };
        
        {
          node with
          currentRelevance = safeRelevance;
          relevanceHistory = Array.append(node.relevanceHistory, [safeRelevance]);
          archived = safeRelevance < 0.1;
          archivalBeat = if (safeRelevance < 0.1 and not node.archived) { ?state.currentBeat } else { node.archivalBeat };
          latentPatternValue = if (safeRelevance < 0.1) { calculateLatentValue(node) } else { node.latentPatternValue };
        }
      } else {
        node
      }
    });
    
    // Count active vs archived
    var activeCount = 0;
    var archivedCount = 0;
    for (node in updatedNodes.vals()) {
      if (node.archived) { archivedCount += 1 } else { activeCount += 1 };
    };
    
    {
      state with
      graphNodes = updatedNodes;
      activeMemories = activeCount;
      archivedMemories = archivedCount;
    }
  };

  /// Calculate latent value for archived memory
  func calculateLatentValue(node : MemoryGraphNode) : Float {
    // Value based on:
    // - Historical peak relevance
    // - Access frequency
    // - Uniqueness (not implemented here)
    let peakValue = node.peakRelevance * 0.3;
    let accessValue = Float.min(1.0, Float.fromInt(node.accessCount) / 100.0) * 0.3;
    let ageValue = 0.4;  // Older memories have potential value
    
    peakValue + accessValue + ageValue
  };

  /// Preserve minority path
  public func preserveMinorityPath(
    state : MemoryTempleState,
    nodeSequence : [Nat],
    divergencePoint : Nat,
    reason : Text,
    potentialValue : Float,
    insights : [Text]
  ) : MemoryTempleState {
    let path : MinorityPath = {
      pathId = state.nextPathId;
      nodeSequence = nodeSequence;
      divergencePoint = divergencePoint;
      divergenceReason = reason;
      potentialValue = potentialValue;
      uniqueInsights = insights;
      status = #Latent;
      preservationReason = "Retained as minority path memory";
      createdBeat = state.currentBeat;
      lastEvaluatedBeat = state.currentBeat;
    };
    
    let newPaths = Array.append(state.minorityPaths, [path]);
    
    {
      state with
      minorityPaths = newPaths;
      nextPathId = state.nextPathId + 1;
    }
  };

  /// Resurrect archived memory
  public func resurrectMemory(
    state : MemoryTempleState,
    nodeId : Nat,
    newRelevance : Float,
    reason : Text
  ) : MemoryTempleState {
    transformRelevance(state, nodeId, newRelevance, #Resurrection, reason)
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    MEMORY ACCESS & SEARCH                              ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Access a memory (updates access count, strengthens relevance)
  public func accessMemory(state : MemoryTempleState, nodeId : Nat) : MemoryTempleState {
    let updatedNodes = Array.map<MemoryGraphNode, MemoryGraphNode>(state.graphNodes, func (node) {
      if (node.nodeId == nodeId) {
        let newRelevance = Float.min(1.0, node.currentRelevance * 1.1);  // Boost by 10%
        {
          node with
          lastAccessedBeat = state.currentBeat;
          accessCount = node.accessCount + 1;
          currentRelevance = newRelevance;
          peakRelevance = Float.max(node.peakRelevance, newRelevance);
        }
      } else {
        node
      }
    });
    
    {
      state with
      graphNodes = updatedNodes;
    }
  };

  /// Find memories by type
  public func findByType(state : MemoryTempleState, nodeType : MemoryNodeType) : [MemoryGraphNode] {
    Array.filter<MemoryGraphNode>(state.graphNodes, func (node) {
      node.nodeType == nodeType and not node.archived
    })
  };

  /// Find connected memories
  public func findConnected(state : MemoryTempleState, nodeId : Nat) : [MemoryGraphNode] {
    // Find all edges containing this node
    let connectedIds = Buffer.Buffer<Nat>(10);
    
    for (edge in state.graphEdges.vals()) {
      if (edge.sourceNodeId == nodeId) {
        connectedIds.add(edge.targetNodeId);
      } else if (edge.targetNodeId == nodeId) {
        connectedIds.add(edge.sourceNodeId);
      };
    };
    
    // Get the nodes
    let ids = Buffer.toArray(connectedIds);
    Array.filter<MemoryGraphNode>(state.graphNodes, func (node) {
      Array.find<Nat>(ids, func (id) { id == node.nodeId }) != null
    })
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    CYCLE-BASED INDEXING                                ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Get daily cycle phase
  public func getDailyCyclePhase(beat : Nat) : Float {
    Float.fromInt(beat % DAILY_CYCLE) / Float.fromInt(DAILY_CYCLE)
  };

  /// Get seasonal cycle phase
  public func getSeasonalCyclePhase(beat : Nat) : Float {
    Float.fromInt(beat % SEASONAL_CYCLE) / Float.fromInt(SEASONAL_CYCLE)
  };

  /// Get long cycle phase
  public func getLongCyclePhase(beat : Nat) : Float {
    Float.fromInt(beat % LONG_CYCLE) / Float.fromInt(LONG_CYCLE)
  };

  /// Get mission cycle phase
  public func getMissionCyclePhase(beat : Nat) : Float {
    Float.fromInt(beat % MISSION_CYCLE) / Float.fromInt(MISSION_CYCLE)
  };

  /// Find events at similar cycle phases
  public func findSimilarPhaseEvents(
    state : MemoryTempleState,
    targetPhases : { daily : Float; seasonal : Float; longCycle : Float },
    tolerance : Float
  ) : [EventMemory] {
    Array.filter<EventMemory>(state.events, func (event) {
      let dailyMatch = Float.abs(event.encoding.dailyCyclePhase - targetPhases.daily) < tolerance;
      let seasonalMatch = Float.abs(event.encoding.seasonalCyclePhase - targetPhases.seasonal) < tolerance;
      let longMatch = Float.abs(event.encoding.longCyclePhase - targetPhases.longCycle) < tolerance;
      
      dailyMatch and seasonalMatch and longMatch
    })
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    HEBBIAN LEARNING                                    ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Strengthen edge through co-activation
  public func hebbianStrengthen(
    state : MemoryTempleState,
    edgeId : Nat,
    amount : Float
  ) : MemoryTempleState {
    let updatedEdges = Array.map<MemoryGraphEdge, MemoryGraphEdge>(state.graphEdges, func (edge) {
      if (edge.edgeId == edgeId) {
        {
          edge with
          strength = Float.min(1.0, edge.strength + amount);
          hebbianWeight = Float.min(1.0, edge.hebbianWeight + amount * 0.5);
          lastActivatedBeat = state.currentBeat;
          activationCount = edge.activationCount + 1;
        }
      } else {
        edge
      }
    });
    
    {
      state with
      graphEdges = updatedEdges;
    }
  };

  /// Apply decay to all edges
  public func applyEdgeDecay(state : MemoryTempleState) : MemoryTempleState {
    let updatedEdges = Array.map<MemoryGraphEdge, MemoryGraphEdge>(state.graphEdges, func (edge) {
      let beatsSinceActivation = state.currentBeat - edge.lastActivatedBeat;
      let decay = Float.fromInt(beatsSinceActivation) * edge.decayRate;
      let newStrength = Float.max(0.01, edge.strength - decay);  // Never fully decay
      
      { edge with strength = newStrength }
    });
    
    {
      state with
      graphEdges = updatedEdges;
    }
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    MAIN TICK FUNCTION                                  ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Main tick for Memory Temple
  public func tickMemoryTemple(
    state : MemoryTempleState,
    currentBeat : Nat
  ) : MemoryTempleState {
    var newState = { state with currentBeat = currentBeat };
    
    // Apply natural relevance decay every 1000 beats
    if (currentBeat > state.lastCleanupBeat + 1000) {
      newState := applyRelevanceDecay(newState);
      newState := applyEdgeDecay(newState);
      newState := { newState with lastCleanupBeat = currentBeat };
    };
    
    // Calculate memory coherence
    let coherence = calculateMemoryCoherence(newState);
    let connectivity = calculateGraphConnectivity(newState);
    
    { newState with memoryCoherence = coherence; graphConnectivity = connectivity }
  };

  /// Apply natural decay to all memories
  func applyRelevanceDecay(state : MemoryTempleState) : MemoryTempleState {
    let updatedNodes = Array.map<MemoryGraphNode, MemoryGraphNode>(state.graphNodes, func (node) {
      if (not node.archived) {
        let beatsSinceAccess = state.currentBeat - node.lastAccessedBeat;
        let decayFactor = Float.fromInt(beatsSinceAccess) / Float.fromInt(LONG_CYCLE);
        let decay = decayFactor * 0.01;  // Very slow decay
        let newRelevance = Float.max(0.001, node.currentRelevance - decay);
        
        { 
          node with 
          currentRelevance = newRelevance;
          archived = newRelevance < 0.1;
          archivalBeat = if (newRelevance < 0.1 and not node.archived) { ?state.currentBeat } else { node.archivalBeat };
        }
      } else {
        node
      }
    });
    
    // Count active vs archived
    var activeCount = 0;
    var archivedCount = 0;
    for (node in updatedNodes.vals()) {
      if (node.archived) { archivedCount += 1 } else { activeCount += 1 };
    };
    
    {
      state with
      graphNodes = updatedNodes;
      activeMemories = activeCount;
      archivedMemories = archivedCount;
    }
  };

  /// Calculate memory coherence
  func calculateMemoryCoherence(state : MemoryTempleState) : Float {
    if (state.graphNodes.size() == 0) { return 1.0 };
    
    var totalRelevance = 0.0;
    for (node in state.graphNodes.vals()) {
      if (not node.archived) {
        totalRelevance := totalRelevance + node.currentRelevance;
      };
    };
    
    let divisor = Float.max(1.0, Float.fromInt(state.activeMemories));
    totalRelevance / divisor
  };

  /// Calculate graph connectivity
  func calculateGraphConnectivity(state : MemoryTempleState) : Float {
    if (state.graphNodes.size() < 2) { return 0.0 };
    
    let nodeCount = Float.fromInt(state.graphNodes.size());
    let edgeCount = Float.fromInt(state.graphEdges.size());
    let maxEdges = nodeCount * (nodeCount - 1.0) / 2.0;
    
    if (maxEdges == 0.0) { return 0.0 };
    
    Float.min(1.0, edgeCount / maxEdges * 10.0)  // Scaled connectivity
  };

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    QUERY FUNCTIONS                                     ║
  // ╚════════════════════════════════════════════════════════════════════════╝

  /// Get Memory Temple summary
  public func getMemoryTempleSummary(state : MemoryTempleState) : {
    totalMemories : Nat;
    activeMemories : Nat;
    archivedMemories : Nat;
    chantCount : Nat;
    eventCount : Nat;
    graphNodes : Nat;
    graphEdges : Nat;
    minorityPaths : Nat;
    memoryCoherence : Float;
    graphConnectivity : Float;
  } {
    {
      totalMemories = state.totalMemories;
      activeMemories = state.activeMemories;
      archivedMemories = state.archivedMemories;
      chantCount = state.chants.size();
      eventCount = state.events.size();
      graphNodes = state.graphNodes.size();
      graphEdges = state.graphEdges.size();
      minorityPaths = state.minorityPaths.size();
      memoryCoherence = state.memoryCoherence;
      graphConnectivity = state.graphConnectivity;
    }
  };

}
