  // SECTION XI: FUNCTIONS — USING THE PHI ARCHITECTURE
  // ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
  
  /// Calculate frequency at phi power n above Schumann
  public func phiFrequency(phiPower : Int) : Float {
    if (phiPower >= 0) {
      BRAIN_HZ * Float.pow(PHI, Float.fromInt(phiPower))
    } else {
      BRAIN_HZ / Float.pow(PHI, Float.fromInt(-phiPower))
    }
  };
  
  /// Calculate temporal interval at phi power n above Schumann period
  public func phiInterval(phiPower : Int) : Float {
    if (phiPower >= 0) {
      SCHUMANN_PERIOD_MS * Float.pow(PHI, Float.fromInt(phiPower))
    } else {
      SCHUMANN_PERIOD_MS / Float.pow(PHI, Float.fromInt(-phiPower))
    }
  };
  
  /// Get the phi power for a given frequency
  public func getPhiPower(frequencyHz : Float) : Float {
    // φⁿ = freq / 7.83
    // n = log_φ(freq / 7.83) = ln(freq / 7.83) / ln(φ)
    let ratio = frequencyHz / BRAIN_HZ;
    let lnPhi = 0.4812118250596034475;  // ln(φ)
    Float.log(ratio) / lnPhi
  };
  
  /// Check if a frequency is on the phi ladder (within tolerance)
  public func isOnPhiLadder(frequencyHz : Float, tolerance : Float) : (Bool, Int) {
    let phiPower = getPhiPower(frequencyHz);
    let rounded = Float.toInt(phiPower);
    let roundedF = Float.fromInt(rounded);
    
    if (Float.abs(phiPower - roundedF) < tolerance) {
      (true, rounded)
    } else {
      (false, 0)
    }
  };
  
  /// Get the nearest Fibonacci frequency boundary
  public func nearestFibonacciBoundary(frequencyHz : Float) : Float {
    var nearest : Float = 8.0;
    var minDist : Float = Float.abs(frequencyHz - 8.0);
    
    for (f in FIBONACCI_BRAIN_BOUNDARIES.vals()) {
      let dist = Float.abs(frequencyHz - f);
      if (dist < minDist) {
        minDist := dist;
        nearest := f;
      };
    };
    
    nearest
  };
  
  /// Calculate room dimension for target frequency
  public func dimensionForFrequency(targetHz : Float) : Float {
    SPEED_OF_SOUND / (2.0 * targetHz)
  };
  
  /// Calculate frequency for room dimension
  public func frequencyForDimension(meters : Float) : Float {
    SPEED_OF_SOUND / (2.0 * meters)
  };
  
