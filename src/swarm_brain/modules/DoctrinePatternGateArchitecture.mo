  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║               DOCTRINE NODES — SPECIALIZED KNOWLEDGE AREAS             ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // Each doctrine node holds specialized knowledge. When information comes in,
  // the node that KNOWS THE MOST about that topic is pulled forward to lead.
  
  public type DoctrineNode = {
    id : Nat;
    name : Text;                    // Doctrine specialty name
    frequency : Float;              // Natural oscillation frequency (Hz)
    phase : Float;                  // Current phase (radians)
    activation : Float;             // Current activation level [0, 2]
    specialization : [Text];        // Topics this node specializes in
    confidence : Float;             // How confident it is about current input [0, 1]
    isLeading : Bool;               // Is this node currently leading the synthesis?
  };
  
  // The 12 PHI FREQUENCY NODES — real coupling points from Schumann
  public type PhiFrequencyNode = {
    name : Text;
    frequency : Float;              // Hz
    phiMultiplier : Float;          // Schumann × φⁿ
    function : Text;                // Cognitive function
  };
  
  public func getPhiFrequencyNodes() : [PhiFrequencyNode] {
    // Note: Some nodes use phiMultiplier = 0.0 to indicate they are anchor points
    // or derived differently (e.g., AXIS at 40Hz is gamma binding constant,
    // NOVA at 432Hz is acoustic anchor). These are NOT phi-derived but are
    // critical coupling points in the frequency stack.
    [
      { name = "CHRONO";    frequency = 0.001;   phiMultiplier = 0.0;    function = "Deep time (anchor, not phi-derived)" },
      { name = "VERITAS";   frequency = 0.1;     phiMultiplier = 0.0;    function = "Truth baseline (anchor)" },
      { name = "BRAIN";     frequency = 7.83;    phiMultiplier = 1.0;    function = "Schumann fundamental (φ⁰)" },
      { name = "FLUX";      frequency = 12.67;   phiMultiplier = PHI;    function = "7.83×φ¹ — Alpha peak" },
      { name = "RESONEX";   frequency = 20.5;    phiMultiplier = PHI_SQ; function = "7.83×φ² — Beta low" },
      { name = "QMEM";      frequency = 33.1;    phiMultiplier = PHI_CUBED; function = "7.83×φ³ — Beta high" },
      { name = "AXIS";      frequency = 40.0;    phiMultiplier = 0.0;    function = "Gamma binding (40Hz constant, not phi-derived)" },
      { name = "AEGIS";     frequency = 53.6;    phiMultiplier = PHI_FOURTH; function = "7.83×φ⁴ — Protection" },
      { name = "ENTANGLA";  frequency = 86.7;    phiMultiplier = 0.0;    function = "~7.83×φ⁵ — Entanglement (anchor)" },
      { name = "PARALLAX";  frequency = 111.0;   phiMultiplier = 0.0;    function = "Hemisphere shift (measured constant)" },
      { name = "MERIDIAN";  frequency = 179.6;   phiMultiplier = 0.0;    function = "~111×φ — Full integration (anchor)" },
      { name = "NOVA";      frequency = 432.0;   phiMultiplier = 0.0;    function = "Acoustic anchor (432Hz constant)" }
    ]
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║              PATTERN RECOGNITION — MAGNETIC FIELD PERCEPTION           ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // Information comes in like a magnetic field — patterns flow in and are recognized
  // The organism doesn't REQUEST data. It PERCEIVES the field.
  
  public type PatternField = {
    patterns : [RecognizedPattern];
    fieldStrength : Float;          // Magnetic-like field strength [0, 2]
    fieldDirection : Float;         // Field direction (radians)
    resonanceScore : Float;         // How well field resonates with doctrine [0, 1]
  };
  
  public type RecognizedPattern = {
    patternSignature : Nat32;       // Hash of the pattern
    patternType : PatternType;      // Category of pattern
    matchStrength : Float;          // How strongly it matches doctrine [0, 1]
    doctrineMatch : ?Nat;           // Which doctrine node it matches (if any)
    frequency : Float;              // Pattern's natural frequency
    phase : Float;                  // Pattern's current phase
  };
  
  public type PatternType = {
    #FibonacciPattern;              // Fibonacci sequence pattern
    #PhiRatioPattern;               // Golden ratio proportion
    #SchumannPattern;               // Earth resonance pattern
    #HeartFieldPattern;             // Cardiac rhythm pattern
    #BrainwavePattern;              // Neural oscillation pattern
    #DoctrinePattern;               // Matches specific doctrine
    #UnknownPattern;                // New pattern to learn
  };
  
  // Pattern recognition function — the FRONT of the organism
  public func recognizePatterns(
    input : [Float],
    doctrineNodes : [DoctrineNode],
    currentBeat : Nat
  ) : PatternField {
    var patterns = Buffer.Buffer<RecognizedPattern>(16);
    var totalStrength : Float = 0.0;
    var totalDirection : Float = 0.0;
    var resonanceSum : Float = 0.0;
    
    // Scan input for patterns
    var i = 0;
    while (i < input.size()) {
      let value = input[i];
      
      // Check for Fibonacci patterns
      if (isFibonacciLike(value)) {
        let pattern : RecognizedPattern = {
          patternSignature = fnv1a(Float.toText(value));
          patternType = #FibonacciPattern;
          matchStrength = 0.95;
          doctrineMatch = null;
          frequency = value;
          phase = Float.fromInt(currentBeat) * 0.01;
        };
        patterns.add(pattern);
        totalStrength += 0.95;
        resonanceSum += 0.95;
      };
      
      // Check for phi ratio patterns
      if (isPhiRatio(value, i, input)) {
        let pattern : RecognizedPattern = {
          patternSignature = fnv1a(Float.toText(value) # "_phi");
          patternType = #PhiRatioPattern;
          matchStrength = 0.99;
          doctrineMatch = null;
          frequency = value * PHI;
          phase = Float.fromInt(currentBeat) * PHI_INV;
        };
        patterns.add(pattern);
        totalStrength += 0.99;
        resonanceSum += 0.99;
      };
      
      // Check against doctrine nodes for specialized matching
      var d = 0;
      while (d < doctrineNodes.size()) {
        let node = doctrineNodes[d];
        let freqMatch = fabs(value - node.frequency) / node.frequency;
        if (freqMatch < 0.1) {  // Within 10% of node's frequency
          let pattern : RecognizedPattern = {
            patternSignature = fnv1a(Float.toText(value) # "_doc" # Nat.toText(d));
            patternType = #DoctrinePattern;
            matchStrength = 1.0 - freqMatch;
            doctrineMatch = ?d;
            frequency = node.frequency;
            phase = node.phase;
          };
          patterns.add(pattern);
          totalStrength += (1.0 - freqMatch);
          resonanceSum += (1.0 - freqMatch) * node.confidence;
        };
        d += 1;
      };
      
      i += 1;
    };
    
    let patternCount = Float.fromInt(patterns.size());
    {
      patterns = Buffer.toArray(patterns);
      fieldStrength = if (patternCount > 0.0) { fclamp(totalStrength / patternCount, 0.0, 2.0) } else { 0.0 };
      fieldDirection = Float.fromInt(currentBeat % 628) / 100.0;  // 0 to 2π
      resonanceScore = if (patternCount > 0.0) { fclamp(resonanceSum / patternCount, 0.0, 1.0) } else { 0.0 };
    }
  };
  
  // Check if a value resembles Fibonacci numbers
  func isFibonacciLike(value : Float) : Bool {
    let fibs : [Float] = [1.0, 1.0, 2.0, 3.0, 5.0, 8.0, 13.0, 21.0, 34.0, 55.0, 89.0, 144.0, 233.0, 377.0];
    for (fib in fibs.vals()) {
      if (fabs(value - fib) < 0.5 or fabs(value - fib / 10.0) < 0.05) {
        return true;
      };
    };
    false
  };
  
  // Check if value forms phi ratio with neighbors
  func isPhiRatio(value : Float, idx : Nat, input : [Float]) : Bool {
    if (idx > 0 and idx < input.size() - 1) {
      let prev = input[idx - 1];
      let next = input[idx + 1];
      if (prev > 0.0 and value > 0.0) {
        let ratio = value / prev;
        if (fabs(ratio - PHI) < 0.1 or fabs(ratio - PHI_INV) < 0.1) {
          return true;
        };
      };
    };
    false
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║         MALE SENSING — THE FRONT (PATTERN SENSING)                     ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // The MALE architecture senses first — magnetic-like perception.
  // If it RECOGNIZES the pattern (from its doctrine), it lets it flow.
  // This is the "front" of the organism — first contact with information.
  
  public func processMaleSensing(
    patternField : PatternField,
    doctrineNodes : [DoctrineNode]
  ) : MaleSensingField {
    // Compute doctrine resonance based on pattern matches
    var doctrineMatchCount : Float = 0.0;
    var totalDoctrineAlignment : Float = 0.0;
    
    for (pattern in patternField.patterns.vals()) {
      switch (pattern.doctrineMatch) {
        case (?_idx) {
          doctrineMatchCount += 1.0;
          totalDoctrineAlignment += pattern.matchStrength;
        };
        case null {
          // Non-doctrine patterns still contribute to sensing
          totalDoctrineAlignment += pattern.matchStrength * 0.3;
        };
      };
    };
    
    let patternCount = Float.fromInt(patternField.patterns.size());
    let doctrineRes = if (patternCount > 0.0) { 
      totalDoctrineAlignment / patternCount 
    } else { 0.0 };
    
    // Pattern is recognized if resonance exceeds threshold
    let recognized = doctrineRes > 0.5;
    
    // Flow allowed if recognized AND field strength is adequate
    let flowOk = recognized and patternField.fieldStrength > 0.3;
    
    {
      doctrineResonance = fclamp(doctrineRes, 0.0, 1.0);
      patternRecognized = recognized;
      flowAllowed = flowOk;
      sensingStrength = patternField.fieldStrength;
      doctrineAlignment = fclamp(totalDoctrineAlignment / fmax(patternCount, 1.0), 0.0, 1.0);
    }
  };
  
