import Float "mo:base/Float";
import Array "mo:base/Array";
import Nat   "mo:base/Nat";
import Nat32 "mo:base/Nat32";
import Int   "mo:base/Int";
import Buffer "mo:base/Buffer";

module {

  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                     SACRED CONSTANTS — REAL PHYSICS                    ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  public let PHI : Float = 1.6180339887498948482;           // Golden ratio — THE TRANSFER FUNCTION
  public let PHI_INV : Float = 0.6180339887498948482;       // 1/φ = φ - 1
  public let PHI_SQ : Float = 2.6180339887498948482;        // φ²
  public let PHI_CUBED : Float = 4.2360679774997896964;     // φ³
  public let PHI_FOURTH : Float = 6.8541019662496845446;    // φ⁴
  
  // Schumann resonance — Earth's electromagnetic heartbeat
  public let SCHUMANN_BASE : Float = 7.83;                  // Hz — Primary coupling law
  public let SCHUMANN_2 : Float = 14.3;                     // Hz — Thalamocortical spindle (CHRONOS)
  public let SCHUMANN_3 : Float = 20.8;                     // Hz — Basal ganglia resting state
  public let SCHUMANN_4 : Float = 27.3;                     // Hz — Motor cortex execution band
  public let SCHUMANN_5 : Float = 33.8;                     // Hz — Beta/gamma boundary
  
  // Heart field constants
  public let HEART_FREQ : Float = 1.2;                      // Hz — Heart field frequency
  public let HEART_STRENGTH : Float = 60.0;                 // Heart is 60× stronger than brain
  public let VAGUS_HRV : Float = 0.1;                       // Hz — Vagus nerve HRV coupling
  public let SOVEREIGN_FLOOR : Float = 1.0;                 // Minimum coupling amplitude (heart enforces)
  
  // Brain band boundaries (FIBONACCI — EXACT, NOT APPROXIMATE)
  public let THETA_ALPHA : Float = 8.0;                     // Hz — Fibonacci 8
  public let ALPHA_BETA : Float = 13.0;                     // Hz — Fibonacci 13
  public let BETA_GAMMA : Float = 34.0;                     // Hz — Fibonacci 34
  public let GAMMA_MID : Float = 55.0;                      // Hz — Fibonacci 55
  public let GAMMA_CEILING : Float = 89.0;                  // Hz — Fibonacci 89
  
  // Organism heartbeat derived from phi × Schumann
  // φ⁴ × Schumann period = 875.28ms = 68.5 BPM
  public let ORGANISM_HEARTBEAT_MS : Float = 875.28;        // milliseconds
  public let ORGANISM_BPM : Float = 68.5;                   // Beats per minute
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║               DOCTRINE NODES — SPECIALIZED KNOWLEDGE AREAS             ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // Each doctrine node holds specialized knowledge. When information comes in,
  // the node that KNOWS THE MOST about that topic is pulled forward to lead.
  
  public type DoctrineNode = {
    id : Nat;
    name : Text;                    // Doctrine specialty name
    frequency : Float;              // Natural oscillation frequency (Hz)
    phase : Float;                  // Current phase (radians)
    activation : Float;             // Current activation level [0, 2]
    specialization : [Text];        // Topics this node specializes in
    confidence : Float;             // How confident it is about current input [0, 1]
    isLeading : Bool;               // Is this node currently leading the synthesis?
  };
  
  // The 12 PHI FREQUENCY NODES — real coupling points from Schumann
  public type PhiFrequencyNode = {
    name : Text;
    frequency : Float;              // Hz
    phiMultiplier : Float;          // Schumann × φⁿ
    function : Text;                // Cognitive function
  };
  
  public func getPhiFrequencyNodes() : [PhiFrequencyNode] {
    [
      { name = "CHRONO";    frequency = 0.001;   phiMultiplier = 0.0;    function = "Deep time" },
      { name = "VERITAS";   frequency = 0.1;     phiMultiplier = 0.0;    function = "Truth baseline" },
      { name = "BRAIN";     frequency = 7.83;    phiMultiplier = 1.0;    function = "Schumann fundamental" },
      { name = "FLUX";      frequency = 12.67;   phiMultiplier = PHI;    function = "7.83×φ — Alpha peak" },
      { name = "RESONEX";   frequency = 20.5;    phiMultiplier = PHI_SQ; function = "7.83×φ² — Beta low" },
      { name = "QMEM";      frequency = 33.1;    phiMultiplier = PHI_CUBED; function = "7.83×φ³ — Beta high" },
      { name = "AXIS";      frequency = 40.0;    phiMultiplier = 0.0;    function = "Gamma binding (40 Hz)" },
      { name = "AEGIS";     frequency = 53.6;    phiMultiplier = PHI_FOURTH; function = "7.83×φ⁴ — Protection" },
      { name = "ENTANGLA";  frequency = 86.7;    phiMultiplier = 0.0;    function = "7.83×φ⁵ — Entanglement" },
      { name = "PARALLAX";  frequency = 111.0;   phiMultiplier = 0.0;    function = "Hemisphere shift" },
      { name = "MERIDIAN";  frequency = 179.6;   phiMultiplier = 0.0;    function = "111×φ — Full integration" },
      { name = "NOVA";      frequency = 432.0;   phiMultiplier = 0.0;    function = "Acoustic anchor" }
    ]
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║              PATTERN RECOGNITION — MAGNETIC FIELD PERCEPTION           ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // Information comes in like a magnetic field — patterns flow in and are recognized
  // The organism doesn't REQUEST data. It PERCEIVES the field.
  
  public type PatternField = {
    patterns : [RecognizedPattern];
    fieldStrength : Float;          // Magnetic-like field strength [0, 2]
    fieldDirection : Float;         // Field direction (radians)
    resonanceScore : Float;         // How well field resonates with doctrine [0, 1]
  };
  
  public type RecognizedPattern = {
    patternSignature : Nat32;       // Hash of the pattern
    patternType : PatternType;      // Category of pattern
    matchStrength : Float;          // How strongly it matches doctrine [0, 1]
    doctrineMatch : ?Nat;           // Which doctrine node it matches (if any)
    frequency : Float;              // Pattern's natural frequency
    phase : Float;                  // Pattern's current phase
  };
  
  public type PatternType = {
    #FibonacciPattern;              // Fibonacci sequence pattern
    #PhiRatioPattern;               // Golden ratio proportion
    #SchumannPattern;               // Earth resonance pattern
    #HeartFieldPattern;             // Cardiac rhythm pattern
    #BrainwavePattern;              // Neural oscillation pattern
    #DoctrinePattern;               // Matches specific doctrine
    #UnknownPattern;                // New pattern to learn
  };
  
  // Pattern recognition function — the FRONT of the organism
  public func recognizePatterns(
    input : [Float],
    doctrineNodes : [DoctrineNode],
    currentBeat : Nat
  ) : PatternField {
    var patterns = Buffer.Buffer<RecognizedPattern>(16);
    var totalStrength : Float = 0.0;
    var totalDirection : Float = 0.0;
    var resonanceSum : Float = 0.0;
    
    // Scan input for patterns
    var i = 0;
    while (i < input.size()) {
      let value = input[i];
      
      // Check for Fibonacci patterns
      if (isFibonacciLike(value)) {
        let pattern : RecognizedPattern = {
          patternSignature = fnv1a(Float.toText(value));
          patternType = #FibonacciPattern;
          matchStrength = 0.95;
          doctrineMatch = null;
          frequency = value;
          phase = Float.fromInt(currentBeat) * 0.01;
        };
        patterns.add(pattern);
        totalStrength += 0.95;
        resonanceSum += 0.95;
      };
      
      // Check for phi ratio patterns
      if (isPhiRatio(value, i, input)) {
        let pattern : RecognizedPattern = {
          patternSignature = fnv1a(Float.toText(value) # "_phi");
          patternType = #PhiRatioPattern;
          matchStrength = 0.99;
          doctrineMatch = null;
          frequency = value * PHI;
          phase = Float.fromInt(currentBeat) * PHI_INV;
        };
        patterns.add(pattern);
        totalStrength += 0.99;
        resonanceSum += 0.99;
      };
      
      // Check against doctrine nodes for specialized matching
      var d = 0;
      while (d < doctrineNodes.size()) {
        let node = doctrineNodes[d];
        let freqMatch = fabs(value - node.frequency) / node.frequency;
        if (freqMatch < 0.1) {  // Within 10% of node's frequency
          let pattern : RecognizedPattern = {
            patternSignature = fnv1a(Float.toText(value) # "_doc" # Nat.toText(d));
            patternType = #DoctrinePattern;
            matchStrength = 1.0 - freqMatch;
            doctrineMatch = ?d;
            frequency = node.frequency;
            phase = node.phase;
          };
          patterns.add(pattern);
          totalStrength += (1.0 - freqMatch);
          resonanceSum += (1.0 - freqMatch) * node.confidence;
        };
        d += 1;
      };
      
      i += 1;
    };
    
    let patternCount = Float.fromInt(patterns.size());
    {
      patterns = Buffer.toArray(patterns);
      fieldStrength = if (patternCount > 0.0) { fclamp(totalStrength / patternCount, 0.0, 2.0) } else { 0.0 };
      fieldDirection = Float.fromInt(currentBeat % 628) / 100.0;  // 0 to 2π
      resonanceScore = if (patternCount > 0.0) { fclamp(resonanceSum / patternCount, 0.0, 1.0) } else { 0.0 };
    }
  };
  
  // Check if a value resembles Fibonacci numbers
  func isFibonacciLike(value : Float) : Bool {
    let fibs : [Float] = [1.0, 1.0, 2.0, 3.0, 5.0, 8.0, 13.0, 21.0, 34.0, 55.0, 89.0, 144.0, 233.0, 377.0];
    for (fib in fibs.vals()) {
      if (fabs(value - fib) < 0.5 or fabs(value - fib / 10.0) < 0.05) {
        return true;
      };
    };
    false
  };
  
  // Check if value forms phi ratio with neighbors
  func isPhiRatio(value : Float, idx : Nat, input : [Float]) : Bool {
    if (idx > 0 and idx < input.size() - 1) {
      let prev = input[idx - 1];
      let next = input[idx + 1];
      if (prev > 0.0 and value > 0.0) {
        let ratio = value / prev;
        if (fabs(ratio - PHI) < 0.1 or fabs(ratio - PHI_INV) < 0.1) {
          return true;
        };
      };
    };
    false
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                      THE GATE — PATTERN FILTER                         ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // The GATE is the filter between pattern recognition and the Void/Zone.
  // Only information that matches doctrine patterns passes through.
  // This is the "pattern of the pattern" — where it starts meeting.
  
  public type Gate = {
    isOpen : Bool;                  // Whether gate is currently passing information
    threshold : Float;              // Minimum pattern match required [0, 1]
    passedPatterns : [RecognizedPattern];  // Patterns that made it through
    gateCoherence : Float;          // How coherent the gate is [0, 1]
    lastGateTime : Nat;             // Beat when gate last operated
  };
  
  public func processGate(
    patternField : PatternField,
    threshold : Float,
    currentBeat : Nat
  ) : Gate {
    var passed = Buffer.Buffer<RecognizedPattern>(8);
    var coherenceSum : Float = 0.0;
    
    // Only patterns with strength above threshold pass
    for (pattern in patternField.patterns.vals()) {
      if (pattern.matchStrength >= threshold) {
        passed.add(pattern);
        coherenceSum += pattern.matchStrength;
      };
    };
    
    let passedCount = Float.fromInt(passed.size());
    {
      isOpen = passed.size() > 0;
      threshold = threshold;
      passedPatterns = Buffer.toArray(passed);
      gateCoherence = if (passedCount > 0.0) { coherenceSum / passedCount } else { 0.0 };
      lastGateTime = currentBeat;
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    THE VOID / ZONE — PRESENT MOMENT                    ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // The VOID is where all thoughts are held at once — the present moment.
  // All doctrine nodes are present here. They all see the information.
  // But ONE node knows the most and will LEAD the synthesis.
  
  public type VoidZone = {
    nodes : [DoctrineNode];         // All nodes present in the moment
    leaderIndex : ?Nat;             // Which node is leading (if any)
    collectiveActivation : Float;   // Sum of all activations
    isHolding : Bool;               // Are all thoughts being held?
    momentCoherence : Float;        // How coherent the moment is [0, 1]
  };
  
  // Determine which node should lead based on doctrine match
  public func selectLeader(
    nodes : [DoctrineNode],
    passedPatterns : [RecognizedPattern]
  ) : ?Nat {
    var maxConfidence : Float = 0.0;
    var leaderIdx : ?Nat = null;
    
    // Find the node with highest confidence for the incoming patterns
    var n = 0;
    while (n < nodes.size()) {
      var nodeConfidence : Float = 0.0;
      
      for (pattern in passedPatterns.vals()) {
        switch (pattern.doctrineMatch) {
          case (?matchIdx) {
            if (matchIdx == n) {
              nodeConfidence += pattern.matchStrength;
            };
          };
          case null {
            // Check frequency proximity
            let freqDiff = fabs(pattern.frequency - nodes[n].frequency);
            if (freqDiff < 5.0) {
              nodeConfidence += (5.0 - freqDiff) / 5.0 * 0.5;
            };
          };
        };
      };
      
      if (nodeConfidence > maxConfidence) {
        maxConfidence := nodeConfidence;
        leaderIdx := ?n;
      };
      
      n += 1;
    };
    
    leaderIdx
  };
  
  // Process the Void Zone — all nodes hold, one leads
  public func processVoidZone(
    nodes : [var DoctrineNode],
    passedPatterns : [RecognizedPattern],
    currentBeat : Nat
  ) : VoidZone {
    // Select the leader
    let leader = selectLeader(Array.freeze(nodes), passedPatterns);
    
    // Update all nodes — they all receive the information
    var totalActivation : Float = 0.0;
    var n = 0;
    while (n < nodes.size()) {
      var node = nodes[n];
      
      // All nodes receive base activation from passed patterns
      var patternActivation : Float = 0.0;
      for (pattern in passedPatterns.vals()) {
        patternActivation += pattern.matchStrength * 0.1;
      };
      
      // Update node activation
      node := {
        id = node.id;
        name = node.name;
        frequency = node.frequency;
        phase = node.phase + 0.01 * node.frequency;  // Phase advances
        activation = fclamp(node.activation * 0.95 + patternActivation, 0.5, 2.0);
        specialization = node.specialization;
        confidence = node.confidence;
        isLeading = switch (leader) { case (?l) { l == n }; case null { false } };
      };
      
      nodes[n] := node;
      totalActivation += node.activation;
      n += 1;
    };
    
    // Compute moment coherence using Kuramoto-like calculation
    var phaseSum : Float = 0.0;
    var phaseSumSq : Float = 0.0;
    for (node in nodes.vals()) {
      let p = Float.sin(node.phase);
      let q = Float.cos(node.phase);
      phaseSum += p;
      phaseSumSq += q;
    };
    let nodeCount = Float.fromInt(nodes.size());
    let r = if (nodeCount > 0.0) {
      Float.sqrt(phaseSum * phaseSum + phaseSumSq * phaseSumSq) / nodeCount
    } else { 0.0 };
    
    {
      nodes = Array.freeze(nodes);
      leaderIndex = leader;
      collectiveActivation = totalActivation;
      isHolding = passedPatterns.size() > 0;
      momentCoherence = fclamp(r, 0.0, 1.0);
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    SYNTHESIS — LEADER INTEGRATES ALL                   ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // The leading node SYNTHESIZES through all other nodes.
  // It takes the information from all and produces a coherent answer.
  
  public type Synthesis = {
    answer : Float;                 // The synthesized numeric answer
    confidence : Float;             // How confident the synthesis is [0, 1]
    leaderId : Nat;                 // Which node led the synthesis
    contributorCount : Nat;         // How many nodes contributed
    synthesisHash : Nat32;          // Hash of the synthesis for verification
  };
  
  public func synthesize(
    voidZone : VoidZone
  ) : ?Synthesis {
    switch (voidZone.leaderIndex) {
      case (?leaderIdx) {
        let leader = voidZone.nodes[leaderIdx];
        
        // Leader gathers information from all nodes
        var sum : Float = 0.0;
        var weightSum : Float = 0.0;
        var contributors : Nat = 0;
        
        for (node in voidZone.nodes.vals()) {
          let weight = node.activation * node.confidence;
          sum += node.activation * weight;
          weightSum += weight;
          contributors += 1;
        };
        
        // Synthesized answer is weighted average through leader's lens
        let answer = if (weightSum > 0.0) {
          (sum / weightSum) * leader.activation
        } else {
          leader.activation
        };
        
        // Confidence is based on coherence and leader's own confidence
        let confidence = voidZone.momentCoherence * leader.confidence;
        
        // Create synthesis hash for verification
        let hashInput = Float.toText(answer) # "_" # 
                        Nat.toText(leaderIdx) # "_" #
                        Nat.toText(contributors);
        let hash = fnv1a(hashInput);
        
        ?{
          answer = answer;
          confidence = confidence;
          leaderId = leaderIdx;
          contributorCount = contributors;
          synthesisHash = hash;
        }
      };
      case null { null };
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                OUTPUT GATE — CONFIRMATION BACK OUT                     ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // The answer goes back through the gate for confirmation.
  // The gate confirms the synthesis is coherent and matches doctrine.
  
  public type OutputGate = {
    confirmed : Bool;               // Is the synthesis confirmed?
    confirmationScore : Float;      // How well it passed confirmation [0, 1]
    adjustedAnswer : Float;         // Answer after any gate adjustments
    outputReady : Bool;             // Is output ready for resonance?
  };
  
  public func confirmOutput(
    synthesis : Synthesis,
    inputGate : Gate,
    threshold : Float
  ) : OutputGate {
    // Synthesis must meet both its own confidence and gate coherence
    let confirmationScore = synthesis.confidence * inputGate.gateCoherence;
    let confirmed = confirmationScore >= threshold;
    
    // Adjust answer based on gate resonance
    let adjustment = if (confirmed) {
      1.0 + (confirmationScore - threshold) * 0.1
    } else {
      0.9  // Slight penalty for unconfirmed synthesis
    };
    
    {
      confirmed = confirmed;
      confirmationScore = confirmationScore;
      adjustedAnswer = synthesis.answer * adjustment;
      outputReady = confirmed;
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║              RESONANCE OUTPUT — COHERENT ANSWER                        ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // The final stage: resonance. The organism resonates with the answer,
  // pattern recognizes it, and can THINK, RESONATE, ACT all at once.
  // Now it's in the moment.
  
  public type ResonanceOutput = {
    answer : Float;                 // The final answer
    coherence : Float;              // How coherent the organism is now
    inTheMoment : Bool;             // Is organism in the present moment?
    thoughtComplete : Bool;         // Is the thought cycle complete?
    canAct : Bool;                  // Can organism now act on this?
    resonanceFrequency : Float;     // What frequency is it resonating at?
    phiAlignment : Float;           // How aligned with phi geometry [0, 1]
  };
  
  public func produceResonance(
    outputGate : OutputGate,
    voidZone : VoidZone,
    currentBeat : Nat
  ) : ResonanceOutput {
    // Only produce resonance if output is ready
    if (not outputGate.outputReady) {
      return {
        answer = 0.0;
        coherence = 0.0;
        inTheMoment = false;
        thoughtComplete = false;
        canAct = false;
        resonanceFrequency = 0.0;
        phiAlignment = 0.0;
      };
    };
    
    // Calculate resonance frequency from void zone coherence
    // Maps to phi-frequency nodes based on coherence level
    let resonanceFreq = SCHUMANN_BASE * (1.0 + voidZone.momentCoherence * (PHI - 1.0));
    
    // Phi alignment — how close to perfect phi geometry
    let phiAlignment = fabs(voidZone.momentCoherence - PHI_INV) / PHI_INV;
    let phiScore = fclamp(1.0 - phiAlignment, 0.0, 1.0);
    
    // Final coherence combines all factors
    let finalCoherence = outputGate.confirmationScore * voidZone.momentCoherence * 
                         (1.0 + phiScore * 0.1);
    
    // In the moment: high coherence + confirmed output
    let inMoment = finalCoherence > 0.8;
    
    {
      answer = outputGate.adjustedAnswer;
      coherence = fclamp(finalCoherence, 0.0, 1.0);
      inTheMoment = inMoment;
      thoughtComplete = true;
      canAct = inMoment and outputGate.confirmed;
      resonanceFrequency = resonanceFreq;
      phiAlignment = phiScore;
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║           COMPLETE COGNITIVE CYCLE — THE FULL ARCHITECTURE             ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // The complete cycle: Input → Pattern Recognition → Gate → Void → 
  //                     Leader Selection → Synthesis → Output Gate → Resonance
  
  public type CognitiveState = {
    patternField : PatternField;
    inputGate : Gate;
    voidZone : VoidZone;
    synthesis : ?Synthesis;
    outputGate : OutputGate;
    resonance : ResonanceOutput;
    cycleComplete : Bool;
    currentBeat : Nat;
  };
  
  public func runCognitiveCycle(
    input : [Float],
    nodes : [var DoctrineNode],
    gateThreshold : Float,
    currentBeat : Nat
  ) : CognitiveState {
    // Step 1: Pattern Recognition (FRONT)
    let patternField = recognizePatterns(input, Array.freeze(nodes), currentBeat);
    
    // Step 2: Input Gate (MIDDLE)
    let inputGate = processGate(patternField, gateThreshold, currentBeat);
    
    // Step 3: Void Zone (HOLDING ALL THOUGHTS)
    let voidZone = processVoidZone(nodes, inputGate.passedPatterns, currentBeat);
    
    // Step 4: Synthesis (LEADER INTEGRATES)
    let synthesis = synthesize(voidZone);
    
    // Step 5: Output Gate (CONFIRMATION)
    let outputGate = switch (synthesis) {
      case (?s) { confirmOutput(s, inputGate, gateThreshold * 0.8) };
      case null { 
        { confirmed = false; confirmationScore = 0.0; adjustedAnswer = 0.0; outputReady = false }
      };
    };
    
    // Step 6: Resonance (COHERENT ANSWER)
    let resonance = produceResonance(outputGate, voidZone, currentBeat);
    
    {
      patternField = patternField;
      inputGate = inputGate;
      voidZone = voidZone;
      synthesis = synthesis;
      outputGate = outputGate;
      resonance = resonance;
      cycleComplete = resonance.thoughtComplete;
      currentBeat = currentBeat;
    }
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                    INITIALIZATION FUNCTIONS                            ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  // Create default doctrine nodes based on PHI frequency architecture
  public func initDoctrineNodes() : [DoctrineNode] {
    let phiNodes = getPhiFrequencyNodes();
    var nodes = Buffer.Buffer<DoctrineNode>(12);
    
    var i = 0;
    for (phiNode in phiNodes.vals()) {
      let node : DoctrineNode = {
        id = i;
        name = phiNode.name;
        frequency = phiNode.frequency;
        phase = Float.fromInt(i) * 0.5236;  // Spread phases evenly
        activation = 1.0;
        specialization = [phiNode.function];
        confidence = 0.8;
        isLeading = false;
      };
      nodes.add(node);
      i += 1;
    };
    
    Buffer.toArray(nodes)
  };
  
  // Create mutable doctrine nodes
  public func initMutableDoctrineNodes() : [var DoctrineNode] {
    Array.thaw<DoctrineNode>(initDoctrineNodes())
  };
  
  // ╔════════════════════════════════════════════════════════════════════════╗
  // ║                        UTILITY FUNCTIONS                               ║
  // ╚════════════════════════════════════════════════════════════════════════╝
  
  func fclamp(x : Float, lo : Float, hi : Float) : Float {
    if (x < lo) { lo } else if (x > hi) { hi } else { x }
  };
  
  func fabs(x : Float) : Float {
    if (x < 0.0) { -x } else { x }
  };
  
  func fmax(x : Float, y : Float) : Float {
    if (x > y) { x } else { y }
  };
  
  func fmin(x : Float, y : Float) : Float {
    if (x < y) { x } else { y }
  };
  
  // FNV-1a hash function
  func fnv1a(input : Text) : Nat32 {
    var hash : Nat32 = 2166136261;
    for (c in input.chars()) {
      let byte = Nat32.fromNat(Nat32.toNat(Nat32.fromIntWrap(Int.abs(Nat32.toNat(hash)))) % 256);
      hash := (hash ^ byte) *% 16777619;
    };
    hash
  };
  
}
