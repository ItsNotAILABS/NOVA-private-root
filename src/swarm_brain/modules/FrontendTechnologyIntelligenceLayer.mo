  // ═══════════════════════════════════════════════════════════════════════════
  //
  //  Kuramoto oscillator equation:
  //  dθ_i/dt = ω_i + (K/N) · Σ_j sin(θ_j - θ_i)
  //
  //  F-MODELs synchronize through Kuramoto coupling:
  //  • Each F-MODEL category has a natural frequency (ω_i) from PHI nodes
  //  • Coupling strength K determines synchronization
  //  • Order parameter R measures global coherence
  //
  // ═══════════════════════════════════════════════════════════════════════════
  
  public type KuramotoCoupling = {
    phases : [Float];           // θ for each F-MODEL category (11)
    naturalFreqs : [Float];     // ω for each category (from PHI nodes)
    couplingStrength : Float;   // K
    orderParameter : Float;     // R = |Σ e^{iθ_j}| / N
    meanPhase : Float;          // psi = arg(Σ e^{iθ_j})
  };
  
  // Map categories to PHI nodes for natural frequencies
  public func getCategoryNaturalFreq(categoryIdx : Nat) : Float {
    switch (categoryIdx) {
      case (0)  { PHI_NODE_03_SCHUMANN };  // Markup → Earth resonance
      case (1)  { PHI_NODE_04_FLUX };      // Styling → Flow
      case (2)  { PHI_NODE_05_RESONEX };   // Framework → Resonance
      case (3)  { PHI_NODE_06_QMEM };      // State → Memory
      case (4)  { PHI_NODE_07_AXIS };      // Build → Binding
      case (5)  { PHI_NODE_08_AEGIS };     // Testing → Protection
      case (6)  { PHI_NODE_09_ENTANGLA };  // Graphics → Entanglement
      case (7)  { PHI_NODE_10_PARALLAX };  // Communication → Parallel
      case (8)  { PHI_NODE_06_QMEM };      // Storage → Memory
      case (9)  { PHI_NODE_05_RESONEX };   // WebAPI → Resonance
      case (10) { PHI_NODE_12_NOVA };      // Web3/ICP → Nova (sovereign)
      case (_)  { PHI_NODE_03_SCHUMANN };  // Default
    }
  };
  
