  /// Snapshot from MedinaSacrificeDoctrine
  public type SacrificeSnapshot = {
    // Sacrifice status
    sacrificesPending : Nat;
    sacrificesExecuted : Nat;
    lastSacrificebeat : Nat;

    // Health warnings
