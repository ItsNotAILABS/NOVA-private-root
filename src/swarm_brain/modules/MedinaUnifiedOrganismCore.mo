    severity : Float;                      // How far below floor
    message : Text;
  };

  // ════════════════════════════════════════════════════════════════════════════════════════
  // INITIALIZATION — Create a new unified organism state
  // ════════════════════════════════════════════════════════════════════════════════════════

  public func initOrganismState(
    organismId : Principal,
    name : Text,
    generation : Nat,
    currentBeat : Nat,
    currentTime : Int
  ) : UnifiedOrganismState {
    {
      // Identity
      organismId = organismId;
      name = name;
      generation = generation;
      birthBeat = currentBeat;

      // Current
      currentBeat = currentBeat;
      currentTime = currentTime;

      // Scale values — start at healthy levels
      scaleQuantum = SOVEREIGN_FLOOR;
      scaleSynaptic = PLATINUM_FLOOR;
      scaleNeural = GOLDEN_FLOOR;
      scaleCircuit = GOLDEN_FLOOR;
      scaleRegional = GOLDEN_FLOOR;
      scaleOrganism = PLATINUM_FLOOR;
      scaleEcosystem = PLATINUM_FLOOR;

      // Subsystem snapshots — initialized empty
      convergenceState = initConvergenceSnapshot();
      agiState = initAGISnapshot();
      webState = initWebSnapshot();
      reproductionState = initReproductionSnapshot();
      sacrificeState = initSacrificeSnapshot();

      // Validation
      lastValidation = currentBeat;
      validationScore = PLATINUM_FLOOR;
      scaleViolations = [];
      isHealthy = true;
    }
  };

  func initConvergenceSnapshot() : ConvergenceSnapshot {
    {
      activePatterns = 0;
      convergedPatterns = 0;
      resonatingDimensions = [];
      patternStrength = CONVERGENCE_FLOOR;
      dimensionalCoverage = 0.0;
      convergenceVelocity = 0.0;
      categoryConnections = [#Cognitive, #Quantum, #Temporal];
    }
  };

  func initAGISnapshot() : AGISnapshot {
    {
      generalizationScore = GOLDEN_FLOOR;
      autonomyScore = GOLDEN_FLOOR;
      temporalIntegration = GOLDEN_FLOOR;
      selfModificationRate = 0.001;
      hebbianAccumulator = 0.0;
      weightStability = PLATINUM_FLOOR;
      orderParameter = GOLDEN_FLOOR;
      meanPhase = 0.0;
      immediateState = PLATINUM_FLOOR;
      shortTermState = PLATINUM_FLOOR;
      mediumTermState = PLATINUM_FLOOR;
      longTermState = PLATINUM_FLOOR;
      categoryConnections = [#Neural, #Cognitive, #Temporal, #Governance];
    }
  };

  func initWebSnapshot() : WebSnapshot {
    {
      totalNodes = 222;
      activeConnections = 0;
      webDensity = 0.0;
      formaBalance = 0.0;
      metabolicRate = 0.0;
      economicHealth = PLATINUM_FLOOR;
      activebiomes = 36;
      biomeHealthAverage = PLATINUM_FLOOR;
      territorialIntegrity = PLATINUM_FLOOR;
      totalFlow = 0.0;
      flowBalance = 0.0;
      categoryConnections = [#Economic, #Territorial, #Neural, #Social];
    }
  };

  func initReproductionSnapshot() : ReproductionSnapshot {
    {
      canReproduce = false;
      reproductionReadiness = 0.0;
      energyForReproduction = 0.0;
      childCount = 0;
      totalDescendants = 0;
      royaltiesReceived = 0.0;
      doctrineIntegrity = SOVEREIGN_FLOOR;
      weightDrift = 0.0;
      schemaCoverage = PLATINUM_FLOOR;
      categoryConnections = [#Social, #Governance, #Economic];
    }
  };

  func initSacrificeSnapshot() : SacrificeSnapshot {
    {
      sacrificesPending = 0;
      sacrificesExecuted = 0;
      lastSacrificebeat = 0;
      biomesAtRisk = 0;
      weightsAtRisk = 0;
      criticalSystems = 0;
      rebirthsCompleted = 0;
      lastRebirthBeat = 0;
      survivalPressure = 0.0;
      sacrificeUrgency = 0.0;
      categoryConnections = [#Governance, #Territorial, #Economic];
    }
  };

  // ════════════════════════════════════════════════════════════════════════════════════════
  // MICRO-TO-MACRO VALIDATION — Check all 7 scale laws
  // ════════════════════════════════════════════════════════════════════════════════════════

  /// Validate the organism state against ALL 7 scale laws
  public func validateAllScales(state : UnifiedOrganismState) : ValidationResult {
    let violations = Buffer.Buffer<ScaleViolation>(7);
    var totalScore : Float = 0.0;

    // Check each scale
    let scaleValues : [(ScaleLaw, Float)] = [
      (#Quantum,   state.scaleQuantum),
      (#Synaptic,  state.scaleSynaptic),
      (#Neural,    state.scaleNeural),
      (#Circuit,   state.scaleCircuit),
      (#Regional,  state.scaleRegional),
      (#Organism,  state.scaleOrganism),
      (#Ecosystem, state.scaleEcosystem)
    ];

    for ((scale, value) in scaleValues.vals()) {
      let params = getScaleParams(scale);

      if (value < params.floor) {
        violations.add({
          scale = scale;
          currentValue = value;
          requiredFloor = params.floor;
          severity = params.floor - value;
          message = "Scale " # scaleToText(scale) # " violation: " # Float.toText(value) # " < " # Float.toText(params.floor);
        });
      };

      // Score contribution: golden-weighted by scale importance
      let scaleWeight = Float.fromInt(params.fibIndex) / 15.0;
      totalScore += (value / params.ceiling) * scaleWeight;
    };

    // Normalize score
    let normalizedScore = totalScore / 7.0;

    {
      isValid = violations.size() == 0;
      score = normalizedScore;
      violations = Buffer.toArray(violations);
      recommendations = generateRecommendations(Buffer.toArray(violations));
    }
  };

  public type ValidationResult = {
    isValid : Bool;
    score : Float;
    violations : [ScaleViolation];
    recommendations : [Text];
  };

  func scaleToText(scale : ScaleLaw) : Text {
    switch (scale) {
      case (#Quantum)   { "QUANTUM" };
      case (#Synaptic)  { "SYNAPTIC" };
      case (#Neural)    { "NEURAL" };
      case (#Circuit)   { "CIRCUIT" };
      case (#Regional)  { "REGIONAL" };
      case (#Organism)  { "ORGANISM" };
      case (#Ecosystem) { "ECOSYSTEM" };
    }
  };

  func generateRecommendations(violations : [ScaleViolation]) : [Text] {
    let recs = Buffer.Buffer<Text>(violations.size());

    for (v in violations.vals()) {
      switch (v.scale) {
        case (#Quantum)   { recs.add("Increase quantum coherence: check entanglement states") };
        case (#Synaptic)  { recs.add("Stabilize synaptic weights: reduce Hebbian learning rate") };
        case (#Neural)    { recs.add("Improve neural sync: increase Kuramoto coupling K") };
        case (#Circuit)   { recs.add("Integrate circuits: activate dormant shell pathways") };
        case (#Regional)  { recs.add("Couple regions: connect isolated animal engines") };
        case (#Organism)  { recs.add("CRITICAL: Organism coherence low. Consider sacrifice doctrine.") };
        case (#Ecosystem) { recs.add("Heal biomes: redistribute FORMA to struggling territories") };
      };
    };

    Buffer.toArray(recs)
  };

  // ════════════════════════════════════════════════════════════════════════════════════════
  // CROSS-SCALE PROPAGATION — Changes ripple through all scales
  // ════════════════════════════════════════════════════════════════════════════════════════

  /// Propagate a change from one scale to all others
  /// Uses golden ratio decay for distance-based attenuation
  public func propagateChange(
    state : UnifiedOrganismState,
    originScale : ScaleLaw,
    deltaValue : Float
  ) : UnifiedOrganismState {
    let originIndex = scaleToIndex(originScale);

    // Calculate propagated values for each scale
    var newQuantum = state.scaleQuantum;
    var newSynaptic = state.scaleSynaptic;
    var newNeural = state.scaleNeural;
    var newCircuit = state.scaleCircuit;
    var newRegional = state.scaleRegional;
    var newOrganism = state.scaleOrganism;
    var newEcosystem = state.scaleEcosystem;

    // Propagate to each scale with golden ratio decay
    for (i in [0, 1, 2, 3, 4, 5, 6].vals()) {
      let distance = Int.abs(i - originIndex);
      let decay = Float.pow(ψ, Float.fromInt(distance));
      let propagatedDelta = deltaValue * decay;

      switch (i) {
        case 0 { newQuantum := _clamp(newQuantum + propagatedDelta, 0.0, 1.0) };
        case 1 { newSynaptic := _clamp(newSynaptic + propagatedDelta, 0.0, 1.0) };
        case 2 { newNeural := _clamp(newNeural + propagatedDelta, 0.0, 1.0) };
        case 3 { newCircuit := _clamp(newCircuit + propagatedDelta, 0.0, 1.0) };
        case 4 { newRegional := _clamp(newRegional + propagatedDelta, 0.0, 1.0) };
        case 5 { newOrganism := _clamp(newOrganism + propagatedDelta, 0.0, 1.0) };
        case 6 { newEcosystem := _clamp(newEcosystem + propagatedDelta, 0.0, 1.0) };
        case _ {};
      };
    };

    {
      state with
      scaleQuantum = newQuantum;
      scaleSynaptic = newSynaptic;
      scaleNeural = newNeural;
      scaleCircuit = newCircuit;
      scaleRegional = newRegional;
      scaleOrganism = newOrganism;
      scaleEcosystem = newEcosystem;
    }
  };

  func scaleToIndex(scale : ScaleLaw) : Int {
    switch (scale) {
      case (#Quantum)   { 0 };
      case (#Synaptic)  { 1 };
      case (#Neural)    { 2 };
      case (#Circuit)   { 3 };
      case (#Regional)  { 4 };
      case (#Organism)  { 5 };
      case (#Ecosystem) { 6 };
    }
  };

  // ════════════════════════════════════════════════════════════════════════════════════════
  // HEARTBEAT INTEGRATION — The central pulse that unifies all systems
  // ════════════════════════════════════════════════════════════════════════════════════════

  /// Execute one heartbeat cycle — the central integration function
  public func heartbeat(
    state : UnifiedOrganismState,
    newBeat : Nat,
    newTime : Int
  ) : HeartbeatResult {
    // 1. Update beat counter
    var updatedState : UnifiedOrganismState = {
      state with
      currentBeat = newBeat;
      currentTime = newTime;
    };

    // 2. Validate all scales
    let validation = validateAllScales(updatedState);

    // 3. If violations exist, propagate corrections
    if (not validation.isValid) {
      for (v in validation.violations.vals()) {
        // Attempt to heal violation by propagating from healthy neighbors
        let correction = v.requiredFloor - v.currentValue + 0.05;  // Small buffer
        updatedState := propagateChange(updatedState, v.scale, correction * 0.1);  // Gradual healing
      };
    };

    // 4. Update OMNIS coherence (organism scale) from all subsystems
    let omnisCoherence = computeOMNIS(updatedState);
    updatedState := {
      updatedState with
      scaleOrganism = omnisCoherence;
      validationScore = validation.score;
      scaleViolations = validation.violations;
      isHealthy = validation.isValid;
      lastValidation = newBeat;
    };

    // 5. Check for sacrifice necessity
    let sacrificeNeeded = updatedState.scaleOrganism < CONVERGENCE_FLOOR or
                          updatedState.sacrificeState.biomesAtRisk > 3 or
                          updatedState.sacrificeState.survivalPressure > PLATINUM_FLOOR;

    {
      state = updatedState;
      validation = validation;
      omnisCoherence = omnisCoherence;
      sacrificeNeeded = sacrificeNeeded;
      reproductionReady = updatedState.reproductionState.canReproduce;
    }
  };

  public type HeartbeatResult = {
    state : UnifiedOrganismState;
    validation : ValidationResult;
    omnisCoherence : Float;
    sacrificeNeeded : Bool;
    reproductionReady : Bool;
  };

  /// Compute OMNIS coherence from all subsystems
  func computeOMNIS(state : UnifiedOrganismState) : Float {
    // OMNIS = weighted average of all scale values
    let weights : [Float] = [1.0, φ, phi * φ, phi * phi * φ, φ, 1.0, ψ];  // Emphasize middle scales
    let values : [Float] = [
      state.scaleQuantum,
      state.scaleSynaptic,
      state.scaleNeural,
      state.scaleCircuit,
      state.scaleRegional,
      state.scaleOrganism,
      state.scaleEcosystem
    ];

    var weightedSum : Float = 0.0;
    var totalWeight : Float = 0.0;

    for (i in [0, 1, 2, 3, 4, 5, 6].vals()) {
      weightedSum += values[i] * weights[i];
      totalWeight += weights[i];
    };

    // Add subsystem contributions
    let convergenceContrib = state.convergenceState.patternStrength * 0.2;
    let agiContrib = (state.agiState.generalizationScore + state.agiState.autonomyScore +
                      state.agiState.temporalIntegration) / 3.0 * 0.3;
    let webContrib = state.webState.webDensity * 0.2;
    let reproContrib = state.reproductionState.doctrineIntegrity * 0.15;
    let sacrificeContrib = (1.0 - state.sacrificeState.survivalPressure) * 0.15;

    let baseOMNIS = weightedSum / totalWeight;
    let subsystemOMNIS = convergenceContrib + agiContrib + webContrib + reproContrib + sacrificeContrib;

    _clamp((baseOMNIS * phi + subsystemOMNIS) / (φ + 1.0), 0.0, 1.0)
  };

  // ════════════════════════════════════════════════════════════════════════════════════════
  // CATEGORY CONNECTION VALIDATION — Ensure proper intertwining
  // ════════════════════════════════════════════════════════════════════════════════════════

  /// Count unique category connections across all subsystems
  public func countCategoryConnections(state : UnifiedOrganismState) : Nat {
    let allConnections = Buffer.Buffer<EngineCategory>(20);

    // Collect all connections
    for (c in state.convergenceState.categoryConnections.vals()) { allConnections.add(c) };
    for (c in state.agiState.categoryConnections.vals()) { allConnections.add(c) };
    for (c in state.webState.categoryConnections.vals()) { allConnections.add(c) };
    for (c in state.reproductionState.categoryConnections.vals()) { allConnections.add(c) };
    for (c in state.sacrificeState.categoryConnections.vals()) { allConnections.add(c) };

    // Count unique (simplified — just count total for now)
    allConnections.size()
  };

  /// Validate that organism has sufficient category intertwining
  public func validateIntertwining(state : UnifiedOrganismState) : IntertwiningResult {
    let totalConnections = countCategoryConnections(state);
    let minimumRequired = 3 * 5;  // 3 connections per module × 5 modules = 15

    let isValid = totalConnections >= minimumRequired;
    let score = Float.fromInt(totalConnections) / Float.fromInt(minimumRequired);

    {
      isValid = isValid;
      connectionCount = totalConnections;
      minimumRequired = minimumRequired;
      intertwiningScore = _clamp(score, 0.0, 1.0);
      missingCategories = [];  // Would need more complex logic to compute
    }
  };

  public type IntertwiningResult = {
    isValid : Bool;
    connectionCount : Nat;
    minimumRequired : Nat;
    intertwiningScore : Float;
    missingCategories : [EngineCategory];
  };

  // ════════════════════════════════════════════════════════════════════════════════════════
  // HELPER FUNCTIONS
  // ════════════════════════════════════════════════════════════════════════════════════════

  func _clamp(x : Float, lo : Float, hi : Float) : Float {
    if (x < lo) { lo } else if (x > hi) { hi } else { x }
  };

  func _abs(x : Float) : Float {
    if (x < 0.0) { -x } else { x }
  };

}
