    // ════════════════════════════════════════════════════════════════════════════════════
    // SCALE VALUES — One value for each of the 7 scales
    // ════════════════════════════════════════════════════════════════════════════════════

    scaleQuantum : Float;          // Entanglement coherence
    scaleSynaptic : Float;         // Hebbian weight stability
    scaleNeural : Float;           // Kuramoto order parameter (r)
    scaleCircuit : Float;          // Shell integration score
    scaleRegional : Float;         // Module coupling strength
    scaleOrganism : Float;         // OMNIS coherence
    scaleEcosystem : Float;        // World body health

    // ════════════════════════════════════════════════════════════════════════════════════
    // SUBSYSTEM STATES — Integration from 5 core modules
    // ════════════════════════════════════════════════════════════════════════════════════

    // From MedinaConvergenceEngine (perception)
