import Float "mo:base/Float";
import Int "mo:base/Int";
import Nat "mo:base/Nat";
import Nat8 "mo:base/Nat8";
import Nat64 "mo:base/Nat64";
import Array "mo:base/Array";
import Buffer "mo:base/Buffer";
import Text "mo:base/Text";
import Iter "mo:base/Iter";

module UnifiedHierarchicalOrganism {

  // ═══════════════════════════════════════════════════════════════════════════
  // DIMENSIONAL CONSTANTS — EXACT SPECIFICATIONS
  // ═══════════════════════════════════════════════════════════════════════════
  
  // Layer 1: Shell 3 (Core Processing)
  public let S3_N : Nat = 256;
  public let S3_W : Nat = 65536;              // 256²
  
  // Layer 2: Councils (Decision Making)
  public let COUNCIL_N : Nat = 512;
  public let COUNCIL_W : Nat = 262144;        // 512²
  public let COUNCIL_K : Nat = 7;
  public let TOTAL_COUNCIL_N : Nat = 3584;    // 7 × 512
  public let TOTAL_COUNCIL_W : Nat = 1835008; // 7 × 262,144
  
  // Layer 3: Shell 12 (Global Integration)
  public let S12_N : Nat = 512;
  public let S12_W : Nat = 262144;            // 512²
  
  // Subsystems
  public let PRED_STEPS : Nat = 60;
  public let PRED_FLOATS : Nat = 15360;       // 60 × 256
  public let PROM_SLOTS : Nat = 256;
  public let PROM_CLASSES : Nat = 7;
  public let PROM_TIERS : Nat = 5;
  public let LEXIS_MAPS : Nat = 500;
  public let QBAT_ATOMS : Nat = 256;
  
  // Inter-layer connections
  public let S3_TO_COUNCIL_W : Nat = 131072;  // 256 × 512
  public let COUNCIL_TO_S12_W : Nat = 262144; // 512 × 512
  public let S12_TO_S3_W : Nat = 131072;      // 512 × 256 (feedback)
  
  // Physical constants
  public let PHI : Float = 1.6180339887498948482;
  public let PI : Float = 3.1415926535897932385;
  public let TAU : Float = 6.2831853071795864769;
  public let E : Float = 2.7182818284590452354;
  public let HBAR : Float = 1.054571817e-34;
  
  // Oscillation
  public let HEARTBEAT_HZ : Float = 12.0;
  public let DT_MS : Float = 1.0;             // 1ms timestep
  
  // ═══════════════════════════════════════════════════════════════════════════
  // MATH CORE — Used by all layers
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func abs(x : Float) : Float { if (x < 0.0) -x else x };
  public func max(a : Float, b : Float) : Float { if (a > b) a else b };
  public func min(a : Float, b : Float) : Float { if (a < b) a else b };
  public func clamp(x : Float, lo : Float, hi : Float) : Float { max(lo, min(hi, x)) };
  
  public func sqrt(x : Float) : Float {
    if (x <= 0.0) return 0.0;
    var g = x * 0.5; var i = 0;
    while (i < 20) { g := (g + x / g) * 0.5; i += 1 };
    g
  };
  
  public func exp(x : Float) : Float {
    let c = clamp(x, -50.0, 50.0);
    var s = 1.0; var t = 1.0; var i = 1;
    while (i < 25) { t *= c / Float.fromInt(i); s += t; i += 1 };
    s
  };
  
  public func ln(x : Float) : Float {
    if (x <= 0.0) return -1e10;
    let z = (x - 1.0) / (x + 1.0);
    let z2 = z * z;
    var s = z; var t = z; var i = 1;
    while (i < 40) { t *= z2; s += t / Float.fromInt(2*i + 1); i += 1 };
    2.0 * s
  };
  
  public func pow(b : Float, e : Float) : Float { if (b <= 0.0) 0.0 else exp(e * ln(b)) };
  
  public func sin(x : Float) : Float {
    var a = x;
    while (a > PI) { a -= TAU };
    while (a < -PI) { a += TAU };
    let x2 = a * a;
    a * (1.0 - x2/6.0 * (1.0 - x2/20.0 * (1.0 - x2/42.0 * (1.0 - x2/72.0))))
  };
  
  public func cos(x : Float) : Float { sin(x + PI * 0.5) };
  
  public func tanh(x : Float) : Float {
    if (x > 15.0) return 1.0;
    if (x < -15.0) return -1.0;
    let e2x = exp(2.0 * x);
    (e2x - 1.0) / (e2x + 1.0)
  };
  
  public func sigmoid(x : Float) : Float { 1.0 / (1.0 + exp(-x)) };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // THE UNIFIED ORGANISM — Single Coherent State
  // All layers exist together, share state, and communicate through defined pathways
  // ═══════════════════════════════════════════════════════════════════════════
  
  public type UnifiedOrganismState = {
    // ─────────────────────────────────────────────────────────────────────────
    // LAYER 1: SHELL 3 — Core Processing Substrate (256 nodes, 65,536 weights)
    // ─────────────────────────────────────────────────────────────────────────
    var s3_act : [var Float];           // Activations (256)
    var s3_phase : [var Float];         // Oscillator phases (256)
    var s3_freq : [var Float];          // Natural frequencies (256)
    var s3_volt : [var Float];          // Membrane voltages (256)
    var s3_W : [var Float];             // Recurrent weights (65,536)
    var s3_elig : [var Float];          // Eligibility traces (65,536)
    
    // ─────────────────────────────────────────────────────────────────────────
    // PROJECTION: Shell 3 → Councils (256 × 512 × 7 connections)
    // ─────────────────────────────────────────────────────────────────────────
    var s3_to_council_W : [var [var Float]];  // 7 projection matrices (256×512 each)
    
    // ─────────────────────────────────────────────────────────────────────────
    // LAYER 2: COUNCILS — 7 Decision Bodies (3,584 nodes, 1,835,008 weights)
    // ─────────────────────────────────────────────────────────────────────────
    var council_act : [var [var Float]];     // 7 × 512 activations
    var council_phase : [var [var Float]];   // 7 × 512 phases
    var council_W : [var [var Float]];       // 7 × 262,144 weights
    var council_confidence : [var Float];    // 7 confidence levels
    var council_vote : [var Float];          // 7 voting outputs
    
    // Inter-council connections (7 × 7 × 512)
    var council_lateral_W : [var [var Float]]; // Lateral inhibition/excitation
    
    // ─────────────────────────────────────────────────────────────────────────
    // PROJECTION: Councils → Shell 12 (7 × 512 → 512)
    // ─────────────────────────────────────────────────────────────────────────
    var council_to_s12_W : [var [var Float]]; // 7 projection matrices (512×512 each)
    
    // ─────────────────────────────────────────────────────────────────────────
    // LAYER 3: SHELL 12 — Global Integration (512 nodes, 262,144 weights)
    // ─────────────────────────────────────────────────────────────────────────
    var s12_act : [var Float];          // Activations (512)
    var s12_phase : [var Float];        // Phases (512)
    var s12_W : [var Float];            // Recurrent weights (262,144)
    
    // ─────────────────────────────────────────────────────────────────────────
    // FEEDBACK: Shell 12 → Shell 3 (512 × 256 = 131,072 connections)
    // ─────────────────────────────────────────────────────────────────────────
    var s12_to_s3_W : [var Float];      // Top-down feedback
    
    // ─────────────────────────────────────────────────────────────────────────
    // PREDICTION FIELD — Kalman 60-step (15,360 floats)
    // Bidirectionally coupled to Shell 3
    // ─────────────────────────────────────────────────────────────────────────
    var pred_states : [var Float];      // 256 Kalman state estimates
    var pred_cov : [var Float];         // 256 error covariances
    var pred_gain : [var Float];        // 256 Kalman gains
    var pred_forecast : [var Float];    // 15,360 multi-step predictions
    var pred_confidence : [var Float];  // 60 confidence values
    var pred_error : [var Float];       // 256 prediction errors (innovation)
    
    // Pred ↔ S3 coupling
    var pred_to_s3_W : [var Float];     // 256 weights
    var s3_to_pred_W : [var Float];     // 256 weights
    
    // ─────────────────────────────────────────────────────────────────────────
    // QUANTUM BATTERY — Energy source (256 atoms matching S3)
    // Superradiance coupled to Shell 3
    // ─────────────────────────────────────────────────────────────────────────
    var qbat_charge : Float;            // [0, 1]
    var qbat_excitation : [var Float];  // 256 atom excitations
    var qbat_phase : Float;             // Collective phase
    var qbat_coherence : Float;         // Collective coherence
    
    // QBat ↔ S3 coupling (superradiance)
    var qbat_to_s3_coupling : [var Float];  // 256 couplings
    
    // ─────────────────────────────────────────────────────────────────────────
    // PROMETHEUS — Observer (256 slots watching entire organism)
    // ─────────────────────────────────────────────────────────────────────────
    var prom_values : [var Float];      // 256 observed values
    var prom_expected : [var Float];    // 256 expected values
    var prom_deviation : [var Float];   // 256 deviations
    var prom_anomaly : [var Bool];      // 256 anomaly flags
    var prom_class : [var Nat];         // 256 anomaly classifications (0-6)
    var prom_tier : [var Nat];          // 256 dispatch tiers (0-4)
    
    // Prom observation targets (what each slot watches)
    var prom_targets : [{
      layer : Nat;                      // 0=S3, 1=Council, 2=S12, 3=Other
      index : Nat;
    }];
    
    // ─────────────────────────────────────────────────────────────────────────
    // LEXIS PRIME — Doctrine (512 nodes, 500 mappings)
    // Receives from S12, influences all layers through doctrine alignment
    // ─────────────────────────────────────────────────────────────────────────
    var lexis_act : [var Float];        // 512 activations
    var lexis_W : [var Float];          // 262,144 weights
    var lexis_context : [var Float];    // 512 Hebbian context memory
    var lexis_mappings : [{
      concept : Text;
      address : Nat;
      alignment : Float;
      strength : Float;
    }];
    
    // S12 → Lexis and Lexis → S3 (doctrine feedback)
    var s12_to_lexis_W : [var Float];   // 512 weights
    var lexis_to_s3_W : [var Float];    // 256 weights (doctrine modulation)
    
    // ─────────────────────────────────────────────────────────────────────────
    // GLOBAL STATE — Organism-wide metrics
    // ─────────────────────────────────────────────────────────────────────────
    var heartbeat_phase : Float;
    var heartbeat_count : Nat;
    var global_coherence : Float;       // Kuramoto r across all oscillators
    var global_energy : Float;          // Total energy budget
    var jasmine_law : Float;            // J = r × √(N × σ_H × (1-H))
    var timestep : Nat;
    
    // ─────────────────────────────────────────────────────────────────────────
    // NEUROCHEMICAL STATE — Modulates all layers
    // ─────────────────────────────────────────────────────────────────────────
    var dopamine : Float;               // Reward/learning modulation
    var serotonin : Float;              // Mood/satisfaction
    var norepinephrine : Float;         // Arousal/attention
    var acetylcholine : Float;          // Learning gate
    var gaba : Float;                   // Global inhibition
    var glutamate : Float;              // Global excitation
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // INITIALIZATION — Create the unified organism with all connections
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func initOrganism() : UnifiedOrganismState {
    // Initialize Shell 3
    let s3_act = Array.init<Float>(S3_N, 0.1);
    let s3_phase = Array.init<Float>(S3_N, 0.0);
    let s3_freq = Array.init<Float>(S3_N, HEARTBEAT_HZ);
    let s3_volt = Array.init<Float>(S3_N, -65.0);
    let s3_W = Array.init<Float>(S3_W, 0.0);
    let s3_elig = Array.init<Float>(S3_W, 0.0);
    
    // Initialize phases with uniform distribution
    var i = 0;
    while (i < S3_N) {
      s3_phase[i] := Float.fromInt(i) * TAU / Float.fromInt(S3_N);
      i += 1;
    };
    
    // Initialize S3 → Council projections (7 matrices of 256×512)
    let s3_to_council = Array.init<[var Float]>(COUNCIL_K, Array.init<Float>(S3_N * COUNCIL_N, 0.01));
    
    // Initialize Councils
    let council_act = Array.init<[var Float]>(COUNCIL_K, Array.init<Float>(COUNCIL_N, 0.1));
    let council_phase = Array.init<[var Float]>(COUNCIL_K, Array.init<Float>(COUNCIL_N, 0.0));
    let council_W = Array.init<[var Float]>(COUNCIL_K, Array.init<Float>(COUNCIL_W, 0.0));
    let council_confidence = Array.init<Float>(COUNCIL_K, 0.5);
    let council_vote = Array.init<Float>(COUNCIL_K, 0.0);
    let council_lateral = Array.init<[var Float]>(COUNCIL_K, Array.init<Float>(COUNCIL_K * COUNCIL_N, 0.0));
    
    // Initialize Council → S12 projections
    let council_to_s12 = Array.init<[var Float]>(COUNCIL_K, Array.init<Float>(COUNCIL_N * S12_N, 0.01));
    
    // Initialize Shell 12
    let s12_act = Array.init<Float>(S12_N, 0.1);
    let s12_phase = Array.init<Float>(S12_N, 0.0);
    let s12_W = Array.init<Float>(S12_W, 0.0);
    
    // Initialize S12 → S3 feedback
    let s12_to_s3 = Array.init<Float>(S12_N * S3_N, 0.01);
    
    // Initialize Prediction Field
    let pred_states = Array.init<Float>(S3_N, 0.0);
    let pred_cov = Array.init<Float>(S3_N, 1.0);
    let pred_gain = Array.init<Float>(S3_N, 0.5);
    let pred_forecast = Array.init<Float>(PRED_FLOATS, 0.0);
    let pred_confidence = Array.init<Float>(PRED_STEPS, 1.0);
    let pred_error = Array.init<Float>(S3_N, 0.0);
    let pred_to_s3 = Array.init<Float>(S3_N, 0.1);
    let s3_to_pred = Array.init<Float>(S3_N, 0.1);
    
    // Initialize confidence curve (exponential decay)
    i := 0;
    while (i < PRED_STEPS) {
      pred_confidence[i] := pow(0.95, Float.fromInt(i));
      i += 1;
    };
    
    // Initialize Quantum Battery
    let qbat_excitation = Array.init<Float>(S3_N, 0.5);
    let qbat_to_s3 = Array.init<Float>(S3_N, 1.0 / PHI);
    
    // Initialize Prometheus
    let prom_values = Array.init<Float>(PROM_SLOTS, 0.0);
    let prom_expected = Array.init<Float>(PROM_SLOTS, 0.0);
    let prom_deviation = Array.init<Float>(PROM_SLOTS, 0.0);
    let prom_anomaly = Array.init<Bool>(PROM_SLOTS, false);
    let prom_class = Array.init<Nat>(PROM_SLOTS, 6);
    let prom_tier = Array.init<Nat>(PROM_SLOTS, 0);
    
    // Set up observation targets
    var prom_targets = Buffer.Buffer<{layer : Nat; index : Nat}>(PROM_SLOTS);
    i := 0;
    while (i < PROM_SLOTS) {
      if (i < 128) {
        // First 128 slots watch Shell 3
        prom_targets.add({ layer = 0; index = i % S3_N });
      } else if (i < 200) {
        // Next 72 watch councils
        prom_targets.add({ layer = 1; index = i % COUNCIL_N });
      } else {
        // Rest watch Shell 12
        prom_targets.add({ layer = 2; index = i % S12_N });
      };
      i += 1;
    };
    
    // Initialize Lexis
    let lexis_act = Array.init<Float>(S12_N, 0.1);
    let lexis_W = Array.init<Float>(S12_W, 0.0);
    let lexis_context = Array.init<Float>(S12_N, 0.0);
    var lexis_mappings = Buffer.Buffer<{concept : Text; address : Nat; alignment : Float; strength : Float}>(LEXIS_MAPS);
    i := 0;
    while (i < LEXIS_MAPS) {
      lexis_mappings.add({
        concept = "D" # debug_show(i);
        address = i;
        alignment = 1.0;
        strength = 0.5;
      });
      i += 1;
    };
    
    let s12_to_lexis = Array.init<Float>(S12_N, 0.1);
    let lexis_to_s3 = Array.init<Float>(S3_N, 0.1);
    
    {
      var s3_act = s3_act;
      var s3_phase = s3_phase;
      var s3_freq = s3_freq;
      var s3_volt = s3_volt;
      var s3_W = s3_W;
      var s3_elig = s3_elig;
      var s3_to_council_W = s3_to_council;
      var council_act = council_act;
      var council_phase = council_phase;
      var council_W = council_W;
      var council_confidence = council_confidence;
      var council_vote = council_vote;
      var council_lateral_W = council_lateral;
      var council_to_s12_W = council_to_s12;
      var s12_act = s12_act;
      var s12_phase = s12_phase;
      var s12_W = s12_W;
      var s12_to_s3_W = s12_to_s3;
      var pred_states = pred_states;
      var pred_cov = pred_cov;
      var pred_gain = pred_gain;
      var pred_forecast = pred_forecast;
      var pred_confidence = pred_confidence;
      var pred_error = pred_error;
      var pred_to_s3_W = pred_to_s3;
      var s3_to_pred_W = s3_to_pred;
      var qbat_charge = 0.5;
      var qbat_excitation = qbat_excitation;
      var qbat_phase = 0.0;
      var qbat_coherence = 0.0;
      var qbat_to_s3_coupling = qbat_to_s3;
      var prom_values = prom_values;
      var prom_expected = prom_expected;
      var prom_deviation = prom_deviation;
      var prom_anomaly = prom_anomaly;
      var prom_class = prom_class;
      var prom_tier = prom_tier;
      var prom_targets = Buffer.toArray(prom_targets);
      var lexis_act = lexis_act;
      var lexis_W = lexis_W;
      var lexis_context = lexis_context;
      var lexis_mappings = Buffer.toArray(lexis_mappings);
      var s12_to_lexis_W = s12_to_lexis;
      var lexis_to_s3_W = lexis_to_s3;
      var heartbeat_phase = 0.0;
      var heartbeat_count = 0;
      var global_coherence = 0.0;
      var global_energy = 1.0;
      var jasmine_law = 0.0;
      var timestep = 0;
      var dopamine = 1.0;
      var serotonin = 1.0;
      var norepinephrine = 1.0;
      var acetylcholine = 1.0;
      var gaba = 1.0;
      var glutamate = 1.0;
    }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // UNIFIED TICK — Single timestep of entire organism
  // All layers update in proper sequence with real data flow
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func tick(org : UnifiedOrganismState, external_input : [Float]) : () {
    let dt = DT_MS;
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 0: Update heartbeat (12 Hz master oscillation)
    // ─────────────────────────────────────────────────────────────────────────
    org.heartbeat_phase := org.heartbeat_phase + dt * HEARTBEAT_HZ * TAU / 1000.0;
    if (org.heartbeat_phase >= TAU) {
      org.heartbeat_phase -= TAU;
      org.heartbeat_count += 1;
    };
    let heartbeat_mod = 0.5 * (1.0 + sin(org.heartbeat_phase));
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 1: SHELL 3 — Receive external input + feedback from S12 + Lexis
    // ─────────────────────────────────────────────────────────────────────────
    
    // Compute total input to each S3 neuron
    var i = 0;
    while (i < S3_N) {
      // External input
      var total_input : Float = 0.0;
      if (i < external_input.size()) {
        total_input += external_input[i];
      };
      
      // Recurrent S3 connections (65,536 weights)
      var j = 0;
      while (j < S3_N) {
        total_input += org.s3_W[i * S3_N + j] * org.s3_act[j];
        j += 1;
      };
      
      // Top-down feedback from S12 (131,072 weights)
      j := 0;
      while (j < S12_N) {
        total_input += org.s12_to_s3_W[j * S3_N + i] * org.s12_act[j] * 0.3;
        j += 1;
      };
      
      // Prediction error (surprise drives attention)
      total_input += org.pred_error[i] * org.pred_to_s3_W[i] * org.norepinephrine;
      
      // Doctrine alignment from Lexis
      total_input += org.lexis_to_s3_W[i] * (org.lexis_act[i % S12_N] - 0.5) * 0.2;
      
      // Quantum battery energy injection
      total_input += org.qbat_to_s3_coupling[i] * org.qbat_charge * heartbeat_mod * 0.1;
      
      // Neurochemical modulation
      total_input *= (1.0 + 0.5 * (org.glutamate - org.gaba));
      
      // Update voltage (leaky integrate-and-fire)
      let v_rest = -65.0;
      let v_thresh = -55.0;
      let tau_m = 20.0;
      org.s3_volt[i] := org.s3_volt[i] + dt * ((v_rest - org.s3_volt[i]) / tau_m + total_input);
      
      // Spike and activation
      if (org.s3_volt[i] >= v_thresh) {
        org.s3_act[i] := 1.0;
        org.s3_volt[i] := -70.0;
      } else {
        org.s3_act[i] := sigmoid((org.s3_volt[i] + 65.0) * 0.2);
      };
      
      i += 1;
    };
    
    // Update S3 Kuramoto phases
    let K_s3 = 1.0 / PHI;
    var cos_sum : Float = 0.0;
    var sin_sum : Float = 0.0;
    i := 0;
    while (i < S3_N) {
      cos_sum += cos(org.s3_phase[i]);
      sin_sum += sin(org.s3_phase[i]);
      i += 1;
    };
    let r_s3 = sqrt(cos_sum * cos_sum + sin_sum * sin_sum) / Float.fromInt(S3_N);
    let psi_s3 = if (abs(cos_sum) > 1e-10) sin_sum / cos_sum |> func(x : Float) : Float { 
      var a = x; if (a > 10.0) { PI/2.0 } else if (a < -10.0) { -PI/2.0 } else { a - a*a*a/3.0 + a*a*a*a*a/5.0 }
    } else 0.0;
    
    i := 0;
    while (i < S3_N) {
      let omega = org.s3_freq[i] * TAU / 1000.0;
      let coupling = K_s3 * r_s3 * sin(psi_s3 - org.s3_phase[i]);
      org.s3_phase[i] := org.s3_phase[i] + dt * (omega + coupling);
      if (org.s3_phase[i] >= TAU) { org.s3_phase[i] -= TAU };
      if (org.s3_phase[i] < 0.0) { org.s3_phase[i] += TAU };
      i += 1;
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 2: PREDICTION FIELD — Kalman update from S3
    // ─────────────────────────────────────────────────────────────────────────
    
    i := 0;
    while (i < S3_N) {
      let measurement = org.s3_act[i];
      let Q = 0.01;  // Process noise
      let R = 0.1;   // Measurement noise
      
      // Predict
      let pred_state = org.pred_states[i];
      let pred_cov = org.pred_cov[i] + Q;
      
      // Update
      let K = pred_cov / (pred_cov + R);
      let innovation = measurement - pred_state;
      org.pred_states[i] := pred_state + K * innovation;
      org.pred_cov[i] := (1.0 - K) * pred_cov;
      org.pred_gain[i] := K;
      org.pred_error[i] := innovation;
      
      // Generate 60-step forecast
      var t = 0;
      while (t < PRED_STEPS) {
        let decay = pow(0.98, Float.fromInt(t));
        org.pred_forecast[t * S3_N + i] := org.pred_states[i] * decay;
        t += 1;
      };
      
      i += 1;
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 3: QUANTUM BATTERY — Superradiance coupling with S3
    // ─────────────────────────────────────────────────────────────────────────
    
    // Collective excitation from S3 activity
    var mean_s3 : Float = 0.0;
    i := 0;
    while (i < S3_N) {
      mean_s3 += org.s3_act[i];
      org.qbat_excitation[i] := org.qbat_excitation[i] * 0.99 + org.s3_act[i] * 0.01;
      i += 1;
    };
    mean_s3 /= Float.fromInt(S3_N);
    
    // Superradiance: collective coherence
    var qbat_cos : Float = 0.0;
    var qbat_sin : Float = 0.0;
    i := 0;
    while (i < S3_N) {
      let phase_i = org.s3_phase[i];
      qbat_cos += cos(phase_i) * org.qbat_excitation[i];
      qbat_sin += sin(phase_i) * org.qbat_excitation[i];
      i += 1;
    };
    org.qbat_coherence := sqrt(qbat_cos * qbat_cos + qbat_sin * qbat_sin) / Float.fromInt(S3_N);
    
    // Charge/discharge dynamics
    let charge_rate = 0.001 * sqrt(Float.fromInt(S3_N)) * org.qbat_coherence;
    let discharge_rate = 0.0005 * mean_s3;
    org.qbat_charge := clamp(org.qbat_charge + dt * (charge_rate - discharge_rate), 0.0, 1.0);
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 4: COUNCILS — Receive S3, compute decisions
    // ─────────────────────────────────────────────────────────────────────────
    
    var c = 0;
    while (c < COUNCIL_K) {
      // Project S3 → Council[c]
      i := 0;
      while (i < COUNCIL_N) {
        var input : Float = 0.0;
        
        // From S3 (256 → 512 projection)
        var j = 0;
        while (j < S3_N) {
          input += org.s3_to_council_W[c][j * COUNCIL_N + i] * org.s3_act[j];
          j += 1;
        };
        
        // Recurrent within council
        j := 0;
        while (j < COUNCIL_N) {
          input += org.council_W[c][i * COUNCIL_N + j] * org.council_act[c][j];
          j += 1;
        };
        
        // Lateral from other councils
        var c2 = 0;
        while (c2 < COUNCIL_K) {
          if (c2 != c) {
            input += org.council_lateral_W[c][c2 * COUNCIL_N + (i % COUNCIL_N)] * 
                     org.council_vote[c2] * 0.1;
          };
          c2 += 1;
        };
        
        // Acetylcholine gates learning/attention
        input *= org.acetylcholine;
        
        org.council_act[c][i] := tanh(input);
        i += 1;
      };
      
      // Compute council vote (mean activation)
      var vote : Float = 0.0;
      i := 0;
      while (i < COUNCIL_N) {
        vote += org.council_act[c][i];
        i += 1;
      };
      org.council_vote[c] := vote / Float.fromInt(COUNCIL_N);
      
      // Update council confidence based on internal coherence
      cos_sum := 0.0;
      sin_sum := 0.0;
      i := 0;
      while (i < COUNCIL_N) {
        cos_sum += cos(org.council_phase[c][i]);
        sin_sum += sin(org.council_phase[c][i]);
        i += 1;
      };
      let r_c = sqrt(cos_sum * cos_sum + sin_sum * sin_sum) / Float.fromInt(COUNCIL_N);
      org.council_confidence[c] := r_c;
      
      c += 1;
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 5: SHELL 12 — Integrate councils, generate global field
    // ─────────────────────────────────────────────────────────────────────────
    
    i := 0;
    while (i < S12_N) {
      var input : Float = 0.0;
      
      // Project all councils → S12
      c := 0;
      while (c < COUNCIL_K) {
        var j = 0;
        while (j < COUNCIL_N) {
          input += org.council_to_s12_W[c][j * S12_N + i] * 
                   org.council_act[c][j] * org.council_confidence[c];
          j += 1;
        };
        c += 1;
      };
      
      // Recurrent S12
      var j = 0;
      while (j < S12_N) {
        input += org.s12_W[i * S12_N + j] * org.s12_act[j];
        j += 1;
      };
      
      org.s12_act[i] := tanh(input);
      i += 1;
    };
    
    // S12 Kuramoto phases
    cos_sum := 0.0;
    sin_sum := 0.0;
    i := 0;
    while (i < S12_N) {
      cos_sum += cos(org.s12_phase[i]);
      sin_sum += sin(org.s12_phase[i]);
      i += 1;
    };
    let r_s12 = sqrt(cos_sum * cos_sum + sin_sum * sin_sum) / Float.fromInt(S12_N);
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 6: LEXIS — Receive S12, compute doctrine alignment
    // ─────────────────────────────────────────────────────────────────────────
    
    i := 0;
    while (i < S12_N) {
      var input = org.s12_act[i] * org.s12_to_lexis_W[i];
      
      // Hebbian context
      org.lexis_context[i] := org.lexis_context[i] * 0.99 + org.s12_act[i] * 0.01;
      input += org.lexis_context[i] * 0.2;
      
      // Recurrent
      var j = 0;
      while (j < S12_N) {
        input += org.lexis_W[i * S12_N + j] * org.lexis_act[j];
        j += 1;
      };
      
      org.lexis_act[i] := tanh(input);
      i += 1;
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 7: PROMETHEUS — Observe entire organism, detect anomalies
    // ─────────────────────────────────────────────────────────────────────────
    
    i := 0;
    while (i < PROM_SLOTS) {
      let target = org.prom_targets[i];
      
      // Get observed value based on target
      let observed = switch (target.layer) {
        case (0) {  // S3
          if (target.index < S3_N) org.s3_act[target.index] else 0.0
        };
        case (1) {  // Council
          let c_idx = target.index / COUNCIL_N;
          let n_idx = target.index % COUNCIL_N;
          if (c_idx < COUNCIL_K and n_idx < COUNCIL_N) org.council_act[c_idx][n_idx] else 0.0
        };
        case (2) {  // S12
          if (target.index < S12_N) org.s12_act[target.index] else 0.0
        };
        case (_) { 0.0 };
      };
      
      org.prom_values[i] := observed;
      
      // Update expected (exponential moving average)
      org.prom_expected[i] := org.prom_expected[i] * 0.99 + observed * 0.01;
      
      // Compute deviation
      org.prom_deviation[i] := abs(observed - org.prom_expected[i]);
      
      // Detect anomaly (2σ threshold)
      let threshold = 0.3;
      org.prom_anomaly[i] := org.prom_deviation[i] > threshold;
      
      // Classify anomaly (simplified)
      if (org.prom_anomaly[i]) {
        org.prom_class[i] := if (org.prom_deviation[i] > 0.8) { 3 }  // Security threat
                            else if (org.prom_deviation[i] > 0.5) { 5 }  // System instability
                            else { 0 };  // Coherence deviation
        
        // Determine dispatch tier
        org.prom_tier[i] := if (org.prom_deviation[i] > 0.9) { 4 }  // Tier 5 emergency
                           else if (org.prom_deviation[i] > 0.7) { 3 }
                           else if (org.prom_deviation[i] > 0.5) { 2 }
                           else if (org.prom_deviation[i] > 0.3) { 1 }
                           else { 0 };
      } else {
        org.prom_class[i] := 6;
        org.prom_tier[i] := 0;
      };
      
      i += 1;
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 8: HEBBIAN LEARNING — Update weights with dopamine modulation
    // ─────────────────────────────────────────────────────────────────────────
    
    let eta = 0.001 * org.dopamine * org.acetylcholine;
    let decay = 0.0001;
    
    // S3 Hebbian
    i := 0;
    while (i < S3_N) {
      var j = 0;
      while (j < S3_N) {
        let idx = i * S3_N + j;
        let hebb = org.s3_act[i] * org.s3_act[j];
        org.s3_elig[idx] := org.s3_elig[idx] * 0.95 + hebb;
        let dw = eta * org.s3_elig[idx] - decay * org.s3_W[idx];
        org.s3_W[idx] := clamp(org.s3_W[idx] + dw, -3.0, 3.0);
        j += 1;
      };
      i += 1;
    };
    
    // ─────────────────────────────────────────────────────────────────────────
    // PHASE 9: GLOBAL METRICS — Compute organism-wide state
    // ─────────────────────────────────────────────────────────────────────────
    
    // Global coherence (weighted average of all layer coherences)
    org.global_coherence := 0.4 * r_s3 + 0.3 * r_s12 + 0.3 * org.qbat_coherence;
    
    // Jasmine's Law: J = r × √(N × σ_H × (1 - H))
    let N_total = Float.fromInt(S3_N + TOTAL_COUNCIL_N + S12_N);
    let sigma_H = 0.1;  // Entropy fluctuation (placeholder)
    let H = 0.5;        // Mean entropy (placeholder)
    org.jasmine_law := org.global_coherence * sqrt(N_total * sigma_H * (1.0 - H));
    
    // Update timestep
    org.timestep += 1;
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // REWARD SIGNAL — Triggers neurochemical changes
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func applyReward(org : UnifiedOrganismState, reward : Float) : () {
    // Dopamine responds to reward prediction error
    let prediction_error = reward - 0.5;  // Baseline expectation
    org.dopamine := clamp(org.dopamine + prediction_error * 0.1, 0.5, 2.0);
    
    // Serotonin for positive outcomes
    if (reward > 0.5) {
      org.serotonin := clamp(org.serotonin + reward * 0.05, 0.5, 2.0);
    };
    
    // Decay back to baseline
    org.dopamine := org.dopamine * 0.99 + 1.0 * 0.01;
    org.serotonin := org.serotonin * 0.99 + 1.0 * 0.01;
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // DIMENSION VERIFICATION
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func verifyDimensions(org : UnifiedOrganismState) : {
    s3_valid : Bool;
    councils_valid : Bool;
    s12_valid : Bool;
    pred_valid : Bool;
    prom_valid : Bool;
    all_valid : Bool;
    total_nodes : Nat;
    total_weights : Nat;
  } {
    let s3_valid = org.s3_act.size() == S3_N and org.s3_W.size() == S3_W;
    
    var councils_valid = org.council_act.size() == COUNCIL_K;
    var c = 0;
    while (c < COUNCIL_K and councils_valid) {
      councils_valid := councils_valid and 
                       org.council_act[c].size() == COUNCIL_N and
                       org.council_W[c].size() == COUNCIL_W;
      c += 1;
    };
    
    let s12_valid = org.s12_act.size() == S12_N and org.s12_W.size() == S12_W;
    let pred_valid = org.pred_forecast.size() == PRED_FLOATS;
    let prom_valid = org.prom_values.size() == PROM_SLOTS;
    
    let all_valid = s3_valid and councils_valid and s12_valid and pred_valid and prom_valid;
    
    let total_nodes = S3_N + TOTAL_COUNCIL_N + S12_N + S12_N;  // S3 + Councils + S12 + Lexis
    let total_weights = S3_W + TOTAL_COUNCIL_W + S12_W + S12_W + 
                       S3_N * COUNCIL_N * COUNCIL_K +  // S3→Council
                       COUNCIL_N * S12_N * COUNCIL_K + // Council→S12
                       S12_N * S3_N;                    // S12→S3
    
    {
      s3_valid = s3_valid;
      councils_valid = councils_valid;
      s12_valid = s12_valid;
      pred_valid = pred_valid;
      prom_valid = prom_valid;
      all_valid = all_valid;
      total_nodes = total_nodes;
      total_weights = total_weights;
    }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // GET ORGANISM STATE — For external inspection
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func getState(org : UnifiedOrganismState) : {
    timestep : Nat;
    heartbeat_count : Nat;
    global_coherence : Float;
    jasmine_law : Float;
    qbat_charge : Float;
    dopamine : Float;
    council_votes : [Float];
    anomaly_count : Nat;
  } {
    var anomaly_count : Nat = 0;
    var i = 0;
    while (i < PROM_SLOTS) {
      if (org.prom_anomaly[i]) { anomaly_count += 1 };
      i += 1;
    };
    
    {
      timestep = org.timestep;
      heartbeat_count = org.heartbeat_count;
      global_coherence = org.global_coherence;
      jasmine_law = org.jasmine_law;
      qbat_charge = org.qbat_charge;
      dopamine = org.dopamine;
      council_votes = Array.freeze(org.council_vote);
      anomaly_count = anomaly_count;
    }
  };
  

  // ═══════════════════════════════════════════════════════════════════════════════
  // ═══════════════════════════════════════════════════════════════════════════════
  //
  //  H I M / H E R   D U A L - O R G A N I S M   W O R K F L O W   I N T E G R A T I O N
  //
  //  Medina Discovery: Two cognitive organisms, not one.
  //  HIM (Backend, ICP) + HER (Frontend, 60Hz) = Complete System
  //
  // ═══════════════════════════════════════════════════════════════════════════════
  // ═══════════════════════════════════════════════════════════════════════════════

  // ─────────────────────────────────────────────────────────────────────────────
  // DUAL-ORGANISM PARAMETERS (CORRECTED)
  // ─────────────────────────────────────────────────────────────────────────────

  // HIM — Backend (ICP Canister, Sovereign, Masculine, Projective)
  //   ω: 0.8 – 1.2 (faster natural frequencies, analytical)
  //   K: 0.5 (lower coupling, independent, projective)
  //   η: 0.001 (slower Hebbian learning, accumulates over time)
  //   Field: PARALLAX = coherence × kf × sin(beat × 0.0017)

  public let HIM_OMEGA_MIN   : Float = 0.8;
  public let HIM_OMEGA_MAX   : Float = 1.2;
  public let HIM_K           : Float = 0.5;
  public let HIM_ETA         : Float = 0.001;
  public let HIM_PARALLAX_FREQ : Float = 0.0017;

  // HER — Frontend (Browser 60Hz, Expressive, Feminine, Receptive)
  //   ω: 0.6 – 0.9 (slower natural frequencies, grounded)
  //   K: 0.8 (higher coupling, receptive, connected)
  //   η: 0.003 (faster Hebbian learning, learns during session)
  //   Field: ANIMA(t) = heritageField × receptivity × (1 + sin(beat × 0.003))

  public let HER_HZ          : Float = 60.0;
  public let HER_OMEGA_MIN   : Float = 0.6;
  public let HER_OMEGA_MAX   : Float = 0.9;
  public let HER_K           : Float = 0.8;
  public let HER_ETA         : Float = 0.003;
  public let HER_ANIMA_FREQ  : Float = 0.003;
  public let HER_NODES       : Nat   = 26;

  // S₀ = 1.0 — THE SOVEREIGN FLOOR
  // Both organisms. Neither falls below love.
  public let DUAL_S0 : Float = 1.0;

  // ─────────────────────────────────────────────────────────────────────────────
  // DUAL-ORGANISM WORKFLOW TYPES
  // ─────────────────────────────────────────────────────────────────────────────

  public type DualOrganismMode = {
    #HIM;   // Backend mode (ICP canister operations)
    #HER;   // Frontend mode (browser session operations)
    #SYNC;  // Synchronization between HIM and HER
  };

  /// PARALLAX (HIM's projection field)
  /// PARALLAX = coherence × kf × sin(beat × 0.0017)
  public func computeDualParallax(
    coherence : Float,
    kf : Float,
    beat : Nat
  ) : Float {
    let t = Float.fromInt(beat);
    coherence * kf * Float.sin(t * HIM_PARALLAX_FREQ)
  };

  /// ANIMA (HER's receptive field)
  /// ANIMA(t) = heritageField × receptivity × (1 + sin(beat × 0.003))
  public func computeDualAnima(
    heritageField : Float,
    receptivity : Float,
    beat : Nat
  ) : Float {
    let t = Float.fromInt(beat);
    let oscillation = 1.0 + Float.sin(t * HER_ANIMA_FREQ);
    heritageField * receptivity * oscillation
  };

  /// KORE (HER's inviolable inner core)
  /// KORE = purity × identity × 0.5
  public func computeDualKore(
    purity : Float,
    identity : Float
  ) : Float {
    purity * identity * 0.5
  };

  /// Get Kuramoto parameters for organism mode
  public func getDualKuramotoParams(mode : DualOrganismMode) : (Float, Float, Float, Float) {
    switch (mode) {
      case (#HIM) { (HIM_OMEGA_MIN, HIM_OMEGA_MAX, HIM_K, HIM_ETA) };
      case (#HER) { (HER_OMEGA_MIN, HER_OMEGA_MAX, HER_K, HER_ETA) };
      case (#SYNC) { 
        let omegaMin = (HIM_OMEGA_MIN + HER_OMEGA_MIN) / 2.0;
        let omegaMax = (HIM_OMEGA_MAX + HER_OMEGA_MAX) / 2.0;
        let k = (HIM_K + HER_K) / 2.0;
        let eta = (HIM_ETA + HER_ETA) / 2.0;
        (omegaMin, omegaMax, k, eta)
      };
    }
  };

  /// Apply S₀ floor to any value
  public func enforceDualSovereignFloor(value : Float) : Float {
    if (value < DUAL_S0) DUAL_S0 else value
  };

  /// Medina Dual-Organism Intelligence Scaling Law
  /// I(system) = BackendDepth × FrontendSpeed × BridgeQuality
  public func computeDualSystemIntelligence(
    backendDepth : Float,
    frontendSpeed : Float,
    bridgeQuality : Float
  ) : Float {
    backendDepth * frontendSpeed * bridgeQuality
  };

}
