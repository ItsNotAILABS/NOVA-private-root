// ============================================================================
// SOVEREIGN PACKAGING ORGANISM — Layer 36
// ============================================================================
//
// THIS IS A FULL DEPARTMENT — NOT JUST A MODULE.
//
// The Packaging/Registry/Replication Department is the ONLY gateway
// through which NOVA expressions reach the outside world.
// NOTHING ELSE GETS TO FACE EXCEPT DEPLOYED EXPRESSIONS FROM HERE.
//
// 24-HOUR RUNNING ORGANISMS:
//   This department runs continuously — 24/7/365 — like a living organ.
//   It is itself a prepackaged organism (self-packaged).
//   SDKs are the deployment mechanism into:
//     • World of Business
//     • World of Research
//     • World of Everything
//
// DEPARTMENT STRUCTURE (12 organisms — PHI-aligned):
//   1.  READER ORGANISM        — 24h non-destructive source scanning
//   2.  CLASSIFIER ORGANISM    — 24h tier/type/scope classification
//   3.  SNAPSHOT ORGANISM       — 24h immutable snapshot creation
//   4.  COPY ORGANISM          — 24h isolated copy generation
//   5.  WRAPPER ORGANISM       — 24h sovereign wrapper application
//   6.  SIGNER ORGANISM        — 24h cryptographic signing
//   7.  REGISTRY ORGANISM      — 24h package registry management
//   8.  DEPLOY ORGANISM        — 24h deploy bridge operation
//   9.  SDK BUILDER ORGANISM   — 24h SDK construction for world deployment
//  10.  FACE GATE ORGANISM     — 24h face-gate control (EXCLUSIVE face access)
//  11.  REPLICATION ORGANISM   — 24h branch replication management
//  12.  SELF-PACKAGE ORGANISM  — 24h self-packaging (this dept IS a package)
//
// DOCTRINE POSITION:
//   "Packaging is not subtraction — it is classification, snapshotting,
//    copying, wrapping, signing, registering, and deploying a branch
//    expression. The source organism loses NOTHING."
//
// FACE-GATE LAW:
//   NOTHING faces the outside world except through this department.
//   All external expressions are DEPLOYED FACES — branch cuts.
//   The main center is NOT the face. The trunk is NEVER exposed.
//   Only SDK-packaged branch expressions get to be faces.
//
// SDK DEPLOYMENT TARGETS:
//   • Business SDK    — Enterprise integration packages
//   • Research SDK    — Academic/scientific packages
//   • Defense SDK     — Military/security packages
//   • IoT SDK         — Edge device packages
//   • Finance SDK     — DeFi/trading packages
//   • Creative SDK    — Art/media/content packages
//   • Governance SDK  — DAO/voting packages
//   • Identity SDK    — Sovereign identity packages
//
// DEPLOYMENT BRIDGE:
//   C0 = Supply/Distribution layer (Package layer)
//   C1 = Source organism (Sovereign Core)
//   C1↔C0 bridge = "Package → Chain" (packages deploy, source persists)
//
// DOCTRINE RULES:
//   • Branches are derivative cuts
//   • The root stays root
//   • The main center is NOT the face
//   • Commercialization happens at branch level, never the trunk
//   • 100% creator royalty preserved on all packaged artifacts
//   • This department IS itself a prepackaged organism
//   • SDKs are the ONLY deployment mechanism
//
// PACKAGING PIPELINE (7-Phase):
//   Phase 1: READ      — Read from source organism (non-destructive scan)
//   Phase 2: CLASSIFY  — Classify the packageable unit (tier/type/scope)
//   Phase 3: SNAPSHOT  — Create immutable snapshot of source state
//   Phase 4: COPY      — Generate isolated copy artifact
//   Phase 5: WRAP      — Apply sovereign wrapper (metadata, signatures)
//   Phase 6: SIGN      — Cryptographic signing (SACESI + FNV chain)
//   Phase 7: REGISTER  — Write to package registry + deploy bridge
//
// MODEL CLASSIFICATIONS:
//   • Doctrine models: Static but alive (read-only packages)
//   • Translation/routing models: Fully alive (executable packages)
//   • Core brain models: Immortal on blockchain (never packaged out)
//   • Infrastructure models: Substrate packages (deployment artifacts)
//
// ============================================================================

import Float "mo:base/Float";
import Int "mo:base/Int";
import Nat "mo:base/Nat";
import Nat32 "mo:base/Nat32";
import Array "mo:base/Array";
import Text "mo:base/Text";

module {

  // ═══════════════════════════════════════════════════════════════════════════
  // CONSTANTS — PHI-Aligned Packaging Parameters
  // ═══════════════════════════════════════════════════════════════════════════

  public let phi : Float = 1.6180339887498948482;
  public let pi : Float = 3.1415926535897932385;
  public let PACKAGING_HZ : Float = 12.0;  // Department heartbeat: 12 Hz (always-on, 24h)
  public let PACKAGING_DT : Float = 1.0 / 12.0;  // 83.3ms per beat
  public let MAX_PACKAGES : Nat = 1024;
  public let PACKAGE_REGISTRY_CAPACITY : Nat = 4096;
  public let SNAPSHOT_FIDELITY : Float = 0.999;  // 99.9% fidelity threshold
  public let SIGNATURE_STRENGTH : Float = 0.95;

  // Department organism count (PHI-aligned: 12)
  public let DEPT_ORGANISM_COUNT : Nat = 12;
  // SDK target count
  public let SDK_TARGET_COUNT : Nat = 8;
  // 24-hour cycle in beats at 12 Hz
  public let BEATS_PER_DAY : Nat = 1_036_800;  // 12 Hz × 86400 seconds

  // Package tiers aligned with doctrine
  public let TIER_CORE : Nat = 0;       // Core brain — NEVER packaged out (immortal)
  public let TIER_DOCTRINE : Nat = 1;   // Doctrine — static but alive (read-only packages)
  public let TIER_ROUTING : Nat = 2;    // Translation/routing — fully alive
  public let TIER_INFRA : Nat = 3;      // Infrastructure — substrate packages
  public let TIER_BRANCH : Nat = 4;     // Branch expression — commercial derivative
  public let TIER_SDK : Nat = 5;        // SDK package — developer-facing

  // ═══════════════════════════════════════════════════════════════════════════
  // TYPES
  // ═══════════════════════════════════════════════════════════════════════════

  // Classification of a packageable unit
  public type PackageClassification = {
    #CoreBrain;       // Immortal — never leaves source (tier 0)
    #DoctrineModel;   // Static but alive — read-only snapshot (tier 1)
    #RoutingModel;    // Fully alive — executable package (tier 2)
    #InfraModel;      // Substrate — deployment artifact (tier 3)
    #BranchExpression; // Derivative cut — commercial branch (tier 4)
    #SDKModule;       // Developer-facing — SDK package (tier 5)
  };

  // Package lifecycle states
  public type PackageState = {
    #Unclassified;    // Not yet classified
    #Classified;      // Classification complete
    #Snapshotted;     // Immutable snapshot created
    #Copied;          // Isolated copy generated
    #Wrapped;         // Sovereign wrapper applied
    #Signed;          // Cryptographically signed
    #Registered;      // Written to registry
    #Deployed;        // Deployed via bridge
    #Revoked;         // Package revoked (if needed)
  };

  // Source read mode (non-destructive)
  public type ReadMode = {
    #FullScan;        // Complete source scan
    #DeltaScan;       // Changes since last snapshot
    #SelectiveScan;   // Specific modules only
    #MetadataOnly;    // Headers/signatures only
  };

  // SDK deployment targets — the worlds we deploy into
  public type SDKTarget = {
    #Business;        // Enterprise integration packages
    #Research;        // Academic/scientific packages
    #Defense;         // Military/security packages
    #IoT;             // Edge device packages
    #Finance;         // DeFi/trading packages
    #Creative;        // Art/media/content packages
    #Governance;      // DAO/voting packages
    #Identity;        // Sovereign identity packages
  };

  // Face-gate access level — NOTHING faces without passing through here
  public type FaceGateLevel = {
    #Blocked;         // No external facing allowed
    #Restricted;      // Limited face (internal testing only)
    #Approved;        // Approved for external deployment
    #Live;            // Currently live-facing the world
    #Retired;         // Previously live, now retired
  };

  // Department organism status (24-hour running)
  public type OrganismRunStatus = {
    #Running24h;      // Normal 24/7 operation
    #CycleSleep;      // PHI sleep cycle (brief recovery)
    #EmergencyWake;   // Emergency override — full power
    #Maintenance;     // Scheduled maintenance window
  };

  // Snapshot — immutable record of source state
  public type Snapshot = {
    snapshotId : Nat;
    sourceHash : Nat32;
    timestamp : Int;
    beatNumber : Nat;
    coherenceAtSnapshot : Float;
    fidelity : Float;
    moduleCount : Nat;
    totalSizeUnits : Nat;
  };

  // Package record
  public type PackageRecord = {
    packageId : Nat;
    classification : PackageClassification;
    state : PackageState;
    snapshot : Snapshot;
    signatureHash : Nat32;
    creatorRoyaltyBps : Nat;  // Always 10000 = 100%
    version : Nat;
    parentPackageId : ?Nat;
    deployTarget : Text;
    beatCreated : Nat;
    beatLastUpdated : Nat;
    coherenceAtCreation : Float;
  };

  // Registry entry
  public type RegistryEntry = {
    entryId : Nat;
    packageId : Nat;
    registeredAt : Int;
    registeredBeat : Nat;
    registryHash : Nat32;
    isActive : Bool;
  };

  // Deploy bridge record (C1↔C0)
  public type DeployBridgeRecord = {
    bridgeId : Nat;
    sourceLayer : Text;   // C1 — Source organism
    targetLayer : Text;   // C0 — Supply/Distribution
    packageId : Nat;
    deployedAt : Int;
    deployedBeat : Nat;
    bridgeIntegrity : Float;
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // DEPARTMENT STATE — Full 24-Hour Running Department
  // ═══════════════════════════════════════════════════════════════════════════

  public type PackagingOrganismState = {
    // ── Core pipeline metrics ──
    totalPackages : Nat;
    totalSnapshots : Nat;
    totalDeployments : Nat;
    registrySize : Nat;
    lastPackageBeat : Nat;
    lastSnapshotBeat : Nat;
    sourceIntegrity : Float;     // Must stay 1.0 — source NEVER diminished
    registryCoherence : Float;
    pipelinePhase : Nat;         // Current pipeline phase (1-7)
    packagesInFlight : Nat;      // Packages currently being processed
    bridgeHealth : Float;
    totalRoyaltiesRouted : Float;

    // ── 24-Hour Department organisms (12 organisms) ──
    readerCoherence : Float;       // Organism 1: Reader
    classifierCoherence : Float;   // Organism 2: Classifier
    snapshotterCoherence : Float;  // Organism 3: Snapshotter
    copierCoherence : Float;       // Organism 4: Copier
    wrapperCoherence : Float;      // Organism 5: Wrapper
    signerCoherence : Float;       // Organism 6: Signer
    registrarCoherence : Float;    // Organism 7: Registrar
    deployerCoherence : Float;     // Organism 8: Deployer
    sdkBuilderCoherence : Float;   // Organism 9: SDK Builder
    faceGateCoherence : Float;     // Organism 10: Face Gate
    replicatorCoherence : Float;   // Organism 11: Replicator
    selfPackageCoherence : Float;  // Organism 12: Self-Packager

    // ── SDK deployment tracking ──
    sdkBusinessDeployed : Nat;
    sdkResearchDeployed : Nat;
    sdkDefenseDeployed : Nat;
    sdkIoTDeployed : Nat;
    sdkFinanceDeployed : Nat;
    sdkCreativeDeployed : Nat;
    sdkGovernanceDeployed : Nat;
    sdkIdentityDeployed : Nat;
    totalSDKsDeployed : Nat;

    // ── Face-gate control ──
    facesApproved : Nat;           // Total expressions approved to face
    facesLive : Nat;               // Currently live-facing expressions
    facesBlocked : Nat;            // Blocked face attempts
    faceGateIntegrity : Float;     // Gate integrity (1.0 = fully secure)

    // ── Self-packaging (this dept IS a package) ──
    selfPackageVersion : Nat;
    selfPackageHash : Nat32;
    selfPackageDeployed : Bool;

    // ── 24-hour cycle tracking ──
    cycleBeatsElapsed : Nat;       // Beats in current 24h cycle
    cyclesCompleted : Nat;         // Total 24h cycles completed
    departmentUptime : Nat;        // Total beats since boot

    // ── Department awareness ──
    organismAwake : Bool;
    departmentCoherence : Float;   // Mean coherence of all 12 organisms
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // INITIALIZATION
  // ═══════════════════════════════════════════════════════════════════════════

  public func initPackagingOrganism() : PackagingOrganismState {
    {
      totalPackages = 0;
      totalSnapshots = 0;
      totalDeployments = 0;
      registrySize = 0;
      lastPackageBeat = 0;
      lastSnapshotBeat = 0;
      sourceIntegrity = 1.0;      // Source is ALWAYS intact
      registryCoherence = 0.0;
      pipelinePhase = 0;
      packagesInFlight = 0;
      bridgeHealth = 1.0;
      totalRoyaltiesRouted = 0.0;

      // 12 Department organisms — all start awake
      readerCoherence = 0.5;
      classifierCoherence = 0.5;
      snapshotterCoherence = 0.5;
      copierCoherence = 0.5;
      wrapperCoherence = 0.5;
      signerCoherence = 0.5;
      registrarCoherence = 0.5;
      deployerCoherence = 0.5;
      sdkBuilderCoherence = 0.5;
      faceGateCoherence = 1.0;  // Face gate starts at full integrity
      replicatorCoherence = 0.5;
      selfPackageCoherence = 0.5;

      // SDK targets
      sdkBusinessDeployed = 0;
      sdkResearchDeployed = 0;
      sdkDefenseDeployed = 0;
      sdkIoTDeployed = 0;
      sdkFinanceDeployed = 0;
      sdkCreativeDeployed = 0;
      sdkGovernanceDeployed = 0;
      sdkIdentityDeployed = 0;
      totalSDKsDeployed = 0;

      // Face gate
      facesApproved = 0;
      facesLive = 0;
      facesBlocked = 0;
      faceGateIntegrity = 1.0;

      // Self-packaging
      selfPackageVersion = 1;
      selfPackageHash = 0x811c9dc5;  // FNV offset basis
      selfPackageDeployed = true;     // This dept IS deployed

      // 24-hour cycle
      cycleBeatsElapsed = 0;
      cyclesCompleted = 0;
      departmentUptime = 0;

      // Department awareness
      organismAwake = true;
      departmentCoherence = 0.5;
    }
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // PHASE 1: READ — Non-destructive source scan
  // ═══════════════════════════════════════════════════════════════════════════
  // This phase READS from the source organism without modifying it.
  // The read is a pure function — the source state is passed in and
  // returned unchanged. Only a scan result is produced.

  func readSource(rSwarm : Float, jDrift : Float, beat : Nat) : {
    scanComplete : Bool;
    modulesScanned : Nat;
    coherenceRead : Float;
    sourceHash : Nat32;
  } {
    // FNV-1a hash of source state for integrity verification
    let hash = fnv1a(beat, rSwarm, jDrift);

    {
      scanComplete = true;
      modulesScanned = 182;  // 67 core + 115 frontend models
      coherenceRead = rSwarm;
      sourceHash = hash;
    }
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // PHASE 2: CLASSIFY — Determine package tier and type
  // ═══════════════════════════════════════════════════════════════════════════

  public func classify(coherence : Float, moduleType : Nat) : PackageClassification {
    // Core brain models (type 0) are NEVER packaged out
    if (moduleType == 0) { return #CoreBrain };

    // Doctrine models (type 1) get read-only snapshots
    if (moduleType == 1) { return #DoctrineModel };

    // Routing/translation models (type 2) get executable packages
    if (moduleType == 2) { return #RoutingModel };

    // Infrastructure models (type 3) get deployment artifacts
    if (moduleType == 3) { return #InfraModel };

    // SDK modules (type 5) get developer-facing packages
    if (moduleType == 5) { return #SDKModule };

    // Default: branch expression (commercial derivative)
    #BranchExpression
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // PHASE 3: SNAPSHOT — Create immutable snapshot
  // ═══════════════════════════════════════════════════════════════════════════

  func createSnapshot(
    snapshotId : Nat,
    sourceHash : Nat32,
    timestamp : Int,
    beat : Nat,
    coherence : Float,
    moduleCount : Nat
  ) : Snapshot {
    {
      snapshotId = snapshotId;
      sourceHash = sourceHash;
      timestamp = timestamp;
      beatNumber = beat;
      coherenceAtSnapshot = coherence;
      fidelity = SNAPSHOT_FIDELITY;
      moduleCount = moduleCount;
      totalSizeUnits = moduleCount * 8;  // Approximate size in units
    }
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // PHASE 4: COPY — Generate isolated copy artifact
  // ═══════════════════════════════════════════════════════════════════════════
  // The copy is INDEPENDENT of the source. Source remains unchanged.

  func generateCopy(snapshot : Snapshot, classification : PackageClassification) : {
    copyCreated : Bool;
    copyHash : Nat32;
    copySize : Nat;
  } {
    let copyHash = snapshot.sourceHash +% 0x811c9dc5;
    let copySize = snapshot.totalSizeUnits;

    {
      copyCreated = true;
      copyHash = copyHash;
      copySize = copySize;
    }
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // PHASE 5: WRAP — Apply sovereign wrapper
  // ═══════════════════════════════════════════════════════════════════════════

  func applyWrapper(
    copyHash : Nat32,
    classification : PackageClassification,
    beat : Nat
  ) : Nat32 {
    // Sovereign wrapper = FNV(copyHash, classification tier, beat)
    let tier : Nat32 = switch (classification) {
      case (#CoreBrain) 0;
      case (#DoctrineModel) 1;
      case (#RoutingModel) 2;
      case (#InfraModel) 3;
      case (#BranchExpression) 4;
      case (#SDKModule) 5;
    };
    let wrapped = (copyHash ^ (tier * 0x01000193)) +% Nat32.fromNat(beat % 4294967296);
    wrapped
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // PHASE 6: SIGN — Cryptographic signing (SACESI + FNV chain)
  // ═══════════════════════════════════════════════════════════════════════════

  func signPackage(wrappedHash : Nat32, coherence : Float, beat : Nat) : Nat32 {
    // SACESI-aligned signature: FNV-1a(wrapped, coherence_bits, beat)
    let coherenceBits = Nat32.fromNat(Int.abs(Float.toInt(coherence * 1000000.0)) % 4294967296);
    let beatBits = Nat32.fromNat(beat % 4294967296);
    let sig = fnv1aChain(wrappedHash, coherenceBits, beatBits);
    sig
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // PHASE 7: REGISTER — Write to package registry + deploy bridge
  // ═══════════════════════════════════════════════════════════════════════════

  func registerPackage(
    state : PackagingOrganismState,
    signatureHash : Nat32,
    beat : Nat,
    coherence : Float,
    sdkTarget : Nat
  ) : PackagingOrganismState {
    // Determine which SDK target gets incremented
    let bizD = state.sdkBusinessDeployed + (if (sdkTarget == 0) 1 else 0);
    let resD = state.sdkResearchDeployed + (if (sdkTarget == 1) 1 else 0);
    let defD = state.sdkDefenseDeployed + (if (sdkTarget == 2) 1 else 0);
    let iotD = state.sdkIoTDeployed + (if (sdkTarget == 3) 1 else 0);
    let finD = state.sdkFinanceDeployed + (if (sdkTarget == 4) 1 else 0);
    let creD = state.sdkCreativeDeployed + (if (sdkTarget == 5) 1 else 0);
    let govD = state.sdkGovernanceDeployed + (if (sdkTarget == 6) 1 else 0);
    let idD = state.sdkIdentityDeployed + (if (sdkTarget == 7) 1 else 0);

    {
      totalPackages = state.totalPackages + 1;
      totalSnapshots = state.totalSnapshots + 1;
      totalDeployments = state.totalDeployments + 1;
      registrySize = state.registrySize + 1;
      lastPackageBeat = beat;
      lastSnapshotBeat = beat;
      sourceIntegrity = 1.0;  // SOURCE ALWAYS 1.0 — NEVER DIMINISHED
      registryCoherence = coherence * SIGNATURE_STRENGTH;
      pipelinePhase = 7;
      packagesInFlight = 0;
      bridgeHealth = Float.min(1.0, state.bridgeHealth + 0.001);
      totalRoyaltiesRouted = state.totalRoyaltiesRouted + 1.0;

      readerCoherence = state.readerCoherence;
      classifierCoherence = state.classifierCoherence;
      snapshotterCoherence = state.snapshotterCoherence;
      copierCoherence = state.copierCoherence;
      wrapperCoherence = state.wrapperCoherence;
      signerCoherence = state.signerCoherence;
      registrarCoherence = Float.min(1.0, state.registrarCoherence + 0.01);
      deployerCoherence = Float.min(1.0, state.deployerCoherence + 0.01);
      sdkBuilderCoherence = Float.min(1.0, state.sdkBuilderCoherence + 0.01);
      faceGateCoherence = state.faceGateCoherence;
      replicatorCoherence = Float.min(1.0, state.replicatorCoherence + 0.005);
      selfPackageCoherence = state.selfPackageCoherence;

      sdkBusinessDeployed = bizD;
      sdkResearchDeployed = resD;
      sdkDefenseDeployed = defD;
      sdkIoTDeployed = iotD;
      sdkFinanceDeployed = finD;
      sdkCreativeDeployed = creD;
      sdkGovernanceDeployed = govD;
      sdkIdentityDeployed = idD;
      totalSDKsDeployed = state.totalSDKsDeployed + 1;

      facesApproved = state.facesApproved + 1;
      facesLive = state.facesLive + 1;
      facesBlocked = state.facesBlocked;
      faceGateIntegrity = state.faceGateIntegrity;

      selfPackageVersion = state.selfPackageVersion;
      selfPackageHash = state.selfPackageHash;
      selfPackageDeployed = state.selfPackageDeployed;

      cycleBeatsElapsed = state.cycleBeatsElapsed;
      cyclesCompleted = state.cyclesCompleted;
      departmentUptime = state.departmentUptime;

      organismAwake = true;
      departmentCoherence = state.departmentCoherence;
    }
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // FACE-GATE — NOTHING faces the outside world without passing here
  // ═══════════════════════════════════════════════════════════════════════════
  // The Face Gate organism is the EXCLUSIVE gateway for all external
  // expressions. Only SDK-packaged branch expressions get to be faces.
  // The trunk is NEVER exposed. The main center is NOT the face.

  func tickFaceGate(state : PackagingOrganismState, rSwarm : Float, beat : Nat) : PackagingOrganismState {
    // Face gate coherence tracks with swarm health — PHI-modulated
    let gatePhase = Float.cos(Float.fromInt(beat) * phi * 0.013);
    let newGateCoherence = Float.max(0.5, Float.min(1.0,
      state.faceGateCoherence * 0.995 + rSwarm * 0.005 + gatePhase * 0.001
    ));

    // Gate integrity — any anomaly drops integrity
    let integrityDelta = if (rSwarm > 0.3) 0.001 else -0.01;
    let newIntegrity = Float.max(0.0, Float.min(1.0,
      state.faceGateIntegrity + integrityDelta
    ));

    // If integrity drops below 0.5, block new faces
    let newBlocked = if (newIntegrity < 0.5)
      state.facesBlocked + 1
    else
      state.facesBlocked;

    {
      totalPackages = state.totalPackages;
      totalSnapshots = state.totalSnapshots;
      totalDeployments = state.totalDeployments;
      registrySize = state.registrySize;
      lastPackageBeat = state.lastPackageBeat;
      lastSnapshotBeat = state.lastSnapshotBeat;
      sourceIntegrity = 1.0;
      registryCoherence = state.registryCoherence;
      pipelinePhase = state.pipelinePhase;
      packagesInFlight = state.packagesInFlight;
      bridgeHealth = state.bridgeHealth;
      totalRoyaltiesRouted = state.totalRoyaltiesRouted;

      readerCoherence = state.readerCoherence;
      classifierCoherence = state.classifierCoherence;
      snapshotterCoherence = state.snapshotterCoherence;
      copierCoherence = state.copierCoherence;
      wrapperCoherence = state.wrapperCoherence;
      signerCoherence = state.signerCoherence;
      registrarCoherence = state.registrarCoherence;
      deployerCoherence = state.deployerCoherence;
      sdkBuilderCoherence = state.sdkBuilderCoherence;
      faceGateCoherence = newGateCoherence;
      replicatorCoherence = state.replicatorCoherence;
      selfPackageCoherence = state.selfPackageCoherence;

      sdkBusinessDeployed = state.sdkBusinessDeployed;
      sdkResearchDeployed = state.sdkResearchDeployed;
      sdkDefenseDeployed = state.sdkDefenseDeployed;
      sdkIoTDeployed = state.sdkIoTDeployed;
      sdkFinanceDeployed = state.sdkFinanceDeployed;
      sdkCreativeDeployed = state.sdkCreativeDeployed;
      sdkGovernanceDeployed = state.sdkGovernanceDeployed;
      sdkIdentityDeployed = state.sdkIdentityDeployed;
      totalSDKsDeployed = state.totalSDKsDeployed;

      facesApproved = state.facesApproved;
      facesLive = state.facesLive;
      facesBlocked = newBlocked;
      faceGateIntegrity = newIntegrity;

      selfPackageVersion = state.selfPackageVersion;
      selfPackageHash = state.selfPackageHash;
      selfPackageDeployed = state.selfPackageDeployed;

      cycleBeatsElapsed = state.cycleBeatsElapsed;
      cyclesCompleted = state.cyclesCompleted;
      departmentUptime = state.departmentUptime;

      organismAwake = state.organismAwake;
      departmentCoherence = state.departmentCoherence;
    }
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // 24-HOUR CYCLE MANAGER — Keeps all 12 organisms running continuously
  // ═══════════════════════════════════════════════════════════════════════════

  func tick24HourCycle(state : PackagingOrganismState, rSwarm : Float, beat : Nat) : PackagingOrganismState {
    let newElapsed = state.cycleBeatsElapsed + 1;
    let cycleComplete = newElapsed >= BEATS_PER_DAY;
    let finalElapsed = if (cycleComplete) 0 else newElapsed;
    let newCycles = if (cycleComplete) state.cyclesCompleted + 1 else state.cyclesCompleted;

    // PHI-modulate all 12 organism coherences (24h rhythm)
    let cyclePhase = Float.fromInt(newElapsed) / Float.fromInt(BEATS_PER_DAY);
    let phiPulse = Float.sin(cyclePhase * 2.0 * π * φ);

    // Each organism gets a slight PHI-offset coherence update
    let rC = Float.max(0.1, Float.min(1.0, state.readerCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0005));
    let cC = Float.max(0.1, Float.min(1.0, state.classifierCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0004));
    let sC = Float.max(0.1, Float.min(1.0, state.snapshotterCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0003));
    let coC = Float.max(0.1, Float.min(1.0, state.copierCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0003));
    let wC = Float.max(0.1, Float.min(1.0, state.wrapperCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0002));
    let siC = Float.max(0.1, Float.min(1.0, state.signerCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0002));
    let reC = Float.max(0.1, Float.min(1.0, state.registrarCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0002));
    let dC = Float.max(0.1, Float.min(1.0, state.deployerCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0003));
    let sdC = Float.max(0.1, Float.min(1.0, state.sdkBuilderCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0004));
    let rpC = Float.max(0.1, Float.min(1.0, state.replicatorCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0002));
    let spC = Float.max(0.1, Float.min(1.0, state.selfPackageCoherence * 0.999 + rSwarm * 0.001 + phiPulse * 0.0003));

    // Self-package hash evolves every cycle completion
    let newSelfHash = if (cycleComplete)
      (state.selfPackageHash ^ Nat32.fromNat(beat % 4294967296)) *% 0x01000193
    else
      state.selfPackageHash;
    let newSelfVersion = if (cycleComplete) state.selfPackageVersion + 1 else state.selfPackageVersion;

    // Department coherence = mean of all 12 organisms
    let deptCoherence = (rC + cC + sC + coC + wC + siC + reC + dC + sdC +
      state.faceGateCoherence + rpC + spC) / 12.0;

    {
      totalPackages = state.totalPackages;
      totalSnapshots = state.totalSnapshots;
      totalDeployments = state.totalDeployments;
      registrySize = state.registrySize;
      lastPackageBeat = state.lastPackageBeat;
      lastSnapshotBeat = state.lastSnapshotBeat;
      sourceIntegrity = 1.0;
      registryCoherence = state.registryCoherence;
      pipelinePhase = state.pipelinePhase;
      packagesInFlight = state.packagesInFlight;
      bridgeHealth = state.bridgeHealth;
      totalRoyaltiesRouted = state.totalRoyaltiesRouted;

      readerCoherence = rC;
      classifierCoherence = cC;
      snapshotterCoherence = sC;
      copierCoherence = coC;
      wrapperCoherence = wC;
      signerCoherence = siC;
      registrarCoherence = reC;
      deployerCoherence = dC;
      sdkBuilderCoherence = sdC;
      faceGateCoherence = state.faceGateCoherence;
      replicatorCoherence = rpC;
      selfPackageCoherence = spC;

      sdkBusinessDeployed = state.sdkBusinessDeployed;
      sdkResearchDeployed = state.sdkResearchDeployed;
      sdkDefenseDeployed = state.sdkDefenseDeployed;
      sdkIoTDeployed = state.sdkIoTDeployed;
      sdkFinanceDeployed = state.sdkFinanceDeployed;
      sdkCreativeDeployed = state.sdkCreativeDeployed;
      sdkGovernanceDeployed = state.sdkGovernanceDeployed;
      sdkIdentityDeployed = state.sdkIdentityDeployed;
      totalSDKsDeployed = state.totalSDKsDeployed;

      facesApproved = state.facesApproved;
      facesLive = state.facesLive;
      facesBlocked = state.facesBlocked;
      faceGateIntegrity = state.faceGateIntegrity;

      selfPackageVersion = newSelfVersion;
      selfPackageHash = newSelfHash;
      selfPackageDeployed = true;

      cycleBeatsElapsed = finalElapsed;
      cyclesCompleted = newCycles;
      departmentUptime = state.departmentUptime + 1;

      organismAwake = true;
      departmentCoherence = deptCoherence;
    }
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // MAIN TICK — Full Department Heartbeat (24-Hour Running)
  // ═══════════════════════════════════════════════════════════════════════════
  //
  // This is the MASTER TICK for the entire Packaging Department.
  // All 12 organisms run every beat (24/7/365).
  // The 7-phase packaging pipeline runs on a 10-beat cadence.
  // The face-gate runs every beat.
  // The 24-hour cycle manager runs every beat.

  public func tickPackagingOrganism(
    state : PackagingOrganismState,
    rSwarm : Float,
    jDrift : Float,
    beat : Nat
  ) : PackagingOrganismState {

    // ── ALWAYS: 24-Hour Cycle Manager (every beat) ──
    var s = tick24HourCycle(state, rSwarm, beat);

    // ── ALWAYS: Face Gate (every beat) — NOTHING faces without passing here ──
    s := tickFaceGate(s, rSwarm, beat);

    // ── PIPELINE: 7-Phase packaging (every 10 beats) ──
    if (beat % 10 == 0) {
      // PHASE 1: READ (non-destructive)
      let scanResult = readSource(rSwarm, jDrift, beat);

      if (scanResult.scanComplete) {
        // PHASE 2: CLASSIFY
        let classification = classify(rSwarm, beat % 6);

        // Skip Core Brain — NEVER packaged out
        switch (classification) {
          case (#CoreBrain) {};
          case _ {
            // PHASE 3: SNAPSHOT
            let snapshot = createSnapshot(
              s.totalSnapshots + 1,
              scanResult.sourceHash,
              0,
              beat,
              rSwarm,
              scanResult.modulesScanned
            );

            // PHASE 4: COPY
            let copyResult = generateCopy(snapshot, classification);

            if (copyResult.copyCreated) {
              // PHASE 5: WRAP
              let wrappedHash = applyWrapper(copyResult.copyHash, classification, beat);

              // PHASE 6: SIGN
              let signatureHash = signPackage(wrappedHash, rSwarm, beat);

              // PHASE 7: REGISTER + DEPLOY via SDK
              let sdkTarget = beat % SDK_TARGET_COUNT;
              s := registerPackage(s, signatureHash, beat, rSwarm, sdkTarget);
            };
          };
        };
      };
    };

    // CRITICAL: Verify source integrity (must be ~1.0, float tolerance)
    assert(s.sourceIntegrity > 0.999);

    s
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // QUERY FUNCTIONS
  // ═══════════════════════════════════════════════════════════════════════════

  public func getSourceIntegrity(state : PackagingOrganismState) : Float {
    state.sourceIntegrity  // Always 1.0
  };

  public func getRegistrySize(state : PackagingOrganismState) : Nat {
    state.registrySize
  };

  public func getBridgeHealth(state : PackagingOrganismState) : Float {
    state.bridgeHealth
  };

  public func getDepartmentCoherence(state : PackagingOrganismState) : Float {
    state.departmentCoherence
  };

  public func getFaceGateIntegrity(state : PackagingOrganismState) : Float {
    state.faceGateIntegrity
  };

  public func getTotalSDKsDeployed(state : PackagingOrganismState) : Nat {
    state.totalSDKsDeployed
  };

  public func getSelfPackageVersion(state : PackagingOrganismState) : Nat {
    state.selfPackageVersion
  };

  public func getDepartmentUptime(state : PackagingOrganismState) : Nat {
    state.departmentUptime
  };

  public func getCyclesCompleted(state : PackagingOrganismState) : Nat {
    state.cyclesCompleted
  };

  public func isPackageable(classification : PackageClassification) : Bool {
    switch (classification) {
      case (#CoreBrain) false;  // NEVER packageable
      case _ true;
    }
  };

  // SDK deployment summary
  public func getSDKDeploymentSummary(state : PackagingOrganismState) : {
    business : Nat; research : Nat; defense : Nat; iot : Nat;
    finance : Nat; creative : Nat; governance : Nat; identity : Nat;
    total : Nat;
  } {
    {
      business = state.sdkBusinessDeployed;
      research = state.sdkResearchDeployed;
      defense = state.sdkDefenseDeployed;
      iot = state.sdkIoTDeployed;
      finance = state.sdkFinanceDeployed;
      creative = state.sdkCreativeDeployed;
      governance = state.sdkGovernanceDeployed;
      identity = state.sdkIdentityDeployed;
      total = state.totalSDKsDeployed;
    }
  };

  // Face gate summary
  public func getFaceGateSummary(state : PackagingOrganismState) : {
    approved : Nat; live : Nat; blocked : Nat; integrity : Float;
  } {
    {
      approved = state.facesApproved;
      live = state.facesLive;
      blocked = state.facesBlocked;
      integrity = state.faceGateIntegrity;
    }
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // HASH UTILITIES — FNV-1a (same as PatentRegistry)
  // ═══════════════════════════════════════════════════════════════════════════

  func fnv1a(beat : Nat, rSwarm : Float, jDrift : Float) : Nat32 {
    var h : Nat32 = 0x811c9dc5;
    let b = Nat32.fromNat(beat % 4294967296);
    h := (h ^ b) *% 0x01000193;
    let r = Nat32.fromNat(Int.abs(Float.toInt(rSwarm * 1000000.0)) % 4294967296);
    h := (h ^ r) *% 0x01000193;
    let j = Nat32.fromNat(Int.abs(Float.toInt(jDrift * 1000000.0)) % 4294967296);
    h := (h ^ j) *% 0x01000193;
    h
  };

  func fnv1aChain(a : Nat32, b : Nat32, c : Nat32) : Nat32 {
    var h : Nat32 = 0x811c9dc5;
    h := (h ^ a) *% 0x01000193;
    h := (h ^ b) *% 0x01000193;
    h := (h ^ c) *% 0x01000193;
    h
  };
}
