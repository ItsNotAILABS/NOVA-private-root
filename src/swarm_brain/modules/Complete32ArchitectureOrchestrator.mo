  // 19. Bird Pallium
  public type BirdState = {
    nidopalliumCaudolaterale : Float; // NCL = PFC equivalent
    hyperstriatum : Float;            // Tool use
    songCircuit : {
      hvc : [Float];                  // 16 neurons
      ra : [Float];                   // 16 neurons
      timing : Float;
    };
    magneticSensing : Float;          // Beak particles
