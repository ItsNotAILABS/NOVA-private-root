  // ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
  // TIER 5: VERTEBRATE ARCHETYPES
  // ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────

  // 14. Lamprey Brainstem
  public type LampreyState = {
    reticularFormation : [Float];     // 16 neurons
    reticulospinalTract : [Float];
    cranialNerveNuclei : [Float];
