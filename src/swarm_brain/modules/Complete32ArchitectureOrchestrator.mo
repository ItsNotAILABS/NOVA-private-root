    workingMemory : [Float];          // 8 slots
    mirrorNeurons : [Float];          // 32 neurons
    defaultModeNetwork : Float;       // Self-model
    hippocampus : [Float];            // 32 place cells
    amygdala : Float;
    theoryOfMind : Float;
  };

