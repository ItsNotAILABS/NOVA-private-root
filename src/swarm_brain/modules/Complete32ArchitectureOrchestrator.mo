  };

  // 20. Bat Echolocation
  public type BatState = {
    inferiorColliculus : [Float];     // 64 frequency bands
    auditoryCortex : [Float];         // 256 neurons
    dopplerShiftNeurons : [Float];
    timeDelayNeurons : [Float];       // Distance encoding
    callGeneration : Float;
    targetTracking : [Float];         // 8 targets
  };

  // 21. Cetacean Neocortex
  public type CetaceanState = {
    neocortex : [Float];              // 256 high-density
    paralimbicLobe : Float;           // Social/emotional
    vonEconomoNeurons : Float;
    unihemisphericSleep : (Float, Float);  // L/R hemispheres
    echolocationProcessing : [Float];
    socialBonding : Float;
  };

  // 22. Elephant Brain
  public type ElephantState = {
