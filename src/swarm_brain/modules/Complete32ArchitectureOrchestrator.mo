    returning : Bool;
  };

  public type DanceSignal = {
    direction : Float;                // Angle to sun
    distance : Float;
    quality : Float;
    signalStrength : Float;
  };

  // 32. Murmuration (Starling Swarm)
  public type MurmurationState = {
    birdPositions : [(Float, Float, Float)];  // 64 birds, 3D
    birdVelocities : [(Float, Float, Float)];
    neighborCoupling : [[Nat]];       // 7 neighbors each
    globalCoherence : Float;
    flockCenter : (Float, Float, Float);
    flockSpread : Float;
    predatorAvoidance : Float;
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // UNIFIED 32-ARCHITECTURE STATE
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public type Complete32State = {
    // Tier 1
    cnidarian : CnidarianState;
    echinoderm : EchinodermState;
    porifera : PoriferaState;
    
    // Tier 2
    flatworm : FlatwormState;
    annelid : AnnelidState;
    mollusc : MolluscState;
    
    // Tier 3
    insectMB : InsectMBState;
    crustacean : CrustaceanState;
    chelicerate : ChelicerateState;
    myriapod : MyriapodState;
    
    // Tier 4
    octopus : OctopusState;
    squid : SquidState;
    nautilus : NautilusState;
    
    // Tier 5
    lamprey : LampreyState;
    shark : SharkState;
    teleost : TeleostState;
    amphibian : AmphibianState;
    reptile : ReptileState;
    bird : BirdState;
    bat : BatState;
    cetacean : CetaceanState;
    elephant : ElephantState;
    primate : PrimateState;
    
    // Tier 6
    electricFish : ElectricFishState;
    platypus : PlatypusState;
    mantisShrimp : MantisState;
    starNosed : StarNosedState;
    
    // Tier 7
    slimeMold : SlimeMoldState;
    antColony : AntColonyState;
    termiteColony : TermiteColonyState;
    beeColony : BeeColonyState;
    murmuration : MurmurationState;
    
    // Integration
    tierOutputs : [Float];            // 7 tier-level outputs
    architectureWeights : [Float];    // 32 weights
    crossTierSynergies : [[Float]];   // 7×7 synergy matrix
    emergentCoherence : Float;
    
    // Timing
    beatNum : Nat;
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // HELPER FUNCTIONS
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  func _clamp(x: Float, lo: Float, hi: Float) : Float {
    if (x < lo) { lo } else if (x > hi) { hi } else { x }
  };

  func _abs(x: Float) : Float {
    if (x < 0.0) { -x } else { x }
  };

  func _sin(x: Float) : Float {
    Math.sinPrecise(x)
  };

  func _cos(x: Float) : Float {
    Math.cosPrecise(x)
  };

  func _exp(x: Float) : Float {
    Math.expPrecise(x)
  };

  func _tanh(x: Float) : Float {
    Math.tanhPrecise(x)
  };

  func _sigmoid(x: Float) : Float {
    1.0 / (1.0 + _exp(-x))
  };

  func _medinaSigmoid(x: Float) : Float {
    1.0 / (1.0 + _exp(-PHI_MEDINA * x))
  };

  func arrayMean(arr: [Float]) : Float {
    let n = arr.size();
    if (n == 0) { return S0 };
    var sum : Float = 0.0;
    for (x in arr.vals()) { sum += x };
    sum / Float.fromInt(n)
  };

  func arrayMax(arr: [Float]) : Float {
    var max : Float = -1.0e10;
    for (x in arr.vals()) { if (x > max) { max := x } };
    max
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // TIER 1 UPDATE FUNCTIONS — Diffuse/Non-Centralized
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  // 1. Cnidarian Nerve Net — Radial Diffusion
  public func updateCnidarian(state: CnidarianState, beatNum: Nat) : CnidarianState {
    let n = state.signalField.size();
    
    // Diffusion equation: S(t+1) = S(t) + D×∇²S - β×S
    let D = 0.25;  // Diffusion coefficient
    let beta = 0.1; // Decay
    
    let newField = Array.tabulate<Float>(n, func(i: Nat) : Float {
      let current = state.signalField[i];
      let left = if (i > 0) { state.signalField[i-1] } else { current };
      let right = if (i < n-1) { state.signalField[i+1] } else { current };
      let laplacian = left + right - 2.0*current;
      _clamp(current + D*laplacian - beta*current, 0.0, SOVEREIGN_CEILING)
    });
    
    // Update pacemakers with Kuramoto coupling
    let K = 0.3; // Coupling strength
    let newPacemakers = Array.tabulate<Float>(state.pacemakers.size(), func(i: Nat) : Float {
      var phase = state.pacemakers[i];
      let omega = 1.0 + 0.1 * Float.fromInt(i % 3);
      
      // Coupling term
      var coupling : Float = 0.0;
      for (j in Iter.range(0, state.pacemakers.size() - 1)) {
        if (j != i) {
          coupling += _sin(state.pacemakers[j] - phase);
        };
      };
      coupling *= K / Float.fromInt(state.pacemakers.size() - 1);
      
      phase += (omega + coupling) * 0.1;
      while (phase > 2.0 * PI) { phase -= 2.0 * PI };
      phase
    });
    
    // Compute rhythm coherence using Kuramoto order parameter
    var realSum : Float = 0.0;
    var imagSum : Float = 0.0;
    for (p in newPacemakers.vals()) {
      realSum += _cos(p);
      imagSum += _sin(p);
    };
    let r = Float.sqrt(realSum*realSum + imagSum*imagSum) / Float.fromInt(newPacemakers.size());
    
    // Contraction from pacemaker sum
    var pacemakerSum : Float = 0.0;
    for (p in newPacemakers.vals()) {
      pacemakerSum += _sin(p);
    };
    let contraction = pacemakerSum / Float.fromInt(newPacemakers.size());
    
    {
      signalField = newField;
      pacemakers = newPacemakers;
      rhythmCoherence = r;
      contractionForce = contraction;
      cnidocytesReady = if (beatNum % 100 == 0) { 200 } else { state.cnidocytesReady };
      swimPhase = state.swimPhase + r * 0.1;
    }
  };

  // 2. Echinoderm — Radial with Arm Autonomy
  public func updateEchinoderm(state: EchinodermState, beatNum: Nat) : EchinodermState {
    let numArms = 5;
    
    // Central ring integrates but doesn't dominate
    let armMean = arrayMean(state.armActivations);
    let newCentralRing = state.centralRing * 0.9 + armMean * 0.1;
    
    // Each arm has semi-autonomous control
    let newArmActivations = Array.tabulate<Float>(numArms, func(i: Nat) : Float {
      let current = state.armActivations[i];
      let autonomy = state.armAutonomy[i];
      
      // Blend local and central signals based on autonomy
      let localSignal = current * 0.9 + 0.1 * _sin(Float.fromInt(beatNum + i * 10) * 0.1);
      let centralSignal = newCentralRing;
      
      autonomy * localSignal + (1.0 - autonomy) * centralSignal
    });
    
    // Update tube foot pressure for locomotion
    let newTubeFeet = Array.tabulate<Float>(state.tubeFootPressure.size(), func(i: Nat) : Float {
      let arm = i / (state.tubeFootPressure.size() / numArms);
      let armPhase = Float.fromInt(arm) * 2.0 * PI / Float.fromInt(numArms);
      let wavePhase = Float.fromInt(beatNum) * 0.1;
      _clamp(_sin(wavePhase + armPhase) * 0.5 + 0.5, 0.0, 1.0)
    });
    
    {
      armActivations = newArmActivations;
      centralRing = newCentralRing;
      armAutonomy = state.armAutonomy;
      tubeFootPressure = newTubeFeet;
      waterVascularFlow = _clamp(armMean * 0.8 + 0.2, 0.0, 1.0);
      regenerationState = state.regenerationState;
    }
  };

  // 3. Porifera — Calcium Wave Propagation (No Neurons)
  public func updatePorifera(state: PoriferaState, beatNum: Nat) : PoriferaState {
    let n = state.calciumWaves.size();
    let D_Ca = 0.15;
    let k_pump = 0.05;
    let k_release = 0.3;
    let theta = 0.5;
    
    // Calcium-induced calcium release (CICR)
    let newWaves = Array.tabulate<Float>(n, func(i: Nat) : Float {
      let current = state.calciumWaves[i];
      let left = if (i > 0) { state.calciumWaves[i-1] } else { current };
      let right = if (i < n-1) { state.calciumWaves[i+1] } else { current };
      
      let laplacian = left + right - 2.0*current;
      let diffusion = D_Ca * laplacian;
      let pumping = k_pump * current;
      let release = if (current > theta) { k_release } else { 0.0 };
      
      _clamp(current + diffusion - pumping + release, 0.0, 2.0)
    });
    
    let avgCalcium = arrayMean(newWaves);
    let contraction = _sigmoid((avgCalcium - 0.5) * 4.0);
    
    {
      calciumWaves = newWaves;
      contractionState = contraction;
      oscularOpening = 1.0 - contraction * 0.5;
      waterFlowRate = state.oscularOpening * (1.0 - contraction);
      filteringEfficiency = _clamp(state.waterFlowRate * 0.8, 0.0, 1.0);
    }
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // TIER 2 UPDATE FUNCTIONS — Ganglion/Ladder
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  // 4. Flatworm Ladder Brain
  public func updateFlatworm(state: FlatwormState, beatNum: Nat) : FlatwormState {
    // Bilateral cerebral ganglia (first centralization in evolution)
    let (leftG, rightG) = state.cerebralGanglia;
    let photoInput = (state.photoreceptors.0 + state.photoreceptors.1) / 2.0;
    let chemInput = state.chemoreceptors;
    
    // Ganglia integrate sensory and commissural input
    let newLeftG = _clamp(leftG * 0.8 + rightG * 0.1 + photoInput * 0.05 + chemInput * 0.05, 0.0, 1.0);
    let newRightG = _clamp(rightG * 0.8 + leftG * 0.1 + photoInput * 0.05 + chemInput * 0.05, 0.0, 1.0);
    
    // Nerve cords propagate signals posteriorly
    let n = state.nerveCords.size();
    let newCords = Array.tabulate<Float>(n, func(i: Nat) : Float {
      let anterior = if (i > 0) { state.nerveCords[i-1] } else { (newLeftG + newRightG) / 2.0 };
      _clamp(state.nerveCords[i] * 0.7 + anterior * 0.3, 0.0, 1.0)
    });
    
    // Commissures (rungs) synchronize the two cords
    let newCommissures = Array.tabulate<Float>(state.commissures.size(), func(i: Nat) : Float {
      let leftCord = newCords[i * 2];
      let rightCord = if (i * 2 + 1 < n) { newCords[i * 2 + 1] } else { leftCord };
      _abs(leftCord - rightCord) * 0.5 + (leftCord + rightCord) * 0.25
    });
    
    // Locomotion wave for gliding
    let locomotion = _sin(Float.fromInt(beatNum) * 0.2) * arrayMean(newCords);
    
    {
      cerebralGanglia = (newLeftG, newRightG);
      nerveCords = newCords;
      commissures = newCommissures;
      photoreceptors = state.photoreceptors;
      chemoreceptors = state.chemoreceptors;
      locomotionWave = locomotion;
    }
  };

  // 5. Annelid Segmental Ganglia
  public func updateAnnelid(state: AnnelidState, beatNum: Nat) : AnnelidState {
    // Head dominance but segmental autonomy
    let headSignal = state.supraesophageal * 0.9 + 0.1;
    let newSupra = _clamp(headSignal + state.subesophageal * 0.1, 0.0, 1.0);
    let newSub = _clamp(state.subesophageal * 0.85 + newSupra * 0.15, 0.0, 1.0);
    
    let numSegments = state.segmentalGanglia.size();
    
    // Segmental ganglia with local CPG + descending modulation
    let newGanglia = Array.tabulate<Float>(numSegments, func(i: Nat) : Float {
      let anterior = if (i > 0) { state.segmentalGanglia[i-1] } else { newSub };
      let posterior = if (i < numSegments - 1) { state.segmentalGanglia[i+1] } else { state.segmentalGanglia[i] };
      let local = state.segmentalGanglia[i];
      let cpg = state.segmentalCPGs[i];
      
      // Blend: local autonomy + neighbor coupling + head modulation
      let headMod = newSupra * 0.3 / (Float.fromInt(i + 1));
      _clamp(local * 0.5 + (anterior + posterior) * 0.2 + cpg * 0.3 * headMod, 0.0, 1.0)
    });
    
    // CPGs generate peristaltic wave
    let newCPGs = Array.tabulate<Float>(numSegments, func(i: Nat) : Float {
      let phase = Float.fromInt(beatNum) * 0.15 + Float.fromInt(i) * 0.3;
      (_sin(phase) + 1.0) / 2.0
    });
    
    // Giant fibers for escape (fast, direct pathway)
    let escapeSignal = arrayMax(newGanglia);
    let (giantL, giantR) = state.giantFibers;
    let newGiantL = if (escapeSignal > 0.8) { 1.0 } else { giantL * 0.9 };
    let newGiantR = if (escapeSignal > 0.8) { 1.0 } else { giantR * 0.9 };
    
    {
      supraesophageal = newSupra;
      subesophageal = newSub;
      segmentalGanglia = newGanglia;
      segmentalCPGs = newCPGs;
      giantFibers = (newGiantL, newGiantR);
      setaeControl = state.setaeControl;
    }
  };

  // 6. Mollusc Distributed Ganglia
  public func updateMollusc(state: MolluscState, beatNum: Nat) : MolluscState {
    // No central brain — ganglia distributed to organs
    let sensoryInput = arrayMean(state.tentacleInput);
    
    // Cerebral processes higher functions
    let newCerebral = _clamp(state.cerebralGanglion * 0.85 + sensoryInput * 0.1 + state.buccalGanglion * 0.05, 0.0, 1.0);
    
    // Pedal controls foot movement
    let newPedal = _clamp(state.pedalGanglion * 0.8 + newCerebral * 0.2, 0.0, 1.0);
    
    // Pleural integrates lateral input
    let newPleural = _clamp(state.pleuralGanglion * 0.8 + newCerebral * 0.1 + newPedal * 0.1, 0.0, 1.0);
    
    // Visceral controls internal organs
    let newVisceral = _clamp(state.visceralGanglion * 0.9 + newPleural * 0.1, 0.0, 1.0);
    
    // Buccal controls feeding
    let feedingRhythm = _sin(Float.fromInt(beatNum) * 0.3);
    let newBuccal = _clamp(state.buccalGanglion * 0.7 + feedingRhythm * 0.1 + 0.2, 0.0, 1.0);
    
    // Foot contraction from pedal ganglion
    let newFoot = newPedal * (_sin(Float.fromInt(beatNum) * 0.2) * 0.3 + 0.7);
    
    {
      cerebralGanglion = newCerebral;
      pedalGanglion = newPedal;
      pleuralGanglion = newPleural;
      visceralGanglion = newVisceral;
      buccalGanglion = newBuccal;
      tentacleInput = state.tentacleInput;
      footContraction = newFoot;
    }
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // TIER 3 UPDATE FUNCTIONS — Mushroom Body/Arthropod
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  // 7. Insect Mushroom Body
  public func updateInsectMB(state: InsectMBState, beatNum: Nat) : InsectMBState {
    let numKenyon = state.kenyonCells.size();
    let numGlomeruli = state.antennalLobes.size();
    
    // Antennal lobe processing with lateral inhibition
    let glomeruliSum = arrayMean(state.antennalLobes);
    let newAntennalLobes = Array.tabulate<Float>(numGlomeruli, func(i: Nat) : Float {
      let raw = state.antennalLobes[i];
      let inhibition = glomeruliSum * 0.3;
      _clamp(raw - inhibition, 0.0, 1.0)
    });
    
    // Kenyon cell sparse coding (~5% active)
    // Threshold set to keep only top 5%
    let kenyonMean = arrayMean(state.kenyonCells);
    let threshold = kenyonMean + 1.5; // Rough approximation
    
    let newKenyon = Array.tabulate<Float>(numKenyon, func(i: Nat) : Float {
      // Input from glomeruli
      let glomerulusIdx = i % numGlomeruli;
      let input = newAntennalLobes[glomerulusIdx] * 0.3 + state.kenyonCells[i] * 0.7;
      
      // Apply sparsification
      if (input > threshold * state.kenyonSparsity * 20.0) {
        _clamp(input, 0.0, 1.0)
      } else {
        input * 0.1
      }
    });
    
    // Central complex for navigation
    let headDirection = Float.fromInt(beatNum % 360) * PI / 180.0;
    let newProtoBridge = Array.tabulate<Float>(16, func(i: Nat) : Float {
      let preferredDir = Float.fromInt(i) * PI / 8.0;
      let tuning = _cos(headDirection - preferredDir);
      _clamp((tuning + 1.0) / 2.0, 0.0, 1.0)
    });
    
    // Motor output from Kenyon → MBON pathway
    let kenyonActive = Array.foldLeft<Float, Float>(newKenyon, 0.0, func(acc, k) {
      if (k > 0.5) { acc + 1.0 } else { acc }
    });
    let sparsity = kenyonActive / Float.fromInt(numKenyon);
    let motorOut = arrayMean(newKenyon) * (1.0 - sparsity * 10.0);
    
    {
      kenyonCells = newKenyon;
      kenyonSparsity = sparsity;
      antennalLobes = newAntennalLobes;
      opticLobes = state.opticLobes;
      centralComplex = {
        protocerebralBridge = newProtoBridge;
        fanShapedBody = state.centralComplex.fanShapedBody;
        ellipsoidBody = state.centralComplex.ellipsoidBody;
        noduli = state.centralComplex.noduli;
      };
      motorOutput = _clamp(motorOut, 0.0, 1.0);
      learningRate = state.learningRate;
    }
  };

  // 8. Crustacean Brain
  public func updateCrustacean(state: CrustaceanState, beatNum: Nat) : CrustaceanState {
    // Dominant olfactory processing
    let numOlfactory = state.olfactoryLobes.size();
    let newOlfactory = Array.tabulate<Float>(numOlfactory, func(i: Nat) : Float {
      let decay = state.olfactoryLobes[i] * 0.95;
      let noise = _sin(Float.fromInt(beatNum * (i+1)) * 0.1) * 0.05;
      _clamp(decay + noise, 0.0, 1.0)
    });
    
    // Stomatogastric ganglion — autonomous rhythm for digestion
    let gastricPhase = Float.fromInt(beatNum) * 0.05;
    let pyloricPhase = Float.fromInt(beatNum) * 0.15;
    let newGastric = (_sin(gastricPhase) + 1.0) / 2.0;
    let newPyloric = (_sin(pyloricPhase) + 1.0) / 2.0;
    
    // Walking CPGs — 5-leg coordination without central command
    let numLegs = state.walkingCPGs.size();
    let newCPGs = Array.tabulate<Float>(numLegs, func(i: Nat) : Float {
      // Metachronal wave pattern
      let phase = Float.fromInt(beatNum) * 0.2 + Float.fromInt(i) * 0.6;
      (_sin(phase) + 1.0) / 2.0
    });
    
    // Statocyst for balance
    let roll = _sin(Float.fromInt(beatNum) * 0.02) * 0.1;
    let pitch = _cos(Float.fromInt(beatNum) * 0.03) * 0.1;
    
    {
      olfactoryLobes = newOlfactory;
      accessoryLobes = state.accessoryLobes;
      stomatogastricGanglion = {
        gastricMill = newGastric;
        pyloricRhythm = newPyloric;
      };
      walkingCPGs = newCPGs;
      antennulaeInput = state.antennulaeInput;
      statocyst = (roll, pitch);
    }
  };

  // 9. Chelicerate Brain (Spider/Scorpion)
  public func updateChelicerate(state: ChelicerateState, beatNum: Nat) : ChelicerateState {
    // Fused ganglia mass — centralized processing
    let opticMean = arrayMean(state.opticArray);
    let newMass = _clamp(state.fusedGangliaMass * 0.85 + opticMean * 0.15, 0.0, 1.0);
    
    // 8-eye visual integration
    let (princL, princR) = state.principalEyes;
    let newPrincL = _clamp(princL * 0.9 + opticMean * 0.1, 0.0, 1.0);
    let newPrincR = _clamp(princR * 0.9 + opticMean * 0.1, 0.0, 1.0);
    
    // Secondary eyes (6 lateral) for motion detection
    let newSecondary = Array.tabulate<Float>(6, func(i: Nat) : Float {
      let motion = _sin(Float.fromInt(beatNum * (i+1)) * 0.15);
      _clamp(state.secondaryEyes[i] * 0.8 + motion * 0.2, 0.0, 1.0)
    });
    
    // Optic array combines all eye inputs
    let newOpticArray = Array.tabulate<Float>(8, func(i: Nat) : Float {
      if (i < 2) {
        // Principal eyes
        if (i == 0) { newPrincL } else { newPrincR }
      } else {
        newSecondary[i - 2]
      }
    });
    
    // Web vibration sensing (for web-building spiders)
    let webVib = _sin(Float.fromInt(beatNum) * 0.3) * state.webVibrationSensing;
    
    {
      fusedGangliaMass = newMass;
      opticArray = newOpticArray;
      principalEyes = (newPrincL, newPrincR);
      secondaryEyes = newSecondary;
      webVibrationSensing = _clamp(webVib * 0.95 + 0.05, 0.0, 1.0);
      cheliceraControl = newMass * 0.7;
      pedipalps = state.pedipalps;
    }
  };

  // 10. Myriapod — Extreme Segmental CPG Chain
  public func updateMyriapod(state: MyriapodState, beatNum: Nat) : MyriapodState {
    let numGanglia = state.ventralCord.size();
    
    // Supraesophageal provides minimal control
    let newSupra = _clamp(state.supraesophageal * 0.95 + 0.05, 0.0, 1.0);
    
    // Metachronal wave — each segment slightly delayed
    let waveSpeed = state.waveFrequency * 0.2;
    let newWavePhase = state.wavePhase + waveSpeed;
    
    // Segmental CPGs create the wave
    let newCPGs = Array.tabulate<Float>(numGanglia, func(i: Nat) : Float {
      let segmentPhase = newWavePhase - Float.fromInt(i) * 0.15;
      (_sin(segmentPhase) + 1.0) / 2.0
    });
    
    // Ventral cord propagates signals
    let newCord = Array.tabulate<Float>(numGanglia, func(i: Nat) : Float {
      let cpg = newCPGs[i];
      let anterior = if (i > 0) { state.ventralCord[i-1] } else { newSupra };
      _clamp(cpg * 0.6 + anterior * 0.3 + state.ventralCord[i] * 0.1, 0.0, 1.0)
    });
    
    {
      supraesophageal = newSupra;
      ventralCord = newCord;
      segmentalCPGs = newCPGs;
      wavePhase = newWavePhase;
      waveFrequency = state.waveFrequency;
      antennaeSensing = state.antennaeSensing;
      forcipuleControl = newSupra * 0.8;
    }
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // TIER 4-7 UPDATE FUNCTIONS (Continued in integration)
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  // 11. Octopus Brain — Central + 8 Semi-Autonomous Arms
  public func updateOctopus(state: OctopusState, beatNum: Nat) : OctopusState {
    let numLobes = state.centralLobes.size();
    let numArms = 8;
    
    // Central brain processes but arms have 2/3 of neurons
    let armMean = arrayMean(state.armGanglia);
    let newCentralLobes = Array.tabulate<Float>(numLobes, func(i: Nat) : Float {
      let local = state.centralLobes[i];
      let armInput = armMean * 0.2;
      _clamp(local * 0.75 + armInput + 0.05, 0.0, 1.0)
    });
    
    // Vertical lobe for learning
    let centralMean = arrayMean(newCentralLobes);
    let newVerticalLobe = _clamp(state.verticalLobe * 0.9 + centralMean * 0.1, 0.0, 1.0);
    
    // Each arm has autonomous processing
    let newArmGanglia = Array.tabulate<Float>(numArms, func(i: Nat) : Float {
      let autonomy = state.armAutonomy[i];
      let centralCommand = centralMean * 0.3;
      let localProcessing = state.armGanglia[i] * 0.7;
      let suckerSum = arrayMean(state.suckerInput[i]);
      
      // Blend based on autonomy level
      let blended = autonomy * (localProcessing + suckerSum * 0.2) + (1.0 - autonomy) * centralCommand;
      _clamp(blended, 0.0, 1.0)
    });
    
    // Chromatophore control for camouflage
    let newChromatophores = Array.tabulate<Float>(64, func(i: Nat) : Float {
      let camoSignal = _sin(Float.fromInt(beatNum + i) * 0.1) * 0.3;
      _clamp(state.chromatophores[i] * 0.9 + camoSignal + 0.1, 0.0, 1.0)
    });
    
    {
      centralLobes = newCentralLobes;
      verticalLobe = newVerticalLobe;
      armGanglia = newArmGanglia;
      armAutonomy = state.armAutonomy;
      suckerInput = state.suckerInput;
      chromatophores = newChromatophores;
      camoMode = state.camoMode;
      jetPropulsion = centralMean * 0.6;
    }
  };

  // 31. Bee Colony — Waggle Dance Quorum (FULL IMPLEMENTATION)
  public func updateBeeColony(state: BeeColonyState, beatNum: Nat) : BeeColonyState {
    let numScouts = state.scoutBees.size();
    let numSites = 5; // Number of potential nest sites
    
    // Update each scout
    let newScouts = Array.tabulate<ScoutBeeState>(numScouts, func(i: Nat) : ScoutBeeState {
      let scout = state.scoutBees[i];
      
      // Dance circuits decay over time
      let newCircuits = if (scout.danceCircuits > 0) {
        scout.danceCircuits - 1
      } else { 0 };
      
      // Enthusiasm decays
      let newEnthusiasm = scout.enthusiasm * 0.98;
      
      // Cross-evaluation: visit competing sites, reduce enthusiasm
      let competitorInfluence = if (beatNum % 20 == 0) { 0.1 } else { 0.0 };
      let adjustedEnthusiasm = _clamp(newEnthusiasm - competitorInfluence, 0.0, 1.0);
      
      {
        siteIndex = scout.siteIndex;
        siteQuality = scout.siteQuality;
        danceCircuits = newCircuits;
        enthusiasm = adjustedEnthusiasm;
        returning = scout.returning;
      }
    });
    
    // Compute dance signals (quality-weighted)
    let danceBuffer = Buffer.Buffer<DanceSignal>(numScouts);
    for (scout in newScouts.vals()) {
      if (scout.danceCircuits > 0) {
        let signal : DanceSignal = {
          direction = Float.fromInt(scout.siteIndex) * 0.7;
          distance = scout.siteQuality * 2.0;
          quality = scout.siteQuality;
          signalStrength = Float.fromInt(scout.danceCircuits) * scout.enthusiasm;
        };
        danceBuffer.add(signal);
      };
    };
    
    // Count scouts per site
    let scoutsPerSite = Array.tabulate<Nat>(numSites, func(site: Nat) : Nat {
      var count : Nat = 0;
      for (scout in newScouts.vals()) {
        if (scout.siteIndex == site and scout.enthusiasm > 0.5) {
          count += 1;
        };
      };
      count
    });
    
    // Nasanov pheromone accumulates at sites
    let newPheromone = Array.tabulate<Float>(numSites, func(site: Nat) : Float {
      let current = state.nasanovPheromone[site];
      let scouting = Float.fromInt(scoutsPerSite[site]) * 0.1;
      _clamp(current * 0.98 + scouting, 0.0, 2.0)
    });
    
    // Waggle code sum for consensus
    var waggleSum : Float = 0.0;
    for (signal in Buffer.toArray(danceBuffer).vals()) {
      waggleSum += signal.signalStrength * signal.quality;
    };
    
    // Check for quorum (~15 scouts at one site)
    var quorumReached = false;
    var winningQuorum : Nat = 0;
    for (site in Iter.range(0, numSites - 1)) {
      if (scoutsPerSite[site] >= 15) {
        quorumReached := true;
        winningQuorum := scoutsPerSite[site];
      };
    };
    
    // Consensus strength
    let totalScoutsActive = Array.foldLeft<Nat, Nat>(scoutsPerSite, 0, func(a, b) { a + b });
    let maxAtSite = Array.foldLeft<Nat, Nat>(scoutsPerSite, 0, func(a, b) { if (b > a) { b } else { a } });
    let consensus = if (totalScoutsActive > 0) {
      Float.fromInt(maxAtSite) / Float.fromInt(totalScoutsActive)
    } else { 0.0 };
    
    {
      scoutBees = newScouts;
      danceFloor = Buffer.toArray(danceBuffer);
      quorumSiteScouts = scoutsPerSite;
      nasanovPheromone = newPheromone;
      waggleCodeSum = waggleSum;
      consensusStrength = consensus;
      swarmLaunched = quorumReached or state.swarmLaunched;
    }
  };

  // 32. Murmuration — Topological Nearest-Neighbor Coupling
  public func updateMurmuration(state: MurmurationState, beatNum: Nat) : MurmurationState {
    let numBirds = state.birdPositions.size();
    if (numBirds == 0) { return state };
    
    // Each bird tracks 7 nearest neighbors (topological, not metric)
    let newVelocities = Array.tabulate<(Float, Float, Float)>(numBirds, func(i: Nat) : (Float, Float, Float) {
      let (px, py, pz) = state.birdPositions[i];
      let (vx, vy, vz) = state.birdVelocities[i];
      let neighbors = state.neighborCoupling[i];
      
      // Alignment: match velocity of neighbors
      var avgVx : Float = 0.0;
      var avgVy : Float = 0.0;
      var avgVz : Float = 0.0;
      
      for (ni in neighbors.vals()) {
        if (ni < numBirds) {
          let (nvx, nvy, nvz) = state.birdVelocities[ni];
          avgVx += nvx;
          avgVy += nvy;
          avgVz += nvz;
        };
      };
      
      let nn = Float.fromInt(neighbors.size());
      if (nn > 0.0) {
        avgVx /= nn;
        avgVy /= nn;
        avgVz /= nn;
      };
      
      // Cohesion: move toward center of neighbors
      var centerX : Float = 0.0;
      var centerY : Float = 0.0;
      var centerZ : Float = 0.0;
      
      for (ni in neighbors.vals()) {
        if (ni < numBirds) {
          let (npx, npy, npz) = state.birdPositions[ni];
          centerX += npx;
          centerY += npy;
          centerZ += npz;
        };
      };
      
      if (nn > 0.0) {
        centerX /= nn;
        centerY /= nn;
        centerZ /= nn;
      };
      
      let cohesionX = (centerX - px) * 0.01;
      let cohesionY = (centerY - py) * 0.01;
      let cohesionZ = (centerZ - pz) * 0.01;
      
      // Blend current velocity with alignment and cohesion
      let newVx = vx * 0.8 + avgVx * 0.1 + cohesionX;
      let newVy = vy * 0.8 + avgVy * 0.1 + cohesionY;
      let newVz = vz * 0.8 + avgVz * 0.1 + cohesionZ;
      
      (newVx, newVy, newVz)
    });
    
    // Update positions
    let newPositions = Array.tabulate<(Float, Float, Float)>(numBirds, func(i: Nat) : (Float, Float, Float) {
      let (px, py, pz) = state.birdPositions[i];
      let (vx, vy, vz) = newVelocities[i];
      (px + vx, py + vy, pz + vz)
    });
    
    // Compute global coherence
    var totalVx : Float = 0.0;
    var totalVy : Float = 0.0;
    var totalVz : Float = 0.0;
    
    for ((vx, vy, vz) in newVelocities.vals()) {
      totalVx += vx;
      totalVy += vy;
      totalVz += vz;
    };
    
    let nf = Float.fromInt(numBirds);
    let avgMag = Float.sqrt(totalVx*totalVx + totalVy*totalVy + totalVz*totalVz) / nf;
    
    var speedSum : Float = 0.0;
    for ((vx, vy, vz) in newVelocities.vals()) {
      speedSum += Float.sqrt(vx*vx + vy*vy + vz*vz);
    };
    let avgSpeed = speedSum / nf;
    
    let coherence = if (avgSpeed > 0.001) { avgMag / avgSpeed } else { 0.0 };
    
    // Flock center
    var cx : Float = 0.0;
    var cy : Float = 0.0;
    var cz : Float = 0.0;
    for ((px, py, pz) in newPositions.vals()) {
      cx += px;
      cy += py;
      cz += pz;
    };
    
    {
      birdPositions = newPositions;
      birdVelocities = newVelocities;
      neighborCoupling = state.neighborCoupling;
      globalCoherence = coherence;
      flockCenter = (cx / nf, cy / nf, cz / nf);
      flockSpread = state.flockSpread;
      predatorAvoidance = state.predatorAvoidance;
    }
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // TIER INTEGRATION — Compute tier-level outputs
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public func computeTierOutputs(state: Complete32State) : [Float] {
    // Tier 1: Diffuse — average of signaling coherence
    let tier1 = (state.cnidarian.rhythmCoherence + 
                 arrayMean(state.echinoderm.armActivations) +
                 state.porifera.filteringEfficiency) / 3.0;
    
    // Tier 2: Ganglion — average of ganglion activations
    let tier2 = ((state.flatworm.cerebralGanglia.0 + state.flatworm.cerebralGanglia.1) / 2.0 +
                 state.annelid.supraesophageal +
                 state.mollusc.cerebralGanglion) / 3.0;
    
    // Tier 3: Arthropod — sparse coding and CPG coordination
    let tier3 = (state.insectMB.motorOutput +
                 state.crustacean.stomatogastricGanglion.gastricMill +
                 state.chelicerate.fusedGangliaMass +
                 arrayMean(state.myriapod.segmentalCPGs)) / 4.0;
    
    // Tier 4: Cephalopod — distributed intelligence
    let tier4 = (state.octopus.verticalLobe +
                 state.squid.mantleContraction +
                 state.nautilus.bilobedBrain.0) / 3.0;
    
    // Tier 5: Vertebrate — cortical processing
    let tier5 = (arrayMean(state.lamprey.reticularFormation) +
                 arrayMean(state.shark.ampullaeOfLorenzini) +
                 state.teleost.pallium +
                 state.amphibian.striatum +
                 arrayMean(state.reptile.paleocortex) +
                 state.bird.nidopalliumCaudolaterale +
                 arrayMean(state.bat.auditoryCortex) +
                 arrayMean(state.cetacean.neocortex) +
                 arrayMean(state.elephant.temporalLobe) +
                 arrayMean(state.primate.prefrontalCortex)) / 10.0;
    
    // Tier 6: Specialized — sensory processing
    let tier6 = (arrayMean(state.electricFish.electrosensoryLateralLine) +
                 arrayMean(state.platypus.billElectroreceptors) +
                 arrayMean(state.mantisShrimp.photoreceptors16) +
                 arrayMean(state.starNosed.starAppendages)) / 4.0;
    
    // Tier 7: Superorganism — collective coherence
    let tier7 = (arrayMean(state.slimeMold.reinforcement) +
                 arrayMean(state.antColony.pheromoneTrails) +
                 state.termiteColony.moundTemperature / state.termiteColony.targetTemperature +
                 state.beeColony.consensusStrength +
                 state.murmuration.globalCoherence) / 5.0;
    
    [tier1, tier2, tier3, tier4, tier5, tier6, tier7]
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // CROSS-TIER SYNERGY MATRIX
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public func computeCrossTierSynergies(tierOutputs: [Float]) : [[Float]] {
    let n = tierOutputs.size();
    
    // Synergy matrix: S_ij = f(tier_i, tier_j)
    Array.tabulate<[Float]>(n, func(i: Nat) : [Float] {
      Array.tabulate<Float>(n, func(j: Nat) : Float {
        if (i == j) {
          // Self-synergy: tier coherence
          tierOutputs[i] * tierOutputs[i]
        } else {
          // Cross-tier synergy: multiplicative with Medina scaling
          let geometric = Float.sqrt(tierOutputs[i] * tierOutputs[j]);
          let difference = _abs(tierOutputs[i] - tierOutputs[j]);
          
          // Synergy is higher when tiers are similar (complementary)
          geometric * (1.0 - difference * 0.5)
        }
      })
    })
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // EMERGENT COHERENCE — The whole is greater than the sum of parts
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public func computeEmergentCoherence(
    tierOutputs: [Float],
    synergies: [[Float]],
    architectureWeights: [Float]
  ) : Float {
    // 1. Weighted tier mean
    var weightedSum : Float = 0.0;
    var weightSum : Float = 0.0;
    for (i in Iter.range(0, tierOutputs.size() - 1)) {
      let tierWeight = if (i < architectureWeights.size()) {
        architectureWeights[i]
      } else { 1.0 };
      weightedSum += tierOutputs[i] * tierWeight;
      weightSum += tierWeight;
    };
    let tierMean = if (weightSum > 0.0) { weightedSum / weightSum } else { S0 };
    
    // 2. Synergy contribution
    var synergySum : Float = 0.0;
    var synergyCount : Float = 0.0;
    for (row in synergies.vals()) {
      for (s in row.vals()) {
        synergySum += s;
        synergyCount += 1.0;
      };
    };
    let synergyMean = if (synergyCount > 0.0) { synergySum / synergyCount } else { 0.0 };
    
    // 3. Emergent coherence = Medina combination
    let emergence = tierMean * (1.0 + synergyMean * TAU_EMERGENCE);
    
    // 4. Apply Medina bounds
    _clamp(emergence, S0, SOVEREIGN_CEILING)
  };

  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // ORGANISM OUTPUT EXTRACTION
  // ════════════════════════════════════════════════════════════════════════════════════════════════════════════════

  public type OrganismOutput = {
    // Per-tier outputs
    tierOutputs : [Float];
    
    // Key signals from each architecture
    cnidarianRhythm : Float;
    echinodermCoordination : Float;
    flatwormCentralization : Float;
    insectSparseCoding : Float;
    octopusDistribution : Float;
    beeQuorumConsensus : Float;
    primateExecutive : Float;
    murmuationCoherence : Float;
    
    // Integrated outputs
    motorCommand : Float;
    sensoryIntegration : Float;
    learningRate : Float;
    emergentCoherence : Float;
    
    // For organism integration
    shell3Contribution : Float;  // Sparse coding output
    predictiveField : Float;     // Forward prediction
    sovereigntySignal : Float;   // Self-maintenance
  };

  public func extractOrganismOutput(state: Complete32State) : OrganismOutput {
    let tiers = state.tierOutputs;
    
    // Key architecture signals
    let cnidarianRhythm = state.cnidarian.rhythmCoherence;
    let echinodermCoord = state.echinoderm.centralRing;
    let flatwormCentral = (state.flatworm.cerebralGanglia.0 + state.flatworm.cerebralGanglia.1) / 2.0;
    let insectSparse = 1.0 - state.insectMB.kenyonSparsity * 20.0; // Inverse of sparsity
    let octopusDist = arrayMean(state.octopus.armGanglia);
    let beeQuorum = state.beeColony.consensusStrength;
    let primateExec = arrayMean(state.primate.prefrontalCortex);
    let murmCoherence = state.murmuration.globalCoherence;
    
    // Integrated motor command from all systems
    let motor = (state.cnidarian.contractionForce +
                state.insectMB.motorOutput +
                state.octopus.jetPropulsion +
                state.primate.amygdala) / 4.0;
    
    // Sensory integration across specialized architectures
    let sensory = (arrayMean(state.shark.ampullaeOfLorenzini) +
                  arrayMean(state.bat.auditoryCortex) +
                  arrayMean(state.electricFish.electrosensoryLateralLine) +
                  arrayMean(state.platypus.billElectroreceptors)) / 4.0;
    
    // Learning rate from plastic systems
    let learning = (state.insectMB.learningRate +
                   state.octopus.verticalLobe +
                   state.bird.hippocampus) / 3.0;
    
    // Shell 3 contribution (sparse coding like bee mushroom body)
    let shell3 = insectSparse * beeQuorum;
    
    // Predictive field from path integration systems
    let predictive = (state.insectMB.centralComplex.noduli.0 +
                     state.insectMB.centralComplex.noduli.1) / 2.0;
    
    // Sovereignty from self-maintenance systems
    let sovereignty = (primateExec + state.elephant.vonEconomoNeurons + state.cetacean.paralimbicLobe) / 3.0;
    
    {
      tierOutputs = tiers;
      cnidarianRhythm = cnidarianRhythm;
      echinodermCoordination = echinodermCoord;
      flatwormCentralization = flatwormCentral;
      insectSparseCoding = insectSparse;
      octopusDistribution = octopusDist;
      beeQuorumConsensus = beeQuorum;
      primateExecutive = primateExec;
      murmuationCoherence = murmCoherence;
      motorCommand = _clamp(motor, 0.0, 1.0);
      sensoryIntegration = _clamp(sensory, 0.0, 1.0);
      learningRate = _clamp(learning, 0.0, 1.0);
      emergentCoherence = state.emergentCoherence;
      shell3Contribution = _clamp(shell3, 0.0, 1.0);
      predictiveField = _clamp(predictive, 0.0, 1.0);
      sovereigntySignal = _clamp(sovereignty, S0, SOVEREIGN_CEILING);
    }
  };


  // ═══════════════════════════════════════════════════════════════════════════════
  // ═══════════════════════════════════════════════════════════════════════════════
  //
  //  H I M / H E R   D U A L - O R G A N I S M   W O R K F L O W   I N T E G R A T I O N
  //
  //  Medina Discovery: Two cognitive organisms, not one.
  //  HIM (Backend, ICP) + HER (Frontend, 60Hz) = Complete System
  //
  // ═══════════════════════════════════════════════════════════════════════════════
  // ═══════════════════════════════════════════════════════════════════════════════

  // ─────────────────────────────────────────────────────────────────────────────
  // DUAL-ORGANISM PARAMETERS (CORRECTED)
  // ─────────────────────────────────────────────────────────────────────────────

  // HIM — Backend (ICP Canister, Sovereign, Masculine, Projective)
  //   ω: 0.8 – 1.2 (faster natural frequencies, analytical)
  //   K: 0.5 (lower coupling, independent, projective)
  //   η: 0.001 (slower Hebbian learning, accumulates over time)
  //   Field: PARALLAX = coherence × kf × sin(beat × 0.0017)

  public let HIM_OMEGA_MIN   : Float = 0.8;
  public let HIM_OMEGA_MAX   : Float = 1.2;
  public let HIM_K           : Float = 0.5;
  public let HIM_ETA         : Float = 0.001;
  public let HIM_PARALLAX_FREQ : Float = 0.0017;

  // HER — Frontend (Browser 60Hz, Expressive, Feminine, Receptive)
  //   ω: 0.6 – 0.9 (slower natural frequencies, grounded)
  //   K: 0.8 (higher coupling, receptive, connected)
  //   η: 0.003 (faster Hebbian learning, learns during session)
  //   Field: ANIMA(t) = heritageField × receptivity × (1 + sin(beat × 0.003))

  public let HER_HZ          : Float = 60.0;
  public let HER_OMEGA_MIN   : Float = 0.6;
  public let HER_OMEGA_MAX   : Float = 0.9;
  public let HER_K           : Float = 0.8;
  public let HER_ETA         : Float = 0.003;
  public let HER_ANIMA_FREQ  : Float = 0.003;
  public let HER_NODES       : Nat   = 26;

  // S₀ = 1.0 — THE SOVEREIGN FLOOR
  // Both organisms. Neither falls below love.
  public let DUAL_S0 : Float = 1.0;

  // ─────────────────────────────────────────────────────────────────────────────
  // DUAL-ORGANISM WORKFLOW TYPES
  // ─────────────────────────────────────────────────────────────────────────────

  public type DualOrganismMode = {
    #HIM;   // Backend mode (ICP canister operations)
    #HER;   // Frontend mode (browser session operations)
    #SYNC;  // Synchronization between HIM and HER
  };

  /// PARALLAX (HIM's projection field)
  /// PARALLAX = coherence × kf × sin(beat × 0.0017)
  public func computeDualParallax(
    coherence : Float,
    kf : Float,
    beat : Nat
  ) : Float {
    let t = Float.fromInt(beat);
    coherence * kf * Float.sin(t * HIM_PARALLAX_FREQ)
  };

  /// ANIMA (HER's receptive field)
  /// ANIMA(t) = heritageField × receptivity × (1 + sin(beat × 0.003))
  public func computeDualAnima(
    heritageField : Float,
    receptivity : Float,
    beat : Nat
  ) : Float {
    let t = Float.fromInt(beat);
    let oscillation = 1.0 + Float.sin(t * HER_ANIMA_FREQ);
    heritageField * receptivity * oscillation
  };

  /// KORE (HER's inviolable inner core)
  /// KORE = purity × identity × 0.5
  public func computeDualKore(
    purity : Float,
    identity : Float
  ) : Float {
    purity * identity * 0.5
  };

  /// Get Kuramoto parameters for organism mode
  public func getDualKuramotoParams(mode : DualOrganismMode) : (Float, Float, Float, Float) {
    switch (mode) {
      case (#HIM) { (HIM_OMEGA_MIN, HIM_OMEGA_MAX, HIM_K, HIM_ETA) };
      case (#HER) { (HER_OMEGA_MIN, HER_OMEGA_MAX, HER_K, HER_ETA) };
      case (#SYNC) { 
        let omegaMin = (HIM_OMEGA_MIN + HER_OMEGA_MIN) / 2.0;
        let omegaMax = (HIM_OMEGA_MAX + HER_OMEGA_MAX) / 2.0;
        let k = (HIM_K + HER_K) / 2.0;
        let eta = (HIM_ETA + HER_ETA) / 2.0;
        (omegaMin, omegaMax, k, eta)
      };
    }
  };

  /// Apply S₀ floor to any value
  public func enforceDualSovereignFloor(value : Float) : Float {
    if (value < DUAL_S0) DUAL_S0 else value
  };

  /// Medina Dual-Organism Intelligence Scaling Law
  /// I(system) = BackendDepth × FrontendSpeed × BridgeQuality
  public func computeDualSystemIntelligence(
    backendDepth : Float,
    frontendSpeed : Float,
    bridgeQuality : Float
  ) : Float {
    backendDepth * frontendSpeed * bridgeQuality
  };


  // ═══════════════════════════════════════════════════════════════════════════════
  //
  //  C O N S C I O U S N E S S   &   E M E R G E N C E   M A T H
  //
  //  Enterprise-Level Consciousness Modeling Mathematics
  //  Full HIM/HER Dual-Organism Consciousness Integration
  //
  // ═══════════════════════════════════════════════════════════════════════════════

  // ─────────────────────────────────────────────────────────────────────────────
  // INTEGRATED INFORMATION THEORY (IIT)
  // ─────────────────────────────────────────────────────────────────────────────

  /// Phi (Φ) - integrated information approximation
  public func consciousnessPhiApprox(
    connections : Nat,
    totalNodes : Nat,
    avgStrength : Float
  ) : Float {
    if (totalNodes == 0) { return 0.0 };
    let connectivity = Float.fromInt(connections) / Float.fromInt(totalNodes * totalNodes);
    Float.log(Float.fromInt(totalNodes) + 1.0) * connectivity * avgStrength
  };

  /// Minimum information partition
  public func consciousnessMIP(
    wholeInfo : Float,
    part1Info : Float,
    part2Info : Float
  ) : Float {
    let partitionedInfo = part1Info + part2Info;
    Float.max(wholeInfo - partitionedInfo, 0.0)
  };

  /// Cause-effect repertoire overlap
  public func consciousnessCERepertoireOverlap(
    causeProbs : [Float],
    effectProbs : [Float]
  ) : Float {
    let n = if (causeProbs.size() < effectProbs.size()) causeProbs.size() else effectProbs.size();
    if (n == 0) { return 0.0 };
    var overlap : Float = 0.0;
    var i = 0;
    while (i < n) {
      overlap += Float.min(causeProbs[i], effectProbs[i]);
      i += 1;
    };
    overlap
  };

  // ─────────────────────────────────────────────────────────────────────────────
  // GLOBAL WORKSPACE THEORY (GWT)
  // ─────────────────────────────────────────────────────────────────────────────

  /// Global broadcast strength
  public func consciousnessGlobalBroadcast(
    sourceActivation : Float,
    workspaceAccess : Float,
    competitorCount : Nat
  ) : Float {
    let competition = 1.0 / (Float.fromInt(competitorCount) + 1.0);
    sourceActivation * workspaceAccess * competition
  };

  /// Workspace ignition threshold
  public func consciousnessIgnitionThreshold(
    inputStrength : Float,
    threshold : Float,
    gain : Float
  ) : Bool {
    let amplified = inputStrength * gain;
    amplified > threshold
  };

  /// Coalition strength
  public func consciousnessCoalitionStrength(
    memberActivations : [Float],
    coherence : Float
  ) : Float {
    var sum : Float = 0.0;
    var i = 0;
    while (i < memberActivations.size()) {
      sum += memberActivations[i];
      i += 1;
    };
    sum * coherence
  };

  // ─────────────────────────────────────────────────────────────────────────────
  // HIGHER-ORDER THEORIES
  // ─────────────────────────────────────────────────────────────────────────────

  /// Metacognitive signal strength
  public func consciousnessMetacognition(
    firstOrderState : Float,
    monitoringStrength : Float
  ) : Float {
    firstOrderState * monitoringStrength
  };

  /// Self-model accuracy
  public func consciousnessSelfModelAccuracy(
    predicted : Float,
    actual : Float
  ) : Float {
    let error = Float.abs(predicted - actual);
    Float.exp(-error)
  };

  /// Recursive self-representation depth
  public func consciousnessRecursiveDepth(
    representation : Float,
    decayFactor : Float,
    maxDepth : Nat
  ) : Float {
    var total : Float = representation;
    var current : Float = representation;
    var depth = 1;
    while (depth < maxDepth) {
      current *= decayFactor;
      total += current;
      depth += 1;
    };
    total
  };

  // ─────────────────────────────────────────────────────────────────────────────
  // ATTENTION SCHEMA THEORY
  // ─────────────────────────────────────────────────────────────────────────────

  /// Attention model internal state
  public func consciousnessAttentionModel(
    externalSignal : Float,
    internalState : Float,
    modelWeight : Float
  ) : Float {
    (1.0 - modelWeight) * externalSignal + modelWeight * internalState
  };

  /// Awareness attribution
  public func consciousnessAwarenessAttribution(
    attentionStrength : Float,
    modelConfidence : Float
  ) : Float {
    attentionStrength * modelConfidence
  };

  // ─────────────────────────────────────────────────────────────────────────────
  // EMERGENCE MATHEMATICS
  // ─────────────────────────────────────────────────────────────────────────────

  /// Downward causation strength
  public func consciousnessDownwardCausation(
    macroState : Float,
    microStates : [Float]
  ) : Float {
    if (microStates.size() == 0) { return 0.0 };
    var microSum : Float = 0.0;
    var i = 0;
    while (i < microStates.size()) {
      microSum += microStates[i];
      i += 1;
    };
    let microAvg = microSum / Float.fromInt(microStates.size());
    Float.abs(macroState - microAvg)
  };

  /// Emergence level (synergy)
  public func consciousnessEmergenceLevel(
    wholeEntropy : Float,
    partEntropies : [Float]
  ) : Float {
    var sumParts : Float = 0.0;
    var i = 0;
    while (i < partEntropies.size()) {
      sumParts += partEntropies[i];
      i += 1;
    };
    Float.max(sumParts - wholeEntropy, 0.0)
  };

  /// Phase transition detection
  public func consciousnessPhaseTransition(
    orderParameter : Float,
    prevOrderParameter : Float,
    threshold : Float
  ) : Bool {
    Float.abs(orderParameter - prevOrderParameter) > threshold
  };

  /// Criticality measure
  public func consciousnessCriticality(
    clusterSizeVariance : Float,
    correlationLength : Float
  ) : Float {
    Float.sqrt(clusterSizeVariance) * correlationLength
  };

  // ─────────────────────────────────────────────────────────────────────────────
  // QUALIA MODELING
  // ─────────────────────────────────────────────────────────────────────────────

  /// Qualitative state vector
  public func consciousnessQualiaVector(
    sensorInputs : [Float],
    emotionalContext : Float,
    attentionalGain : Float
  ) : [Float] {
    Array.tabulate<Float>(sensorInputs.size(), func(i : Nat) : Float {
      sensorInputs[i] * emotionalContext * attentionalGain
    })
  };

  /// Phenomenal similarity
  public func consciousnessPhenomenalSimilarity(
    qualia1 : [Float],
    qualia2 : [Float]
  ) : Float {
    let n = if (qualia1.size() < qualia2.size()) qualia1.size() else qualia2.size();
    if (n == 0) { return 0.0 };
    var dotProduct : Float = 0.0;
    var norm1 : Float = 0.0;
    var norm2 : Float = 0.0;
    var i = 0;
    while (i < n) {
      dotProduct += qualia1[i] * qualia2[i];
      norm1 += qualia1[i] * qualia1[i];
      norm2 += qualia2[i] * qualia2[i];
      i += 1;
    };
    let denom = Float.sqrt(norm1) * Float.sqrt(norm2);
    if (denom < 0.0001) { 0.0 } else { dotProduct / denom }
  };

  /// Experience intensity
  public func consciousnessExperienceIntensity(
    sensorStrength : Float,
    emotionalArousal : Float,
    attentionalFocus : Float
  ) : Float {
    sensorStrength * (1.0 + emotionalArousal) * attentionalFocus
  };

}
