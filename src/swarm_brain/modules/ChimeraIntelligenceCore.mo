  /// Threshold ECDSA signatures
  public type ThresholdSignatureRequest = {
    keyId : {curve: EllipticCurve; name: Text};
    derivationPath : [Blob];
    messageHash : Blob;
    var signature : ?Blob;
    var status : SignatureStatus;
  };

