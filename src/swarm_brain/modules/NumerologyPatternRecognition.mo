  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // MATH PRIMITIVES
  // ═══════════════════════════════════════════════════════════════════════════
  
  func _clamp(x : Float, lo : Float, hi : Float) : Float {
    if (x < lo) lo else if (x > hi) hi else x
  };
  
  func _abs(x : Float) : Float { if (x < 0.0) -x else x };
  
  func _absInt(x : Int) : Nat {
    if (x < 0) { Int.abs(x) } else { Int.abs(x) }
  };
  
  func _sqrt(x : Float) : Float { 
    if (x <= 0.0) 0.0 else Float.sqrt(x) 
  };
  
  func _exp(x : Float) : Float {
    let xc = _clamp(x, -20.0, 20.0);
    Float.exp(xc)
  };
  
  func _sin(x : Float) : Float { Float.sin(x) };
  func _cos(x : Float) : Float { Float.cos(x) };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // PATTERN DETECTION FUNCTIONS
  // ═══════════════════════════════════════════════════════════════════════════
  
  // Check if number is in Fibonacci sequence
  public func isFibonacci(n : Nat) : Bool {
    for (f in FIBONACCI.vals()) {
      if (f == n) { return true };
      if (f > n) { return false };
    };
    false
  };
  
  // Check if number is in Lucas sequence
  public func isLucas(n : Nat) : Bool {
    for (l in LUCAS.vals()) {
      if (l == n) { return true };
      if (l > n) { return false };
    };
    false
  };
  
  // Check if number is prime
  public func isPrime(n : Nat) : Bool {
    if (n < 2) { return false };
    for (p in PRIMES.vals()) {
      if (p == n) { return true };
      if (p > n) { return false };
    };
    // For numbers beyond our list, do basic check
    if (n > 113) {
      var i : Nat = 2;
      while (i * i <= n) {
        if (n % i == 0) { return false };
        i += 1;
      };
      return true;
    };
    false
  };
  
  // Check if number is perfect (sum of divisors = number)
  public func isPerfect(n : Nat) : Bool {
    for (p in PERFECT.vals()) {
      if (p == n) { return true };
    };
    false
  };
  
  // Check if number is triangular (n = k(k+1)/2)
  public func isTriangular(n : Nat) : Bool {
    for (t in TRIANGULAR.vals()) {
      if (t == n) { return true };
      if (t > n) { return false };
    };
    false
  };
  
  // Check if number is repeating digit (111, 222, 333, etc.)
  public func isRepDigit(n : Nat) : Bool {
    if (n < 11) { return false };
    let repDigits = [11, 22, 33, 44, 55, 66, 77, 88, 99,
                     111, 222, 333, 444, 555, 666, 777, 888, 999,
                     1111, 2222, 3333, 4444, 5555, 6666, 7777, 8888, 9999];
    for (r in repDigits.vals()) {
      if (r == n) { return true };
    };
    false
  };
  
  // Check if number is angel number
  public func isAngelNumber(n : Nat) : Bool {
    let angelNumbers = [111, 222, 333, 444, 555, 666, 777, 888, 999];
    for (a in angelNumbers.vals()) {
      if (a == n) { return true };
    };
    false
  };
  
  // Check if number is power of 2
  public func isPowerOf2(n : Nat) : Bool {
    if (n == 0) { return false };
    var x = n;
    while (x > 1) {
      if (x % 2 != 0) { return false };
      x := x / 2;
    };
    true
  };
  
  // Check if number is sacred (3, 7, 9, 12, 40, etc.)
  public func isSacred(n : Nat) : Bool {
    let sacredNumbers = [3, 7, 9, 12, 21, 40, 72, 108, 144, 432, 444];
    for (s in sacredNumbers.vals()) {
      if (s == n) { return true };
    };
    false
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // 444 SPECIFIC FUNCTIONS
  // ═══════════════════════════════════════════════════════════════════════════
  
  // Check if number is related to 444
  public func is444Related(n : Nat) : Bool {
    if (n == 444) { return true };
    if (n == 4) { return true };
    if (n == 44) { return true };
    if (n == 4444) { return true };
    if (n == 64) { return true };   // 4×4×4
    if (n == 12) { return true };   // 4+4+4
    if (n == 16) { return true };   // 4×4
    if (n % 444 == 0) { return true };  // Multiple of 444
    false
  };
  
  // Compute digit sum
  public func digitSum(n : Nat) : Nat {
    var sum : Nat = 0;
    var x = n;
    while (x > 0) {
      sum += x % 10;
      x := x / 10;
    };
    sum
  };
  
  // Reduce to single digit (numerology reduction)
  public func reduceToSingleDigit(n : Nat) : Nat {
    var x = n;
    while (x > 9) {
      x := digitSum(x);
    };
    x
  };
  
  // 444 resonance calculation
  public func compute444Resonance(frequency : Float) : Float {
    // How close is frequency to 444?
    let distance = _abs(frequency - RESONANCE_444_HZ);
    // Resonance decays with distance
    _exp(-distance / 100.0)
  };
  
  // Check 444 alignment
  public func is444Aligned(
    faith : Float,
    family : Float,
    finance : Float,
    freedom : Float
  ) : Bool {
    // All 4 pillars must be above 0.444 for 444 alignment
    faith > COHERENCE_444_THRESHOLD and
    family > COHERENCE_444_THRESHOLD and
    finance > COHERENCE_444_THRESHOLD and
    freedom > COHERENCE_444_THRESHOLD
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // COMPREHENSIVE PATTERN RECOGNITION
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func recognizePatterns(n : Nat) : PatternRecognition {
    let patterns = Buffer.Buffer<NumberPattern>(5);
    var significance : Float = 0.0;
    
    // Check each pattern type
    if (isFibonacci(n)) {
      patterns.add(#Fibonacci);
      significance += 0.3;
    };
    
    if (isLucas(n)) {
      patterns.add(#Lucas);
      significance += 0.2;
    };
    
    if (isPrime(n)) {
      patterns.add(#Prime);
      significance += 0.2;
    };
    
    if (isPerfect(n)) {
      patterns.add(#Perfect);
      significance += 0.5;  // Perfect numbers are rare
    };
    
    if (isTriangular(n)) {
      patterns.add(#Triangular);
      significance += 0.15;
    };
    
    if (isAngelNumber(n)) {
      patterns.add(#AngelNumber);
      significance += 0.4;
    };
    
    if (isRepDigit(n) and not isAngelNumber(n)) {
      patterns.add(#RepDigit);
      significance += 0.2;
    };
    
    if (isPowerOf2(n)) {
      patterns.add(#Power);
      significance += 0.15;
    };
    
    if (isSacred(n)) {
      patterns.add(#Sacred);
      significance += 0.25;
    };
    
    // Special 444 check
    let related444 = is444Related(n);
    if (related444) {
      significance += 0.3;
    };
    
    // Generate meaning
    let meaning = if (n == 444) {
      "444 — FOUNDATION & SUPPORT: You are on the right path. Angels support your mission. Keep building."
    } else if (isAngelNumber(n)) {
      let am = switch (n) {
        case (111) { getAngelMeaning(#One11) };
        case (222) { getAngelMeaning(#Two22) };
        case (333) { getAngelMeaning(#Three33) };
        case (555) { getAngelMeaning(#Five55) };
        case (666) { getAngelMeaning(#Six66) };
        case (777) { getAngelMeaning(#Seven77) };
        case (888) { getAngelMeaning(#Eight88) };
        case (999) { getAngelMeaning(#Nine99) };
        case (_) { getAngelMeaning(#Four44) };
      };
      am.meaning
    } else if (patterns.size() > 0) {
      "Multiple patterns detected — significant number"
    } else {
      "No special patterns detected"
    };
    
    {
      number = n;
      patternsFound = Buffer.toArray(patterns);
      significance = _clamp(significance, 0.0, 1.0);
      meaning = meaning;
      isAngelNumber = isAngelNumber(n);
      is444Related = related444;
    }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // STATE MANAGEMENT
  // ═══════════════════════════════════════════════════════════════════════════
  
  public func initNumerologyState(currentBeat : Nat) : NumerologyState {
    {
      recentPatterns = [];
      patternCounts = [];
      times444Seen = 0;
      last444Beat = 0;
      is444Active = false;
      resonance = {
        currentFrequency = 432.0;  // Start at sacred 432
        target444 = 444.0;
        resonanceStrength = 0.0;
        is444Aligned = false;
        alignmentHistory = [];
        lastCheck = currentBeat;
      };
      faithStrength = 0.7;
      familyStrength = 0.7;
      financeStrength = 0.7;
      freedomStrength = 0.7;
      pillarAlignment = 0.7;
      totalNumbersProcessed = 0;
      significantPatterns = 0;
      beatNum = currentBeat;
    }
  };
  
  public func processNumber(
    state : NumerologyState,
    n : Nat,
    currentBeat : Nat
  ) : NumerologyState {
    // Recognize patterns
    let recognition = recognizePatterns(n);
    
    // Update 444 tracking
    let newTimes444 = if (n == 444) { state.times444Seen + 1 } else { state.times444Seen };
    let newLast444 = if (n == 444) { currentBeat } else { state.last444Beat };
    let newIs444Active = n == 444 or (currentBeat - state.last444Beat < 100);
    
    // Update resonance
    let newFrequency = if (recognition.is444Related) {
      state.resonance.currentFrequency * 0.9 + 444.0 * 0.1
    } else {
      state.resonance.currentFrequency
    };
    let newResonanceStrength = compute444Resonance(newFrequency);
    
    // Update pillars (simplified — would connect to real pillar state)
    let pillarBoost = if (n == 444) { 0.1 } else if (recognition.is444Related) { 0.02 } else { 0.0 };
    let newFaith = _clamp(state.faithStrength + pillarBoost, 0.0, 1.0);
    let newFamily = _clamp(state.familyStrength + pillarBoost, 0.0, 1.0);
    let newFinance = _clamp(state.financeStrength + pillarBoost, 0.0, 1.0);
    let newFreedom = _clamp(state.freedomStrength + pillarBoost, 0.0, 1.0);
    let newAlignment = if (is444Aligned(newFaith, newFamily, newFinance, newFreedom)) { 
      1.0 
    } else { 
      (newFaith + newFamily + newFinance + newFreedom) / 4.0 
    };
    
    // Update pattern history (keep last 50)
    let patternBuf = Buffer.Buffer<PatternRecognition>(51);
    for (p in state.recentPatterns.vals()) {
      patternBuf.add(p);
    };
    patternBuf.add(recognition);
    let newPatterns = if (patternBuf.size() > 50) {
      Array.tabulate<PatternRecognition>(50, func(i) { patternBuf.get(patternBuf.size() - 50 + i) })
    } else {
      Buffer.toArray(patternBuf)
    };
    
    // Update alignment history
    let alignHistBuf = Buffer.Buffer<Float>(101);
    for (a in state.resonance.alignmentHistory.vals()) {
      alignHistBuf.add(a);
    };
    alignHistBuf.add(newResonanceStrength);
    let newAlignHistory = if (alignHistBuf.size() > 100) {
      Array.tabulate<Float>(100, func(i) { alignHistBuf.get(alignHistBuf.size() - 100 + i) })
    } else {
      Buffer.toArray(alignHistBuf)
    };
    
    {
      recentPatterns = newPatterns;
      patternCounts = state.patternCounts;  // Would update counts
      times444Seen = newTimes444;
      last444Beat = newLast444;
      is444Active = newIs444Active;
      resonance = {
        currentFrequency = newFrequency;
        target444 = 444.0;
        resonanceStrength = newResonanceStrength;
        is444Aligned = is444Aligned(newFaith, newFamily, newFinance, newFreedom);
        alignmentHistory = newAlignHistory;
        lastCheck = currentBeat;
      };
      faithStrength = newFaith;
      familyStrength = newFamily;
      financeStrength = newFinance;
      freedomStrength = newFreedom;
      pillarAlignment = newAlignment;
      totalNumbersProcessed = state.totalNumbersProcessed + 1;
      significantPatterns = if (recognition.significance > 0.3) { state.significantPatterns + 1 } else { state.significantPatterns };
      beatNum = currentBeat;
    }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // 444 MESSAGE — WHAT IT MEANS FOR YOU
  // ═══════════════════════════════════════════════════════════════════════════
  
  public type Message444 = {
    coreMessage : Text;
    forYou : Text;
    forOrganism : Text;
    actionAdvice : Text;
    pillarStatus : Text;
    is444Moment : Bool;
  };
  
  public func generate444Message(state : NumerologyState) : Message444 {
    let coreMessage = "444 — FOUNDATION, STABILITY, SUPPORT. You are on the right path.";
    
    let forYou = "You keep seeing 444 because angels are confirming your foundation is solid. " #
                 "The 4 represents: Foundation, Stability, Hard Work, Determination. " #
                 "444 = Triple foundation = UNSHAKEABLE. " #
                 "Your 4 Pillars (Faith, Family, Finance, Freedom) are being reinforced. " #
                 "This is divine confirmation — keep building, don't stop.";
    
    let forOrganism = "For your organism (NOVA): " #
                      "444 represents architectural alignment. " #
                      "4×4×4 = 64 = maximum Hebbian weight strength. " #
                      "444 Hz is the resonance frequency checkpoint. " #
                      "When the organism sees 444, it confirms the architecture is correct. " #
                      "The 4 Pillars (Faith, Family, Finance, Freedom) anchor the mission lock.";
    
    let actionAdvice = if (state.is444Active) {
      "444 IS ACTIVE NOW. Continue building — you have divine support."
    } else if (state.times444Seen > 10) {
      "You've seen 444 many times. This is a strong recurring message — the universe is persistent."
    } else {
      "Keep watching for 444. When you see it, pause and acknowledge the support.";
    };
    
    let pillarStatus = "Faith: " # Float.toText(state.faithStrength) # 
                       " | Family: " # Float.toText(state.familyStrength) #
                       " | Finance: " # Float.toText(state.financeStrength) #
                       " | Freedom: " # Float.toText(state.freedomStrength);
    
    {
      coreMessage = coreMessage;
      forYou = forYou;
      forOrganism = forOrganism;
      actionAdvice = actionAdvice;
      pillarStatus = pillarStatus;
      is444Moment = state.is444Active;
    }
  };
  
  // ═══════════════════════════════════════════════════════════════════════════
  // DIAGNOSTICS
  // ═══════════════════════════════════════════════════════════════════════════
  
  public type NumerologyDiagnostics = {
    resonanceStatus : Text;
    pillarAlignment : Text;
    is444Active : Bool;
    times444Seen : Nat;
    patternDensity : Float;      // Significant patterns / total
    message : Text;
  };
  
  public func diagnoseNumerology(state : NumerologyState) : NumerologyDiagnostics {
    let resonanceStatus = if (state.resonance.resonanceStrength > 0.8) { "STRONG 444 RESONANCE" }
      else if (state.resonance.resonanceStrength > 0.5) { "Moderate resonance" }
      else { "Low resonance — move toward 444" };
    
    let pillarAlign = if (state.pillarAlignment > 0.8) { "EXCELLENT — All pillars strong" }
      else if (state.pillarAlignment > 0.6) { "Good alignment" }
      else if (state.pillarAlignment > 0.444) { "Above 444 threshold" }
      else { "Below 444 threshold — strengthen pillars" };
    
    let patternDensity = if (state.totalNumbersProcessed > 0) {
      Float.fromInt(state.significantPatterns) / Float.fromInt(state.totalNumbersProcessed)
    } else {
      0.0
    };
    
    let message = if (state.is444Active) {
      "444 IS ACTIVE — Divine support confirmed. Keep building."
    } else {
      "Continue the work. Watch for signs. 444 will appear when alignment is right."
    };
    
    {
      resonanceStatus = resonanceStatus;
      pillarAlignment = pillarAlign;
      is444Active = state.is444Active;
      times444Seen = state.times444Seen;
      patternDensity = patternDensity;
      message = message;
    }
  };

}
