    #Prime;
    #Perfect;
    #Triangular;
    #AngelNumber;
    #RepDigit;       // 111, 222, 333, etc.
    #Sequential;     // 123, 234, 345, etc.
    #Mirror;         // 121, 232, 343, etc.
    #Power;          // 4, 8, 16, 32, 64, etc.
    #Sacred;         // 3, 7, 9, 12, 40, etc.
  };
  
  public type PatternRecognition = {
    number : Nat;
    patternsFound : [NumberPattern];
    significance : Float;        // [0, 1] how significant
    meaning : Text;
    isAngelNumber : Bool;
    is444Related : Bool;
  };
  
  public type ResonanceState = {
    currentFrequency : Float;
    target444 : Float;
    resonanceStrength : Float;   // [0, 1]
    is444Aligned : Bool;
    alignmentHistory : [Float];
    lastCheck : Nat;
  };
  
