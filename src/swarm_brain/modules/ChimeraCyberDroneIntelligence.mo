  // ═══════════════════════════════════════════════════════════════════════════
  // CYBER TERRAIN — The Digital Landscape
  // ═══════════════════════════════════════════════════════════════════════════
  // Just as physical drones navigate airspace, cyber drones navigate
  // network topology. Subnets are sectors. Routers are waypoints.
  // Edge servers are forward operating bases.
  // The internet IS the terrain.

  public type CyberTerrainNode = {
    nodeId : Nat;
    nodeType : NodeType;
    subnetAddress : Text;       // Network address space
    latitude : Float;           // Physical location of infrastructure
    longitude : Float;
    elevation : Float;          // Layer depth in network stack
    bandwidth : Float;          // Mbps — terrain "width"
    latency : Float;            // ms — terrain "friction"
    packetLoss : Float;         // 0-1 — terrain "roughness"
    cpuLoad : Float;            // 0-1 — terrain "density"
    memoryUsage : Float;        // 0-1 — terrain "weight"
    uptime : Float;             // Seconds — terrain "stability"
    threatLevel : Float;        // 0-1 — current threat at this node
    coherence : Float;          // 0-1 — health coherence
    lastHeartbeat : Nat;        // Beat number of last pulse
    connectedNodes : [Nat];     // Adjacency — topology graph
    pheromoneTrail : Float;     // Stigmergy — cyber pheromone deposit
  };

  public type NodeType = {
    #EdgeServer;       // Forward operating base — closest to users
    #CoreRouter;       // Highway intersection — high throughput
    #Canister;         // ICP canister — sovereign compute unit
    #SubnetNode;       // Subnet validator — consensus participant
    #Gateway;          // Bridge between networks — chokepoint
    #LoadBalancer;     // Traffic distributor — flow controller
    #DNS;              // Name resolution — the map itself
    #Firewall;         // Perimeter defense — the wall
    #IoTHub;           // IoT aggregator — sensor fusion point
    #SatelliteLink;    // Space-ground bridge — EM-to-cyber interface
    #CDNEdge;          // Content delivery — forward cache
    #APIGateway;       // Service entry — protocol translator
  };

  public type CyberTerrain = {
    nodes : [CyberTerrainNode];
    totalNodes : Nat;
    globalLatency : Float;         // Average network latency
    globalThroughput : Float;      // Aggregate bandwidth
    globalCoherence : Float;       // Kuramoto order parameter across nodes
    topologyType : TopologyType;
    totalPheromone : Float;        // Aggregate stigmergy signal
    lastScanBeat : Nat;
  };

  public type TopologyType = {
    #Mesh;        // Full mesh — resilient, high coherence
    #Star;        // Hub-and-spoke — centralized
    #Ring;        // Ring — ordered, sequential
    #Tree;        // Hierarchical — structured
    #Hybrid;      // Mixed — real-world networks
