  };

  public func initAbsoluteChimeraCyber() : AbsoluteChimeraCyberState {
    {
      finalChimera = initFinalChimeraCyber();
      swarmLearning = initSwarmLearning(10, 100);
      reinforcementLearning = initReinforcementLearning();
