    absoluteEnergy : Float;
    absoluteMemory : Float;
    absoluteLearning : Float;
    absoluteFitness : Float;
    absoluteCommunication : Float;
    // === ABSOLUTE STATUS ===
    absoluteStatus : AbsoluteStatus;
    // === FINAL STATISTICS ===
    absoluteHeartbeats : Nat;
    absoluteBeat : Nat;
  };

  public type AbsoluteStatus = {
    #Dormant;
    #Initializing;
    #Online;
    #Learning;
    #Evolving;
    #Defending;
    #Attacking;
