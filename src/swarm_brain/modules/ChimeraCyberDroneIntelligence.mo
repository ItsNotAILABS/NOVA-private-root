    successfulRequests : Nat;
    failedRequests : Nat;
    averageLatency : Float;
    // Rate limiting
    requestsThisBeat : Nat;
    maxRequestsPerBeat : Nat;
    // Authentication
    authenticatedSources : [Text];
    // Logging
