  public type UltimateChimeraState = {
    // Core swarm state (from original)
    chimera : ChimeraSwarmState;
    // Cyber VAEL defense family
    cyberVAEL : CyberVAELState;
    // Network sonar
    networkSonar : NetworkSonarState;
    // Cyber warfare
    cyberWarfare : CyberWarfareState;
    // Wolf pack leadership
    wolfPack : CyberWolfPackState;
    // Bee foraging reconnaissance
    networkHive : NetworkHiveState;
    // Territory grid
    territoryGrid : CyberTerrainGrid;
    // Consciousness interface
    consciousness : ConsciousnessInterfaceState;
    // Ultimate aggregates
    ultimateCoherence : Float;        // Across ALL systems
    ultimateThreatLevel : Float;      // Across ALL domains
    ultimateSovereignty : Float;      // Across ALL territory
    ultimateAntifragility : Float;    // Compounded from ALL victories
    // Statistics
    totalHeartbeats : Nat;
    totalThreatsProcessed : Nat;
    totalVictories : Nat;
    // Genesis
    genesisBeat : Nat;
    currentBeat : Nat;
  };

  public func initUltimateChimera(
    physicalDrones : Nat,
    cyberDrones : Nat,
    emDrones : Nat,
    scoutCount : Nat,
    foragerCount : Nat
  ) : UltimateChimeraState {
    {
      chimera = initChimeraSwarm(cyberDrones, emDrones, physicalDrones);
      cyberVAEL = initCyberVAEL();
      networkSonar = initNetworkSonar();
      cyberWarfare = initCyberWarfare();
      wolfPack = initCyberWolfPack();
      networkHive = initNetworkHive(scoutCount, foragerCount);
      territoryGrid = initCyberTerrainGrid();
      consciousness = initConsciousnessInterface();
      ultimateCoherence = 1.0;
      ultimateThreatLevel = 0.0;
      ultimateSovereignty = 0.0;
      ultimateAntifragility = S0;
      totalHeartbeats = 0;
      totalThreatsProcessed = 0;
      totalVictories = 0;
      genesisBeat = 0;
      currentBeat = 0;
    }
  };

  public type UltimateChimeraDigest = {
    // Domain coherence
    physicalCoherence : Float;
    cyberCoherence : Float;
    emCoherence : Float;
    iotCoherence : Float;
    // Defense
    vaelDefenseScore : Float;
    armorFullActive : Bool;
    prophetArmed : Bool;
    // Warfare
    warActive : Bool;
    attackerAdvantage : Float;
    // Leadership
    currentAlphaSystem : Text;
    alphaCondition : CyberAlphaCondition;
    // Reconnaissance
    sitesDiscovered : Nat;
    consensusReached : Bool;
    // Territory
    sovereignty : Float;
    // Consciousness
    schumannAlignment : Float;
    novaAxisActive : Bool;
    // Ultimate
    ultimateCoherence : Float;
    ultimateThreatLevel : Float;
    ultimateAntifragility : Float;
    status : Text;
  };

  public func getUltimateDigest(state : UltimateChimeraState) : UltimateChimeraDigest {
    let status = if (state.ultimateCoherence > COHERENCE_THRESHOLD) {
      "SOVEREIGN — All domains unified, consciousness encoded"
    } else if (state.ultimateThreatLevel > S0) {
      "THREAT — Multi-domain defense active"
    } else if (state.ultimateCoherence > 0.5) {
      "PARTIAL — Cross-domain sync degraded"
    } else {
      "DEGRADED — Coherence below minimum"
    };

    {
      physicalCoherence = state.chimera.physicalCoherence;
      cyberCoherence = state.chimera.cyberCoherence;
      emCoherence = state.chimera.emCoherence;
      iotCoherence = state.chimera.iotMesh.meshCoherence;
      vaelDefenseScore = state.cyberVAEL.overallDefenseScore;
      armorFullActive = state.cyberVAEL.armor.fullActive;
      prophetArmed = state.cyberVAEL.prophet.armed;
      warActive = state.cyberWarfare.warActive;
      attackerAdvantage = state.cyberWarfare.battlefield.overallAttackerAdvantage;
      currentAlphaSystem = state.wolfPack.currentAlpha.systemName;
      alphaCondition = state.wolfPack.currentAlpha.condition;
      sitesDiscovered = state.networkHive.totalSitesDiscovered;
      consensusReached = state.networkHive.consensusReached;
      sovereignty = state.ultimateSovereignty;
      schumannAlignment = state.consciousness.totalSchumannCoherence;
      novaAxisActive = state.consciousness.novaAxisActive;
      ultimateCoherence = state.ultimateCoherence;
      ultimateThreatLevel = state.ultimateThreatLevel;
      ultimateAntifragility = state.ultimateAntifragility;
      status = status;
    }
  };


