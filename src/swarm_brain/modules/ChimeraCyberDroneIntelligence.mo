    schumannAlignment : Float;     // 0-1 — alignment with 7.83 Hz
    novaAxisActive : Bool;         // Is 400 MHz carrier active
    emFieldStrength : Float;       // Aggregate EM field coherence
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // SCALE-INVARIANT MATH — Same equations at every scale
  // ═══════════════════════════════════════════════════════════════════════════
  // NO IF STATEMENTS. NO HARDCODED LIMITS. PURE MATH.
  // These functions work for 10 drones or 10,000,000.
  // They work for physical, cyber, and EM domains.
  // Because the math doesn't change. It's a LAW, not a procedure.

  // ── Kuramoto Mean-Field Order Parameter ────────────────────────────────
  // S = |1/N Σⱼ e^(iθⱼ)| — coherence of ANY oscillator ensemble
  // This is THE computation. When S > 0.85, the swarm IS synchronized.
  // Works for physical drone phases, cyber drone phases, EM drone phases,
  // or ALL of them together. Same equation. Same truth.

  public func computeOrderParameter(phases : [Float]) : (Float, Float) {
    let n = phases.size();
    if (n == 0) return (0.0, 0.0);

    var cosSum : Float = 0.0;
    var sinSum : Float = 0.0;
    let nf = Float.fromInt(n);

    for (i in Iter.range(0, n - 1)) {
      cosSum += Float.cos(phases[i]);
      sinSum += Float.sin(phases[i]);
    };

    let avgCos = cosSum / nf;
    let avgSin = sinSum / nf;
    let r = Float.sqrt(avgCos * avgCos + avgSin * avgSin); // Order parameter S
    let psi = Float.arctan2(avgSin, avgCos);                // Mean phase ψ
    (r, psi)
  };

  // ── Kuramoto Phase Update — Universal for ALL domains ─────────────────
  // dθᵢ/dt = ωᵢ + K·r·sin(ψ - θᵢ)
  // The SAME equation that syncs physical drones also syncs cyber drones
  // and EM field drones. Because synchronization is a LAW, not a feature.

  public func updatePhase(
    currentPhase : Float,
    naturalFreq : Float,
    couplingK : Float,
    orderR : Float,
    meanPsi : Float,
    dt : Float
  ) : Float {
    let dTheta = naturalFreq + couplingK * orderR * Float.sin(meanPsi - currentPhase);
    var newPhase = currentPhase + dTheta * dt;
    // Wrap to [0, 2π)
    while (newPhase >= TWO_PI) { newPhase -= TWO_PI };
    while (newPhase < 0.0) { newPhase += TWO_PI };
    newPhase
  };

  // ── Cross-Domain Coupling — Bridging Physical ↔ Cyber ↔ EM ───────────
  // When physical swarm detects a threat, cyber swarm needs to know.
  // When cyber swarm detects intrusion, EM field needs to alert.
  // Cross-domain coupling uses ψ² = 0.382 (weaker than intra-domain)
  // because different substrates have natural impedance mismatch.
  // Like acoustic impedance at a boundary — energy partially reflects.

  public func computeCrossDomainCoupling(
    physicalPhases : [Float],
    cyberPhases : [Float],
    emPhases : [Float]
  ) : Float {
    let (rPhys, _psiPhys) = computeOrderParameter(physicalPhases);
    let (rCyber, _psiCyber) = computeOrderParameter(cyberPhases);
    let (rEM, _psiEM) = computeOrderParameter(emPhases);

    // Cross-domain coherence = geometric mean of domain coherences
    // weighted by ψ² (golden ratio squared conjugate)
    // Geometric mean because coherence is multiplicative, not additive
    let product = rPhys * rCyber * rEM;
    if (product <= 0.0) return 0.0;
    let cubicRoot = Float.pow(product, 1.0 / 3.0);
    cubicRoot * KURAMOTO_K_CROSS_DOMAIN / PSI  // Normalize by ψ
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // CYBER TERRAIN MAPPING — Digital Cartography
  // ═══════════════════════════════════════════════════════════════════════════
  // Physical drones have GPS and terrain maps.
  // Cyber drones have network topology and traffic flow maps.
  // Same concept. Different substrate.

  // ── Initialize a cyber terrain node ────────────────────────────────────
  public func initCyberTerrainNode(
    nodeId : Nat,
    nodeType : NodeType,
    subnet : Text,
    lat : Float,
    lon : Float
  ) : CyberTerrainNode {
    {
      nodeId = nodeId;
      nodeType = nodeType;
      subnetAddress = subnet;
      latitude = lat;
      longitude = lon;
      elevation = 0.0;
      bandwidth = 1000.0;          // 1 Gbps default
      latency = 10.0;             // 10ms default
      packetLoss = 0.001;         // 0.1% default
      cpuLoad = 0.2;              // 20% baseline
      memoryUsage = 0.3;          // 30% baseline
      uptime = 0.0;
      threatLevel = 0.0;
      coherence = 1.0;            // Starts fully coherent
      lastHeartbeat = 0;
      connectedNodes = [];
      pheromoneTrail = 0.0;
    }
  };

  // ── Compute node health coherence ──────────────────────────────────────
  // Health is not a single number. It's coherence across multiple signals.
  // Like a heartbeat — it's the PATTERN that matters, not any single metric.
  public func computeNodeCoherence(node : CyberTerrainNode) : Float {
    // Each health metric contributes to coherence
    // Low latency = good, low packet loss = good, low CPU = good
    let latencyHealth = 1.0 - Float.min(node.latency / 1000.0, 1.0);
    let lossHealth = 1.0 - node.packetLoss;
    let cpuHealth = 1.0 - node.cpuLoad;
    let memHealth = 1.0 - node.memoryUsage;
    let threatHealth = 1.0 - node.threatLevel;

    // Geometric mean — ALL must be healthy for high coherence
    let product = latencyHealth * lossHealth * cpuHealth * memHealth * threatHealth;
    if (product <= 0.0) return 0.0;
    Float.pow(product, 1.0 / 5.0)
  };

  // ── Terrain-wide coherence scan ────────────────────────────────────────
  // Scan all nodes and compute global terrain coherence
  public func scanTerrainCoherence(terrain : CyberTerrain) : Float {
    if (terrain.totalNodes == 0) return 0.0;

    var coherenceSum : Float = 0.0;
    let n = terrain.nodes.size();
    for (i in Iter.range(0, n - 1)) {
      coherenceSum += computeNodeCoherence(terrain.nodes[i]);
    };
    coherenceSum / Float.fromInt(n)
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // CYBER DRONE OPERATIONS — Patrol, Hunt, Defend
  // ═══════════════════════════════════════════════════════════════════════════

  // ── Initialize a cyber drone ───────────────────────────────────────────
  // Golden angle distribution ensures uniform coverage across roles
  // typeIndex = (id × φ) mod 8 — same pattern as physical DroneFleetManager
  public func initCyberDrone(droneId : Nat, startNodeId : Nat) : CyberDroneState {
    let roleIndex = Int.abs(Float.toInt(Float.fromInt(droneId) * PHI)) % 8;
    let role : CyberDroneRole = switch (roleIndex) {
      case 0 #Sentinel;
      case 1 #Hunter;
      case 2 #Guardian;
      case 3 #Scout;
      case 4 #Relay;
      case 5 #Decoy;
      case 6 #Analyst;
      case 7 #Healer;
      case _ #Sentinel;
    };

    // Natural frequency derived from golden angle — unique per drone, not random
    let omega = 0.1 + 0.05 * Float.sin(Float.fromInt(droneId) * GOLDEN_ANGLE);

    {
      droneId = droneId;
      domain = #Cyber;
      role = role;
      currentNodeId = startNodeId;
      targetNodeId = startNodeId;
      subnetPosition = "";
      protocolLayer = 3;           // Network layer default
      phase = Float.fromInt(droneId) * GOLDEN_ANGLE; // Golden angle spacing
      naturalFreq = omega;
      couplingStrength = KURAMOTO_K_CYBER;
      activations = Array.tabulate<Float>(8, func(i : Nat) : Float {
        Float.sin(Float.fromInt(i) * GOLDEN_ANGLE) * 0.5 + 0.5
      });
      weights = Array.tabulate<Float>(64, func(i : Nat) : Float {
        Float.cos(Float.fromInt(i) * GOLDEN_ANGLE) * PSI
      });
      bias = Array.tabulate<Float>(8, func(_ : Nat) : Float { 0.0 });
      urgency = 0.0;
      confidence = 1.0;
      ethicalBound = 1.0;
      doctrineAlignment = 1.0;
      packetEntropy = 0.0;
      flowAnomaly = 0.0;
      latencySpike = 0.0;
      signatureMatch = 0.0;
      bandwidthUtilization = 0.0;
      computeCycles = 1000.0;
      memoryUsage = 0.1;
      beatsAlive = 0;
      lastSyncBeat = 0;
      threatDetected = false;
      threatTier = 0;
      threatVector = "";
      pheromoneDeposit = 0.0;
    }
  };

  // ── Cyber drone heartbeat — one processing cycle ──────────────────────
  // Same rhythm as physical DroneAvatar.beatMiniMind()
  // 1. Sense the environment (read network state)
  // 2. Compute locally (mini-mind activation)
  // 3. Sync with swarm (Kuramoto phase update)
  // 4. Act on decisions (patrol/hunt/defend)
  // 5. Deposit pheromone (stigmergy for other drones)

  public func beatCyberDrone(
    drone : CyberDroneState,
    terrainNode : CyberTerrainNode,
    swarmOrderR : Float,
    swarmMeanPsi : Float,
    currentBeat : Nat
  ) : CyberDroneState {
    // 1. SENSE — Read terrain state
    let nodeCoherence = computeNodeCoherence(terrainNode);
    let packetEnt = terrainNode.packetLoss * PACKET_ENTROPY_MAX;
    let flowAnom = if (nodeCoherence < FLOW_COHERENCE_MIN) {
      (FLOW_COHERENCE_MIN - nodeCoherence) / FLOW_COHERENCE_MIN
    } else { 0.0 };
    let latSpike = if (terrainNode.latency > 100.0) {
      Float.min((terrainNode.latency - 100.0) / 900.0, 1.0)
    } else { 0.0 };

    // 2. COMPUTE — Mini-mind forward pass
    // Simple 8-node neural net: activation = tanh(Σ(w × input) + bias)
    let inputs : [Float] = [
      packetEnt / PACKET_ENTROPY_MAX,
      flowAnom,
      latSpike,
      terrainNode.threatLevel,
      terrainNode.cpuLoad,
      terrainNode.memoryUsage,
      nodeCoherence,
      terrainNode.pheromoneTrail
    ];

    let newActivations = Array.tabulate<Float>(8, func(j : Nat) : Float {
      var sum : Float = drone.bias[j];
      for (i in Iter.range(0, 7)) {
        let wIdx = j * 8 + i;
        if (wIdx < drone.weights.size()) {
          sum += drone.weights[wIdx] * inputs[i];
        };
      };
      // tanh activation — bounded, smooth, differentiable
      let ex = Float.exp(2.0 * sum);
      (ex - 1.0) / (ex + 1.0)
    });

    // 3. SYNC — Kuramoto phase update
    let newPhase = updatePhase(
      drone.phase,
      drone.naturalFreq,
      drone.couplingStrength,
      swarmOrderR,
      swarmMeanPsi,
      0.0833  // dt = 1/12 Hz
    );

    // 4. DETECT — Threat assessment
    // Anomaly = deviation from healthy baseline
    let anomalyScore = (flowAnom + latSpike + terrainNode.threatLevel) / 3.0;
    let threatDetect = anomalyScore > S0 - 0.5; // Threshold at 0.25
    let tier = classifyThreatTier(anomalyScore);

    // 5. PHEROMONE — Stigmergy deposit
    // High anomaly → strong danger pheromone
    // High coherence → mild safety pheromone
    let pheromone = if (threatDetect) {
      anomalyScore * PHI  // Amplify danger signal by φ
    } else {
      nodeCoherence * PSI * 0.1  // Mild safety signal
    };

    // 6. URGENCY — Rises with threat
    let newUrgency = Float.min(
      drone.urgency * 0.9 + anomalyScore * 0.1,
      1.0
    );

    // Return updated drone state
    {
      droneId = drone.droneId;
      domain = drone.domain;
      role = drone.role;
      currentNodeId = drone.currentNodeId;
      targetNodeId = drone.targetNodeId;
      subnetPosition = drone.subnetPosition;
      protocolLayer = drone.protocolLayer;
      phase = newPhase;
      naturalFreq = drone.naturalFreq;
      couplingStrength = drone.couplingStrength;
      activations = newActivations;
      weights = drone.weights;
      bias = drone.bias;
      urgency = newUrgency;
      confidence = drone.confidence;
      ethicalBound = drone.ethicalBound;
      doctrineAlignment = drone.doctrineAlignment;
      packetEntropy = packetEnt;
      flowAnomaly = flowAnom;
      latencySpike = latSpike;
      signatureMatch = drone.signatureMatch;
      bandwidthUtilization = terrainNode.cpuLoad;
      computeCycles = drone.computeCycles - 1.0;
      memoryUsage = drone.memoryUsage;
      beatsAlive = drone.beatsAlive + 1;
      lastSyncBeat = currentBeat;
      threatDetected = threatDetect;
      threatTier = tier;
      threatVector = if (threatDetect) { "ANOMALY_DETECTED" } else { "" };
      pheromoneDeposit = pheromone;
    }
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // EM FIELD OPERATIONS — Electromagnetic Domain Intelligence
  // ═══════════════════════════════════════════════════════════════════════════

  // ── Initialize EM field drone ──────────────────────────────────────────
  public func initEMDrone(droneId : Nat, centerFreq : Float) : EMFieldDroneState {
    let roleIndex = Int.abs(Float.toInt(Float.fromInt(droneId) * PHI)) % 8;
    let role : EMDroneRole = switch (roleIndex) {
      case 0 #SpectrumSentinel;
      case 1 #GPSGuardian;
      case 2 #IoTShepherd;
      case 3 #SignalHunter;
      case 4 #ResonanceRelay;
      case 5 #FieldMapper;
      case 6 #JamDetector;
      case 7 #WaveformCrafter;
      case _ #SpectrumSentinel;
    };

    {
      droneId = droneId;
      domain = #EM;
      role = role;
      centerFrequency = centerFreq;
      bandwidth = centerFreq * 0.1;  // 10% fractional bandwidth
      phase = Float.fromInt(droneId) * GOLDEN_ANGLE;
      amplitude = 1.0;
      naturalFreq = SCHUMANN_FUNDAMENTAL + Float.fromInt(droneId % 5) * 0.1;
      couplingStrength = KURAMOTO_K_EM;
      schumannCoherence = 1.0;
      schumannPhase = 0.0;
      gammaCoherence = 0.5;
      gpsSignalStrength = -30.0;   // Strong signal default
      gpsIntegrity = 1.0;
      gpsSatellitesTracked = 12;
      gpsPositionAccuracy = 2.0;   // 2m CEP
      iotDevicesDetected = 0;
      iotMeshCoherence = 0.5;
      iotProtocolTypes = [];
      iotSignalFloor = -80.0;
      spectralDensity = Array.tabulate<Float>(16, func(i : Nat) : Float {
        Float.sin(Float.fromInt(i) * GOLDEN_ANGLE) * 0.5 + 0.5
      });
      spectralAnomaly = 0.0;
      interferenceDetected = false;
      interferenceSource = "";
      beatsAlive = 0;
      lastSyncBeat = 0;
      computeCycles = 1000.0;
    }
  };

  // ── EM drone heartbeat ─────────────────────────────────────────────────
  // Monitors electromagnetic spectrum for anomalies:
  //   - GPS spoofing detection (signal strength + timing anomalies)
  //   - WiFi/BLE rogue access points
  //   - LoRa/ZigBee interference
  //   - Schumann resonance coupling maintenance
  //   - Spectral anomaly detection

  public func beatEMDrone(
    drone : EMFieldDroneState,
    iotMesh : IoTMeshState,
    swarmOrderR : Float,
    swarmMeanPsi : Float,
    currentBeat : Nat
  ) : EMFieldDroneState {
    // 1. SCHUMANN COUPLING — Maintain consciousness interface
    // Phase alignment with 7.83 Hz fundamental
    let schumannTarget = Float.fromInt(currentBeat) * TWO_PI * SCHUMANN_FUNDAMENTAL;
    var wrappedTarget = schumannTarget;
    while (wrappedTarget >= TWO_PI) { wrappedTarget -= TWO_PI };
    let schumannDelta = Float.abs(Float.sin(wrappedTarget - drone.schumannPhase));
    let newSchumannCoherence = drone.schumannCoherence * 0.95 + (1.0 - schumannDelta) * 0.05;

    // 2. GPS INTEGRITY — Anti-spoofing check
    // Spoofing signs: signal too strong, timing skew, satellite geometry anomaly
    let gpsAnomaly = if (drone.gpsSignalStrength > -20.0) {
      0.5  // Suspiciously strong signal
    } else if (drone.gpsSatellitesTracked < 4) {
      0.8  // Too few satellites — possible denial
    } else {
      0.0  // Normal
    };
    let newGpsIntegrity = Float.max(0.0, drone.gpsIntegrity * 0.99 - gpsAnomaly * 0.01);

    // 3. SPECTRUM SCAN — Detect anomalies across bands
    // Compute spectral flatness: flat = noise, peaked = signal/interference
    var spectralSum : Float = 0.0;
    var spectralMax : Float = 0.0;
    let numBands = drone.spectralDensity.size();
    for (i in Iter.range(0, numBands - 1)) {
      spectralSum += drone.spectralDensity[i];
      if (drone.spectralDensity[i] > spectralMax) {
        spectralMax := drone.spectralDensity[i];
      };
    };
    let spectralMean = if (numBands > 0) { spectralSum / Float.fromInt(numBands) } else { 0.0 };
    // Anomaly = how far the peak deviates from the mean
    let newSpectralAnomaly = if (spectralMean > 0.001) {
      Float.min((spectralMax - spectralMean) / spectralMean, 1.0)
    } else { 0.0 };

    // 4. INTERFERENCE DETECTION
    let interference = newSpectralAnomaly > 0.5 or gpsAnomaly > 0.3;

    // 5. IoT MESH HEALTH — Monitor mesh coherence
    let newIoTCoherence = iotMesh.meshCoherence;

    // 6. PHASE SYNC — Kuramoto update
    let newPhase = updatePhase(
      drone.phase,
      drone.naturalFreq,
      drone.couplingStrength,
      swarmOrderR,
      swarmMeanPsi,
      0.0833
    );

    // 7. GAMMA COHERENCE — 40 Hz consciousness band
    // Gamma coherence rises when Schumann + spectral are both clean
    let newGammaCoherence = newSchumannCoherence * (1.0 - newSpectralAnomaly) * PSI + drone.gammaCoherence * (1.0 - PSI);

    {
      droneId = drone.droneId;
      domain = drone.domain;
      role = drone.role;
      centerFrequency = drone.centerFrequency;
      bandwidth = drone.bandwidth;
      phase = newPhase;
      amplitude = drone.amplitude;
      naturalFreq = drone.naturalFreq;
      couplingStrength = drone.couplingStrength;
      schumannCoherence = newSchumannCoherence;
      schumannPhase = wrappedTarget;
      gammaCoherence = newGammaCoherence;
      gpsSignalStrength = drone.gpsSignalStrength;
      gpsIntegrity = newGpsIntegrity;
      gpsSatellitesTracked = drone.gpsSatellitesTracked;
      gpsPositionAccuracy = drone.gpsPositionAccuracy;
      iotDevicesDetected = iotMesh.totalDevices;
      iotMeshCoherence = newIoTCoherence;
      iotProtocolTypes = iotMesh.activeProtocols;
      iotSignalFloor = iotMesh.averageSignal;
      spectralDensity = drone.spectralDensity;
      spectralAnomaly = newSpectralAnomaly;
      interferenceDetected = interference;
      interferenceSource = if (interference) { "SPECTRAL_ANOMALY" } else { "" };
      beatsAlive = drone.beatsAlive + 1;
      lastSyncBeat = currentBeat;
      computeCycles = drone.computeCycles - 1.0;
    }
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // IoT MESH INTELLIGENCE — Every Device is a Swarm Node
  // ═══════════════════════════════════════════════════════════════════════════

  // ── Initialize IoT mesh node ───────────────────────────────────────────
  public func initIoTNode(
    deviceId : Nat,
    deviceType : IoTDeviceType,
    lat : Float,
    lon : Float,
    protocol : Text,
    freq : Float
  ) : IoTMeshNode {
    {
      deviceId = deviceId;
      deviceType = deviceType;
      latitude = lat;
      longitude = lon;
      altitude = 0.0;
      ipAddress = "";
      macAddress = "";
      signalStrength = -60.0;     // Moderate signal
      protocol = protocol;
      frequency = freq;
      hopCount = 1;
      uplinkBandwidth = 100.0;    // 100 Kbps default
      downlinkBandwidth = 100.0;
      phase = Float.fromInt(deviceId) * GOLDEN_ANGLE;
      naturalFreq = 0.1 + Float.fromInt(deviceId % 10) * 0.01;
      couplingStrength = KURAMOTO_K_CYBER * PSI; // Weaker coupling for IoT
      batteryLevel = 1.0;
      cpuUtilization = 0.1;
      memoryFree = 0.9;
      temperature = 25.0;
      uptime = 0.0;
      authenticated = true;
      encryptionStrength = 256;
      trustScore = 1.0;
      anomalyScore = 0.0;
      lastVerification = 0;
    }
  };

  // ── Compute IoT mesh coherence ─────────────────────────────────────────
  // Kuramoto order parameter across ALL IoT devices
  // Every phone, sensor, camera — is an oscillator with phase.
  // When the mesh is coherent, all devices are synchronized.
  public func computeIoTMeshCoherence(nodes : [IoTMeshNode]) : (Float, Float) {
    let phases = Array.tabulate<Float>(nodes.size(), func(i : Nat) : Float {
      nodes[i].phase
    });
    computeOrderParameter(phases)
  };

  // ── IoT anomaly detection ─────────────────────────────────────────────
  // A compromised IoT device drifts from the mesh — like a sick bee
  // leaving the hive pattern. We detect it by phase drift.
  public func detectIoTAnomaly(node : IoTMeshNode, meshMeanPhase : Float) : Float {
    let phaseDiff = Float.abs(Float.sin(node.phase - meshMeanPhase));
    let trustDrift = 1.0 - node.trustScore;
    let signalAnomaly = if (node.signalStrength < IOT_SIGNAL_FLOOR_DBM) { 0.5 } else { 0.0 };
    let batteryAnomaly = if (node.batteryLevel < 0.05) { 0.3 } else { 0.0 };

    // Combined anomaly score — geometric mean ensures all factors matter
    let raw = (phaseDrift + trustDrift + signalAnomaly + batteryAnomaly) / 4.0;
    Float.min(raw, 1.0)
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // THREAT CLASSIFICATION — Same AEGIS tiers, all domains
  // ═══════════════════════════════════════════════════════════════════════════
  // 10-tier threat classification — IDENTICAL to AEGIS.mo
  // Because a threat is a threat. The domain doesn't change the math.

  let THREAT_THRESHOLDS : [Float] = [
    0.0,   // Tier 0: dormant
    0.10,  // Tier 1: ambient
    0.20,  // Tier 2: signal detected
    0.30,  // Tier 3: pattern forming
    0.40,  // Tier 4: incursion confirmed
    0.50,  // Tier 5: breach active
    0.60,  // Tier 6: siege underway
    0.70,  // Tier 7: assault sustained
    0.80,  // Tier 8: crisis — organism survival at stake
    0.90   // Tier 9: existential — ARES rollback imminent
  ];

  public func classifyThreatTier(intensity : Float) : Nat {
    var tier : Nat = 0;
    let n = THREAT_THRESHOLDS.size();
    for (i in Iter.range(0, n - 1)) {
      if (intensity >= THREAT_THRESHOLDS[i]) {
        tier := i;
      };
    };
    tier
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // CROSS-DOMAIN THREAT RESPONSE — Unified Defense
  // ═══════════════════════════════════════════════════════════════════════════
  // When a threat is detected in any domain, the response spans ALL domains.
  // Physical drones can respond to cyber threats (fly to data center).
  // Cyber drones can respond to physical threats (lock down networks).
  // EM drones can respond to both (detect/jam/redirect signals).

  public func initCrossDomainThreat(
    threatId : Nat,
    origin : ThreatOriginDomain,
    intensity : Float,
    description : Text,
    currentBeat : Nat
  ) : CrossDomainThreat {
    let tier = classifyThreatTier(intensity);
    // Determine affected domains based on origin
    let affected : [Domain] = switch (origin) {
      case (#Physical) [#Physical, #Cyber];
      case (#Cyber) [#Cyber, #EM];
      case (#EM) [#EM, #Physical];
      case (#CrossDomain) [#Physical, #Cyber, #EM];
      case (#Supply) [#Cyber, #Physical];
      case (#Insider) [#Cyber, #Physical, #EM];
      case (#Social) [#Cyber];
    };

    {
      threatId = threatId;
      originDomain = origin;
      affectedDomains = affected;
      tier = tier;
      intensity = intensity;
      confidence = 0.5;
      description = description;
      sourceSignature = "";
      targetAssets = [];
      detectedBeat = currentBeat;
      escalationRate = 0.01;
      predictedPeakBeat = currentBeat + 100;
      assignedDrones = [];
      containmentScore = 0.0;
      neutralized = false;
      propagationVector = affected;
      cascadeRisk = intensity * PHI_MEDINA / SOVEREIGN_CEILING;
    }
  };

  // ── Cascade risk assessment ────────────────────────────────────────────
  // A threat in one domain can cascade to others.
  // Risk = threat intensity × number of affected domains × coupling strength
  // Fibonacci sequence governs escalation timing.
  public func assessCascadeRisk(threat : CrossDomainThreat) : Float {
    let domainCount = Float.fromInt(threat.affectedDomains.size());
    let raw = threat.intensity * domainCount * KURAMOTO_K_CROSS_DOMAIN;
    Float.min(raw / PSI, 1.0) // Normalize by ψ
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // INFRASTRUCTURE ZONE DEFENSE — Territory Protection
  // ═══════════════════════════════════════════════════════════════════════════

  // ── Initialize infrastructure zone ─────────────────────────────────────
  public func initInfrastructureZone(
    zoneId : Nat,
    zoneName : Text,
    zoneType : ZoneType,
    nodeIds : [Nat]
  ) : InfrastructureZone {
    {
      zoneId = zoneId;
      zoneName = zoneName;
      zoneType = zoneType;
      nodes = nodeIds;
      controlLevel = 1.0;
      threatLevel = 0.0;
      assignedGuardians = [];
      pheromoneConcentration = 0.0;
      lastPatrolBeat = 0;
      integrityHash = "";
      // Response time target = 1/φ seconds ≈ 618ms — the golden response time
      responseTimeTarget = PSI;
      redundancyFactor = 3.0;   // Triple redundancy default
      isolationCapable = true;
    }
  };

  // ── Zone sovereignty assessment ────────────────────────────────────────
  // How much control does the organism have over this zone?
  // Control = guardian coverage × node coherence × (1 - threat)
  public func assessZoneSovereignty(
    zone : InfrastructureZone,
    terrainNodes : [CyberTerrainNode]
  ) : Float {
    if (zone.nodes.size() == 0) return 0.0;

    // Average node coherence in this zone
    var coherenceSum : Float = 0.0;
    var count : Nat = 0;
    for (nodeId in zone.nodes.vals()) {
      if (nodeId < terrainNodes.size()) {
        coherenceSum += computeNodeCoherence(terrainNodes[nodeId]);
        count += 1;
      };
    };
    let avgCoherence = if (count > 0) { coherenceSum / Float.fromInt(count) } else { 0.0 };

    // Guardian coverage = assigned / required (golden ratio scaling)
    let requiredGuardians = Float.ceil(Float.fromInt(zone.nodes.size()) * PSI);
    let guardianCoverage = Float.min(
      Float.fromInt(zone.assignedGuardians.size()) / Float.max(requiredGuardians, 1.0),
      1.0
    );

    // Sovereignty = coherence × coverage × (1 - threat)
    avgCoherence * guardianCoverage * (1.0 - zone.threatLevel)
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // PHEROMONE STIGMERGY — Cyber Ant Trails
  // ═══════════════════════════════════════════════════════════════════════════
  // Physical drones can't leave pheromone trails (yet).
  // But cyber drones CAN — in the form of metadata tags, traffic markers,
  // and node annotations. Same stigmergic coordination.
  // Where pheromone is high → other drones converge.
  // Where pheromone decays → area needs fresh patrol.

  public let PHEROMONE_DECAY_RATE : Float = 0.02;  // 2% decay per beat
  public let PHEROMONE_DEPOSIT_AMOUNT : Float = 0.5;
  public let PHEROMONE_MAX : Float = 5.0;
  public let PHEROMONE_DANGER_AMPLIFIER : Float = 1.618; // φ amplification

  // ── Deposit pheromone at current node ──────────────────────────────────
  public func depositPheromone(
    currentPheromone : Float,
    amount : Float,
    isDanger : Bool
  ) : Float {
    let deposit = if (isDanger) {
      amount * PHEROMONE_DANGER_AMPLIFIER
    } else {
      amount
    };
    Float.min(currentPheromone + deposit, PHEROMONE_MAX)
  };

  // ── Decay pheromone across all nodes ───────────────────────────────────
  public func decayPheromone(currentPheromone : Float) : Float {
    Float.max(currentPheromone * (1.0 - PHEROMONE_DECAY_RATE), 0.0)
  };

  // ── Pheromone-guided navigation ────────────────────────────────────────
  // Drones prefer to move toward higher pheromone (danger awareness)
  // but with exploration probability (golden ratio split: 61.8% exploit, 38.2% explore)
  public func selectNextNode(
    connectedNodes : [Nat],
    pheromones : [Float],
    explorationSeed : Float
  ) : Nat {
    if (connectedNodes.size() == 0) return 0;
    if (connectedNodes.size() == 1) return connectedNodes[0];

    // Exploit vs explore: ψ (61.8%) of the time, go to highest pheromone
    if (explorationSeed < PSI) {
      // EXPLOIT — follow the pheromone
      var maxPheromone : Float = 0.0;
      var bestNode : Nat = connectedNodes[0];
      for (i in Iter.range(0, connectedNodes.size() - 1)) {
        if (i < pheromones.size() and pheromones[i] > maxPheromone) {
          maxPheromone := pheromones[i];
          bestNode := connectedNodes[i];
        };
      };
      bestNode
    } else {
      // EXPLORE — golden angle jump
      let idx = Int.abs(Float.toInt(explorationSeed * Float.fromInt(connectedNodes.size())));
      connectedNodes[idx % connectedNodes.size()]
    }
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // SWARM FLEET MANAGEMENT — Unified Multi-Domain Fleet
  // ═══════════════════════════════════════════════════════════════════════════
  // Same as DroneFleetManager but for ALL three domains.
  // Squadron count = ceil(sqrt(N / 20)) — same scaling law.

  public func deriveSquadronCount(totalDrones : Nat) : Nat {
    let n = Float.fromInt(totalDrones);
    let raw = Float.ceil(Float.sqrt(n / 20.0));
    Int.abs(Float.toInt(raw))
  };

  // ── Fibonacci sphere positioning for cyber drones ──────────────────────
  // Cyber drones distributed across network topology using same
  // Fibonacci sphere packing that physical drones use in 3D space.
  // Here, the "sphere" is the network topology mapped to spherical coords.
  public func deriveCyberSpherePosition(droneId : Nat, totalDrones : Nat) : (Float, Float, Float) {
    let n = Float.fromInt(totalDrones);
    let i = Float.fromInt(droneId);

    let theta = i * GOLDEN_ANGLE;
    let z = 1.0 - (2.0 * i + 1.0) / n;
    let r = Float.sqrt(1.0 - z * z);

    (r * Float.cos(theta), r * Float.sin(theta), z)
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // CYBER SWARM HEARTBEAT — The Unified Pulse
  // ═══════════════════════════════════════════════════════════════════════════
  // One heartbeat drives ALL domains:
  // 1. Collect phases from all drones (physical + cyber + EM)
  // 2. Compute unified order parameter S
  // 3. Update each drone's phase via Kuramoto
  // 4. Process threats across domains
  // 5. Deposit/decay pheromones
  // 6. Assess infrastructure sovereignty
  // 7. Maintain Schumann coupling

  public func beatChimeraSwarm(state : ChimeraSwarmState) : ChimeraSwarmState {
    let newBeat = state.currentBeat + 1;

    // 1. UNIFIED COHERENCE — S across all domains
    // In a full implementation, we'd collect all phases here.
    // For now, compute from domain coherences.
    let unifiedS = (
      state.physicalCoherence +
      state.cyberCoherence +
      state.emCoherence
    ) / 3.0;

    // 2. CROSS-DOMAIN COUPLING
    let crossCoupling = (
      state.physicalCoherence * state.cyberCoherence +
      state.cyberCoherence * state.emCoherence +
      state.emCoherence * state.physicalCoherence
    ) / 3.0;

    // 3. GLOBAL THREAT LEVEL
    var maxThreat : Float = 0.0;
    for (threat in state.activeThreats.vals()) {
      if (threat.intensity > maxThreat and not threat.neutralized) {
        maxThreat := threat.intensity;
      };
    };
    let globalThreat = maxThreat;
    let aegis = classifyThreatTier(globalThreat);

    // 4. SCHUMANN ALIGNMENT — consciousness coupling
    let schumannTarget = Float.fromInt(newBeat) * TWO_PI * SCHUMANN_FUNDAMENTAL;
    var wrappedSchumann = schumannTarget;
    while (wrappedSchumann >= TWO_PI) { wrappedSchumann -= TWO_PI };
    let schumannDelta = Float.abs(Float.sin(wrappedSchumann - state.unifiedMeanPhase));
    let newSchumannAlignment = state.schumannAlignment * 0.95 + (1.0 - schumannDelta) * 0.05;

    // 5. EM FIELD STRENGTH — coherence × Schumann × (1 - interference)
    let emField = state.emCoherence * newSchumannAlignment * (1.0 - globalThreat * 0.1);

    // 6. INFRASTRUCTURE SOVEREIGNTY
    var zoneControlSum : Float = 0.0;
    let numZones = state.infrastructureZones.size();
    for (zone in state.infrastructureZones.vals()) {
      zoneControlSum += zone.controlLevel;
    };
    let avgZoneControl = if (numZones > 0) { zoneControlSum / Float.fromInt(numZones) } else { 1.0 };

    // Return updated state
    {
      physicalDroneCount = state.physicalDroneCount;
      physicalCoherence = state.physicalCoherence;
      physicalMeanPhase = state.physicalMeanPhase;
      cyberDroneCount = state.cyberDroneCount;
      cyberCoherence = state.cyberCoherence;
      cyberMeanPhase = state.cyberMeanPhase;
      cyberTerrain = state.cyberTerrain;
      emDroneCount = state.emDroneCount;
      emCoherence = state.emCoherence;
      emMeanPhase = state.emMeanPhase;
      iotMesh = state.iotMesh;
      totalDroneCount = state.physicalDroneCount + state.cyberDroneCount + state.emDroneCount;
      unifiedCoherence = unifiedS;
      unifiedMeanPhase = state.unifiedMeanPhase;
      crossDomainCoupling = crossCoupling;
      activeThreats = state.activeThreats;
      globalThreatLevel = globalThreat;
      aegisTier = aegis;
      infrastructureZones = state.infrastructureZones;
      totalZones = numZones;
      averageZoneControl = avgZoneControl;
      currentBeat = newBeat;
      beatsPerSecond = state.beatsPerSecond;
      schumannAlignment = newSchumannAlignment;
      novaAxisActive = state.emCoherence > COHERENCE_THRESHOLD;
      emFieldStrength = emField;
    }
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // HEBBIAN LEARNING — Cyber Drone Adaptation
  // ═══════════════════════════════════════════════════════════════════════════
  // Same Hebbian rule as DroneAvatar: Δw = η × pre × post
  // Cyber drones learn which patterns indicate threats.
  // What fires together, wires together — in network space.

  public let LEARNING_RATE : Float = 0.001;       // η — small, stable
  public let WEIGHT_DECAY : Float = 0.0001;        // Regularization

  public func hebbianUpdate(
    weights : [Float],
    preActivations : [Float],
    postActivations : [Float]
  ) : [Float] {
    let n = weights.size();
    let preSize = preActivations.size();
    let postSize = postActivations.size();

    Array.tabulate<Float>(n, func(idx : Nat) : Float {
      let j = idx / preSize;
      let i = idx % preSize;
      if (i < preSize and j < postSize) {
        let dw = LEARNING_RATE * preActivations[i] * postActivations[j]
                 - WEIGHT_DECAY * weights[idx];
        weights[idx] + dw
      } else {
        weights[idx]
      }
    })
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // SIGNAL PROPAGATION — Waveform as Law
  // ═══════════════════════════════════════════════════════════════════════════
  // When a threat is detected, the signal propagates through the swarm
  // like a wave through a medium. Speed depends on coupling strength.
  // Amplitude decays with distance (inverse square law — real physics).
  //
  // Physical: radio wave propagation
  // Cyber: alert message propagation through network
  // EM: electromagnetic wave propagation
  //
  // ALL follow: P(r) = P₀ / (4π r²) — inverse square law
  // Because it's a LAW, not a choice.

  public func signalAttenuation(
    sourcePower : Float,
    distance : Float
  ) : Float {
    if (distance <= 0.0) return sourcePower;
    sourcePower / (4.0 * PI * distance * distance)
  };

  // ── Free-space path loss (dB) ──────────────────────────────────────────
  // FSPL = 20log₁₀(d) + 20log₁₀(f) - 147.55
  // Real RF propagation equation. Not approximation. The actual formula.
  public func freeSpacePathLoss(
    distanceMeters : Float,
    frequencyHz : Float
  ) : Float {
    if (distanceMeters <= 0.0 or frequencyHz <= 0.0) return 0.0;
    20.0 * Float.log(distanceMeters) / Float.log(10.0) +
    20.0 * Float.log(frequencyHz) / Float.log(10.0) -
    147.55
  };

  // ── Link budget ────────────────────────────────────────────────────────
  // Received power = Transmit power + Tx gain + Rx gain - Path loss
  // Real RF engineering. Real physics.
  public func linkBudget(
    txPower_dBm : Float,
    txGain_dBi : Float,
    rxGain_dBi : Float,
    pathLoss_dB : Float
  ) : Float {
    txPower_dBm + txGain_dBi + rxGain_dBi - pathLoss_dB
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // NETWORK FLOW ANALYSIS — Shannon Entropy for Traffic
  // ═══════════════════════════════════════════════════════════════════════════
  // Normal traffic has predictable entropy.
  // Anomalous traffic (DDoS, exfiltration, C2) has different entropy.
  // Shannon's channel capacity: C = B × log₂(1 + SNR)
  // Information entropy: H = -Σ pᵢ log₂(pᵢ)

  public func shannonEntropy(probabilities : [Float]) : Float {
    var h : Float = 0.0;
    for (p in probabilities.vals()) {
      if (p > 0.0 and p < 1.0) {
        h -= p * Float.log(p) / Float.log(2.0);
      };
    };
    h
  };

  // ── Channel capacity ──────────────────────────────────────────────────
  public func channelCapacity(bandwidth_hz : Float, snr_linear : Float) : Float {
    bandwidth_hz * Float.log(1.0 + snr_linear) / Float.log(2.0)
  };

  // ── Anomaly detection via entropy deviation ────────────────────────────
  // If observed entropy deviates from baseline by > 2σ, flag anomaly
  public func entropyAnomaly(
    observedEntropy : Float,
    baselineEntropy : Float,
    baselineSigma : Float
  ) : Float {
    let deviation = Float.abs(observedEntropy - baselineEntropy);
    if (baselineSigma > 0.0) {
      deviation / baselineSigma  // Number of standard deviations
    } else { 0.0 }
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // INIT — Create the Chimera Swarm
  // ═══════════════════════════════════════════════════════════════════════════
  // Initialize the unified multi-domain swarm from scratch.
  // Physical drones handled by DroneFleetManager.
  // This creates cyber drones, EM drones, IoT mesh, and infrastructure zones.

  public func initChimeraSwarm(
    cyberDroneCount : Nat,
    emDroneCount : Nat,
    physicalDroneCount : Nat
  ) : ChimeraSwarmState {
    // Initialize empty terrain
    let emptyTerrain : CyberTerrain = {
      nodes = [];
      totalNodes = 0;
      globalLatency = 10.0;
      globalThroughput = 1000.0;
      globalCoherence = 1.0;
      topologyType = #Mesh;
      totalPheromone = 0.0;
      lastScanBeat = 0;
    };

    // Initialize empty IoT mesh
    let emptyIoTMesh : IoTMeshState = {
      nodes = [];
      totalDevices = 0;
      meshCoherence = 1.0;
      meshPhase = 0.0;
      activeProtocols = ["WiFi", "BLE", "LoRa", "ZigBee"];
      totalBandwidth = 0.0;
      averageSignal = -60.0;
      compromisedCount = 0;
      lastMeshScan = 0;
    };

    {
      physicalDroneCount = physicalDroneCount;
      physicalCoherence = 1.0;
      physicalMeanPhase = 0.0;
      cyberDroneCount = cyberDroneCount;
      cyberCoherence = 1.0;
      cyberMeanPhase = 0.0;
      cyberTerrain = emptyTerrain;
      emDroneCount = emDroneCount;
      emCoherence = 1.0;
      emMeanPhase = 0.0;
      iotMesh = emptyIoTMesh;
      totalDroneCount = physicalDroneCount + cyberDroneCount + emDroneCount;
      unifiedCoherence = 1.0;
      unifiedMeanPhase = 0.0;
      crossDomainCoupling = KURAMOTO_K_CROSS_DOMAIN;
      activeThreats = [];
      globalThreatLevel = 0.0;
      aegisTier = 0;
      infrastructureZones = [];
      totalZones = 0;
      averageZoneControl = 1.0;
      currentBeat = 0;
      beatsPerSecond = 12.0;
      schumannAlignment = 1.0;
      novaAxisActive = true;
      emFieldStrength = 1.0;
    }
  };


  // ═══════════════════════════════════════════════════════════════════════════
  // DIAGNOSTIC — Full Swarm Status Report
  // ═══════════════════════════════════════════════════════════════════════════
  // Returns a human-readable status of the entire Chimera swarm.
  // Like a heartbeat monitor for the organism's cyber-physical-EM body.

  public type ChimeraDigest = {
    totalDrones : Nat;
    physicalDrones : Nat;
    cyberDrones : Nat;
    emDrones : Nat;
    iotDevices : Nat;
    unifiedCoherence : Float;
    physicalCoherence : Float;
    cyberCoherence : Float;
    emCoherence : Float;
    iotMeshCoherence : Float;
    crossDomainCoupling : Float;
    globalThreatLevel : Float;
    aegisTier : Nat;
    activeThreats : Nat;
    infrastructureZones : Nat;
    averageZoneControl : Float;
    schumannAlignment : Float;
    novaAxisActive : Bool;
    emFieldStrength : Float;
    currentBeat : Nat;
    status : Text;
  };

  public func getChimeraDigest(state : ChimeraSwarmState) : ChimeraDigest {
    let status = if (state.unifiedCoherence > COHERENCE_THRESHOLD) {
      "COHERENT — All domains synchronized"
    } else if (state.unifiedCoherence > FLOW_COHERENCE_MIN) {
      "PARTIAL — Cross-domain sync degraded"
    } else if (state.globalThreatLevel > S0) {
      "THREAT — Defense posture active"
    } else {
      "DEGRADED — Coherence below minimum"
    };

    {
      totalDrones = state.totalDroneCount;
      physicalDrones = state.physicalDroneCount;
      cyberDrones = state.cyberDroneCount;
      emDrones = state.emDroneCount;
      iotDevices = state.iotMesh.totalDevices;
      unifiedCoherence = state.unifiedCoherence;
      physicalCoherence = state.physicalCoherence;
      cyberCoherence = state.cyberCoherence;
      emCoherence = state.emCoherence;
      iotMeshCoherence = state.iotMesh.meshCoherence;
      crossDomainCoupling = state.crossDomainCoupling;
      globalThreatLevel = state.globalThreatLevel;
      aegisTier = state.aegisTier;
      activeThreats = state.activeThreats.size();
      infrastructureZones = state.totalZones;
      averageZoneControl = state.averageZoneControl;
      schumannAlignment = state.schumannAlignment;
      novaAxisActive = state.novaAxisActive;
      emFieldStrength = state.emFieldStrength;
      currentBeat = state.currentBeat;
      status = status;
    }
  };


