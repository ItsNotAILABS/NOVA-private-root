  // ─── IoT HUB OPERATIONS ───────────────────────────────────────────────────

  public shared(msg) func registerIoTDevice(
    deviceId: Text,
    deviceType: Text,
    protocol: Text
  ) : async Nat {
    let deviceTypeEnum = switch (deviceType) {
      case ("Sensor") { #Sensor };
      case ("Drone") { #Drone };
      case ("Camera") { #Camera };
      case ("Audio") { #Audio };
      case ("Gateway") { #Gateway };
      case ("Edge") { #Edge };
      case ("Medical") { #Medical };
      case ("Industrial") { #Industrial };
      case ("SmartHome") { #SmartHome };
      case ("Wearable") { #Wearable };
      case ("Vehicle") { #Vehicle };
      case ("Actuator") { #Actuator };
      case _ { #Sensor };
    };

    let protocolEnum = switch (protocol) {
      case ("MQTT") { #MQTT };
      case ("HTTP") { #HTTP };
      case ("CoAP") { #CoAP };
      case ("LoRa") { #LoRa };
      case ("Zigbee") { #Zigbee };
      case ("BLE") { #BLE };
      case ("Modbus") { #Modbus };
      case ("OPC_UA") { #OPC_UA };
      case ("Frequency") { #Frequency };
      case _ { #MQTT };
    };

    let (newState, phiNode) = MemoryTempleIoTHub.registerDevice(
      memoryTempleIoTState,
      deviceId,
      deviceTypeEnum,
      protocolEnum,
      null
    );
    memoryTempleIoTState := newState;
    phiNode
  };

