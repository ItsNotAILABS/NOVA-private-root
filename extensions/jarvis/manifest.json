{
  "manifest_version": 3,
  "name": "JARVIS — NOVA Phantom AI",
  "short_name": "JARVIS",
  "version": "1.0.0",
  "description": "JARVIS AI: Phantom AI thinking engine. 7-step reasoning pipeline. 5 thinking architectures. MiniHeart + MiniBrain. Born once. Never stops.",
  "author": "Alfredo Medina Hernandez — ItsNotAI LABS",
  "icons": {
    "16":  "icons/jarvis-16.png",
    "48":  "icons/jarvis-48.png",
    "128": "icons/jarvis-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup":   "popup.html",
    "default_title":   "JARVIS — Phantom AI",
    "default_icon": {
      "16":  "icons/jarvis-16.png",
      "48":  "icons/jarvis-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js":  ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+J" },
      "description": "Open JARVIS popup"
    },
    "open-side-panel": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Open JARVIS side panel"
    }
  }
}
